#!/bin/sh
# mux-save_lib - `mux save`: snapshot the live session as a profile.
#
# A SOURCED LIB AND NOT AN EXECUTED HELPER, the same call mux-why_lib made
# and for a sharper reason: what this needs is bin/mux's OWN `tm`, the tmux
# wrapper that carries the partition's `-L` socket. A separate process would
# have to grow a second copy, and this package has shipped the wrong-socket
# bug THREE times, every time because one answer was derived in two places.
#
# AND `emit_window` CAME WITH IT (2026-10-05), from bin/mux, where it had
# exactly one caller: this file. The comment here used to call it "the
# serialiser the build path and this one share", which was simply false by
# the time it was written: the build path emits nothing, it READS directives.
# So 54 lines sat in the entry point to serve one lib, and a lib reached back
# into its caller for a function. `is_shell` travels with it, being
# emit_window's only consumer.
#
# THE CALLER SOURCES THE DEPENDENCIES (see bin/mux's lib loop for why):
#
#     from bin/mux       tm
#     mux-conf_lib       mux_conf_clean
#     mux-data_lib       mux_data_find mux_data_stems
#     mux-profiles_lib   mux_fold_tilde mux_prof_drop mux_prof_file
#                        mux_prof_replace
#     mux-resolve_lib    mux_resolve_hash_theme
#     mux-sessions_lib   mux_sess_sanitise
#
# CALLER INPUTS: `name_arg` (what to call the saved profile; defaults to the
# live session's name) and `force` (overwrite an existing layout). Both are
# the parser's, and both are loud if absent since every caller runs under
# `set -u`.
#
# THE `sv_` PREFIX AND THE `_save_` NAMES STAY. Sourcing loads them into the
# same shell they already lived in, so they are exactly as private as before,
# and renaming would have moved mutation anchors and made the move's
# differential about two things at once.
# True when a pane's current command is just a shell (so it maps to a bare
# directive, no command). tmux re-quotes pane_start_command, so the clean signal
# is pane_current_command: a single word.
is_shell() {
  case $1 in
  sh|-sh|bash|-bash|ksh|-ksh|zsh|-zsh|dash|fish|login) return 0 ;;
  *) return 1 ;;
  esac
}

# Emit `pane`/`bottom` directives for one window ("=SESSION:INDEX"): top panes
# in index order first, then the full-width bottom if the window has one (marked
# by @mux-bottom, carrying its SPEC). The command is the pane's CURRENT command
# (best-effort); a shell pane emits a bare directive.
emit_window() {
  tm list-panes -t "$1" -F \
   "#{pane_index}|#{@mux-bottom}|#{@mux-agent}|#{@mux-control}|\
#{@mux-attention}|#{pane_current_command}" \
  | sort -t'|' -k1,1n | while IFS='|' read -r _pi _pb _pa _pk _pn _pc; do
    [ -z "$_pb" ] || continue
    # @mux-agent, set at build: an agent that has exited (or was
    # never installed) looks exactly like a shell here, so without
    # the mark a round trip would turn `pane agent` into `pane`.
    if [ -n "$_pa" ]; then printf 'pane    agent\n'
    elif is_shell "$_pc"; then printf 'pane\n'
    else printf 'pane    %s\n' "$_pc"; fi
    # AND THE CLASS ROUND-TRIPS, for exactly the reason one line up: without
    # it a save-then-build cycle silently reclasses a worker to `human`, the
    # safe default, and a supervisor then cannot type into its own worker.
    # The same loss `@mux-agent` is already here to prevent.
    #
    # OMITTED WHEN IT IS THE DEFAULT, because a layout holds only what
    # OVERRIDES: an explicit `control human` is indistinguishable from the
    # absence of the line, so emitting it would be noise that reads as a
    # decision.
    case $_pk in
    agent|hybrid) printf 'control %s\n' "$_pk" ;;
    esac
    # AND THE SAME FOR ATTENTION, separately rather than in one arm with the
    # line above: the two markers answer different questions and a session
    # can easily declare one and not the other (an agent-supervised worker
    # the human still wants to SEE is `control agent` with attention left
    # alone). Folding them would make that unsayable.
    case $_pn in
    agent|hybrid) printf 'attention %s\n' "$_pn" ;;
    esac
  done
  tm list-panes -t "$1" -F '#{@mux-bottom}|#{pane_current_command}' \
  | while IFS='|' read -r _pb _pc; do
    [ -n "$_pb" ] || continue
    if is_shell "$_pc"; then printf 'bottom  %s\n' "$_pb"
    else printf 'bottom  %s %s\n' "$_pb" "$_pc"; fi
  done
}

# --- save: snapshot the live session ---------------------------------------
# Records the session the way everything else does: as a DEVIATION. It reads
# the arrangement off the live session (window names, each pane's current
# command, any full-width bottom from @mux-bottom) and writes only what mux
# could not have worked out for itself:
#
#   - the arrangement, as layouts/<name>.layout, unless it is byte-for-byte one
#     that already exists: saving a session you never rearranged should not
#     mint a private copy of the shipped default;
#   - a row, carrying root only when the name would not derive from it, theme
#     only when it is not the one the name hashes to, and layout only when it is
#     not `default`.
#
# So `mux save` on an untouched session can correctly write NOTHING. Pane
# commands are best-effort: review them. Runs inside a session; NAME defaults
# to the session name.
#
# Shared state, in the order the steps below set it:
#   _save_identify      sv_sess sv_name
#   _save_capture       sv_tmp        (the arrangement, as directives)
#   _save_match_layout  sv_layout     (an existing layout that already says it)
#   _save_write_layout  sv_layout     (or the one it just wrote)
#   _save_deltas        sv_pairs      (only what is NOT derivable)

# Which live session this is, and what to call the saved profile.
_save_identify() {
  [ -n "${TMUX:-}" ] || {
    echo "mux: save must run inside a session" >&2; exit 1; }
  sv_sess=$(tm display-message -p '#{session_name}' 2>/dev/null || true)
  [ -n "$sv_sess" ] || {
    echo "mux: could not identify the session" >&2; exit 1; }
  sv_name=${name_arg:-$sv_sess}
  sv_name=$(mux_sess_sanitise "$sv_name")
}

# The arrangement, into a temp so it can be compared before it lands.
_save_capture() {
  sv_tmp=$(mktemp) || { echo "mux: mktemp failed" >&2; exit 1; }
  trap 'rm -f "$sv_tmp"' EXIT
  tm list-windows -t "=$sv_sess" -F '#{window_index} #{window_name}' \
  | while read -r _wi _wn; do
    printf 'window  %s\n' "$_wn"
    emit_window "=$sv_sess:$_wi"
  done >"$sv_tmp"
  [ -s "$sv_tmp" ] || {
    echo "mux: read no windows from $sv_sess" >&2; exit 1; }
}

# Does an existing layout already say this? Compared NORMALIZED, so comments
# and spacing do not make a match look like a difference.
_save_match_layout() {
  sv_layout=
  sv_norm=$(mux_conf_clean <"$sv_tmp")
  # Line by line: a layout file may be named with a space, and
  # splitting it would look for two layouts that do not exist.
  while IFS= read -r _cand; do
    [ -n "$_cand" ] || continue
    _cf=$(mux_data_find layouts "$_cand" .layout)
    [ -n "$_cf" ] || continue
    [ "$(mux_conf_clean <"$_cf")" = "$sv_norm" ] || continue
    sv_layout=$_cand
    break
  done <<EOF
$(mux_data_stems layouts .layout)
EOF
}

# Write the captured arrangement, unless an existing layout already matched:
# config never restates what mux can already point at.
_save_write_layout() {
  sv_lfile=$MUX_DIR/layouts/$sv_name.layout
  if [ -n "$sv_layout" ]; then
    echo "mux: arrangement matches the '$sv_layout' layout;" \
      "no new one written"
  else
    # `force` IS A CALLER INPUT (--force, from bin/mux's parser), named in
    # the header's contract. Loud if absent anyway, since every caller runs
    # under `set -u`.
    # shellcheck disable=SC2154
    [ "$force" -eq 1 ] || [ ! -e "$sv_lfile" ] || {
      echo "mux: exists: $sv_lfile (use --force)" >&2
      exit 1
    }
    mkdir -p "$MUX_DIR/layouts"
    {
      printf '# %s: arrangement captured from session %s' \
        "$sv_name" "$sv_sess"
      printf ' on %s.\n' "$(date '+%Y-%m-%d')"
      printf '# Pane commands are best-effort;'
      printf ' review them.\n'
      cat "$sv_tmp"
    } >"$sv_lfile"
    sv_layout=$sv_name
    echo "mux: wrote $sv_lfile"
  fi
  rm -f "$sv_tmp"; trap - EXIT
}

# The profile row: ONLY what mux could not derive on its own.
_save_deltas() {
  # Root: the session's own start directory, folded to ~. Dropped when
  # the name derives from it, which needs the root to BE a project base
  # (a git toplevel, or in no repo at all): a subdirectory of a repo
  # derives the REPO's name, so its root must be kept.
  sv_root=$(tm display-message -t "=$sv_sess" -p '#{session_path}' \
    2>/dev/null || true)
  sv_pairs=
  if [ -n "$sv_root" ]; then
    _top=$(git -C "$sv_root" rev-parse --show-toplevel \
      2>/dev/null || true)
    if [ "$(basename "$sv_root")" = "$sv_name" ] \
       && { [ -z "$_top" ] || [ "$_top" = "$sv_root" ]; }; then
      :        # derivable, so not worth recording
    else
      sv_pairs="root=$(mux_fold_tilde "$sv_root")"
    fi
  fi
  # Theme: only when it is not the one this name would hash to anyway.
  sv_theme=$(tm show-options -t "=$sv_sess" -qv @mux-theme \
    2>/dev/null || true)
  sv_hash=$(mux_resolve_hash_theme "$sv_name")
  if [ -n "$sv_theme" ] && [ "$sv_theme" != "$sv_hash" ]
  then
    sv_pairs="$sv_pairs theme=$sv_theme"
  fi
  [ "$sv_layout" = default ] || sv_pairs="$sv_pairs layout=$sv_layout"
  sv_pairs=${sv_pairs# }
}

# Record the deltas, or drop the row entirely when there are none.
_save_record() {
  if [ -n "$sv_pairs" ]; then
    mux_prof_replace "$sv_name" "$sv_pairs" || {
      echo "mux: could not write $(mux_prof_file)" >&2
      exit 1; }
    echo "mux: $sv_name -> $sv_pairs"
  else
    mux_prof_drop "$sv_name"
    echo "mux: nothing to record: $sv_name is entirely derivable"
  fi
  echo "mux: launch it with  mux go $sv_name"
}

mux_save() {
  _save_identify
  _save_capture
  _save_match_layout
  _save_write_layout
  _save_deltas
  _save_record
  exit 0
}

