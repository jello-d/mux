#!/bin/sh
# mux-paths_lib - WHERE MUX KEEPS THINGS. One place, because the answer was
# open-coded in five.
#
# Three homes, and the line between them is one question: DOES IT REBUILD?
#
#   $MUX_DIR    your config. Authored, and mux writes here too (`mux save`,
#               `mux edit`, `mux theme`). Resolved in mux-data_lib.
#
#   $MUX_CACHE  YES. Palette stamps and the project discovery map both
#               regenerate from what they summarise, so losing one costs a
#               moment. ~/.cache is by definition what anything may delete.
#
#   $MUX_STATE  NO. The session set accumulates one `mux go` at a time; an
#               unsaved profile draft is work you typed. Nothing can
#               reconstruct either, so a cache clear must not take them.
#
# THAT TEST IS THE WHOLE DESIGN, and was got wrong twice: the session set sat
# in $MUX_CACHE until 0.38 and the edit draft until 0.39, both because they
# were "transient", true of the FACT each records and irrelevant to whether
# the file can be rebuilt. The cost lands much later: a cache clear, a reboot,
# then a `mux resume` that finds nothing, at the one moment the answer cannot
# be reconstructed. So for a new file, ask only whether mux could regenerate
# it; if not, it belongs under mux_state_path and gets the adoption for free.

# Regenerable state. $MUX_CACHE overrides so an integrator can relocate it.
mux_cache_dir() {
  printf '%s' "${MUX_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/mux}"
}

# Durable, unreconstructible state. $XDG_STATE_HOME is the standard home for
# this category: kept across restarts, not precious enough to be user DATA.
mux_state_dir() {
  printf '%s' "${MUX_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/mux}"
}

# mux_state_path REL -> the state path for REL, ADOPTING a pre-0.38 copy left
# in the cache. File or directory.
#
# A FUNCTION AND NOT A VARIABLE BECAUSE OF THE ADOPTION. An upgrade lands
# while things are already recorded and the next reader may be the `mux
# resume` after a reboot, so a file left in the old location is lost at the
# one moment it mattered; on first touch there is no verb to remember and no
# window in which it has not happened yet. NEVER CLOBBERS: if the state copy
# exists the cache copy is ignored, since an upgrade followed by real use
# would lose everything recorded in between. Best effort: a failed move
# leaves the caller seeing nothing rather than an error, and the old copy
# intact for a later run.
mux_state_path() {      # <relative path>
  _mpn=$(mux_state_path_ro "$1")
  _mpo=$(mux_cache_dir)/$1
  if [ ! -e "$_mpn" ] && [ -e "$_mpo" ]; then
    if mkdir -p "$(dirname "$_mpn")" 2>/dev/null; then
      mv -f "$_mpo" "$_mpn" 2>/dev/null || true
    fi
  fi
  printf '%s' "$_mpn"
}

# mux_state_path_ro REL -> the SAME path and NOTHING ELSE. No adoption, no
# mkdir, no move: safe from a caller that must not write.
#
# THE DOOR EXISTS BECAUSE A READER THAT MIGRATES TAKES A SNAPSHOT, paid for
# in full once: agent-state adopted inside `mux_agent_dir`, eleven of whose
# twelve callers are read-only, and a checkout invocation COPIED the live
# records at a moment nobody chose, freezing a session as `working` for an
# hour while every beat refreshed it, after which no timestamp rule could tell
# the two apart. That adoption moved to the installer.
#
# The adoption above stays: its one consumer is the session set, whose next
# reader after an upgrade really is the `mux resume` that needs it. What was
# missing is a way to ASK WITHOUT ACTING, and `mux check` is the caller that
# needs it, its contract saying it must never damage what it inspects while it
# had called the adopting form since the edit-draft marker was written.
mux_state_path_ro() {   # <relative path>
  printf '%s/%s' "$(mux_state_dir)" "$1"
}
