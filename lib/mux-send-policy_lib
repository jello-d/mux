#!/bin/sh
# mux-send-policy_lib - WHO MAY TYPE INTO A PANE MUX CANNOT VOUCH FOR.
#
# mux refuses to send text into an agent that is BLOCKED (at a permission
# prompt, waiting on a human) or that has NO RECORD at all (mux knows nothing
# about it, so it can vouch for nothing). One reason for both: a peer that can
# answer another agent's approval prompt is a way for agents to approve each
# other and route around the person.
#
# THE OVERRIDE CANNOT LIVE WHERE THE AGENT CAN REACH IT, and that is the whole
# design. A command-line flag is forgeable, since the agent composes its own
# argv. A file under $MUX_DIR is equally forgeable and worse for being
# plausible: mux WRITES there (`mux save`, `mux theme`, `mux edit`), so it is
# user-owned by design and an agent with a shell tool edits it in one line.
#
# So the policy sits at the privilege boundary this fleet already writes down:
# what the user session runs lives in ~/.config and is user-editable; what the
# user must NOT edit lives in /etc, root-owned. A human takes this one with
# sudo; the agent it governs cannot.
#
#   /etc/mux/send-policy      root-owned, not user-writable
#
# ALLOWLIST ONLY, so there is no precedence to get wrong. No file means
# "never", an empty file means "never", and each line names something
# permitted. There is no `deny` directive: a two-sided policy language is
# where order-of-evaluation bugs live, and this file has one job.
#
#   send-blocked  <scope>...   type into an agent waiting on a human
#   send-unknown  <scope>...   type into a pane with no agent record
#
# TWO DIRECTIVES, NOT ONE, because they permit different things. "This worker
# may have its prompts answered" and "this worker may be typed at blind" are
# separate grants, and allowing one must not quietly allow the other.
#
# A SCOPE IS `*` OR ONE OR MORE `key:value` TOKENS, AND A LINE MATCHES ONLY
# WHEN ALL OF THEM DO. Keys are `control`, `partition`, `session`, `window`:
#
#   send-blocked  control:agent                any agent-supervised worker
#   send-blocked  control:hybrid session:api   hybrid, in one project only
#   send-blocked  partition:work               a whole boundary
#   send-blocked  session:api window:reviewer  ONE worker in one project
#
# WHO CONTROLS THE PANE IS THE REAL QUESTION, and a different one from where
# the pane is. What makes answering a prompt wrong is not that an agent typed
# it, it is that the prompt was ADDRESSED TO A HUMAN. A worker spawned and
# supervised by an agent usurps no human decision: it has a supervision
# ladder, and the class is what lets mux respect that ladder instead of
# pretending every prompt belongs to a person.
#
#   human    NEVER. Not a token here at all: see below.
#   agent    supervised by an agent. Reasonably granted as a whole class:
#            multi-agent work is impossible without it, and per-window grants
#            do not scale to a village of eight generated names.
#   hybrid   IT DEPENDS, which is exactly why it is its own class. Grantable,
#            but deliberately and usually scoped to a project.
#
# `control:human` IS NOT A TOKEN AND CANNOT BE WRITTEN. A human-controlled
# pane is refused BEFORE this file is consulted, so `never` is structural
# rather than a property of the operator having written the right tokens:
# `send-blocked window:reviewer` must not grant a human's pane by omission.
#
# AND HYBRID MUST NOT COLLAPSE INTO HUMAN, the first design here and wrong in
# the dangerous direction: the only way to grant a hybrid pane would then have
# been a `human` grant, so expressing the MIDDLING case would force the door
# open for the strictest one.
#
# THE CLASS IS ORGANISATIONAL, NOT A SECURITY BOUNDARY, said plainly so a
# later reader does not mistake it for a sandbox. mux runs as the agent's own
# uid, so any mark mux can read is one the agent can rewrite, and an agent set
# on answering its neighbour's prompt can call `tmux send-keys` today. What
# the refusal buys is narrower and still worth having: the dangerous thing
# stops being the EASY thing, the default sits outside the agent's reach so
# the posture cannot drift, and a bypass goes through tmux, outside mux's
# audit log, which is itself a signal.
#
# THE WINDOW IS THE UNIT A FLEET ACTUALLY HAS. An orchestrator above mux
# spawns a WINDOW per worker in the project's session (vicus does), so
# `session:` alone would grant every worker in the project at once, far
# coarser than anyone means. A window is also what a human watches, so it is
# what they can reason about granting.
#
# Conjunction rather than a `session/window` path syntax, because it needs no
# new grammar and stays allowlist-only: still no `deny`, still no precedence.
#
# NO `pane:` KEY, deliberately. A pane id is stable for the pane's life and
# not across a restore, so a policy keyed on one would silently stop applying
# after `mux undo-pane` or a rebuild, and a permission that lapses without
# saying so is worse than one never granted.

# _sp_file: the policy path. Overridable ONLY for the test suite, and named so
# that is obvious. A variable an agent could point at a file it owns would
# defeat the whole mechanism, so this must never be documented as a user seam
# or read from config.
_sp_file() {
  printf '%s' "${MUX_SEND_POLICY_FILE:-/etc/mux/send-policy}"
}

# mux_send_policy_usable -> is the policy file safe to obey?
#
# THE TEST IS "CAN I WRITE IT", the question that matters: mux runs as the
# agent's own user, so if this process can write the file so can the agent,
# and a policy the governed party can edit is not a policy. The containing
# DIRECTORY too, since being unable to write a file is no protection when you
# can replace it.
#
# Running as root makes both true and the policy unusable, which is the honest
# answer rather than an inconvenience: an agent running as root is outside
# this model, and silently honouring a policy it could rewrite is the worst of
# both.
mux_send_policy_usable() {
  _spf=$(_sp_file)
  [ -f "$_spf" ] || return 1
  [ ! -w "$_spf" ] || return 1
  [ ! -w "$(dirname -- "$_spf")" ] || return 1
  return 0
}

# mux_send_policy_why -> a sentence about why the policy is not in force, or
# empty when it is. SAID, NEVER LEFT TO BE GUESSED: a policy that is silently
# ignored is worse than none, because whoever wrote it believes it applies.
mux_send_policy_why() {
  _spf=$(_sp_file)
  if [ ! -f "$_spf" ]; then
    printf 'no policy at %s' "$_spf"
  elif [ -w "$_spf" ]; then
    printf '%s is writable by this user, so it is not a policy' \
      "$_spf"
  elif [ -w "$(dirname -- "$_spf")" ]; then
    printf '%s is in a directory this user can write,' \
      "$(dirname -- "$_spf")"
    printf ' so the file could be replaced'
  fi
}

# mux_send_allowed WHAT PARTITION SESSION WINDOW CLASS -> is it permitted?
#
# WHAT is `blocked` or `unknown`. Every token on a line must match, each
# compared as a STRING and never as a pattern, so a window called `*` cannot
# grant itself everything and neither can one called `partition:work`.
#
# THE CALLER MUST HAVE REFUSED A `human` CLASS ALREADY, and this function does
# not check, on purpose: a gate in one place cannot be half applied, where one
# here would let a future caller reach the allowlist with a human pane by
# forgetting a check.
mux_send_allowed() {   # <what> <partition> <session> <window> <class>
  mux_send_policy_usable || return 1
  # A SUBSHELL WITH GLOBBING OFF. `set -- $_spl` also PATHNAME-EXPANDS,
  # so the scope token `*` became whatever files were in the current
  # directory and the systemwide grant silently never matched. Found on
  # the first run of this function's own test.
  #
  # A subshell rather than save-and-restore because the matching loop
  # returns from the middle, so a restore after it would be skipped on
  # every successful match.
  ( set -f
  _spw=$1 _spp=$2 _sps=$3 _spwin=$4 _spc=$5
  while IFS= read -r _spl; do
    # Full-line comments and blanks go; an inline `#` stays, because a
    # name may legitimately contain one. mux_conf_clean's rule.
    case $_spl in
      ''|'#'*) continue ;;
    esac
    # shellcheck disable=SC2086   # tokens, split on purpose
    set -- $_spl
    [ "${1:-}" = "send-$_spw" ] || continue
    shift
    # A DIRECTIVE WITH NO SCOPE GRANTS NOTHING. `send-blocked` alone
    # reads like "allow it", which would turn a truncated line into a
    # systemwide permission.
    [ $# -gt 0 ] || continue
    _ok=1
    for _tok in "$@"; do
      case $_tok in
        '*') ;;
        "partition:$_spp") ;;
        "session:$_sps") ;;
        "window:$_spwin") ;;
        "control:$_spc") ;;
        *) _ok=0; break ;;
      esac
    done
    [ "$_ok" = 1 ] && exit 0
  done <"$(_sp_file)"
  # LITERAL 0/1, NOT MUX_EC_*: this is the SUBSHELL's status, which the
  # caller reads as a predicate. It is a true/false, not one of mux's exit
  # codes, and naming it would claim the function had decided mux's own.
  exit 1 )
}
