#!/bin/sh
# mux-notice_lib: telling the human something they will actually read.
#
# THE PROBLEM IS NOT "stderr does not work". Measured: a line mux writes
# before it attaches DOES survive a detach, because tmux uses the ALTERNATE
# screen (`?1049h`, `?1049l` on teardown) and the terminal restores the
# primary underneath, so the line reappears just above tmux's `[detached]`.
#
# IT IS STILL THE WRONG PLACE, for two reasons unrelated to erasure:
#
#   - IT IS HOURS OLD BY THEN. The human typed `mux go` and then worked in
#     the session for a day, so the line sits above a prompt they stopped
#     looking at, competing with tmux's detach message for the same glance.
#   - AND IT IS GENUINELY LOST on any path that CLEARS or RESETS the terminal
#     rather than merely leaving the alternate screen. mux has those: `mux
#     sane` exists because a dead tmux leaves a terminal to repair, and latch
#     repairs before it reports.
#
# SO A NOTICE GOES OUT TWICE, the user's design (2026-09-30):
#
#   NOW, to stderr, where it may be seen, may be missed, may be wiped.
#   AGAIN as the terminal is handed back, so it is the thing under the cursor
#        when the human returns to their shell.
#
# ---------------------------------------------------------------------------
# THE HANDBACK IS TWO TMUX HOOKS, AND THAT WAS MEASURED
#
# The obvious single hook cannot work: `client-detached` FIRES, but
# `#{client_tty}` and `#{client_name}` both resolve EMPTY inside it, because
# the client is gone by the time the body runs. Same shape as `run-shell -t`
# exporting no pane to its child.
#
# Two hooks do, and the ordering is what had to be checked:
#
#     client-attached   record #{client_tty}, which IS available there
#     client-detached   write to the tty recorded at attach
#
#     6 of 6 runs: the bytes land AFTER `?1049l`
#
# so the text reaches the REAL terminal rather than the alternate screen about
# to be discarded. Landing before it would have made the whole approach
# silently useless, which is why this was measured over several runs.
#
# IT BEATS MUX FLUSHING THE QUEUE ITSELF twice over: mux keeps its deliberate
# `exec` of the tmux client, so no shell lingers per attached session, and a
# detach mux never saw (`tmux detach-client`, `prefix d`) still delivers. mux
# is not the only way out of a session, so a mechanism tied to mux's own exit
# path would miss the common case.
#
# TWO COSTS, neither hidden:
#
#   - THE QUEUE MUST BE DURABLE: the hook runs in the SERVER's context and
#     cannot see a temp file owned by a mux since replaced by exec. So it is
#     a file at a known path, and a crash between write and flush leaves
#     notices for the next detach on that terminal.
#   - ONE TTY PER SERVER OPTION: with two clients attached the second attach
#     overwrites the first's record, and a detach prints on whichever was
#     recorded last. tmux offers no per-client storage and `client-detached`
#     knows no client identity, so this is unresolvable from here. A notice
#     in the wrong terminal is confusing rather than harmful, and mux's
#     common case is one client.
#
# ---------------------------------------------------------------------------
# AGE IS NOT STALENESS, the user's correction to an earlier design here, and
# worth stating because the instinct it corrects is a strong one. The first
# version dropped a notice past an age, by analogy with MUX_NOTIF_TTL
# dropping a stale notification id. The analogy is wrong: a freedesktop id
# goes stale because the THING IT NAMES is reassigned to somebody else's
# banner, so an old id actively misleads. An environment notice names a FACT
# ("WAYLAND_DISPLAY was withheld because nothing is listening on it"), which
# does not expire because an hour passed, is very likely still true, and
# discarding it loses the only record that mux withheld anything.
#
# SO NOTHING IS DROPPED BY AGE. Each notice carries WHEN and IN WHAT PHASE it
# arose, and the reader judges: this package's "names rather than counts"
# instinct applied to time.

# WHERE THE QUEUE LIVES: $MUX_STATE, not $MUX_CACHE, by the does-it-rebuild
# test. A notice cannot be recomputed; the moment that made it true is gone.
# Same argument that moved the session set and the colour slots.
#
# KEYED BY TTY, because that is what the handback can resolve: the hook knows
# the tty it recorded at attach and nothing else about who is waiting.
mux_notice_file() {   # [tty] -> the queue for that terminal
  _nfd=$(mux_state_dir)/notices
  _nft=${1:-}
  # `tty` PRINTS "not a tty" ON STDOUT and exits non-zero, so
  # `$(tty || echo unknown)` concatenates BOTH and the key became
  # `not_a_tty_unknown`. Capture first, then decide: a fallback appended to a
  # failed command's own output is not a fallback. Found running this from a
  # shell with no controlling terminal, which is where an agent lives.
  if [ -z "$_nft" ]; then
    _nft=$(tty 2>/dev/null) || _nft=
    case ${_nft:-} in
    /dev/*) ;;
    *) _nft=unknown ;;
    esac
  fi
  # The undo-pane record's sanitiser. Only `/` is replaced, so two distinct
  # ttys cannot collide after it.
  printf '%s/%s' "$_nfd" \
    "$(printf '%s' "$_nft" | tr -c 'A-Za-z0-9_.-' '_')"
}

# Say something now AND keep it for the handback.
#
# STDERR IMMEDIATELY, not only at the end, because the end may never come: a
# killed `mux go` still owes the human the reason, at the moment it happened.
#
# THE PHASE IS THE CALLER'S WORD for what it was doing, so a notice read an
# hour later is attributable without mux guessing. TAB-separated because the
# text is prose and will contain spaces, the agent record's reason too.
mux_notice() {   # <phase> <text...>
  _nph=$1; shift
  printf 'mux: %s\n' "$*" >&2
  _nqf=$(mux_notice_file)
  mkdir -p "${_nqf%/*}" 2>/dev/null || return 0
  # `2>/dev/null` FIRST, not cosmetic: redirections apply left to right, so
  # reversed, a failing OPEN happens while stderr is still the terminal and
  # the SHELL prints the complaint before this command runs. test/lint.t
  # refuses the wrong order, and caught this very line.
  printf '%s\t%s\t%s\n' "$(date +%s 2>/dev/null || echo 0)" "$_nph" "$*" \
    2>/dev/null >>"$_nqf" || true
}

# --- the handback ----------------------------------------------------------
# Called by the client-detached hook with the tty recorded at attach. Prints
# there and REMOVES the queue, so a notice is delivered once.
#
# EACH LINE CARRIES ITS OWN AGE, per the correction above: a notice from a run
# that died is still delivered, and says when it happened rather than
# pretending to be current.
mux_notice_flush() {   # <tty>
  _nft=${1:-}
  [ -n "$_nft" ] || return 0
  _nqf=$(mux_notice_file "$_nft")
  [ -s "$_nqf" ] || return 0
  _nnow=$(date +%s 2>/dev/null || echo 0)
  {
    # tmux has just written `[detached (from session X)]`, and two unrelated
    # messages on adjacent lines read as one.
    printf '\n'
    printf 'mux noticed:\n'
    while IFS='	' read -r _nwhen _nphase _ntext; do
      [ -n "$_ntext" ] || continue
      _nage=
      case ${_nwhen:-0} in
      ''|*[!0-9]*) ;;
      *) if [ "$_nnow" -gt "$_nwhen" ] 2>/dev/null; then
           _nage=$(( _nnow - _nwhen ))
           if   [ "$_nage" -lt 90 ];   then _nage="${_nage}s ago"
           elif [ "$_nage" -lt 5400 ]; then _nage="$(( _nage / 60 ))m ago"
           else _nage="$(( _nage / 3600 ))h ago"
           fi
         fi ;;
      esac
      printf '  %s%s: %s\n' "$_nphase" "${_nage:+, $_nage}" "$_ntext"
    done <"$_nqf"
    # `2>/dev/null` BEFORE the redirect, and this one is why the rule exists:
    # with `>"$_nft" 2>/dev/null` a RELEASED tty prints `cannot create
    # /dev/pts/21: Permission denied` into whatever stderr still points at,
    # which during a detach hook is the tmux server's log. Observed.
  } 2>/dev/null >"$_nft" || {
    # DELIVERY FAILED, SO THE QUEUE SURVIVES. The first version removed it
    # unconditionally and lost the notice, found by an end-to-end test where
    # the tty had already been released. A notice that could not be delivered
    # is exactly the one worth keeping, and the next detach on that terminal
    # carries it with its age: the other half of dropping nothing for age.
    return 1
  }
  # THE LITERAL IS CHECKED BEFORE THE REMOVAL, per the standing rule in
  # ~/src/CLAUDE.md: expand first, check what it is, then remove that. An
  # absolute path under the state dir, or nothing happens.
  case $_nqf in
  /*) rm -f "$_nqf" 2>/dev/null || true ;;
  esac
}
