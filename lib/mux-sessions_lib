#!/bin/sh
# mux-sessions_lib - the SESSION SET: which sessions this partition had, so a
# reboot is followed by `mux resume` and not by rebuilding five sessions by
# hand.
#
# STATE, not config, and not CACHE either. Never in $MUX_DIR and never in git,
# since which sessions are up is per-machine; it must outlive a reboot, so not
# /tmp; and it must outlive a CACHE CLEAR, which is the part that was wrong.
#
# It lived under $MUX_CACHE until 0.38, where the comment reasoned about cache
# versus /tmp and never about cache versus state, and ~/.cache is by
# definition what anything may delete to reclaim space. NOTHING REBUILDS THIS
# FILE: the set accumulates one `mux go` at a time, so clearing the cache
# silently destroyed the answer to "what was I working on", and the only
# moment you would notice is the `mux resume` after a reboot, exactly when you
# cannot reconstruct it. $MUX_STATE is the XDG home for precisely this:
# durable, unreconstructible, not precious enough to be data. Palette stamps
# and the discovery map stay in $MUX_CACHE, correctly, since both regenerate.
#
# Recorded AUTOMATICALLY, because the scenario is "the machine rebooted",
# exactly the moment you did not think to save. Adding a session records it,
# killing one removes it, `kill --all` clears the set. There is deliberately
# no save verb: `mux save` already means "capture this session's shape into a
# profile", and a second meaning would be one too many.
#
# ADDITIVE on create and SUBTRACTIVE on kill, NOT a snapshot of what is live.
# A snapshot would be clobbered by the first `mux go` after a reboot, when
# exactly one session is up, destroying the record being rebuilt.
#
# Each line is NAME<TAB>ROOT, and the root is not optional: the common session
# is a bare `mux go` in a directory, with no profile and no map entry, so the
# name alone cannot rebuild it. Recording where it lived also makes the set an
# evidence source in its own right, so `mux go <name>` resolves through it
# exactly as through a profile or the discovery map.
#
# Insertion-ordered, so a resume rebuilds in the order you first opened them.
# THAT ORDER DOES NOT SAY WHERE TO LAND, though this file used to claim it did
# ("lands you on the oldest, which is usually the one you think of as
# primary"). Creation order has nothing to do with where you were: reported
# live after a reboot, a latch came back on the oldest session while the human
# had been working in the newest, so the message they typed reached the wrong
# agent. The landing spot is its own fact, recorded separately below.
#
# Keyed on the PARTITION, so each isolated namespace resumes only its own.

# The set file for a partition. KEY defaults to the ambient socket, matching
# how the theme stamp and the agent-state dir are keyed.
#
# MIGRATES ON FIRST TOUCH, and it has to happen here rather than in a verb
# somebody has to remember to run. The upgrade lands while sessions are already
# recorded, and the very next thing that reads this file is likely the
# `mux resume` after a reboot, so a set left behind in the old location is a
# set lost at the one moment it mattered. The move is a rename, idempotent, and
# silent when there is nothing to move.
# --- what a session may be CALLED ------------------------------------------
# mux RESERVES THE COLON in a session name, and that reservation is now the
# grammar's foundation rather than a convenience.
#
# IT USED TO BE TMUX'S JOB. Every tmux up to 3.6 rewrote `:` and `.` to `_` in
# a session name, so `[PARTITION::]SESSION[:WINDOW]` was unambiguous for free.
# MEASURED ACROSS THREE VERSIONS, that is no longer true:
#
#     tmux 3.4    structural: : :: .     verbatim: @ ~ % ^ + = , /
#     tmux 3.6    structural: : :: .     verbatim: @ ~ % ^ + = , /
#     tmux 3.7c   structural: (none)     verbatim: everything
#
# 3.7 sanitises NOTHING, so a session there can be called `work::api` and no
# choice of delimiter can rescue the grammar on its own. The premise has to be
# mux's (the user's call, 2026-10-01), and it costs nothing to keep: a colon
# is tmux's OWN window separator, so a session named `work:api` cannot be
# addressed by a raw `tmux -t` either. mux is not fighting tmux here, it is
# holding a line tmux stopped holding.
#
# `.` IS SANITISED TOO AND FOR A DIFFERENT REASON, which is why the two are
# not one rule: mux's grammar does not use a dot any more, so a session called
# `example.com` would be perfectly addressable. It is rewritten because TMUX
# <= 3.6 rewrites it, and mux has to agree with what tmux will actually store
# or `has-session` stops matching the name mux recorded. That is a
# compatibility rule with a version attached, not a reservation.
#
# ONE COPY. This was open-coded as `tr ':.' '--'` in FIVE places in bin/mux
# with no test anywhere, which is the shape that drifts.
mux_sess_sanitise() {   # <name> -> a name tmux will store unchanged
  printf '%s' "$1" | tr ':.' '--'
}

# Does this name hold something mux reserves? Answers 0 when it is CLEAN.
# Separate from the sanitiser because the two have different callers: a name
# the user TYPED is refused, while one DERIVED from a directory is rewritten,
# since directories are full of dots and refusing `~/src/example.com` would be
# mux being difficult about a name nobody chose.
mux_sess_name_clean() {   # <name>
  case ${1:-} in
  *:*) return 1 ;;
  esac
  return 0
}

# A SECOND ARGUMENT ASKS WITHOUT ACTING. The adoption above is a WRITE, and
# `mux check` must never be able to damage what it inspects, so the one
# read-only consumer says so and gets a pure derivation. Every other caller
# is a verb that is entitled to migrate, and they are unchanged.
mux_sess_file() {       # [partition] [ro]
  _sk=${1:-${MUX_CTX_PARTITION:-global}}
  if [ -n "${2:-}" ]; then
    mux_state_path_ro "sessions.$_sk"
  else
    mux_state_path "sessions.$_sk"
  fi
}

# mux_sess_list [key] [ro] -> every recorded name, one per line, insertion
# order.
mux_sess_list() {       # [key] [ro]
  _sf=$(mux_sess_file "${1:-}" "${2:-}")
  [ -f "$_sf" ] || return 0
  cut -f1 "$_sf" 2>/dev/null | grep . || true
}

# mux_sess_root NAME [key] -> where that session lived, or empty.
mux_sess_root() {       # <name> [key]
  _sf=$(mux_sess_file "${2:-}")
  [ -f "$_sf" ] || return 0
  awk -F'\t' -v n="$1" '$1==n{print $2; exit}' "$_sf"
}

# mux_sess_has NAME [key] -> is NAME recorded? MEMBERSHIP, which is not the
# same question as mux_sess_root: a record may legitimately carry an EMPTY root
# (tmux could not report session_path when it was added), so a non-empty root
# is not a membership test and using one silently misses those entries.
mux_sess_has() {        # <name> [key]
  [ -n "${1:-}" ] || return 1
  _sf=$(mux_sess_file "${2:-}")
  [ -f "$_sf" ] || return 1
  cut -f1 "$_sf" 2>/dev/null | grep -qxF -- "$1"
}

# mux_sess_add NAME ROOT [key] -> record NAME if it is not already there.
# Idempotent, so recording on every attach (not just on build) heals a set that
# predates this feature or a session someone made with raw tmux.
mux_sess_add() {        # <name> <root> [key]
  [ -n "$1" ] || return 0
  _sf=$(mux_sess_file "${3:-}")
  mkdir -p "$(dirname "$_sf")" 2>/dev/null || return 0
  mux_sess_has "$1" "${3:-}" && return 0
  printf '%s\t%s\n' "$1" "$2" 2>/dev/null >>"$_sf" || true
  return 0
}

# mux_sess_drop NAME [key] -> forget NAME. Via a temp and a move, so an
# interrupted write cannot truncate the set.
mux_sess_drop() {       # <name> [key]
  [ -n "$1" ] || return 0
  _sf=$(mux_sess_file "${2:-}")
  [ -f "$_sf" ] || return 0
  _st=$_sf.tmp.$$
  awk -F'\t' -v n="$1" '$1!=n' "$_sf" 2>/dev/null >"$_st"
  mv -f "$_st" "$_sf" 2>/dev/null || rm -f "$_st"
  return 0
}

# mux_sess_clear [key] -> forget the whole set (kill --all).
mux_sess_clear() {      # [key]
  rm -f "$(mux_sess_file "${1:-}")" 2>/dev/null || true
  return 0
}

# --- the LANDING MARK: which session you were last on -----------------------
# WHERE YOU WERE, which the set above cannot answer: it is insertion-ordered,
# and the order you first opened things is not the order you care about them.
#
# STATE, not cache, by the does-it-rebuild test: once the server is gone
# NOTHING can reconstruct which session held the client, so losing this file
# loses the answer at the exact moment it is asked, the `mux resume` after a
# reboot. Same directory and partition key as the set, being the same
# question's second half.
#
# A SIDECAR RATHER THAN A SIXTH FIELD on the set's lines, the call 0.49 made
# for the beat mark: the set is read by `cut`/`awk` in several programs and
# widening a record format has cost this project a day. It is also a different
# SHAPE, the set being a list where this is one value for the partition.
#
# ONE LINE, THE SESSION NAME, and only line 1 is ever read. A session name can
# hold a space (which is why the set is tab-separated), so the whole line is
# the value and nothing splits it.

# mux_landing_file [key] -> the landing mark for a partition.
mux_landing_file() {      # [partition]
  _lk=${1:-${MUX_CTX_PARTITION:-global}}
  mux_state_path "landing.$_lk"
}

# mux_landing_get [key] -> the session last active there, or empty.
#
# NO LIVENESS TEST HERE, deliberately: this library cannot ask tmux anything
# (it is sourced by programs that run with no server at all), and the caller
# has to check anyway, since the named session may have been killed or may
# have failed to rebuild. Answering "what was recorded" is the whole job.
mux_landing_get() {       # [key]
  _lf=$(mux_landing_file "${1:-}")
  [ -f "$_lf" ] || return 0
  # Redirect LAST: `read ... <"$f" 2>/dev/null` silences nothing, because
  # redirections apply left to right and a failing open happens while stderr
  # is still the terminal. A rule this suite greps for in test/lint.t.
  IFS= read -r _ln 2>/dev/null <"$_lf" || return 0
  printf '%s' "${_ln:-}"
}

# mux_landing_set NAME [key] -> remember NAME as the last active session.
#
# BEST EFFORT, like every other write here: this is a convenience about where
# to land, so a read-only state dir must never cost anybody a session switch.
# Atomic through a temp and a rename, for the reason the undo record learned
# the hard way: a reader that sees a created-but-not-yet-written file reads an
# empty value and silently falls back.
mux_landing_set() {       # <name> [key]
  [ -n "${1:-}" ] || return 0
  _lf=$(mux_landing_file "${2:-}")
  mkdir -p "$(dirname "$_lf")" 2>/dev/null || return 0
  _lt=$_lf.tmp.$$
  # stderr FIRST, then the target: `>"$_lt" 2>/dev/null` silences nothing,
  # because redirections apply left to right and the failing OPEN happens
  # while stderr is still the terminal. Caught here by the unwritable-state
  # case in test/mux-landing.t, having written the same warning two functions
  # up and then got it the wrong way round.
  if printf '%s\n' "$1" 2>/dev/null >"$_lt"; then
    mv -f "$_lt" "$_lf" 2>/dev/null || rm -f "$_lt" 2>/dev/null || true
  else
    rm -f "$_lt" 2>/dev/null || true
  fi
  return 0
}
