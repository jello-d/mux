#!/bin/sh
# mux-resume_lib - `mux resume`: bring back a partition's sessions after a
# reboot, and land on the one you were last using.
#
# EXTRACTED FROM bin/mux (2026-10-05), 211 lines, and the last of the verb
# slices. A SOURCED LIB for the usual reason plus one specific to this verb:
# it calls `mux_attach`, which is lib/mux-build_lib's, and `tm`, which is
# bin/mux's own and carries the partition's `-L` socket. resume's whole job is
# to REBUILD, so it is the heaviest consumer of the build machinery there is;
# a separate process would have to carry both.
#
# SOURCED LAZILY, inside the branch, the rule bin/mux's other verb branches
# follow: the front end is parsed on every invocation and a verb nobody called
# must not cost a lib. The build lib above it is unconditional for a different
# and stated reason (its definitions have to sit exactly where they used to);
# this one is a single verb with a single dispatch point.
#
# THE CALLER SOURCES THE DEPENDENCIES, because a sourced POSIX sh file sees
# the CALLER's `$0` and so cannot resolve its own siblings:
#
#     from bin/mux        tm
#     mux-build_lib       mux_attach
#     mux-context_lib     mux_ctx_conf
#     mux-env_lib         mux_env_names  mux_env_ready
#     mux-log_lib         mux_log
#     mux-sessions_lib    mux_landing_get  mux_sess_has  mux_sess_list
#                         mux_sess_root
#
# CALLER INPUTS: `part` (which partition), `rs_focus` (where to land),
# `listing` (--list), `nowaitenv` (--no-wait-env) and `cmd`, plus the exit-code
# and env-verdict constants bin/mux declares at the top (MUX_EX_NONAME,
# MUX_EX_NOTREADY, MUX_ENV_UNMANAGED, MUX_ENV_UNREADY, _RS_NL, _self). All are
# the parser's or the file's, and all are loud if absent under `set -u`.
# The point of the session set: after a reboot, `mux resume` and the five
# sessions you had are back. It acts on the CURRENT partition only and takes no
# way to name another, if you want a different partition's sessions, you go to
# that partition, which is what partitions are for.
#
# Each session is rebuilt by re-running the front end with --no-attach, so the
# whole build path (profile resolution, layout, theme, agent) is reused exactly
# rather than reimplemented here. Then we attach the first, which insertion
# order makes the oldest, usually the one you think of as primary.
# Rebuild every recorded session that is not already up, counting outcomes
# into rs_built / rs_up / rs_failed.
#
# Each is rebuilt by re-running the front end with --no-attach, so the whole
# build path (profile resolution, layout, theme, agent) is reused exactly
# rather than reimplemented here. It replays a PUBLIC command, addressing the
# session by its ROOT: `mux go <dir>` is a form anyone can type, so resume is a
# loop over it rather than a private path through the resolver.
_resume_rebuild() {     # <partition key> <recorded names, one per line>
  _rk=$1
  rs_built=0
  rs_up=0
  rs_builtn=
  rs_failed=
  # LINE by line. `for rs_n in $*` word-splits, so a recorded session
  # named `my project` was rebuilt as two phantoms (`my` and
  # `project`), and the real one never came back. A here-doc rather
  # than a pipe: the counters are carried out of this loop.
  while IFS= read -r rs_n; do
    [ -n "$rs_n" ] || continue
    if tm has-session -t "=$rs_n" 2>/dev/null; then
      rs_up=$((rs_up + 1))
      continue
    fi
    # Flag BEFORE the positional: the parser stops consuming
    # options at the first positional, so `go DIR --no-attach`
    # would leave --no-attach to be read as a PROFILE name.
    rs_root=$(mux_sess_root "$rs_n" "$_rk")
    # shellcheck disable=SC2154  # a caller input; see the header
    if [ -n "$rs_root" ] && [ -d "$rs_root" ] \
       && "$_self" go --no-attach "$rs_root" >/dev/null 2>&1; then
      rs_built=$((rs_built + 1))
      rs_builtn="$rs_builtn $rs_n"
    else
      # Keep going: one unbuildable session (a root that
      # moved, a profile since deleted) must not cost you the
      # other four.
      rs_failed="$rs_failed$rs_n$_RS_NL"
    fi
  done <<EOF
$2
EOF
}

# Where to land: the session you were last on, else the first recorded one
# that is actually up.
#
# THE FOCUS MARK FIRST, and it is the whole reason this function is not one
# line. Insertion order is CREATION order, which says nothing about where you
# were working, and resume used to land on the oldest entry that came back.
# Found live rather than reasoned about: a box rebooted, latch reattached, and
# the human came back on a session they had not touched in days, so the next
# thing they typed was addressed to the wrong agent. The mark is written by the
# client-session-changed hook (see `mux landing`), so it covers tmux's own
# switches too, not just mux's verbs.
#
# CHECKED FOR LIFE, NOT FOR MEMBERSHIP, and the order matters: this runs AFTER
# the rebuild, so a marked session that was rebuildable is up by now, and one
# whose root moved is not. Liveness answers both at once, which is why no
# second test against the recorded set is needed (and a session made with raw
# tmux is still a legitimate place to have been).
#
# ABSENT MARK IS TODAY'S BEHAVIOUR, which is what makes this safe to ship: a
# box upgrading mid-session, or one where nobody has switched since the server
# started, falls through to the insertion-order rule unchanged.
_resume_landing() {     # <recorded names> [key] -> a live session, or empty
  _rl=$(mux_landing_get "${2:-}")
  if [ -n "$_rl" ] && tm has-session -t "=$_rl" 2>/dev/null; then
    printf '%s' "$_rl"; return 0
  fi
  while IFS= read -r _rn; do
    [ -n "$_rn" ] || continue
    if tm has-session -t "=$_rn" 2>/dev/null; then
      printf '%s' "$_rn"; return 0
    fi
  done <<EOF
$1
EOF
}

mux_resume() {
  # shellcheck disable=SC2154  # a caller input; see the header
  rs_key=$part
  rs_set=$(mux_sess_list "$rs_key")
  # shellcheck disable=SC2154  # a caller input; see the header
  if [ "$listing" -eq 1 ]; then
    [ -n "$rs_set" ] && printf '%s\n' "$rs_set"
    exit 0
  fi
  if [ -z "$rs_set" ]; then
    echo "mux: no sessions recorded for this partition" >&2
    echo "mux: they are recorded as you open them; nothing to" \
      "resume yet" >&2
    # Asked to restore and could not: a reboot that lost the set
    # looks exactly like this, and the difference between "the set
    # was empty" and "resume was never run" is the whole question.
    mux_log resume "nothing recorded for partition ${part:-?}"
    exit 1
  fi
  # THE FOCUS TARGET, checked BEFORE rebuilding. Naming a session that
  # is not in the set is a typo, and finding that out after the rebuild
  # would mean the work happened and the one thing you asked for did
  # not: reported as a success with a footnote. Exit 3 is mux's "the
  # name is not known here", the same answer `go` gives.
  if [ -n "${rs_focus:-}" ] \
     && ! mux_sess_has "$rs_focus" "$rs_key"; then
    echo "mux: no such session recorded here: $rs_focus" >&2
    echo "mux: partition '$rs_key' has:" >&2
    printf '%s\n' "$rs_set" | sed 's/^/mux:   /' >&2
    exit "$MUX_EX_NONAME"
  fi
  # THE HOST-RELATCH GATE. A TMUX SERVER CANNOT OUTLIVE THE BOOT, so no
  # server for this partition means this host has not been set up since it came
  # up. That one fact separates the two kinds of relatch: a NETWORK event (the
  # server is still there, so reconnect at once, there is nothing to wait for)
  # from a HOST event (the machine restarted), and only the second can be
  # racing a graphical session that is still starting.
  #
  # IT IS A RACE AND NOT A TIMING BUG: sshd answers seconds after boot while
  # the session is still initialising, and the two are concurrent, so starting
  # the session earlier changes the odds and not the shape. Measured here: the
  # sessions were rebuilt 39 minutes before the compositor started, and a
  # pane's environment is fixed at exec, so nothing could repair them after.
  #
  # AFTER THE FOCUS CHECK, deliberately. A focus name that is not in the set is
  # a TYPO and will never become valid, so reporting it first means a latch
  # gives up (exit 3 reads as `gone`) instead of retrying until the display
  # arrives and only then telling you.
  #
  # COSTS NOTHING IN THE OTHER THREE CASES: a present server skips it, and on a
  # box that is merely idle (a killed server, a first-ever latch) the declared
  # pointers are already live, so it is asked once and answered yes.
  # shellcheck disable=SC2154  # a caller input; see the header
  if [ "$nowaitenv" -eq 0 ] && ! tm list-sessions >/dev/null 2>&1 \
     && _mux_env_load; then
    rs_decl=$(mux_ctx_conf env-ready)
    rs_erc=0
    # WORD-SPLIT ON PURPOSE: the directive is a space-separated list, and
    # every element is a variable NAME, so none can contain whitespace.
    # shellcheck disable=SC2086
    mux_env_ready $rs_decl || rs_erc=$?
    if [ "$rs_erc" -eq 2 ]; then
      # A DECLARED NAME NOTHING MANAGES is a typo, and its failure mode is a
      # full timeout on every host relatch with nothing said, so it is loud
      # HERE rather than discovered after a reboot. The same rule latch
      # applies to a named hook that does not resolve.
      # ONLY WHEN THE GATE ENGAGES, which is deliberate rather than an
      # oversight: on a box whose server is up the condition short-circuits
      # before any of this, so resume never pays for it, and a typo can only
      # do harm in the case the gate exists for. `mux check` validates the
      # declaration UNCONDITIONALLY, which is the better place to find one,
      # because it is found while somebody is looking rather than during the
      # one event it would spoil.
      echo "mux: env-ready names nothing manages:$MUX_ENV_UNMANAGED" >&2
      echo "mux: envhooks.d manages:" >&2
      mux_env_names | sed 's/^/mux:   /' >&2
      exit 2
    fi
    if [ "$rs_erc" -eq 1 ]; then
      echo "mux: this host has no server for '$rs_key' yet, and the" \
        "session environment has not arrived:$MUX_ENV_UNREADY" >&2
      echo "mux: rebuilding now would bake that absence into every pane," \
        "which nothing can repair afterwards." >&2
      echo "mux: a latch retries, and each attempt re-reads the" \
        "environment. To build them anyway:" >&2
      echo "mux:   mux resume --no-wait-env" >&2
      # LOGGED ON THE HOST, because the whole window is otherwise
      # unobservable: this is the evidence for the next time it is argued
      # about, and `mux log` is already where that lives.
      mux_log resume "not ready, refused to rebuild '$rs_key':$MUX_ENV_UNREADY"
      exit "$MUX_EX_NOTREADY"
    fi
  fi
  _resume_rebuild "$rs_key" "$rs_set"
  printf 'mux: resumed %s, %s already up\n' "$rs_built" "$rs_up"
  # ... and only now switch to it. AFTER the rebuild, because the
  # session may be one of the ones just created; before it, there would
  # be nothing to select.
  if [ -n "${rs_focus:-}" ]; then
    tm switch-client -t "=$rs_focus" 2>/dev/null \
      || tm attach-session -t "=$rs_focus" 2>/dev/null \
      || echo "mux: could not focus $rs_focus" >&2
  fi
  # LOGGED BECAUSE IT IS A MUTATION, and one that happens at the worst
  # moment to be unobservable: after a reboot, when the question "did my
  # sessions come back?" is the only question, and the terminal that
  # answered it has usually scrolled away or been closed since.
  #
  # NAMES, NOT JUST COUNTS. "resumed 5" cannot tell you WHICH five, and
  # the useful post-mortem is always about the one that is missing.
  [ "$rs_built" -gt 0 ] \
    && mux_log resume "rebuilt$rs_builtn ($rs_up already up)"
  if [ -n "$rs_failed" ]; then
    echo "mux: could NOT build:" >&2
    printf '%s' "$rs_failed" | sed 's/^/mux:   /' >&2
    echo "mux: see why with  mux go <name>" >&2
    # The other half of the log's rule: what mux could NOT do. A
    # session whose root moved or whose profile went fails here and
    # nowhere else, and a rebuild that silently came back short is
    # exactly the thing you cannot reconstruct afterwards.
    mux_log resume "could NOT build:$(printf '%s' "$rs_failed" \
      | tr '\n' ' ')"
  fi
  name=$(_resume_landing "$rs_set" "$rs_key")
  [ -n "$name" ] || { echo "mux: nothing to attach" >&2; exit 1; }
  mux_attach
}
