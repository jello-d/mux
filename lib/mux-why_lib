#!/bin/sh
# mux-why_lib - `mux why`: where every resolved value came from.
#
# WHY SOURCED AND NOT libexec/mux-why. Everything here answers about values
# bin/mux has ALREADY resolved: `base` (a `git rev-parse`, plus for a path
# argument an expand, a readlink, a directory check that exits 1 and a
# profile-by-root lookup), the name the shared block derived, and the whole
# MUX_CFG_* / MUX_CTX_* set. A separate process would redo all of it, which is
# a SECOND copy of the resolution this verb's entire job is to report on, and
# a drifting copy makes `mux why` describe a session `mux go` would not build.
# Sourcing shares the shell, so the globals contract below holds unchanged.
#
# LAZILY, inside the `why` branch, per bin/mux's dispatch rule: a verb nobody
# called must not cost a lib.
#
# THE CALLER SOURCES THE DEPENDENCIES, and all five are ones bin/mux already
# loads eagerly:
#
#     mux-conf_lib       mux_conf_clean
#     mux-exit_lib       MUX_EC_* (the exit codes)
#     mux-profiles_lib   mux_expand_tilde mux_fold_tilde mux_prof_by_root
#                        mux_prof_find mux_prof_get mux_prof_has
#     mux-resolve_lib    mux_resolve_hash_theme mux_resolve_is_path
#                        mux_resolve_typed_roots
#     mux-scan_lib       mux_scan_near mux_scan_roots
#     mux-sessions_lib   mux_sess_sanitise
#
# THE `_why_` PREFIX STAYS rather than becoming `_mux_why_`, this tree's usual
# shape for a lib's privates: sourcing loads these into the SAME shell they
# already lived in, so they are exactly as private as before, and renaming
# eight functions would have moved a mutation anchor and made the move's
# differential about two things at once.
#
# IT EXITS RATHER THAN RETURNING. `mux why` is the whole of the process by
# the time this runs, and the exit code is the contract: 3 for a name
# nothing here knows (see mux_why's tail), 0 otherwise.
# --- why: where every resolved value came from -----------------------------
# Resolution has five steps, the theme four priority levels, and a name may
# come from a row, a map, or the directory. That is a lot of inference working
# on your behalf, and inference you cannot inspect is indistinguishable from
# magic. This prints each field with its PROVENANCE, so "why is this session
# green / rooted there / called that" is always a question with an answer.
#
# The _why_* helpers share state through globals rather than arguments, which
# is deliberate: they are one report split for legibility, not reusable parts.
# The contract between them:
#
#   set by _why_resolve_name:   wh w_bypath w_row w_file w_src
#   set by _why_derived_root:   w_droot w_rsrc w_hits w_nhit
#   read throughout:            base name_arg and the MUX_CFG_* / MUX_CTX_*
#
# _why_get and _why_field are the only two that answer about a DECLARED value;
# everything else reports what mux derived.

# The session name this report is about, and where that name came from.
_why_resolve_name() {
  # A PATH argument is not a session name: `go` derives a name from it
  # exactly as it does for a bare `mux go`, so `why` must too, or it
  # reports a whole filesystem path as the session's name.
  w_bypath=0
  [ -n "$name_arg" ] && mux_resolve_is_path "$name_arg" && w_bypath=1
  wh=$name_arg
  if [ -z "$wh" ] || [ "$w_bypath" -eq 1 ]; then
    # `base` IS A CALLER INPUT, listed in the contract above: the project
    # root bin/mux already resolved, which for a path argument cost an
    # expand, a readlink and a directory check. Re-deriving it here would be
    # the second copy this lib exists to avoid. Loud if absent anyway, since
    # every caller runs under `set -u`.
    # shellcheck disable=SC2154
    wh=$(mux_prof_by_root "$base")
    [ -n "$wh" ] || wh=$(basename "$base")
    wh=$(mux_sess_sanitise "$wh")
  fi
  w_row=0; mux_prof_has "$wh" && w_row=1
  w_file=$(mux_prof_find "$wh")

  if [ "$w_bypath" -eq 1 ]; then w_src="derived from the path you gave"
  elif [ -n "$name_arg" ]; then w_src="you typed it"
  elif [ -n "$(mux_prof_by_root "$base")" ]; then
    w_src="a profile claims this directory"
  elif git rev-parse --show-toplevel >/dev/null 2>&1; then
    w_src="the git toplevel's basename"
  else w_src="the current directory's basename"; fi
}

# The fixed head of the report: where you are, which context and partition
# answered, the name, and which profile (if any) backs it.
_why_header() {
  # `where` FIRST: every line below is an answer about a directory, and
  # without naming it the reader cannot tell that a profile's root may
  # not be the place they are standing.
  printf '%-9s %-26s %s\n' where "$(mux_fold_tilde "$base")" \
    "the project you are in"
  # From MUX_CTX_SRC, which the resolver sets from what actually
  # happened. Asking whether a context-command was merely CONFIGURED
  # credited one that had failed, or declined to answer, for a token that
  # came from the baseline: the one lie this verb must never tell.
  case ${MUX_CTX_SRC:-baseline} in
  command)  w_csrc='from context-command' ;;
  declined) w_csrc='context-command named none; the baseline' ;;
  failed)   w_csrc='context-command FAILED; the baseline' ;;
  *)        w_csrc='no context-command; the baseline' ;;
  esac
  printf '%-9s %-26s %s\n' context "$MUX_CTX_TOKEN" "$w_csrc"
  printf '%-9s %-26s %s\n' partition "$MUX_CTX_PARTITION" \
    "$([ "$MUX_CTX_PARTITION" = "$MUX_CTX_TOKEN" ] \
      && echo 'defaults to the context name' \
      || echo 'named by the context file')"
  printf '%-9s %-26s %s\n' name "$wh" "$w_src"

  if [ -n "$w_file" ]; then
    printf '%-9s %-26s %s\n' profile '(breakout)' "$w_file"
  elif [ "$w_row" -eq 1 ]; then
    printf '%-9s %-26s %s\n' profile '(row)' "$(mux_prof_file)"
  else
    printf '%-9s %-26s %s\n' profile '(none)' \
      'everything below is derived'
  fi
}

# One DECLARED value from the profile backing this name, or empty.
_why_get() {   # <key>
  if [ -n "$w_file" ]; then
    mux_conf_clean <"$w_file" \
      | awk -v k="$1" '$1==k{sub("^"k"[ \t]+","")
        print; exit}'
  elif [ "$w_row" -eq 1 ]; then mux_prof_get "$wh" "$1"
  fi
}

# KEY, then either the declared value or the derived one, then where it came
# from. ALT is shown only where knowing the road not taken is useful: the
# theme, where "why is it not the hashed one" is the question people ask.
_why_field() { # <key> <derived> <derived source> [show-alt]
  _v=$(_why_get "$1")
  case $1 in root) _v=$(mux_fold_tilde "$_v") ;; esac
  if [ -n "$_v" ]; then
    _w=declared
    # Only worth showing the road not taken when it DIFFERS:
    # "declared (x would give x)" reads like a bug.
    [ -n "${4:-}" ] && [ "$_v" != "$2" ] \
      && _w="declared ($3 would give $2)"
    # A profile's root is where its panes open, which need not be
    # where you are standing. Saying so is the whole point of this
    # verb: the name resolved to a profile, and that profile lives
    # somewhere else.
    [ "$1" = root ] && [ "$_v" != "$2" ] \
      && _w="$_w (NOT where you are)"
    printf '%-9s %-26s %s\n' "$1" "$_v" "$_w"
  else
    printf '%-9s %-26s %s\n' "$1" "$2" "$3"
  fi
}

# The DERIVED root (what `go` would use when no profile declares one), and
# the candidate list behind it. A bare `mux why` (or a path) answers about
# where you are standing. A TYPED name answers about what `mux go NAME` would
# RESOLVE, which is the session set and then the map. It used to answer "the
# project you are in" for every typed name, which was wrong whenever the name
# meant anywhere else: that is, nearly always.
_why_derived_root() {
  w_droot=$(mux_fold_tilde "$base")
  w_rsrc="the project you are in"
  [ "$w_bypath" -eq 1 ] && w_rsrc="the path you gave"
  w_hits=; w_nhit=0
  # Not applicable unless a NAME was typed and no profile already
  # declared a root: `go` skips the map in both those cases too.
  if [ -z "$name_arg" ] || [ "$w_bypath" -eq 1 ] \
     || [ -n "$(_why_get root)" ]; then
    return 0
  fi
  # `part` is the other caller input (bin/mux's $MUX_CTX_PARTITION), and the
  # one mux_resolve_typed_roots refuses to default: a partition guessed here
  # would answer about another side's session set.
  # shellcheck disable=SC2154
  w_hits=$(mux_resolve_typed_roots "$wh" "$part")
  w_nhit=$(printf '%s' "$w_hits" | grep -c . || true)
  if [ "$w_nhit" -eq 1 ]; then
    w_droot=$(mux_fold_tilde \
      "$(printf '%s' "$w_hits" | cut -f2)")
    w_rsrc=$(printf '%s' "$w_hits" | cut -f1)
  elif [ "$w_nhit" -gt 1 ]; then
    w_droot='(ambiguous)'
    w_rsrc="$w_nhit projects share this name"
  else
    w_droot='(unknown)'
    w_rsrc='nothing here knows this name'
  fi
}

# A typed name `go` would REFUSE. Saying so is the whole point: every field
# above describes a session, and without this you would read them as a session
# mux is willing to build. The conditions mirror the two refusals in the go
# path exactly: ambiguity outranks a profile (a rootless one cannot say WHICH
# project it meant), while an unknown name is a refusal only when no profile
# claims it at all.
_why_note_refusal() {
  if [ "$w_nhit" -gt 1 ]; then
    echo
    echo "note: \`mux go $wh\` REFUSES," \
      "$w_nhit projects share this name:"
    printf '%s\n' "$w_hits" | cut -f2 | while IFS= read -r _wd; do
      [ -n "$_wd" ] && \
        echo "        $(mux_fold_tilde "$_wd")"
    done
    echo "      Name one of them:  cd <dir> && mux new <alias>"
  elif [ "$w_nhit" -eq 0 ] && [ -n "$name_arg" ] \
       && [ "$w_bypath" -eq 0 ] && [ "$w_row" -eq 0 ] \
       && [ -z "$w_file" ]; then
    echo
    echo "note: \`mux go $wh\` REFUSES. Nothing here knows that" \
      "name, and from"
    echo "      the name alone a new session and a typo are" \
      "indistinguishable."
    if [ -z "$(mux_scan_roots)" ]; then
      echo "      Discovery is off for partition" \
        "'$MUX_CTX_PARTITION' (no scan roots)."
    else
      _wn=$(mux_scan_near "$wh" "$MUX_CTX_PARTITION" \
        | tr '\n' ' ')
      [ -n "$_wn" ] && \
        echo "      Did you mean:      $_wn"
    fi
    echo "      Or create it here: mux new $wh"
  fi
}

# If the name was DERIVED and the profile it landed on lives somewhere else,
# say WHY plainly. The bare "NOT where you are" marker above flags the fact
# without explaining it, which is how you end up asking why mux is talking
# about a directory you did not mention.
_why_note_collision() {
  # Only for a DERIVED name: a name you typed is one you chose.
  if [ -n "$name_arg" ]; then return 0; fi
  _wr=$(_why_get root)
  _wrx=$(readlink -f -- "$(mux_expand_tilde "${_wr:-$base}")" \
    2>/dev/null || true)
  _wbx=$(readlink -f -- "$base" 2>/dev/null || printf '%s' "$base")
  # Nothing to explain unless the profile's root is a real, DIFFERENT
  # place. readlink resolves both sides so a symlinked root does not
  # read as a collision.
  if [ -z "$_wr" ] || [ -z "$_wrx" ] || [ "$_wrx" = "$_wbx" ]; then
    return 0
  fi
  echo
  echo "note: '$wh' is this directory's basename, but it is also a"
  echo "      profile rooted at $(mux_fold_tilde "$_wr")."
  echo "      \`mux go\` here refuses rather than build the wrong one:"
  echo "      \`mux go $wh\` for that project," \
    "\`mux new <name>\` for this one."
}

mux_why() {
  _why_resolve_name
  _why_header
  _why_derived_root
  _why_field root "$w_droot" "$w_rsrc"
  # theme: declared > context > hashed > global default.
  w_dth=; w_dsrc=
  if [ -n "$MUX_CFG_theme" ]; then
    w_dth=$MUX_CFG_theme; w_dsrc="this context's theme"
  elif [ "${MUX_CFG_derive:-hash}" = hash ]; then
    w_dth=$(mux_resolve_hash_theme "$wh"); w_dsrc="hashed from the name"
  else
    w_dth=$MUX_THEME_FALLBACK; w_dsrc="mux's fallback"
  fi
  _why_field theme "$w_dth" "$w_dsrc" alt
  _why_field layout "${MUX_CFG_layout:-default}" "the context's default"
  _why_field agent "${MUX_CFG_agent:-claude}" "the context's default"
  _why_note_refusal
  _why_note_collision
  # A name nothing knows is not a successful answer, whatever the prose
  # above explained. `mux why` is the one verb whose whole job is telling
  # you what a name resolves to, so "it resolves to nothing" has to be
  # readable without parsing English.
  if [ "$w_nhit" -eq 0 ] && [ -n "$name_arg" ] \
     && [ "$w_bypath" -eq 0 ] && [ "$w_row" -eq 0 ] \
     && [ -z "$w_file" ]; then
    exit "$MUX_EC_NONAME"
  fi
  exit "$MUX_EC_OK"
}

