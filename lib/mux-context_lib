#!/bin/sh
# mux-context_lib: the mux CONTEXT seam. Sourced (functions only).
#
# NEEDS mux-conf_lib, and the caller must source it FIRST. Nothing in this
# tree has a lib source another lib, so a dependency is declared here and met
# by whoever loads us; relying on who happens to source first is how a
# standalone helper stops being standalone.
#
# mux core knows nothing about any particular notion of "context" (a
# work/personal split, a k8s namespace, a git host, ...). It asks an OPTIONAL
# command for ONE WORD and decides everything else itself.
#
#   context   a named situation, identified by a TOKEN.
#   partition an isolation unit. Sessions in different partitions are mutually
#             invisible. Defaults to the context's own token, so contexts are
#             isolated by default; several may name one partition to share it.
#   global    the reserved token AND partition of the unconfigured baseline.
#
# THE ENTIRE INTEGRATION SURFACE is one command, named in $MUX_DIR/config:
#
#     context-command   severance current
#
# It prints one line: a token. Empty output or a non-zero exit means `global`.
# No sockets, no styles, no themes, no path classification: the integrator
# reports IDENTITY, mux decides presentation and isolation. That is deliberate:
# the previous contract made the integrator supply a tmux style string for the
# banner (so a missing style silently removed a safety reminder) while
# withholding the one structural fact mux needed.
#
# SETTINGS resolve in three levels, merged in order, last wins per key:
#
#   1. built-in defaults below: BEHAVIOUR ONLY, never a location. That is
#      what keeps `scan` from leaking between partitions, and it is a decision
#      about data rather than a branch in this resolver.
#   2. partitions/<partition>.partition: what this partition shares
#   3. contexts/<token>.context:          what is unique to this context
#
# The same key set is legal in either file: where you put a key IS the
# statement of its scope, so there is no per-key classification to learn.

: "${MUX_DIR:=${XDG_CONFIG_HOME:-$HOME/.config}/mux}"

# --- resolved state, readable by callers after mux_ctx_resolve --------------
MUX_CTX_TOKEN=global
MUX_CTX_PARTITION=global
# The theme when nothing at all has an opinion: no profile, no context, and
# derivation switched off. A last resort, not a default. MUX_CFG_theme is
# deliberately EMPTY by default so that "a context set a theme" is
# distinguishable from "nobody did", which is what lets an explicit context
# theme beat the name hash.
MUX_THEME_FALLBACK=purple

# A token becomes a socket name and a path component, so it is validated as a
# DNS label before use: lowercase alphanumeric and hyphens, not leading or
# trailing, 63 max. An integrator returning `../..` would otherwise choose
# where mux writes. Invalid is an ERROR, never a silent fall back to global:
# a typo'd token quietly becoming the baseline would put work sessions in the
# personal partition.
# THE CLASS IS ENUMERATED, NOT A RANGE, and that is a portability fix rather
# than a style one. `[a-z]` is a COLLATION range, so what it matches depends on
# the locale: on macOS, `mux_ctx_valid Work` ACCEPTED, measured on the CI runner
# (`FAIL mux-context: validator accepted [Work]`), because the range spans the
# case-interleaved order there. A class (`[:lower:]`) fixes the case half and
# opens another: in a UTF-8 locale it admits non-ASCII lowercase, and a DNS
# label is ASCII by definition. Thirty-seven characters said outright cannot
# drift with anybody's locale.
#
# WHAT IT COST ON macOS was not a traversal (`.` and `/` are in no letter
# range), it was IDENTITY: the token becomes a socket name and a state
# directory, the default filesystem there is case-INSENSITIVE, so `Work` and
# `work` are two partitions to mux and one directory to the OS.
mux_ctx_valid() {       # <token>
  case $1 in
  ''|*[!abcdefghijklmnopqrstuvwxyz0123456789-]*|-*|*-) return 1 ;;
  esac
  [ "${#1}" -le 63 ]
}

# One value from $MUX_DIR/config (the invariants: context-command, env-ready,
# and the latch-* seams, which latch reads with its own three-layer `_seam`).
#
# THROUGH `mux_conf_clean`, WHICH IT DID NOT USE, and that was a live defect
# rather than untidiness. Its own sed dropped a FULL-LINE comment and left an
# INLINE one in the value, so this reader disagreed with every other config
# reader in the tree about the same file. Measured:
#
#     env-ready  WAYLAND_DISPLAY   # wait for the compositor
#       here        -> [WAYLAND_DISPLAY   # wait for the compositor]
#       mux_env_ready then reports `#` as a name nothing manages, so
#       `mux resume` EXITS 2, which ssh-classify reads as `refused`, which
#       is TERMINAL: a latch gives up permanently on a box that is fine.
#
#     context-command  sev current  # a note
#       here        -> [sev current  # a note], which is then executed
#
# Both are reachable by anyone who comments their own config, which is
# exactly what a documented config invites. The rule has one home for this
# reason; a second copy of it is a second answer about the same bytes.
mux_ctx_conf() {        # <key>
  _cf=$MUX_DIR/config
  [ -f "$_cf" ] || return 0
  # CLEANED INTO A VARIABLE FIRST so the one line that carries the rule can
  # be a mutation anchor: the corpus matches whole lines and a continuation
  # backslash can never be one, which this tree has twice answered by
  # reshaping the code rather than exempting it.
  _cc=$(mux_conf_clean <"$_cf")
  printf '%s\n' "$_cc" \
  | awk -v k="$1" '$1==k{sub("^"k"[ \t]+",""); print; exit}'
}

# Merge one settings file over the current values. Unknown keys are IGNORED
# rather than fatal: a newer mux writing a key this one does not know must not
# break an older one, and these files are commonly generated.
_mux_ctx_merge() {      # <file>
  [ -f "$1" ] || return 0
  _first_scan=1
  _first_ignore=1
  while read -r _k _v; do
    case $_k in
    ''|'#'*) continue ;;
    partition) MUX_CFG_partition=$_v ;;
    label)     MUX_CFG_label=$_v ;;
    theme)     MUX_CFG_theme=$_v ;;
    derive)    MUX_CFG_derive=$_v ;;
    agent)     MUX_CFG_agent=$_v ;;
    layout)    MUX_CFG_layout=$_v ;;
    host-chip) MUX_CFG_host_chip=$_v ;;
    scan)
      # Repeatable WITHIN a file, but a file REPLACES the list
      # from earlier levels: last wins per key, where the
      # key's value is the whole list. So a context can drop
      # its partition's roots rather than only add to them.
      if [ "$_first_scan" = 1 ]; then
        MUX_CFG_scan=$_v; _first_scan=0
      else
        MUX_CFG_scan="$MUX_CFG_scan
$_v"
      fi ;;
    ignore)
      # Same multiplicity rule as `scan`, deliberately: this
      # file format already had ONE answer for "a key that is
      # a list", and a second convention (CSV, say) would be
      # a second thing to remember, and would break on a
      # path containing a comma. Repeatable within a file;
      # a file that sets it REPLACES the inherited list, so a
      # context can drop its partition's ignores rather than
      # only add to them.
      if [ "$_first_ignore" = 1 ]; then
        MUX_CFG_ignore=$_v; _first_ignore=0
      else
        MUX_CFG_ignore="$MUX_CFG_ignore
$_v"
      fi ;;
    esac
  done <<EOF
$(sed -e 's/\r$//' -e 's/[[:space:]]*$//' "$1")
EOF
  return 0
}

# Resolve the context for PID (default: this process) and merge its settings.
# Sets MUX_CTX_TOKEN, MUX_CTX_PARTITION and every MUX_CFG_*.
mux_ctx_resolve() {     # [PID]
  # 1. built-in defaults. BEHAVIOUR ONLY: no scan, no label.
  MUX_CFG_partition=
  MUX_CFG_label=
  MUX_CFG_theme=
  MUX_CFG_derive=hash
  MUX_CFG_agent=claude
  MUX_CFG_layout=default
  MUX_CFG_host_chip=on
  MUX_CFG_scan=
  MUX_CFG_ignore=
  MUX_CTX_TOKEN=global
  MUX_CTX_ERR=
  # How the token was arrived at, so a caller can report the PROVENANCE
  # without re-deriving it (and getting it wrong). `mux why` used to decide
  # this by asking whether a context-command was CONFIGURED, and so
  # credited one that had failed or declined to answer for a token that
  # actually came from the baseline below. Asserted and actual must not be
  # separately computed. One of:
  #   baseline  no context-command configured
  #   command   it ran and named this token
  #   declined  it ran, succeeded, and named nothing (the baseline stands)
  #   failed    it exited non-zero, so it has not answered at all
  MUX_CTX_SRC=baseline

  _cc=$(mux_ctx_conf context-command)
  # A bare name resolves against $MUX_DIR before PATH. The config file is
  # commonly shared between machines through a dotfiles repo, so it must
  # not have to carry an absolute path that is only right on one of them.
  case $_cc in
  '' | */*) ;;
  *) [ -x "$MUX_DIR/$_cc" ] && _cc=$MUX_DIR/$_cc ;;
  esac
  if [ -n "$_cc" ]; then
    # Capture RAW, then trim. A pipeline's status is its LAST
    # command's, so piping straight into head/tr would report tr's
    # success and silently trust the stdout of a command that
    # FAILED. A context-command that exits non-zero has not
    # answered, and its output is not an answer either.
    if _raw=$($_cc "${1:-$$}" 2>/dev/null); then
      _t=$(printf '%s' "$_raw" | head -1 | tr -d '[:space:]')
      [ -n "$_t" ] && MUX_CTX_SRC=command \
        || MUX_CTX_SRC=declined
    else
      _t=
      MUX_CTX_SRC=failed
    fi
    if [ -n "$_t" ]; then
      if mux_ctx_valid "$_t"; then
        MUX_CTX_TOKEN=$_t
      else
        MUX_CTX_ERR="invalid context token: $_t"
        return 1
      fi
    fi
  fi

  # The context file names the partition; absent, the partition IS the
  # token, so contexts are isolated by default.
  _ctxf=$(_mux_ctx_file contexts "$MUX_CTX_TOKEN" .context)
  if [ -n "$_ctxf" ]; then
    MUX_CFG_partition=$(sed -e 's/\r$//' -e '/^[[:space:]]*#/d' \
      "$_ctxf" \
      | awk '$1=="partition"{print $2; exit}')
  fi
  [ -n "$MUX_CFG_partition" ] || MUX_CFG_partition=$MUX_CTX_TOKEN
  mux_ctx_valid "$MUX_CFG_partition" || {
    MUX_CTX_ERR="invalid partition: $MUX_CFG_partition"
    return 1
  }
  MUX_CTX_PARTITION=$MUX_CFG_partition

  # 2. the partition, then 3. the context.
  _partf=$(_mux_ctx_file partitions "$MUX_CTX_PARTITION" .partition)
  _mux_ctx_merge "$_partf"
  _mux_ctx_merge "$_ctxf"
  MUX_CTX_PARTITION=$MUX_CFG_partition

  # Neither file: nothing knows this context. The caller decides whether
  # to warn (never from here: the status bar calls this every tick).
  MUX_CTX_UNKNOWN=0
  [ -z "$_partf" ] && [ -z "$_ctxf" ] && MUX_CTX_UNKNOWN=1
  return 0
}

# $MUX_DIR over $MUX_SHARE, like every other package-data read.
_mux_ctx_file() {       # <kind> <name> <ext>
  if [ -f "$MUX_DIR/$1/$2$3" ]; then printf '%s' "$MUX_DIR/$1/$2$3"
  elif [ -n "${MUX_SHARE:-}" ] && [ -f "$MUX_SHARE/$1/$2$3" ]; then
    printf '%s' "$MUX_SHARE/$1/$2$3"
  fi
}

# Every partition mux knows of, one per line: whatever has a .partition file,
# plus the one we are in. Used by `reload` and the palette sync to reach every
# running server regardless of which partition the caller is in.
mux_ctx_partitions() {
  {
    for _d in "$MUX_DIR/partitions" "${MUX_SHARE:-}/partitions"; do
      [ -d "$_d" ] || continue
      for _f in "$_d"/*.partition; do
        [ -e "$_f" ] || continue
        _b=${_f##*/}; printf '%s\n' "${_b%.partition}"
      done
    done
    [ -n "${MUX_CTX_PARTITION:-}" ] && printf '%s\n' \
      "$MUX_CTX_PARTITION"
  } | LC_ALL=C sort -u | grep . || true
}

# The tmux -L name for a partition. An implementation detail of the partition:
# nobody outside mux names a socket, and `global` is an ordinary name here:
# it gets its own socket like any other, so the isolation story has no
# exception in it.
mux_ctx_socket() {      # [partition]
  printf '%s' "${1:-$MUX_CTX_PARTITION}"
}

# mux_ctx_mine -> THIS caller's own partition, or empty if it cannot be told.
#
# THE IDIOM, NOT A NEW CAPABILITY: six places across four files spelled out
# `mux_ctx_resolve 2>/dev/null && _x=$MUX_CTX_PARTITION`, every one of them a
# headless caller with no $TMUX to take a namespace from. Three lines copied
# six times is three lines that can disagree six ways, and this tree has
# shipped the wrong-socket bug three times already, every time because one
# answer was derived in two places.
#
# EMPTY RATHER THAN `global` WHEN RESOLUTION FAILS, which is the half worth
# stating. Each caller then decides what an unanswerable context costs it:
# `mux agent` scopes to global because failing OPEN is the one answer an
# actuating verb must not give, while `mux resume` REFUSES, because resuming
# the baseline when the hook broke hands you another partition's sessions
# while looking like success. A helper that picked one of those for everybody
# would be wrong for the other, so it answers the fact and not the policy.
#
# AND IT ANSWERS LESS THAN mux_ctx_resolve DOES, which anyone reaching for it
# has to know. Measured, because the exit status does NOT separate these and
# reading it as if it did is how the wrong partition gets acted on:
#
#     no context-command at all   rc 0  part=global  src=baseline
#     the command EXITS 1         rc 0  part=global  src=failed
#     the command names one       rc 0  part=work    src=command
#
# So `failed` arrives here as `global`, and MUX_CTX_SRC is the discriminator.
# A COMMAND SUBSTITUTION IS A SUBSHELL, so none of MUX_CTX_SRC, MUX_CTX_ERR or
# the MUX_CFG_* settings survive `_x=$(mux_ctx_mine)`. A caller that needs any
# of them calls mux_ctx_resolve itself; `mux resume`, the one verb that
# refuses on `failed`, deliberately still does. That hidden discard is the
# trap this package already paid for when `$(_remote_cmd)` threw away the
# negotiation cache it had just filled, and nothing observable broke.
#
# THE STDERR IS DISCARDED HERE, deliberately: a caller that wants the reason
# reads $MUX_CTX_ERR, and these are status-bar and tray paths where a context
# command's own noise would land in a pane or a log at poll rate.
mux_ctx_mine() {
  mux_ctx_resolve 2>/dev/null || return 0
  printf '%s' "${MUX_CTX_PARTITION:-}"
}

# mux_ctx_crossing TARGET ACTION -> 0 when this call is being made from INSIDE
# TARGET's partition, 1 when it would cross one, with the reason in
# $MUX_CTX_CROSS. ACTION is the verb phrase for the message ("type across",
# "open a window across"), so the sentence stays whole in one place rather
# than being assembled by each caller.
#
# ONE SITE, which is the point of its being here: `mux agent send` asked this
# question inline, and every actuating verb has to ask it, so the second copy
# would be the one that drifts. `_mux-partition-security.md` lists what is
# still OPEN about the comparison, and this is where that fix will land.
#
# WHY CROSSING MATTERS, in one paragraph rather than at each caller: a
# partition is a tmux `-L` socket, `/tmp/tmux-<uid>` is `drwx------ <user>`
# and the sockets inside are the login user's, so SAME UID IS FULL REACH.
# Where the boundary is a GROUP acquired per session (which is how a
# kernel-enforced work/personal split does it), the pane on the other side
# HOLDS that group, so acting on it carries privileges this side was refused.
# mux did not create that capability and cannot enforce the boundary; what it
# does is DECLINE TO BE THE INSTRUMENT, which is the whole claim and is
# narrower than it first reads.
#
# A FAILED CONTEXT COMMAND REFUSES rather than assuming the baseline, because
# `mux_ctx_resolve` answers 0 with `global` for a hook that EXITED NON-ZERO
# (measured) and so cannot be distinguished by its status alone.
# `MUX_CTX_SRC` is the discriminator: `baseline` is no hook at all and
# `declined` is a real answer, while `failed` is the ABSENCE of one. Failing
# OPEN is the single answer an actuating verb must never give, which is the
# call `mux resume` already makes.
#
# COSTS NOTHING ON A BOX WITH NO PARTITIONS, which is most of them: no hook
# answers `baseline` with `global`, the target resolves to `global` too, and
# the comparison passes.
mux_ctx_crossing() {    # <target partition> <action phrase>
  MUX_CTX_CROSS=
  mux_ctx_resolve 2>/dev/null || true
  _cxown=${MUX_CTX_PARTITION:-global}
  _cxto=${1:-global}
  if [ "${MUX_CTX_SRC:-baseline}" = failed ]; then
    MUX_CTX_CROSS="the context command failed, so mux cannot tell which"
    MUX_CTX_CROSS="$MUX_CTX_CROSS partition this call is being made from"
    return 1
  fi
  [ "$_cxto" = "$_cxown" ] && return 0
  MUX_CTX_CROSS="it is in partition $_cxto and this call is from"
  MUX_CTX_CROSS="$MUX_CTX_CROSS $_cxown; mux does not $2 a partition"
  MUX_CTX_CROSS="$MUX_CTX_CROSS boundary"
  return 1
}
