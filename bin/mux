# --- save: snapshot the live session ---------------------------------------
# THE WHOLE VERB IS lib/mux-save_lib (2026-10-05), sourced in the branch,
# including the serialiser `emit_window` and its `is_shell`, which lived here
# for one caller. It still needs `tm` from this file; its header has the
# rest.
if [ "$cmd" = save ]; then
  [ -r "$MUX_LIB/mux-save_lib" ] || {
    echo "mux: mux-save_lib missing (incomplete install)" >&2
    exit 1; }
  # shellcheck source=/dev/null
  . "$MUX_LIB/mux-save_lib"
