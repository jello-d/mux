#!/bin/sh
# mux: the single front end to tmux: bring up, tear down, list, and reload
# sessions without ever touching tmux directly. A session is an identity (its
# name, used to resume) and a shape (a layout, used only to build it the first
# time); the two are separate, so naming a session needs no layout and resuming
# a live one reads none.
#
#   mux                    with no verb: pick a session to attach (fzf, else a
#                          numbered menu); one session attaches straight away.
#   mux go [NAME] [LAYOUT]
#       create if missing, then attach (switch if already inside tmux). The
#       claude pane runs `claude --continue || claude`: pick up where you left
#       off, or start fresh when there is nothing to continue.
#   mux go --resume [NAME] [LAYOUT]
#       same, but `claude --resume` (choose a conversation). This was once the
#       bare verb `mux resume`; that name now belongs to the session rebuild
#       below, which is the thing you reach for after a reboot.
#   mux resume [PARTITION [SESSION]]
#                          rebuild every session this partition had (--list to
#                          see them without building). The set is recorded as
#                          you open sessions, so the bare form needs no
#                          arguments: it always takes the partition you are
#                          in. PARTITION names another one (`global` is the
#                          baseline, and the reserved word for "not the one my
#                          context resolved"); SESSION is only where to focus
#                          afterwards, since a resume rebuilds them all.
#   mux kill NAME          tear the named session down.
#   mux kill-all           tear down EVERY session on this socket (prompts).
#   mux reload             re-source tmux.conf on every running mux server.
#   mux ls                 list sessions in the current context.
#   mux new [NAME] [COLOR] [ROOT]
#                          write a <NAME>.profile. NAME
#                          and ROOT default to the project (the git toplevel,
#                          else the cwd: the same derivation go uses); ROOT
#                          takes '-' to omit it, COLOR defaults to the
#                          per-context default. --force to overwrite.
#                          It lands in the (dir-linked) mux dir, so it shows as
#                          git drift: commit to keep, or delete.
#   mux save [NAME]        snapshot the CURRENT session into a <NAME>.profile
#                          plus the <NAME>.layout it names; pane commands are
#                          best-effort. --force to overwrite.
#   mux hide SESSION       hide SESSION from THIS client's status strip and
#                          ( / ) cycling; mux show SESSION restores it, mux
#                          show-all clears this client's hides. Per client
#                          (per attachment); must run inside a session.
#     --bare (-b)          with go/resume: bring up WITHOUT launching claude
#                          (the claude pane is a plain shell).
#
# A verb, or none for the session picker. For go/resume, NAME defaults to the
# project (git toplevel basename, else cwd basename); kill requires it
# explicitly. PROFILE is the third token; with none, a per-project
# <NAME>.profile is used if one exists, else mux's built-in defaults.
#
# Idempotent: `go`/`resume` on a live session just attaches, never clobbers.
#
# A non-default CONTEXT is a separate namespace. When the context hook reports a
# socket (see mux-context_lib), mux drives a tmux server on that socket and sees
# only that context's sessions; otherwise the default socket. The same name can
# live in both, mutually invisible. mux never establishes a context itself (it
# runs in whatever the hook observes), so an integrator can back a context with
# real isolation (a Unix group, a namespace) and mux just reflects it. `ls`
# lists only the context you are in; `reload` freshens EVERY server (the config
# is shared), so a single reload from any pane updates everything.
#
# A PROFILE is the session: its identity and appearance. It lives in $MUX_DIR
# (default ~/.config/mux) as <name>.profile, and the FILENAME is the session
# name. Directives, one per line, all optional:
#   root   DIR           working dir for the session (a leading ~ expands);
#                        defaults to the project mux was invoked in
#   theme  NAME          colour theme (a themes/NAME.theme fragment: purple,
#                        orange, cyan, green, slate, red, ...). Cosmetic only.
#   agent  NAME          the agent a `pane agent` runs (an agents/NAME.agent:
#                        claude, gemini, ...), default claude. go and resume use
#                        that agent's own continue/resume command.
#   notify always|away   whether the agent notification (see
# mux-agent-state-emit)
#                        fires while you are LOOKING at the pane: `away` (the
#                        default) suppresses it then, `always` fires anyway.
#   layout NAME          the pane ARRANGEMENT to build (a layouts/NAME.layout),
#                        default `default`.
#
# A LAYOUT is the arrangement, and nothing else: layouts/<name>.layout, in
# $MUX_DIR or shipped in $MUX_SHARE. Directives:
#   window NAME          start a new window; the first opens the session
#   pane   CMD [ARG...]  add a pane running CMD; `pane agent` runs the session's
#                        agent (shaped by go/resume), `pane <name>` a specific
#                        agent, anything else runs literally. A bare `pane` is a
#                        plain shell.
#   control CLASS        declare who may TYPE into the pane just above:
#                        human (the default, and refused to every sender),
#                        agent (an orchestrated worker, grantable as a class
#                        by /etc/mux/send-policy) or hybrid. mux records what
#                        you declare and classifies nothing itself.
#   bottom SIZE [CMD]    add a pane spanning the full width below the panes of
#                        the current window; must come after them. SIZE is N to
#                        pin the height, or MIN-MAX to track the window between
#                        those bounds. Held there by mux-pin on every resize.
# Blank lines and lines beginning with # are ignored.
#
# The two files are kept apart deliberately: an arrangement directive in a
# profile, or an identity directive in a layout, fails loud rather than
# half-working. So the same layout serves every profile that names it, which is
# what `include` used to approximate.
#
# The profile and its layout are parsed and VALIDATED together before any tmux
# call, so a malformed pair builds nothing. root and theme are resolved for the
# session as a whole: last one wins, position irrelevant; window/pane/bottom
# build the arrangement in the order they appear.
set -eu

# The ONE version string. The man page footer and `mux --version` both read it
# from here, so they cannot drift apart the way a hardcoded "mux 0.1" in the
# man page already had.
MUX_VERSION=0.86

# EXIT 3: THE NAME YOU GAVE IS NOT KNOWN HERE. A standard code rather than a
# per-verb one, because it is one CONDITION that many verbs can trip on (go,
# kill, rename, hide, show, why), and a caller should not have to learn six
# spellings of the same answer.
#
# It replaces a STRING contract with a numeric one, which is the real win.
# `mux latch` had to grep stderr for "no such session" to tell a rebooted host
# from an ordinary refusal, so the wording of an error message was load-bearing
# across two files, and a test existed only to hold it still. A code cannot be
# reworded.
#
# 3 keeps the small-set property the contract depends on: mux still uses only
# 0, 1, 2 and 3, so 126, 127 and 255 remain unambiguously NOT mux. Callers that
# only know 0/1/2 still behave correctly, since 3 is non-zero and the reason is
# still on stderr.
MUX_EX_NONAME=3

# 4 = NOT READY YET, AND TRY AGAIN. The second cross-cutting condition, added
# for the same reason as 3: a decision on another machine must not depend on
# the WORDING of a message, and a code cannot be reworded.
#
# IT EXISTS FOR THE LATCH-AFTER-A-REBOOT CASE. A host that has no server for
# this partition and whose declared session pointers have not arrived refuses
# rather than rebuilding every session into an environment that is still
# starting. The client already owns waiting, bounding and reporting, so the
# host says "not yet" and stays stateless about it.
#
# AND THE RETRY IS THE MECHANISM, which is why a code beats blocking here:
# each attempt is a NEW remote process with a new login shell, so it re-reads
# the environment rather than remembering the one it started with. That is this
# package's re-derive-never-remember rule falling out of the shape.
#
# IT DEGRADES IN BOTH DIRECTIONS WITH NO NEGOTIATION, which is what makes it
# safe to add: a latch that does not know 4 falls through to `unknown` and
# RETRIES, which is the behaviour wanted anyway, and an older remote never
# emits it. Still a small set, so 126, 127 and 255 remain unambiguously not
# mux.
MUX_EX_NOTREADY=4

MUX_DIR=${MUX_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/mux}
TMUX_CONF=${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux.conf

# Find our own libexec (the helper executables + the sourced *_lib files),
# computed from this script's RESOLVED location: no hardcoded path, no env
# seam. $0 may be a bare name (a PATH lookup: how tmux run-shell and the agent
# hooks invoke us), relative, or absolute, and may arrive through symlinks
# (~/.local/bin/mux is a symlink to the install); resolve all of it. bin/,
# libexec/ and share/ are siblings under one prefix, as in a package install.
_self=$0
case $_self in
*/*) ;;
*) _self=$(command -v -- "$_self" 2>/dev/null || echo "$_self") ;;
esac
# `readlink -f` IN ONE PROCESS WHERE IT EXISTS, a POSIX loop where it does not.
# macOS had no `readlink -f` until 12.3, and the old `|| echo "$_self"` fallback
# was silently WRONG rather than merely unresolved: through the install symlink
# (~/.local/bin/mux) an unresolved $0 makes the prefix ~/.local, so LIBEXEC
# became ~/.local/libexec while setup.sh installs the namespaced
# ~/.local/libexec/mux. mux then could not find its own libraries and blamed the
# install ("missing (incomplete install)"). Reproduced on Linux by stubbing a
# readlink that rejects -f, which is how test/mux-portability.t pins it.
#
# THE FAST PATH IS FIRST because this runs on every status-bar tick and every
# agent hook: where `readlink -f` works, this is the one fork it always was.
if _r=$(readlink -f -- "$_self" 2>/dev/null) && [ -n "$_r" ]; then
  _self=$_r
else
  # One `readlink` per link in the chain. Only the FINAL component is resolved,
  # which is what the install layout needs (bin/mux is the symlink); a directory
  # symlink higher up resolves to the same tree either way. Bounded, because a
  # symlink loop must not hang the status bar: `readlink -f` errors on one and
  # so must this.
  _n=0
  while [ -L "$_self" ] && [ "$_n" -lt 40 ]; do
    _t=$(readlink -- "$_self" 2>/dev/null) || break
    [ -n "$_t" ] || break
    case $_t in
    /*) _self=$_t ;;
    *)  _self=${_self%/*}/$_t ;;
    esac
    _n=$((_n + 1))
  done
fi
LIBEXEC=${_self%/*}/../libexec
MUX_LIB=${_self%/*}/../lib
# Package DATA, the shipped defaults (themes, agents, shapes, the default
# layout), lives in share, a sibling of bin/ and libexec/ under the prefix.
# User layouts and the integrator OVERLAY (context, hosts) live in $MUX_DIR.
#
# Respect an exported $MUX_SHARE ONLY if it still points at a real directory: a
# stale value: e.g. inherited from a long-running tmux server started against
# a since-moved or removed install: would otherwise send every include/theme
# lookup to a dead path. Unset or dangling, self-locate the sibling share/.
if [ -n "${MUX_SHARE:-}" ] && [ -d "$MUX_SHARE" ]; then :   # a valid override
else MUX_SHARE=${_self%/*}/../share
fi
export MUX_DIR MUX_SHARE   # the helper verbs (mux themes ...) inherit both

# THE CAPABILITY MANIFEST MOVED to libexec/mux-capabilities (2026-10-05).
# It sat HERE, before the dispatch below, so every hot-path invocation
# parsed 153 lines it never called: `mux style` and `mux agent-render` run
# per client per status-interval and `mux agent-emit` on every agent state
# change. The dispatch's own promise ("never parsed past here on a hot
# path") was true only of what came AFTER it.
#
# THE VERB LISTS STAYED, deliberately: test/mux-capabilities.t scrapes both
# `case` blocks in THIS file to prove every dispatchable verb is classified,
# so a verb nobody declared still fails the suite.

# Fast path: the helper verbs ARE standalone executables in libexec, and the
# tmux fragment + agent hooks reach them as `mux <verb>` (one entry point, on
# PATH: no path knowledge in the caller). exec straight through, so this
# script is never parsed past here on a hot path: the status bar runs `mux
# style` / `mux agent-render` every tick and the agent hooks fire `mux
# agent-emit` on every state change. Each helper self-locates its own siblings.
case ${1:-} in
cycle)         shift; exec "$LIBEXEC/mux-cycle" "$@" ;;
click)         shift; exec "$LIBEXEC/mux-click" "$@" ;;
refresh)       shift; exec "$LIBEXEC/mux-refresh" "$@" ;;
pin)           shift; exec "$LIBEXEC/mux-pin" "$@" ;;
landing)       shift; exec "$LIBEXEC/mux-landing" "$@" ;;
style)         shift; exec "$LIBEXEC/mux-style" "$@" ;;
status-banner) shift; exec "$LIBEXEC/mux-status-banner" "$@" ;;
agent-render)  shift; exec "$LIBEXEC/mux-agent-state-render" "$@" ;;
agent-emit)    shift; exec "$LIBEXEC/mux-agent-state-emit" "$@" ;;
agent-summary) shift; exec "$LIBEXEC/mux-agent-state-summary" "$@" ;;
agent-list) shift; exec "$LIBEXEC/mux-agent-state-list" "$@" ;;
themes)        shift; exec "$LIBEXEC/mux-themes" "$@" ;;
check)         shift; exec "$LIBEXEC/mux-check" "$@" ;;
next-blocked)  shift; exec "$LIBEXEC/mux-next-blocked" "$@" ;;
migrate-profiles) shift; exec "$LIBEXEC/mux-migrate-profiles" "$@" ;;
scan)          shift; exec "$LIBEXEC/mux-scan" "$@" ;;
views)         shift; exec "$LIBEXEC/mux-views" "$@" ;;
agent-doctor)  shift; exec "$LIBEXEC/mux-agent-doctor" "$@" ;;
latch)         shift; exec "$LIBEXEC/mux-latch" "$@" ;;
sane)          shift; exec "$LIBEXEC/mux-sane" "$@" ;;
agent-hook)    shift; exec "$LIBEXEC/mux-agent-hook" "$@" ;;
# Called only from the client-detached hook in share/mux.tmux, with the tty
# that hook recorded at attach time. Silent when there is nothing queued,
# which is most detaches.
notice-flush)  shift; exec "$LIBEXEC/mux-notice-flush" "$@" ;;
update-env)    shift; exec "$LIBEXEC/mux-update-env" "$@" ;;
# THE MACHINE CONTRACT, and a MODE SWITCH rather than a verb: everything under
# `mux agent` answers JSON on stdout, always, including on failure. The
# hyphenated `agent-*` verbs above are mux's own plumbing (called by tmux
# hooks, the status bar and the tray), and mean "about agent state", which is
# a different thing from "for an agent to call".
agent)         shift; exec "$LIBEXEC/mux-agent" "$@" ;;
# NOT `mux agent skill`: that surface promises one JSON object on stdout, and
# a verb printing markdown would make the promise a convention with an
# exception. This one is for a human or a provisioner, run once.
skill)         shift; exec "$LIBEXEC/mux-skill" "$@" ;;
# THE ONE VERB THAT WRITES SOMEBODY ELSE'S CONFIG, which every other part of
# mux refuses to do. Confined here because the step it performs is the one a
# seam cannot cover: an agent that is never told to report is a strip full of
# "no agent" glyphs and a user who concludes mux does not work.
setup)         shift; exec "$LIBEXEC/mux-setup" "$@" ;;
demo)          shift; exec "$LIBEXEC/mux-demo" "$@" ;;
keys)          shift; exec "$LIBEXEC/mux-keys" "$@" ;;
capabilities)  shift; exec "$LIBEXEC/mux-capabilities" "$@" ;;
even)          shift; exec "$LIBEXEC/mux-even" "$@" ;;
window)        shift; exec "$LIBEXEC/mux-window" "$@" ;;
undo-pane)     shift; exec "$LIBEXEC/mux-undo-pane" "$@" ;;
host-color)    shift; exec "$LIBEXEC/mux-host-color" "$@" ;;
log)           shift; exec "$LIBEXEC/mux-log" "$@" ;;
esac

# The ONE comment/normalize rule (mux_conf_clean) for every config parse below:
# layouts, themes, agents. Core, so sourced unconditionally (it deploys with
# mux); a fallback keeps mux alive if the lib is somehow missing, stripping only
# whole-line comments (the pre-normalizer behaviour) so nothing hard-breaks.
_conf_lib=$MUX_LIB/mux-conf_lib
if [ -r "$_conf_lib" ]; then . "$_conf_lib"
else mux_conf_clean() { grep -vE '^[[:space:]]*(#|$)'; }
fi

# The ONE $MUX_DIR-over-$MUX_SHARE rule (mux_data_find / _stems / _files) for
# every package-data read below: layouts, shapes, themes, agent profiles. No
# fallback here, unlike mux_conf_clean above: a normalizer has a safe degraded
# mode, a data resolver has none (it would silently resolve nothing), so a
# missing lib is a broken install and says so.
# mux-resolve_lib LAST of these: it calls into mux-data_lib, mux-scan_lib and
# mux-sessions_lib, and declares that in its own header. No lib sources
# another here, so the order in this list is the dependency.
for _l in mux-paths_lib mux-data_lib mux-profiles_lib mux-scan_lib \
    mux-sessions_lib mux-class_lib mux-log_lib mux-resolve_lib; do
  [ -r "$MUX_LIB/$_l" ] || {
    echo "mux: $MUX_LIB/$_l missing (incomplete install)" >&2
    exit 1; }
  . "$MUX_LIB/$_l"
done

# The shared agent-state reader (also used by the status strip) lets the session
# picker and `mux ls` show each session's agent glyph. Cosmetic, so a missing
# lib degrades to plain names rather than taking down core verbs (kill, reload).
_have_astate=0
_astate_lib=$MUX_LIB/mux-agent-state_lib
if [ -r "$_astate_lib" ]; then . "$_astate_lib"; _have_astate=1; fi

# The CONTEXT seam: mux core knows no particular notion of "context" (a
# work/personal split, a namespace, a git host, ...). mux-context_lib asks an
# optional $MUX_DIR/context hook and falls back to a single default context.
# Core, so sourced unconditionally; a stub keeps every consumer working if the
# lib is missing (default socket, side `default`, all layouts shared, no socks).
_ctx_lib=$MUX_LIB/mux-context_lib
if [ -r "$_ctx_lib" ]; then . "$_ctx_lib"
else
  mux_ctx_resolve() { MUX_CTX_TOKEN=global; MUX_CTX_PARTITION=global
    MUX_CTX_UNKNOWN=0; MUX_CTX_ERR=
    MUX_CFG_label=''; MUX_CFG_theme=''; MUX_CFG_derive=hash
    MUX_CFG_agent=claude; MUX_CFG_layout=default
    MUX_CFG_host_chip=on; MUX_CFG_scan=''; }
  mux_ctx_socket() { printf '%s' "${1:-global}"; }
  mux_ctx_partitions() { echo global; }
fi

# Resolve a BREAKOUT profile: $MUX_DIR/profiles.d/<name>.profile, the heavier
# form a row is promoted to when it outgrows one line (comments, or a value
# with a space in it). Most profiles are rows in $MUX_DIR/profiles instead; see
# mux-profiles_lib.
#
# TRANSITIONAL: mux profiles were once called layouts and lived in <name>.layout
# files. A leftover .layout is still accepted, with a warning, so that deploying
# a new mux and converting your config need not happen in the same instant.
# Delete this fallback (and the mux-check warning) once nobody has one.

# Every profile NAME available, in any of its forms: a row in the table, a
# breakout file, or (transitionally) a pre-rename <name>.layout at the overlay
# root. The table is the PRIMARY form now, so anything that lists profiles has
# to start here: listing only files showed an empty set to anyone who had
# done the sensible thing and used rows.

# The PARTITION a profile belongs to. Its `context=` tag names a context; that
# context's file names a partition (defaulting to the token). An UNTAGGED
# profile belongs to `global`.
#
# This replaced classifying a profile by its ROOT, which needed the integrator
# to answer "which context owns this path": the one question requiring its
# private knowledge (severance's personal carve-outs inside the work tree), and
# the messiest thing in the old contract. A profile's root is now purely a
# session property: where its panes open, never a context signal.

# The root a profile declares, whichever form it is in. Empty when it declares
# none (the session then roots where it is launched).
_profile_root() {   # <name>
  _r=$(mux_prof_get "$1" root)
  if [ -z "$_r" ]; then
    _pf=$(mux_prof_find "$1")
    [ -n "$_pf" ] && _r=$(mux_conf_clean <"$_pf" \
      | awk '$1=="root"{print $2; exit}')
  fi
  printf '%s' "$_r"
}


# usage IS A ONE-LINE SHIM over libexec/mux-help, which holds the only copy of
# the text and the two list helpers it shares with the topics. It EXECS, so it
# never returns, which is what every error path below already relied on: each
# ends with `usage` and its own exit code. Written as a function rather than 21
# inline execs on purpose, because a path repeated at every call site is the
# duplication this split was removing, one layer out.
usage() { exec "$LIBEXEC/mux-help" --usage "${1:-2}"; }

# --- options and the verb in either order, then positionals ----------------
# ONE loop takes both: an option is an option wherever it sits, and the first
# non-option is the VERB. Once we have a verb the loop stops at the next
# non-option: those are the positionals, which must stay positional. So `mux
# --bare go` and `mux go --bare` are the same command; the flag-first form is
# what the README and the man page have always shown, and it used to die on
# "unknown verb: --bare".
#
# No verb at all -> the session picker: pick=1, then flow as an attach (cmd=go).
bare=0
attach=0
attachonly=0
noattach=0
all=0
listing=0
nowaitenv=0
resume=0
force=0
persist=0
cmd=
while [ "$#" -gt 0 ]; do
  case $1 in
    # --bare said nothing about what it did. --no-agent does.
    --no-agent|--bare|-b) bare=1; shift ;;
    --attach|-a)  attach=1; shift ;;
    --attach-only) attachonly=1; shift ;;
    --no-attach)  noattach=1; shift ;;
    --all)        all=1; shift ;;
    --list)       listing=1; shift ;;
    # THE HUMAN OVERRIDE for the readiness gate below. Needed because a
    # person typing `mux resume` at a terminal meets the same refusal a
    # latch does, and the refusal names this flag rather than leaving it
    # to be discovered.
    --no-wait-env) nowaitenv=1; shift ;;
    --resume)     resume=1; shift ;;
    --force)      force=1; shift ;;
    --persist|-p) persist=1; shift ;;   # retired: now the default
    -h|--help)    usage 0 ;;
    --version|-V) printf 'mux %s\n' "$MUX_VERSION"; exit 0 ;;
    --) shift; break ;;
    -*) echo "mux: unknown option: $1" >&2; usage ;;
    *)  if [ -n "$cmd" ]; then break; fi
        cmd=$1; shift ;;
  esac
done

pick=0
if [ -z "$cmd" ]; then
  pick=1
  cmd=go
fi
case $cmd in
  go|resume|kill|kill-all|reload|ls|hide|show|show-all) ;;
  save|new|help|theme|rename|edit|why) ;;
  *) echo "mux: unknown verb: $cmd" >&2; usage ;;
esac
# The retired verbs are the flag forms spelled out. Kept as aliases rather than
# removed: they are in muscle memory and in whatever scripts already call them,
# and folding them here means exactly one code path below.
#
# `resume` is NOT one of them any more. It used to be a second spelling of
# `go --resume` (the agent offers a conversation to pick up) and now names the
# session rebuild that was briefly called `restore`. The FLAG is untouched, so
# the old behaviour is still there as `mux go --resume`; only the bare verb
# moved. Nothing may test `cmd = resume` to mean the flag now ($resume does
# that), since under the rename the two meanings are the same string, and a
# leftover test would silently give one of them the other's behaviour.
case $cmd in
  kill-all)  cmd=kill; all=1 ;;
  show-all)  cmd=show; all=1 ;;
esac

# Arity per verb. --bare is meaningful only where claude is launched. kill
# requires an explicit NAME: it is too destructive to run against an inferred
# session; kill-all takes none (it hits the whole socket, behind a prompt).
case $cmd in
  reload|ls) [ "$#" -eq 0 ] || {
    echo "mux: $cmd takes no arguments" >&2; usage; } ;;
  resume) [ "$#" -le 2 ] || {
    echo "mux: resume [PARTITION [SESSION]]" >&2; usage; } ;;
  kill|show) if [ "$all" -eq 1 ]; then
    [ "$#" -eq 0 ] || { echo "mux: $cmd --all takes no NAME" >&2
      usage; }
     else
    [ "$#" -eq 1 ] || {
      echo "mux: $cmd needs a NAME, or --all" >&2; usage; }
     fi ;;
  hide) [ "$#" -eq 1 ] || {
    echo "mux: hide needs a session NAME (see: mux ls)" >&2
    usage; } ;;
  go) [ "$#" -le 2 ] || {
    echo "mux: too many arguments" >&2; usage; } ;;
  save|theme|edit|why) [ "$#" -le 1 ] || {
    echo "mux: $cmd takes at most a NAME" >&2; usage; } ;;
  rename) { [ "$#" -ge 1 ] && [ "$#" -le 2 ]; } || {
    echo "mux: rename [OLD] NEW" >&2; usage; } ;;
  new) [ "$#" -eq 1 ] || {
    echo "mux: new NAME (the session to create here)" >&2
    usage; } ;;
  help) [ "$#" -le 6 ] || {
    echo "mux: help [agents|themes|profiles|palette]" >&2
    usage; } ;;
esac
case $cmd in
  go|new) ;;
  *) [ "$bare" -eq 0 ] || {
    echo "mux: --no-agent is only for go/new" >&2; usage; } ;;
esac
case $cmd in
  go) ;;
  *) [ "$attach" -eq 0 ] || {
    echo "mux: --attach is only for go" >&2; usage; } ;;
esac
case $cmd in
  go) ;;
  *) [ "$resume" -eq 0 ] || {
    echo "mux: --resume is only for go" >&2; usage; } ;;
esac
case $cmd in
  kill|show) ;;
  *) [ "$all" -eq 0 ] || {
    echo "mux: --all is only for kill/show" >&2; usage; } ;;
esac
case $cmd in
  resume) ;;
  *) [ "$listing" -eq 0 ] || {
    echo "mux: --list is only for resume" >&2; usage; } ;;
esac
case $cmd in
  go|new) ;;
  *) [ "$noattach" -eq 0 ] || {
    echo "mux: --no-attach is only for go/new" >&2
    usage; } ;;
esac
case $cmd in
  save|new) ;;
  *) [ "$force" -eq 0 ] || {
    echo "mux: --force is only for save/new" >&2
    usage; } ;;
esac
case $cmd in
  theme) ;;
  *) [ "$persist" -eq 0 ] || {
    echo "mux: --persist is only for theme" >&2; usage; } ;;
esac
# -p used to be how a theme was made to stick. It always sticks now, so the flag
# is accepted and ignored rather than breaking a habit or a script.
[ "$persist" -eq 1 ] && [ "$cmd" = theme ] && \
  echo "mux: -p is the default now; the theme is always remembered" >&2

name_arg=${1:-}
layout_arg=${2:-}


# HELP IS ENTIRELY libexec/mux-help (2026-10-05): the topics, the usage
# summary, and the two list helpers they share. The empty topic IS usage, so
# this needs no branch of its own and the topic VOCABULARY lives with the
# topics, which makes adding one a single edit in a single file.
#
# "$@" IS LOAD-BEARING. This was once an inline block reading the script's
# own positionals, and a first attempt at extracting it dropped them, which
# made every `mux help TOPIC` print the usage summary instead: an argument
# this file can only pass on, never interpret.
if [ "$cmd" = help ]; then exec "$LIBEXEC/mux-help" "$@"; fi

# Root and identity both derive from the project: the git toplevel if we are in
# a repo, else the current directory. tmux forbids ':' and '.' in a session
# name, so fold them to '-' in a derived name.
base=$(mux_resolve_project_base)
bypath=0
if [ -n "$name_arg" ] && mux_resolve_is_path "$name_arg"; then
  # A session addressed by its ROOT. Deliberately NOT the same as
  # `cd <path> && mux go`: a bare go climbs to the git toplevel, which
  # would turn a subdirectory session's root into its enclosing repo.
  # Here an exact-root claim wins first, so a profile rooted below a
  # toplevel resolves to itself.
  #
  # This is what lets `mux resume` replay a PUBLIC command rather than
  # reach into mux's internals: it knows each session's root, and a root
  # is an address.
  bypath=1
  _bp=$(mux_expand_tilde "$name_arg")
  _bp=$(readlink -f -- "$_bp" 2>/dev/null || printf '%s' "$_bp")
  [ -d "$_bp" ] || {
    echo "mux: not a directory: $name_arg" >&2; exit 1; }
  name=$(mux_prof_by_root "$_bp")
  if [ -n "$name" ]; then
    base=$_bp
  else
    base=$(mux_resolve_project_base "$_bp")
    name=$(basename "$base")
  fi
elif [ -n "$name_arg" ]; then
  # A NAME THE USER TYPED IS REFUSED, never quietly rewritten, because mux
  # RESERVES the colon for addressing and handing back a different session
  # from the one asked for is this package's signature failure: plausible,
  # wrong, and silent. A DERIVED name is rewritten instead (see
  # mux_sess_sanitise), since a directory called `example.com` is nobody's
  # mistake.
  # NOT FOR `resume`, WHOSE ARGUMENT IS AN ADDRESS rather than a session
  # name: `mux resume work::api` is the qualified form and the colons there
  # are mux's own grammar doing its job. This block is the SHARED name
  # resolution, so without the exclusion the reservation refused the very
  # syntax it exists to protect, which the suite caught at once.
  [ "$cmd" = resume ] || mux_sess_name_clean "$name_arg" || {
    echo "mux: a session name cannot contain a colon: $name_arg" >&2
    echo "mux: mux reserves it for addressing, where PARTITION::SESSION" >&2
    echo "mux: and SESSION:WINDOW are how a name is qualified, and tmux" >&2
    echo "mux: uses it for the same job, so such a session could not be" >&2
    echo "mux: reached by a plain \`tmux -t\` either. Try:" >&2
    echo "mux:   mux $cmd $(mux_sess_sanitise "$name_arg")" >&2
    exit 2; }
  name=$name_arg
else
  # No name typed: the directory decides. A row whose `root` IS this
  # directory names it, so an alias is authoritative for its own
  # project, and `mux go` there reaches the same session `mux go <alias>`
  # would, instead of creating a second one under the derived name.
  # EXACT match only; a subdirectory still derives the enclosing project.
  name=$(mux_prof_by_root "$base")
  [ -n "$name" ] || name=$(basename "$base")
fi
name=$(mux_sess_sanitise "$name")

# Which tmux namespace. The context hook names the socket: an isolated context
# gets a socket of its own, everything else the default server. Degrades cleanly
# to the default socket when no hook is installed, or
# when the caller is in no special context. Prime _cur_side here too, so the
# common path resolves the hook once.
mux_ctx_resolve || { echo "mux: ${MUX_CTX_ERR:-context error}" >&2; exit 1; }
sock=$(mux_ctx_socket)

# The PARTITION KEY: what the session set, the scan map and the agent-state dir
# are filed under. Identical in VALUE to $sock (a partition's socket is named
# after it) but a different QUESTION: $sock answers "which tmux -L", $part
# answers "whose records". Conflating them is how a stale name spread: eleven
# sites wrote ${sock:-default} as a partition key, naming a partition that
# stopped existing when the personal one became `global`, while every library
# fell back to `global`. Unreachable today (resolve either sets a partition or
# exits), but this is the third sighting of that default and the first two were
# live bugs: the tray indicator (15cc461) and mux-agent-state-emit (6099078).
#
# The `default` left in the SOCKET comparisons below is a different string with
# the same spelling, and is correct: with no -L, tmux's own socket really is
# named `default`, so that is what a socket basename compares against.
part=$MUX_CTX_PARTITION
# resume's optional PARTITION and SESSION. Only resume takes them today; every
# other verb acts on the partition you are in, which is the point of a context.
#
# POSITIONAL, and the first is ALWAYS the partition, never "whichever of
# these happens to name one". That magic would change meaning the day you add
# a partition, and a session sharing a partition's name would silently do the
# wrong thing, which is the exact shape of bug `mux latch` already shipped
# once (a default that succeeded at the wrong thing and said nothing).
rs_want=${1:-}
rs_focus=${2:-}
# ONE ARGUMENT IS AN ADDRESS, two are the legacy pair, and the discriminator
# is the ARGUMENT COUNT rather than emptiness: `mux resume work ''` is a
# deliberate two-field call naming a partition and no focus, and reading it as
# an address would turn it into the session `work`, silently.
#
# WHY RESUME MOVED TO THE COMMON GRAMMAR: its space-separated positionals were
# a SECOND grammar for the same concept, with the first field always a
# partition, which collides with "a bare word is always a session" everywhere
# else in mux.
#
# THE BREAK IS LOUD, which is what makes it safe to take: `mux resume work`
# now rebuilds the caller's own partition and tries to FOCUS a session called
# `work`, and when there is no such session that is exit 3 naming every
# session there is. A silent change of meaning would have been the thing to
# refuse; an immediate, listed refusal is a prompt.
#
# THE TWO-FIELD FORM IS KEPT as the compatibility path, because it is what an
# OLDER `mux latch` composes as a remote command and a remote contract cannot
# be changed from one side.
#
# SOURCED LAZILY, inside the branch: the front end parses this file on every
# invocation and a verb nobody called must not cost a lib.
if [ "$cmd" = resume ] && [ "$#" -le 1 ] && [ -n "$rs_want" ]; then
  # shellcheck source=/dev/null
  . "$MUX_LIB/mux-addr_lib"
  mux_addr_parse "$rs_want" || exit 2
  [ -z "$MUX_ADDR_WIN" ] || {
    echo "mux: resume: a window cannot be addressed here." >&2
    echo "mux: resume rebuilds a SESSION SET and lands on one of them," >&2
    echo "mux: so there is nothing per-window for it to do. Try:" >&2
    rs_try=${MUX_ADDR_PART:+${MUX_ADDR_PART}::}$MUX_ADDR_SESS
    echo "mux:   mux resume $rs_try" >&2
    exit 2; }
  rs_want=$MUX_ADDR_PART
  rs_focus=$MUX_ADDR_SESS
fi
if [ "$cmd" = resume ] && [ -n "$rs_want" ]; then
  mux_ctx_valid "$rs_want" || {
    echo "mux: not a partition name: $rs_want" >&2; usage; }
  # KNOWN, or exit 3: mux's cross-cutting "the name is not known
  # here", the same code `go` and `why` use. A typo must not resume an
  # EMPTY set and report "no sessions recorded", which reads as data
  # loss rather than as a misspelling.
  case " $(mux_ctx_partitions | tr '\n' ' ') " in
  *" $rs_want "*) part=$rs_want ;;
  *) echo "mux: no such partition: $rs_want" >&2
     echo "mux: known: $(mux_ctx_partitions | tr '\n' ' ')" >&2
     exit "$MUX_EX_NONAME" ;;
  esac
elif [ "$cmd" = resume ] && [ "${MUX_CTX_SRC:-baseline}" = failed ]; then
  # THE THIRD OUTCOME, and the one that must not be silent. `baseline`
  # and `declined` are real answers meaning the baseline; `failed` is the
  # ABSENCE of an answer, and resuming `global` on the strength of it
  # hands you somebody else's sessions while looking like success.
  # `mux why` already refuses to credit a failed command for a token it
  # did not supply: this is the same lie, available to resume.
  echo "mux: the context-command FAILED, so the partition is unknown" >&2
  echo "mux: name one (mux resume global), or fix the command" >&2
  exit 1
fi

# A session name may contain a space but never a newline (tmux's own -F
# output is line oriented), so newline is the only safe separator for a
# LIST of them, and `for n in $set` is never safe for one.
_RS_NL='
'
# Nothing knows this context. Say so ONCE, here in the front end, never from
# mux-context_lib, which mux-style and mux-agent-render call every status
# interval, where output pops a view-mode buffer over the active pane.
[ "${MUX_CTX_UNKNOWN:-0}" -eq 1 ] && {
  echo "mux: no config for context '$MUX_CTX_TOKEN'" \
    "(no contexts/$MUX_CTX_TOKEN.context," \
    "no partitions/$MUX_CTX_PARTITION.partition)" >&2
  echo "mux: running on built-in defaults; discovery is off" >&2
}

# Single chokepoint for the socket choice: every session-scoped tmux call goes
# through here. reload deliberately bypasses it to reach BOTH servers.
tm() {
  if [ -n "$sock" ]; then
    tmux -L "$sock" "$@"
  else
    tmux "$@"
  fi
}

# --- mux's own wiring, guaranteed on every server mux acts on --------------
# WHY THIS EXISTS: a mux install was NOT complete on its own. The fragment
# loaded only because the user's ~/.config/tmux/tmux.conf carried a
# `source-file` line for it, and on the fleet this was written for that file
# belongs to the PROVISIONER. Remove that project and mux's bindings, status
# strip and hooks all stop loading, while `mux check` reports the remedy as
# "add a line to a file you do not own". Two projects owning one install is
# also how an option drifts, and `update-environment`, which mux needs to own,
# was set in that same foreign file.
#
# IT DOES NOT TAKE THE CONFIG FILE, and that is the design rather than a
# compromise. tmux reads the user's tmux.conf when the server starts, exactly
# as before, so their prefix key and bindings keep working with no migration;
# mux sources its own fragment AFTERWARDS, so a mux binding wins, which is the
# order tmux already gives the last file sourced.
#
# `-f` WAS THE OBVIOUS SHAPE AND IS WORSE, measured both ways. A `-f` server
# reads ONLY that file, so mux would have to re-source the user's config
# itself and a plain `tmux` would then behave differently from a mux one.
# Sourcing afterwards is equivalent: into a RUNNING server the fragment
# delivers status-right, every binding and every hook.
#
# THE OVERLAP IS FREE, which is what lets this ship before the provisioner
# drops its line, with no flag day. mux.tmux is IDEMPOTENT, proven rather than
# assumed: the whole `show-options -g` hash, all 271 bindings, and even the
# APPENDED `window-layout-changed` array are byte-identical after one, two and
# three sourcings, because that hook is reset with `set-hook -g` before its
# three `-ag` appends. Note the reverse is NOT free and is not claimed: if the
# provisioner dropped its line while this was not yet live, a server would get
# NO sourcing at all. Two different windows; idempotence only frees one.
#
# THE MARKER CARRIES THE VERSION AND MUX WRITES IT, not the fragment, because
# `set -gF @x '#(mux -V)'` does NOT expand at set time (measured: it reads back
# empty). Writing it here is better anyway: a fragment left by an OLDER mux
# compares unequal and is re-sourced, which closes the staleness that once had
# `mux check` telling a live server to source a file it had already sourced.
#
# THE PROBE CANNOT CREATE A SERVER, which matters because this runs on paths
# where none may exist yet. `show-options -gqv` exits non-zero and spawns
# nothing (measured), unlike the `list-keys` that had to be taken out of
# `mux check` for exactly that reason. No server means nothing to wire.
#
# ONLY mux.tmux. `mux-opinions.tmux` says in its own header that it is optional
# taste to source or skip, so forcing it would make mux impose a mouse mode
# nobody asked for.
#
# AND A SERVER MUX NEVER TOUCHES IS NOT WIRED, which is the honest limit. A
# plain `tmux new-session` gives mux no hook. This is called from the
# SESSION-AFFECTING paths (the build, the attach, reload) and deliberately NOT
# from the hot read-only ones: `mux agent-render` runs per client every
# status-interval, and a round trip there is paid forever. So such a server is
# wired the first time a mux verb acts on it, which is the first moment mux is
# entitled to an opinion about it.
# --- the session pointers a pane must not start without -------------------
# R1 and R2 from the environment work. A pane's environment comes from the
# SERVER, not from whoever asked for the pane (measured: a client holding a
# good value still got the server's value in a new window), so no caller can
# fix this from outside and it has to happen here.
#
# AND AN ATTACH DESTROYS, which is why this runs on BOTH paths rather than
# only at creation. tmux's `update-environment` copies the attaching client's
# environment into the session, and copying an ABSENT variable records a
# REMOVAL (`-SSH_AUTH_SOCK`), which then MASKS the server global. One attach
# from a client with no agent turns a healthy session into a broken one. On the
# box this was found on, that client was an ssh from another machine while the
# box sat at its login greeter, so any cross-box attach does it.
#
# THE LIBS ARE SOURCED LAZILY, INSIDE THE FUNCTION, and that is deliberate
# rather than lazy writing. `mux agent-render` runs per client every
# status-interval, and a `.` at the top of this file is parsed on every
# invocation including those. Sourcing here costs the hot paths nothing,
# because they never call this. Functions defined by a `.` inside a function
# are global afterwards, so the guard only has to fire once.
_mux_env_loaded=0
# ONE LOADER, TWO CALLERS, and extracted rather than copied the moment the
# second one appeared: `mux resume`'s readiness gate needs the same libs (in
# lib/mux-resume_lib since 2026-10-05, calling this), and a second copy of
# this list is the thing that drifts when a lib is added.
# Non-zero means an incomplete install; each caller decides what that costs.
_mux_env_load() {
  [ "$_mux_env_loaded" -eq 0 ] || return 0
  for _eel in mux-paths_lib mux-conf_lib mux-notice_lib mux-env_lib; do
    [ -r "$MUX_LIB/$_eel" ] || return 1
    # shellcheck source=/dev/null
    . "$MUX_LIB/$_eel"
  done
  _mux_env_loaded=1
  return 0
}
mux_env_ensure() {   # <session>
  [ -n "${1:-}" ] || return 0
  _mux_env_load || return 0
  # R7: A WITHHELD VALUE IS VISIBLE. Three outcomes come back and they are
  # reported differently on purpose:
  #
  #   dropped   a FINDING: resolved, failed its validator, so not written.
  #             Announced, because otherwise this becomes a second silent
  #             removal mechanism beside `update-environment`, which is what
  #             made the original fault cost a long session to find.
  #   stripped  the human's own POLICY, declared in envhooks.d/strip.d. Not
  #             news, and announcing it every run would be noise about a
  #             decision they already made.
  #   set       the repair working. Quiet by design: a session starting
  #             correctly is not an event.
  mux_env_apply "$1" -v 2>/dev/null | while IFS=' ' read -r _eev _een; do
    [ "$_eev" = dropped ] || continue
    mux_notice startup "$_een was withheld from '$1': it resolved," \
      "but its own validator says that value is dead."
  done
}

mux_wire() {
  [ -n "${MUX_SHARE:-}" ] && [ -f "$MUX_SHARE/mux.tmux" ] || return 0
  # No server yet is not a failure: there is simply nothing to wire.
  _wv=$(tm show-options -gqv @mux-wired 2>/dev/null) || return 0
  [ "$_wv" = "$MUX_VERSION" ] && return 0
  if ! tm source-file "$MUX_SHARE/mux.tmux" 2>/dev/null; then
    # LOUD, because the alternative is mux installed and inert: no status
    # strip, no bindings, no hooks, and nothing on screen saying why.
    echo "mux: could not source $MUX_SHARE/mux.tmux into this server," >&2
    echo "mux: so it has no mux bindings, strip or hooks." >&2
    return 1
  fi
  tm set -g @mux-wired "$MUX_VERSION" 2>/dev/null || true
}

# Heal any theme-fragment drift on the running servers before we draw anything:
# a cheap no-op unless a themes/*.theme changed since a server was last synced,
# so an edited palette needs no manual reload. Best-effort; never a gate.
if [ -x "$LIBEXEC/mux-themes" ]; then
  "$LIBEXEC/mux-themes" sync || true
fi

# --- (no verb): pick a session to attach -----------------------------------
# `mux` with no arguments lists the sessions in this context and lets you choose
# one: fzf if present, else a numbered menu. One session attaches straight
# away; none points you at `mux go`. Sets `name`, then falls through to the
# attach path below.
if [ "$pick" = 1 ]; then
  _sessions=$(tm list-sessions -F '#{session_name}' 2>/dev/null || true)
  if [ -z "$_sessions" ]; then
    echo "mux: no sessions in this context (start one: mux go)"
    exit 0
  fi
  _count=$(printf '%s\n' "$_sessions" | grep -c .)
  if [ "$_count" -eq 1 ]; then
    name=$_sessions
  else
    # Decorate each session with its agent-state glyph, so a blocked
    # or working agent is visible while you choose (⚫ = no agent).
    # The menu line is "GLYPH NAME"; NAME is the last field (mux
    # names hold no spaces), so the pick maps straight back. Skipped
    # when the shared state lib is absent, then it is plain names.
    _menu=$_sessions
    if [ "$_have_astate" -eq 1 ]; then
      _adir=$(mux_agent_dir "$part")
      _menu=$(printf '%s\n' "$_sessions" \
        | while IFS= read -r _s; do
        [ -n "$_s" ] || continue
        printf '%s %s\n' \
            "$(mux_agent_state_glyph "$_adir" "$_s")" \
            "$_s"
        done)
    fi
    if command -v fzf >/dev/null 2>&1; then
      _sel=$(printf '%s\n' "$_menu" \
        | fzf --prompt='mux> ' --height=40% --reverse) \
        || exit 0
      name=${_sel##* }
    else
      printf '%s\n' "$_menu" | nl -w2 -s') ' >&2
      printf 'mux: session #? ' >&2
      read -r _n || exit 0
      case $_n in
      ''|*[!0-9]*) echo "mux: not a number" >&2; exit 1 ;;
      esac
      _sel=$(printf '%s\n' "$_menu" | sed -n "${_n}p")
      name=${_sel##* }
    fi
  fi
  [ -n "$name" ] || { echo "mux: nothing selected" >&2; exit 0; }
fi

# --- reload: re-source tmux.conf on every running mux server ---------------
# The config is machine-wide, so one reload from any pane freshens everything:
# the default socket, plus every non-default context socket the hook names, if
# their servers are up. All the same uid, so one can source another's server.
# Guard on list-sessions so source-file never STARTS a server that was not up.
# Re-source ONE server, in the order that makes mux win: the user's own config
# first (their prefix key, their bindings), then mux's fragment.
#
# IT BYPASSES tm() like the rest of this verb, because reload deliberately
# reaches every server rather than the caller's, so the socket is a parameter
# instead of $sock. Read into a local FIRST, because `set --` below replaces
# this function's own arguments.
_reload_one() {   # <socket, or empty for the default server>
  _r_sock=$1
  if [ -n "$_r_sock" ]; then set -- -L "$_r_sock"; else set --; fi
  # Guard on list-sessions so a reload never STARTS a server that was down,
  # and note it is list-sessions rather than list-keys for the reason
  # `mux check` had to learn: list-keys SPAWNS one and answers from defaults.
  tmux "$@" list-sessions >/dev/null 2>&1 || return 1
  if [ -f "$TMUX_CONF" ]; then
    tmux "$@" source-file "$TMUX_CONF" 2>/dev/null || return 1
  fi
  if [ -n "${MUX_SHARE:-}" ] && [ -f "$MUX_SHARE/mux.tmux" ]; then
    tmux "$@" source-file "$MUX_SHARE/mux.tmux" 2>/dev/null || return 1
    tmux "$@" set -g @mux-wired "$MUX_VERSION" 2>/dev/null || true
  fi
  return 0
}

cmd_reload() {
  # THE USER'S CONFIG IS OPTIONAL, which is the whole of R10 in one line. This
  # used to `exit 1` with "no tmux.conf at ..." when that file was absent, so
  # mux's own reload verb DEPENDED on a file mux does not ship and does not
  # own: on the fleet this was written for, that file belongs to the
  # provisioner, and removing that project broke `mux reload` outright.
  #
  # Now the file is sourced IF PRESENT and mux's fragment always is, in that
  # order, so a mux binding wins and a box with no tmux.conf at all reloads
  # correctly. Nothing is required of whoever ships that file, including its
  # existence.
  did=
  if _reload_one ""; then did="$did default"; fi
  # Plus every non-default context server the hook knows, so a reload
  # reaches them regardless of the caller's side.
  # A here-doc, not `for _x in $(...)`: this producer emits one entry per
  # LINE and a name may contain a SPACE, so word splitting turns one entry
  # into two. Fifth instance of that class in this package; the earlier
  # four were session names.
  while IFS= read -r _s; do
    [ -n "$_s" ] || continue
    if _reload_one "$_s"; then did="$did $_s"; fi
  done <<EOF
$(mux_ctx_partitions)
EOF
  echo "mux: reloaded${did:- (no running servers)}"
  exit 0
}

if [ "$cmd" = reload ]; then cmd_reload; fi

# --- ls: sessions in the current context only ------------------------------
# Prefix each line with the session's agent-state glyph (⚫ = no agent), so `mux
# ls` reads like the status strip. Falls back to bare `tmux list-sessions` when
# the shared state lib is absent, or when a session line has no name to key on.
cmd_ls() {
  _ls=$(tm list-sessions 2>/dev/null || true)
  [ -n "$_ls" ] || { echo "mux: no sessions in this context"; exit 0; }
  if [ "$_have_astate" -eq 1 ]; then
    _adir=$(mux_agent_dir "$part")
    printf '%s\n' "$_ls" | while IFS= read -r _line; do
      _s=${_line%%:*}
      printf '%s %s\n' \
        "$(mux_agent_state_glyph "$_adir" "$_s")" \
        "$_line"
    done
  else
    printf '%s\n' "$_ls"
  fi
  exit 0
}

if [ "$cmd" = ls ]; then cmd_ls; fi

# --- theme: set / cycle / show the current session's colour theme -----------
# THE WHOLE VERB IS lib/mux-theme_lib (2026-10-05). Its header says why it
# is a sourced lib rather than an executed helper (`tm` carries the
# partition socket), and names the three libs sourced above.
#
# SOURCED LAZILY, inside the branch: the front end is parsed on every
# invocation and a verb nobody called must not cost a lib.
if [ "$cmd" = theme ]; then
  [ -r "$MUX_LIB/mux-theme_lib" ] || {
    echo "mux: mux-theme_lib missing (incomplete install)" >&2
    exit 1; }
  # shellcheck source=/dev/null
  . "$MUX_LIB/mux-theme_lib"
  mux_theme
fi

# --- why: where every resolved value came from -----------------------------
# THE REPORT IS lib/mux-why_lib (2026-10-05): 243 lines that only describe
# values this file has already resolved, so it is a sourced lib rather than
# an executed helper and the globals contract between its pieces is
# unchanged. Its header says why, and names the five libs it needs, all of
# which are sourced above.
#
# SOURCED LAZILY, inside the branch, the same rule the resume and hide/show
# branches follow: the front end is parsed on every invocation and a verb
# nobody called must not cost a lib.
if [ "$cmd" = why ]; then
  [ -r "$MUX_LIB/mux-why_lib" ] || {
    echo "mux: mux-why_lib missing (incomplete install)" >&2
    exit 1; }
  # shellcheck source=/dev/null
  . "$MUX_LIB/mux-why_lib"
  mux_why
fi

# --- rename: rename a live session (and its matching layout) ----------------
# `mux rename NEW`       rename the CURRENT session (needs to run in one)
# `mux rename OLD NEW`   rename OLD to NEW from anywhere. tmux forbids ':' and
# '.' in names, so they fold to '-'. A matching <OLD>.layout is renamed too if
# <NEW>.layout is free, so the per-project layout keeps matching the session.
cmd_rename() {
  if [ -z "$layout_arg" ]; then
    [ -n "${TMUX:-}" ] || {
      echo "mux: rename NEW needs a session (or: OLD NEW)" >&2
      exit 1; }
    _old=$(tm display-message -p '#{session_name}'); _new=$name_arg
  else
    _old=$name_arg; _new=$layout_arg
  fi
  # REFUSED, NOT REWRITTEN, for the same reason `go`/`new` refuse: a rename
  # is always a name the user TYPED, and quietly giving them a different one
  # is worse than saying no. `why` and `save` keep the sanitiser on purpose:
  # the first only REPORTS on a name and the second names a LAYOUT.
  mux_sess_name_clean "$_new" || {
    echo "mux: a session name cannot contain a colon: $_new" >&2
    echo "mux: mux reserves it for addressing (PARTITION::SESSION and" >&2
    echo "mux: SESSION:WINDOW), and tmux uses it for the same job. Try:" >&2
    echo "mux:   mux rename $_old $(mux_sess_sanitise "$_new")" >&2
    exit 2; }
  # AND THE DOT IS STILL FOLDED, which is a SEPARATE rule: tmux <= 3.6
  # rewrites it, so mux must agree with what tmux will store or
  # `has-session -t =NAME` stops matching the name mux recorded. My first
  # version of this block REPLACED the fold instead of preceding it, and the
  # test caught the dot coming through unfolded.
  _new=$(mux_sess_sanitise "$_new")
  tm has-session -t "=$_old" 2>/dev/null || {
    echo "mux: no such session: $_old" >&2
    exit "$MUX_EX_NONAME"; }
  _oroot=$(mux_sess_root "$_old" "$part")
  tm rename-session -t "=$_old" "$_new"
  # The recorded set has to learn the new name too. It did not, and the
  # cost only showed up after a REBOOT: `mux resume` faithfully rebuilt
  # the OLD name (a session that no longer exists) and never restored the
  # renamed one, so a rename silently dropped the session from the set
  # that exists to bring it back. Same shape as the other state bugs here:
  # one store learned about a change and another did not.
  #
  # Order matters: read the root BEFORE dropping, or the new entry is
  # recorded rootless and resume cannot rebuild it.
  if [ -n "$_oroot" ]; then
    mux_sess_drop "$_old" "$part"
    mux_sess_add "$_new" "$_oroot" "$part"
  fi
  echo "mux: renamed session $_old -> $_new"
  if [ -f "$MUX_DIR/$_old.profile" ] \
     && [ ! -e "$MUX_DIR/$_new.profile" ]; then
    mv "$MUX_DIR/$_old.profile" "$MUX_DIR/$_new.profile"
    echo "mux: renamed profile $_old -> $_new"
  fi
  exit 0
}

if [ "$cmd" = rename ]; then cmd_rename; fi

# --- edit: open a profile, and never eat the work ---------------------------
# THE WHOLE VERB IS lib/mux-edit_lib (2026-10-05). Its header says why it
# is a sourced lib rather than an executed helper (`tm` carries the
# partition socket), and names the four libs sourced above.
#
# SOURCED LAZILY, inside the branch: the front end is parsed on every
# invocation and a verb nobody called must not cost a lib.
if [ "$cmd" = edit ]; then
  [ -r "$MUX_LIB/mux-edit_lib" ] || {
    echo "mux: mux-edit_lib missing (incomplete install)" >&2
    exit 1; }
  # shellcheck source=/dev/null
  . "$MUX_LIB/mux-edit_lib"
  mux_edit
fi

# --- save: snapshot the live session ---------------------------------------
# THE WHOLE VERB IS lib/mux-save_lib (2026-10-05), including the window/pane
# serialiser `emit_window` and its `is_shell`, which lived here for one
# caller. Its header says what it does, why it is a sourced lib rather than
# an executed helper, the one function it still needs from THIS file (`tm`)
# and the five libs sourced above.
#
# SOURCED LAZILY, inside the branch: the front end is parsed on every
# invocation and a verb nobody called must not cost a lib.
if [ "$cmd" = save ]; then
  [ -r "$MUX_LIB/mux-save_lib" ] || {
    echo "mux: mux-save_lib missing (incomplete install)" >&2
    exit 1; }
  # shellcheck source=/dev/null
  . "$MUX_LIB/mux-save_lib"
  mux_save
fi

# --- hide / show / show-all: per-client session hiding ---------------------
# Context-sensitive: must run INSIDE a session, so the client (its tty) can be
# identified; the hidden set is per client. hide drops SESSION from THIS
# client's status strip and ( / ) cycling; show restores it; show-all clears
# the set. Persists until shown or reboot. hide/show need SESSION to exist.
case $cmd in
hide|show)
  [ -n "${TMUX:-}" ] || {
    echo "mux: $cmd must run inside a session" >&2; exit 1; }
  [ -r "$MUX_LIB/mux-exclude_lib" ] || {
    echo "mux: mux-exclude_lib missing (incomplete install)" >&2
    exit 1; }
  _client=$(tm display-message -p '#{client_name}' 2>/dev/null || true)
  [ -n "$_client" ] || {
    echo "mux: could not identify the client" >&2; exit 1; }
  . "$MUX_LIB/mux-exclude_lib"
  _f=$(mux_exclude_file "$_client")
  mkdir -p "$(dirname "$_f")"
  if [ "$cmd" = show ] && [ "$all" -eq 1 ]; then
    rm -f "$_f"
    echo "mux: cleared this client's hidden sessions"
  else
    tm has-session -t "=$name" 2>/dev/null || {
      echo "mux: no such session: $name" >&2
      exit "$MUX_EX_NONAME"; }
    if [ "$cmd" = hide ]; then
      grep -qxF -- "$name" "$_f" 2>/dev/null \
        || printf '%s\n' "$name" >> "$_f"
      echo "mux: hid $name for this client"
    else
      if [ -f "$_f" ]; then
        grep -vxF -- "$name" "$_f" > "$_f.new" || true
        mv -f "$_f.new" "$_f"
      fi
      echo "mux: showing $name for this client"
    fi
  fi
  tm refresh-client 2>/dev/null || true
  exit 0
  ;;
esac

# --- the session BUILD machinery -------------------------------------------
# ATTACH, THE PROFILE READER AND THE PANE VOCABULARY ARE lib/mux-build_lib
# (2026-10-05): 312 lines that `go`, `new` and `resume` all share, plus the
# geometry a session is built at. Its header says why it is a sourced lib,
# names the ten values from this file it reads and the three functions of
# this file it calls.
#
# SOURCED HERE, UNCONDITIONALLY, which is the whole ordering argument: a
# function is defined when the shell reaches it either way, so sourcing at
# the point these definitions used to sit makes availability identical to
# before by construction, with no verb list to keep correct. The saving is
# still real, because every verb that exits ABOVE this line never reads it:
# ls, reload, theme, why, edit and save, plus every hot path, which leaves
# at the early exec dispatch far above.
[ -r "$MUX_LIB/mux-build_lib" ] || {
  echo "mux: mux-build_lib missing (incomplete install)" >&2
  exit 1; }
# shellcheck source=/dev/null
. "$MUX_LIB/mux-build_lib"

# --- kill --all: tear down every session on the current socket -------------
# No name, and it hits the whole context (personal OR work: whichever socket
# you are on, never both), so it is guarded behind a typed confirmation and
# lists what it will kill first. It must never fire by accident.
cmd_kill_all() {
  _all=$(tm list-sessions -F '#{session_name}' 2>/dev/null || true)
  if [ -z "$_all" ]; then
    echo "mux: no sessions in this context"
    exit 0
  fi
  _n=$(printf '%s\n' "$_all" | wc -l | tr -d ' ')
  printf 'mux: kill ALL %s session(s) on socket "%s":\n' \
    "$_n" "${sock:-default}"
  printf '%s\n' "$_all" | sed 's/^/  /'
  printf 'This cannot be undone. Type yes to confirm: '
  read -r _ans || _ans=
  case $_ans in
    yes|YES|y|Y) ;;
    *) echo "mux: aborted"; exit 0 ;;
  esac
  tm kill-server 2>/dev/null || true
  mux_sess_clear "$part"
  echo "mux: killed all sessions on \"${sock:-default}\""
  exit 0
}

if [ "$cmd" = kill ] && [ "$all" -eq 1 ]; then cmd_kill_all; fi

# --- kill: tear down on whichever socket we resolved -----------------------
# Killing is how you say you are done with a session, so the set forgets it.
# Nothing else prunes: that is the whole reason a snapshot of the live set
# would be wrong.
#
# Which left a hole: the set is pruned ONLY here, and this used to require the
# session to be LIVE. A recorded session whose root has since moved or been
# deleted is already dead, so it could not be killed, and therefore could
# never be forgotten. `mux resume` reported it as unbuildable on every single
# run while offering no way out, and the only real fix was hand-editing
# $MUX_CACHE. So a name that is merely RECORDED is killable too: there is
# nothing to tear down, but saying "I am done with this" is exactly what you
# mean, and it is the same sentence either way.
cmd_kill() {
  if tm has-session -t "=$name" 2>/dev/null; then
    tm kill-session -t "=$name"
    mux_sess_drop "$name" "$part"
    echo "mux: killed $name"
    exit 0
  fi
  if mux_sess_has "$name" "$part"; then
    mux_sess_drop "$name" "$part"
    echo "mux: $name was not running; forgotten (it will no" \
      "longer be resumed)"
    exit 0
  fi
  echo "mux: no such session: $name" >&2
  exit "$MUX_EX_NONAME"
}

if [ "$cmd" = kill ]; then cmd_kill; fi

# --- new: bind a NAME to this project, then build it ------------------------
# The ONE explicit creation verb. `mux go` creates implicitly whenever it can
# point at evidence the target exists: a row, a breakout profile, a scanned
# repo, or the directory you are standing in. `mux go NAME` for a name nothing
# knows is refused, because from the input alone a new session and a typo look
# identical. `mux new NAME` is how you say you meant it.
#
# It writes a row only when one is NEEDED: a name this directory would derive
# anyway is already findable, and config never restates what mux can derive.
cmd_new() {
  if tm has-session -t "=$name" 2>/dev/null; then
    echo "mux: $name is already up (attach it: mux go $name)" >&2
    exit 1
  fi
  if [ "$force" -eq 0 ]; then
    if mux_prof_has "$name" || [ -n "$(mux_prof_find "$name")" ]
    then
      echo "mux: $name already has a profile" \
        "(edit it: mux edit $name, or --force)" >&2
      exit 1
    fi
    # Already discoverable as a DIFFERENT project: binding it here
    # would silently change what `mux go $name` means elsewhere.
    # Binding it to the directory it already means is a harmless
    # no-op, so only a conflicting root is refused.
    _other=$(mux_scan_lookup "$name" "$part" \
      | grep -vxF -- "$base" | head -1)
    if [ -n "$_other" ]; then
      echo "mux: '$name' already means $_other" >&2
      echo "mux: choose another name, or --force to" \
        "rebind it here" >&2
      exit 1
    fi
  fi
  # `new` names THIS DIRECTORY, not the project enclosing it. That is
  # the difference between it and a bare `mux go`, which takes the git
  # toplevel: without it a subdirectory could never get a session of its
  # own, since `mux new waybar` inside a repo would bind the whole repo.
  # Subdirectory sessions stay an outlier, but an outlier mux supports.
  here=$(pwd)
  _derived=$(mux_sess_sanitise "$(basename "$base")")
  if [ "$name" != "$_derived" ] || [ "$here" != "$base" ]; then
    mux_prof_set "$name" root "$(mux_fold_tilde "$here")" || {
      echo "mux: could not write $(mux_prof_file)" >&2
      exit 1; }
    echo "mux: $name -> $(mux_fold_tilde "$here")"
  fi
  base=$here
}

if [ "$cmd" = new ]; then cmd_new; fi

# --- resume: bring back this partition's sessions --------------------------
# THE WHOLE VERB IS lib/mux-resume_lib (2026-10-05). Its header says why it
# is a sourced lib rather than an executed helper (it is the heaviest
# consumer of mux-build_lib there is), and names the six libs it needs, all
# of which are sourced above it.
#
# SOURCED LAZILY, inside the branch: the front end is parsed on every
# invocation and a verb nobody called must not cost a lib.
if [ "$cmd" = resume ]; then
  [ -r "$MUX_LIB/mux-resume_lib" ] || {
    echo "mux: mux-resume_lib missing (incomplete install)" >&2
    exit 1; }
  # shellcheck source=/dev/null
  . "$MUX_LIB/mux-resume_lib"
  mux_resume
fi

# Already running: attach. A live session needs no layout, so this comes before
# any layout resolution. The claude flag shapes a session only as it is built,
# so say so on a resume rather than pretending to honour it on an attach.
if tm has-session -t "=$name" 2>/dev/null; then
  # Two projects whose basename is the same derive the same name, and
  # attaching the wrong one is silent: you land in a live session that
  # looks right and is rooted somewhere else entirely. tmux knows where it
  # was started (#{session_path}), so compare before attaching.
  #
  # Only when the name was DERIVED. A name you typed is a name you meant,
  # and looking a session up by it is what a name argument is for; the
  # guard exists for the case where mux picked the name, not you.
  if [ -z "$name_arg" ] && [ "$attach" -eq 0 ]; then
    # Read via list-sessions rather than `display-message -t
    # "=$name"`: display-message takes a PANE target, where the
    # exact-match `=` prefix yields nothing and session_path comes
    # back EMPTY. Matched on the whole rest of the line, so a root
    # containing a space still compares correctly.
    _live=$(tm list-sessions -F '#{session_name} #{session_path}' \
      2>/dev/null \
      | awk -v n="$name" \
          '$1==n{sub(/^[^ ]* /,""); print; exit}')
    # Only when we actually got one. `readlink -f ""` resolves to
    # the CWD, which would equal the side we are comparing against
    # and quietly disable this whole guard.
    # Resolved on both sides, so a symlinked home does not read
    # as a mismatch.
    _lr=$(readlink -f -- "${_live:-/}" 2>/dev/null \
      || printf '%s' "$_live")
    _hr=$(readlink -f -- "$base" 2>/dev/null \
      || printf '%s' "$base")
    if [ -n "$_live" ] && [ "$_lr" != "$_hr" ]; then
      echo "mux: '$name' is live at" \
        "$(mux_fold_tilde "$_live"), but you are" \
        "in $(mux_fold_tilde "$base")" >&2
      echo "mux:   attach it anyway: mux go $name" \
        "--attach" >&2
      echo "mux:   or name this one: mux new <name>" >&2
      exit 1
    fi
  fi
  [ "$resume" -eq 1 ] && \
    echo "mux: $name already up; --resume applies only at" \
      "build" >&2
  mux_attach
  exit 0          # reached only under --no-attach; otherwise exec'd away
fi

# --attach-only: the session is NOT live, and that is the whole answer. Sited
# here, immediately after the attach branch above, so it cannot be reached by a
# live session and cannot be sidestepped by any later resolution.
#
# WHO ASKS FOR THIS: `mux latch`, on every attempt after the first. A reattach
# that finds nothing means the far side rebooted, and building a fresh empty
# session where the work was is the worst available answer, so latch needs a
# form that REFUSES. The message is matched by latch's classifier, which turns
# it into the `gone` state, so the wording is a contract and not decoration.
if [ "$attachonly" -eq 1 ]; then
  echo "mux: no such session: $name" >&2
  echo "mux:   --attach-only will not create one" >&2
  exit "$MUX_EX_NONAME"
fi

# Building a new session: resolve the blueprint. An explicit PROFILE positional
# wins and must exist (a typo is an error, never a silent fallback); else a
# per-project <name>.profile if there is one.
#
# With NEITHER, mux builds from its own defaults rather than demanding a file:
# the shipped layouts/default arrangement, rooted at the project, themed by the
# global default. That is the whole point of the profile/layout split: a
# profile records a DEVIATION, so needing none is the normal case, and a fresh
# install with an empty $MUX_DIR runs `mux go` with nothing configured at all.
# /dev/null stands in as the empty profile so one code path serves both.
profile=
prow=
if [ -n "$layout_arg" ]; then
  # An explicit PROFILE positional wins and must exist: a typo here is
  # an error, never a silent fallback. It may name a row or a breakout.
  profile=$(mux_prof_find "$layout_arg")
  if [ -z "$profile" ]; then
    mux_prof_has "$layout_arg" && prow=$layout_arg
    [ -n "$prow" ] || {
      echo "mux: no profile: $layout_arg" >&2; exit 1; }
  fi
else
  # A BREAKOUT file wins over a row of the same name. Promotion is meant
  # to delete the row, so a surviving one is stale, and the file is the
  # thing you deliberately promoted. `mux check` reports the pair as
  # drift rather than leaving it to precedence.
  profile=$(mux_prof_find "$name")
  if [ -z "$profile" ] && mux_prof_has "$name"; then prow=$name; fi
fi
case $profile in *.layout)
  echo "mux: $profile is a pre-rename layout file; rename it to" \
    "${profile%.layout}.profile (see: mux check)" >&2 ;;
esac

# Does anything we found already declare a root? If so the map is irrelevant.
hasroot=0
if [ -n "$prow" ] && [ -n "$(mux_prof_get "$prow" root)" ]; then hasroot=1; fi
if [ -n "$profile" ] \
   && grep -qE '^[[:space:]]*root[[:space:]]' "$profile" 2>/dev/null; then
  hasroot=1
fi

# A DERIVED name that collides with a profile meaning somewhere ELSE. Exactly
# the live-session guard one step earlier: a name mux picked FOR you must not
# silently resolve to a different place. Standing in ~/src/manifest and getting
# a session rooted at ~/src/work/PlatformOS (because the directory's
# basename happens to match an unrelated profile) is a surprise, not a
# service. A name you TYPED is still trusted, since looking a profile up by
# name is what a name argument is for.
if [ -z "$name_arg" ] && [ "$cmd" != new ] && [ "$bypath" -eq 0 ]; then
  _cr=$(_profile_root "$name")
  if [ -n "$_cr" ]; then
    _crx=$(readlink -f -- "$(mux_expand_tilde "$_cr")" \
      2>/dev/null || true)
    _bsx=$(readlink -f -- "$base" 2>/dev/null \
      || printf '%s' "$base")
    if [ -n "$_crx" ] && [ "$_crx" != "$_bsx" ]; then
      echo "mux: '$name' already means" \
        "$(mux_fold_tilde "$_cr")," \
        "but you are in $(mux_fold_tilde "$base")" >&2
      echo "mux:   that project:     mux go $name" >&2
      echo "mux:   this one, named:  mux new <name>" >&2
      exit 1
    fi
  fi
fi

# A TYPED name means "that project", not "wherever I happen to be standing", so
# its root comes from the discovery map. Bare `mux go` never gets here: the
# directory is the answer, and there was no name to have mistyped.
if [ -n "$name_arg" ] && [ "$bypath" -eq 0 ] && [ "$cmd" != new ] \
   && [ "$hasroot" -eq 0 ]; then
  # The session set first, then the map: the precedence lives in
  # mux_resolve_typed_roots, which `mux why` reads too so the two cannot drift.
  hits=$(mux_resolve_typed_roots "$name" "$part" | cut -f2)
  nhit=$(printf '%s\n' "$hits" | grep -c . || true)
  if [ "$nhit" -eq 1 ]; then
    base=$hits
  elif [ "$nhit" -gt 1 ]; then
    echo "mux: '$name' is ambiguous ($nhit projects share it):" >&2
    printf '%s\n' "$hits" | sed 's/^/         /' >&2
    echo "mux: name one of them:  cd <dir> && mux new <alias>" >&2
    exit 1
  elif [ -z "$prow$profile" ]; then
    # Step 5: nothing knows this name, so "new session" and "typo"
    # are indistinguishable. Refuse, and hand over both fixes.
    echo "mux: nothing known as '$name'" >&2
    if [ -z "$(mux_scan_roots)" ]; then
      # "I never looked" is a different failure from "I
      # looked and did not find it", and suggesting a typo
      # correction when discovery is off is misleading.
      echo "mux:   discovery is off for partition" \
        "'$MUX_CTX_PARTITION' (no scan roots)" >&2
      echo "mux:   configure one: a 'scan <dir>' line in" \
        "partitions/$MUX_CTX_PARTITION.partition" >&2
    else
      near=$(mux_scan_near "$name" "$MUX_CTX_PARTITION" \
        | tr '\n' ' ')
      [ -n "$near" ] && \
        echo "mux:   did you mean:      $near" >&2
    fi
    echo "mux:   or create it here:  mux new $name" >&2
    exit "$MUX_EX_NONAME"
  fi
fi

# A row is materialised as the same `key value` stream a breakout file holds,
# so there is one parse path below whichever form the profile was stored in.
plabel=$profile
if [ -n "$prow" ]; then
  profile=$(mktemp) || { echo "mux: mktemp failed" >&2; exit 1; }
  mux_prof_directives "$prow" >"$profile" || exit 1
  plabel="$(mux_prof_file) [$prow]"
fi
: "${profile:=/dev/null}"
: "${plabel:=$profile}"

# Flatten includes into one directive stream, then parse it TWICE: first to
# resolve the session-wide root/theme and validate the whole shape (touching
# no tmux state), then to build. A malformed layout (or a missing or cyclic
# include), fails before any session exists, never leaving a half-built one,
# and root/theme are position-independent (last one wins).
flat=$(mktemp) || { echo "mux: mktemp failed" >&2; exit 1; }
trap 'rm -f "$flat"' EXIT
expand_profile "$profile" "$plabel" >"$flat"

# Pass 1: resolve root (default the project; a leading ~ expands) and theme,
# each last-wins across the profile, and validate structure. window/pane/bottom
# are checked only here; the build pass trusts what got through. `layout` never
# reaches this stream: expand_profile consumed it to pick the layout file.
root=$base
want_theme=
want_notify=
want_agent=
v_win=0
v_panes=0
v_bottom=0
while read -r verb rest; do
  case $verb in
  root)
    root=$(expand_tilde "$rest")
    [ -d "$root" ] || {
      echo "mux: root not a dir: $root" >&2
      exit 1
    }
    ;;
  theme)
    want_theme=$rest
    ;;
  agent)
    want_agent=$rest
    ;;
  notify)
    case $rest in
    always|away) want_notify=$rest ;;
    *)
      echo "mux: 'notify' wants always|away: $rest" >&2
      exit 1 ;;
    esac
    ;;
  window)
    v_win=1
    v_panes=0
    v_bottom=0
    ;;
  pane)
    [ "$v_win" -eq 1 ] || {
      echo "mux: 'pane' before 'window' in $profile" >&2
      exit 1
    }
    # even-horizontal at build would flatten a bottom pane back
    # into the row, so refuse the order that would wreck it.
    [ "$v_bottom" -eq 0 ] || {
      echo "mux: 'pane' after 'bottom' in $profile" >&2
      exit 1
    }
    v_panes=$((v_panes + 1))
    ;;
  control|attention)
    # TWO MARKERS, ONE GRAMMAR, and the directive name IS the option suffix
    # (`control` -> `@mux-control`), so a third pane class costs one word
    # here. SHARING THE ARM IS NOT FUSING THE CONCEPTS: they answer different
    # questions and are read by different consumers (`control` by the send
    # gate, `attention` by the strip, the notification path and
    # `next-blocked`), which is the whole point of their being two. They
    # merely happen to take the same three words today. If one ever gains a
    # value the other must not, split this arm; nothing else here couples
    # them.
    #
    # QUALIFIES THE PANE JUST DECLARED, which is the shape `bottom` already
    # uses, because `pane`'s argument is the COMMAND and a modifier cannot
    # ride it without colliding with an arbitrary command line.
    #
    # WHY MUX WRITES THIS AT ALL, when `libexec/mux-agent` reads it and
    # nothing wrote it before: the send policy's whole vocabulary is
    # `control:agent`, and with no producer that grant was unreachable, so a
    # root-owned line nobody could satisfy. A seam nobody can cross for you
    # is not a seam, it is a gap, which is the argument `mux setup claude`
    # already makes about another program's config.
    #
    # A DECLARATION, NEVER AN INVENTION. The creator of a pane says what the
    # pane is for; mux records it and classifies nothing on its own. That is
    # also the line that keeps this safe: there is deliberately no way here
    # to reclassify a pane somebody else created.
    [ "$v_panes" -gt 0 ] || {
      echo "mux: '$verb' with no pane in $profile" >&2
      exit 1
    }
    # REFUSED AFTER `bottom` for the same reason `pane` is: the builder
    # qualifies the pane it last created, and after a bottom that is no
    # longer the pane a reader of this file would expect. Silently marking
    # the wrong pane is the failure this package keeps paying for.
    [ "$v_bottom" -eq 0 ] || {
      echo "mux: '$verb' after 'bottom' in $profile" >&2
      exit 1
    }
    # THE VOCABULARY LIVES IN `mux-class_lib` NOW, with its ORDERING, because
    # `mux agent class` needs the direction and three copies of a word list
    # with a direction attached is how the three disagree. `mux-agent`'s
    # `agent|hybrid` is still NOT a shorter spelling of it: that is the
    # narrower set a POLICY may grant, since `human` is refused before the
    # policy file is read at all.
    mux_class_valid "$rest" || {
      echo "mux: '$verb' wants human|agent|hybrid: $rest" >&2
      exit 1; }
    ;;
  bottom)
    [ "$v_panes" -gt 0 ] || {
      echo "mux: 'bottom' with no pane in $profile" >&2
      exit 1
    }
    [ "$v_bottom" -eq 0 ] || {
      echo "mux: two 'bottom' in one window in $profile" >&2
      exit 1
    }
    bottom_spec "$rest" || exit 1
    v_bottom=1
    ;;
  include)
    echo "mux: 'include' was replaced by 'layout <name>' in a" \
      "profile: $profile" >&2
    echo "mux: convert it:  mux-migrate-profiles" >&2
    exit 1
    ;;
  *)
    echo "mux: unknown directive: $verb in $profile" >&2
    exit 1
    ;;
  esac
done <"$flat"

# $plabel, not $layout: nothing ever assigned `layout`, so under set -u
# this error path aborted with "layout: parameter not set" instead of
# saying which profile was empty: a broken message on an error path,
# which is where a clear one matters most.
[ "$v_win" -eq 1 ] || {
  echo "mux: empty layout: $plabel" >&2; exit 1; }

# An explicit `theme` overrides the per-mode default (cosmetic; mux-style
# resolves the default otherwise). Validate before building, so a typo fails
# with a clear message rather than mux-style erroring on every status tick.
# Validate against the FRAGMENT FILE, not the loaded @theme-* option: on a cold
# socket the server (and its options) does not exist until pass 2 builds it, so
# an option check would spuriously reject every theme on the first `mux go`
# after boot/kill-all. The file is the source of truth, and its presence
# guarantees mux-themes load will push @theme-<name>-* at server start.
if [ -n "$want_theme" ]; then
  [ -n "$(mux_data_find themes "$want_theme" .theme)" ] || {
    echo "mux: unknown theme: $want_theme" \
      "(see: mux help colors)" >&2
    exit 1
  }
fi

# The session's agent (for `pane agent`): the layout's `agent` directive, else
# claude. Validate the profile exists here so a typo fails at build with a clear
# message, not later as an empty pane command.
if [ -n "$want_agent" ]; then
  [ -n "$(_find_agent "$want_agent")" ] || {
    echo "mux: unknown agent: $want_agent" \
      "(see: mux help agents)" >&2
    exit 1
  }
fi
# The context's agent, then mux's built-in. `agent` is a documented context
# key; it did nothing until now, which is the asserted-vs-actual drift this
# project exists to avoid.
active_agent=${want_agent:-${MUX_CFG_agent:-claude}}

# No `theme` in the profile: derive one from the session name, when
# the resolved context says to (`derive hash`). A profile that pins a colour
# still wins; this only fills the gap that used to send every unconfigured
# session to the same default, which is what made pinning a colour the single
# most common reason to write a profile at all.
if [ -z "$want_theme" ]; then
  if [ -n "$MUX_CFG_theme" ]; then
    want_theme=$MUX_CFG_theme          # a context said so
  elif [ "${MUX_CFG_derive:-hash}" = hash ]; then
    want_theme=$(mux_resolve_hash_theme "$name")  # nobody did; derive one
  else
    want_theme=$MUX_THEME_FALLBACK
  fi
fi

# Pass 2: build. Everything is validated, so this only executes; using the
# now-final root for every pane's -c, wherever root sat in the source.
# The geometry a session is BUILT at (`-x W -y H`, or empty with no
# terminal to ask) lives in lib/mux-build_lib with the rest of the build,
# sourced below. Its header carries the rescale story that made it exist.
_geom=$(_session_geometry)

have_session=0
firstwin=
firstpane=
agentwin=
agentpane=
win=
paneseen=0
# bottom_spec ANSWERS in b_min/b_max/b_cmd, because POSIX sh cannot return
# three fields; its arm below reads all three. See mux-build_lib's header.
# shellcheck disable=SC2154
while read -r verb rest; do
  case $verb in
  window)
    if [ "$have_session" -eq 0 ]; then
      # shellcheck disable=SC2086
      tm new-session -d $_geom -s "$name" -n "$rest" \
        -c "$root"
      have_session=1
      # AFTER the create, not before: this is the call that brings the
      # server into existence, and the wiring probe deliberately does
      # not. Everything built below (the layout, the theme, the agent
      # panes) then runs against a server that has mux's hooks.
      mux_wire || true
      # AND THE ENVIRONMENT, before anything is built in the session:
      # the agent panes below inherit it, and a pane environment is
      # fixed at exec, so after the build is too late for them.
      mux_env_ensure "$name" || true
      win=$(tm display-message -p -t "$name:" \
        '#{window_index}')
      firstwin=$win
      firstpane=$(tm display-message -p -t "$name:" \
        '#{pane_id}')
    else
      tm new-window -a -t "$name:" -n "$rest" -c "$root"
      win=$(tm display-message -p -t "$name:" \
        '#{window_index}')
    fi
    paneseen=0
    ;;
  pane)
    # Run the command AS the pane's process, never typed in, so it
    # cannot race shell startup. The first pane reuses the shell the
    # window opened with (respawn); the rest are fresh splits.
    proc=$(pane_process "$rest")
    if [ "$paneseen" -gt 0 ]; then
      tm split-window -h -t "$name:$win" -c "$root" "$proc"
      tm select-layout -t "$name:$win" even-horizontal
      thispane=$(tm display-message -p -t "$name:$win" \
        '#{pane_id}')
    else
      tm respawn-pane -k -t "$name:$win" -c "$root" "$proc"
      thispane=$(tm display-message -p -t "$name:$win" \
        '#{pane_id}')
    fi
    # Remember the FIRST agent pane, so the session opens ON the
    # agent: it is the pane you came to look at, and landing left of
    # it cost a keystroke on every single launch. A `pane <name>`
    # that names an agent counts too. Falls back to the first pane
    # when a layout has no agent at all.
    _isagent=0
    case $rest in
    agent) _isagent=1 ;;
    *) [ -n "$(_find_agent "${rest%% *}")" ] && _isagent=1 ;;
    esac
    if [ "$_isagent" -eq 1 ]; then
      # Marked on the PANE, the same way a bottom pane carries
      # @mux-bottom. Without it `mux save` cannot tell the
      # agent pane from any other: it reads the running
      # command, and an agent that has exited (or was never
      # installed) just looks like a shell, so a round trip
      # would quietly turn `pane agent` into a bare `pane`.
      tm set-option -p -t "$thispane" @mux-agent 1
      [ -n "$agentpane" ] || { agentwin=$win
        agentpane=$thispane; }
    fi
    paneseen=$((paneseen + 1))
    ;;
  control|attention)
    # THE VALIDATOR ABOVE READS THE SAME `$flat` AND RUNS FIRST, so a pane
    # precedes this and the value is one of the three. Re-checking here would
    # be a second guard for one condition, which makes NEITHER killable: this
    # package has measured that twice and deleted the redundant half both
    # times.
    tm set-option -p -t "$thispane" "@mux-$verb" "$rest"
    ;;
  bottom)
    # N pins the height; MIN-MAX tracks the window between those
    # bounds. Either way the size is recorded on the pane and
    # re-applied by mux-pin, because tmux rescales panes
    # proportionally on resize and would otherwise inflate this one
    # well past its split height.
    bottom_spec "$rest" || exit 1
    # -f spans the full window width, so the new pane sits under
    # every pane above rather than splitting only the active one. A
    # command runs as the pane's process; with none it is a shell.
    bproc=
    [ -n "$b_cmd" ] && bproc=$(pane_process "$b_cmd")
    # THE TWO ARMS WRAP DIFFERENTLY ON PURPOSE, and this is not a style
    # choice to harmonise away: wrapped identically they were the SAME LINE
    # TWICE, each ending in a continuation, so the height that reaches tmux
    # could not be a mutation anchor at all (the corpus refuses a target
    # that is ambiguous OR a line continuation, and this was both). The
    # `else` arm is one line now, which is what `bottom-built-at-the-min`
    # anchors on.
    #
    # THE COLLAPSE WAS THE OTHER OPTION AND WAS REFUSED. `set -- -v -f -l
    # "$b_max" ...` then one call reads better and is MEASURABLY safe today
    # (nothing after this loop reads the script's positionals), but it
    # mutates the SCRIPT's `$@` from the middle of the build path to buy a
    # local convenience, and "nothing reads them later" is a whole-file
    # property that rots the first time somebody appends a line.
    if [ -n "$bproc" ]; then
      tm split-window -v -f -l "$b_max" -t "$name:$win" \
        -c "$root" "$bproc"
    else
      tm split-window -v -f -l "$b_max" -t "$name:$win" -c "$root"
    fi
    bpane=$(tm display-message -p -t "$name:$win" '#{pane_id}')
    tm set-option -p -t "$bpane" @mux-bottom "$b_min-$b_max"
    ;;
  esac
done <"$flat"

rm -f "$flat"
trap - EXIT

# Apply the validated theme now that the session exists.
[ -n "$want_theme" ] && tm set-option -t "$name" @mux-theme "$want_theme"

# `notify always` fires the agent notification even while you are looking at the
# pane; `away` (also the default when unset) suppresses it then. Read by
# mux-agent-state-emit as @mux-notify-always.
if [ "$want_notify" = always ]; then
  tm set-option -t "$name" @mux-notify-always 1
elif [ "$want_notify" = away ]; then
  tm set-option -t "$name" @mux-notify-always 0
fi

# Land on the agent pane if the layout has one, else the first pane (by id, so
# base-index is irrelevant). Selecting the agent's WINDOW too, since an agent in
# a later window is still the thing you opened the session for.
tm select-window -t "$name:${agentwin:-$firstwin}"
tm select-pane -t "${agentpane:-$firstpane}"

mux_attach
