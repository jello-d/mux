#!/bin/sh
# mux: the single front end to tmux: bring up, tear down, list, and reload
# sessions without ever touching tmux directly. A session is an identity (its
# name, used to resume) and a shape (a layout, used only to build it the first
# time); the two are separate, so naming a session needs no layout and resuming
# a live one reads none.
#
#   mux                    with no verb: pick a session to attach (fzf, else a
#                          numbered menu); one session attaches straight away.
#   mux go [NAME] [LAYOUT]
#       create if missing, then attach (switch if already inside tmux). The
#       claude pane runs `claude --continue || claude`: pick up where you left
#       off, or start fresh when there is nothing to continue.
#   mux go --resume [NAME] [LAYOUT]
#       same, but `claude --resume` (choose a conversation). This was once the
#       bare verb `mux resume`; that name now belongs to the session rebuild
#       below, which is the thing you reach for after a reboot.
#   mux resume [PARTITION [SESSION]]
#                          rebuild every session this partition had (--list to
#                          see them without building). The set is recorded as
#                          you open sessions, so the bare form needs no
#                          arguments: it always takes the partition you are
#                          in. PARTITION names another one (`global` is the
#                          baseline, and the reserved word for "not the one my
#                          context resolved"); SESSION is only where to focus
#                          afterwards, since a resume rebuilds them all.
#   mux kill NAME          tear the named session down.
#   mux kill-all           tear down EVERY session on this socket (prompts).
#   mux reload             re-source tmux.conf on every running mux server.
#   mux ls                 list sessions in the current context.
#   mux new [NAME] [COLOR] [ROOT]
#                          write a <NAME>.profile. NAME
#                          and ROOT default to the project (the git toplevel,
#                          else the cwd: the same derivation go uses); ROOT
#                          takes '-' to omit it, COLOR defaults to the
#                          per-context default. --force to overwrite.
#                          It lands in the (dir-linked) mux dir, so it shows as
#                          git drift: commit to keep, or delete.
#   mux save [NAME]        snapshot the CURRENT session into a <NAME>.profile
#                          plus the <NAME>.layout it names; pane commands are
#                          best-effort. --force to overwrite.
#   mux hide SESSION       hide SESSION from THIS client's status strip and
#                          ( / ) cycling; mux show SESSION restores it, mux
#                          show-all clears this client's hides. Per client
#                          (per attachment); must run inside a session.
#     --bare (-b)          with go/resume: bring up WITHOUT launching claude
#                          (the claude pane is a plain shell).
#
# A verb, or none for the session picker. For go/resume, NAME defaults to the
# project (git toplevel basename, else cwd basename); kill requires it
# explicitly. PROFILE is the third token; with none, a per-project
# <NAME>.profile is used if one exists, else mux's built-in defaults.
#
# Idempotent: `go`/`resume` on a live session just attaches, never clobbers.
#
# A non-default CONTEXT is a separate namespace. When the context hook reports a
# socket (see mux-context_lib), mux drives a tmux server on that socket and sees
# only that context's sessions; otherwise the default socket. The same name can
# live in both, mutually invisible. mux never establishes a context itself (it
# runs in whatever the hook observes), so an integrator can back a context with
# real isolation (a Unix group, a namespace) and mux just reflects it. `ls`
# lists only the context you are in; `reload` freshens EVERY server (the config
# is shared), so a single reload from any pane updates everything.
#
# A PROFILE is the session: its identity and appearance. It lives in $MUX_DIR
# (default ~/.config/mux) as <name>.profile, and the FILENAME is the session
# name. Directives, one per line, all optional:
#   root   DIR           working dir for the session (a leading ~ expands);
#                        defaults to the project mux was invoked in
#   theme  NAME          colour theme (a themes/NAME.theme fragment: purple,
#                        orange, cyan, green, slate, red, ...). Cosmetic only.
#   agent  NAME          the agent a `pane agent` runs (an agents/NAME.agent:
#                        claude, gemini, ...), default claude. go and resume use
#                        that agent's own continue/resume command.
#   notify always|away   whether the agent notification (see
# mux-agent-state-emit)
#                        fires while you are LOOKING at the pane: `away` (the
#                        default) suppresses it then, `always` fires anyway.
#   layout NAME          the pane ARRANGEMENT to build (a layouts/NAME.layout),
#                        default `default`.
#
# A LAYOUT is the arrangement, and nothing else: layouts/<name>.layout, in
# $MUX_DIR or shipped in $MUX_SHARE. Directives:
#   window NAME          start a new window; the first opens the session
#   pane   CMD [ARG...]  add a pane running CMD; `pane agent` runs the session's
#                        agent (shaped by go/resume), `pane <name>` a specific
#                        agent, anything else runs literally. A bare `pane` is a
#                        plain shell.
#   control CLASS        declare who may TYPE into the pane just above:
#                        human (the default, and refused to every sender),
#                        agent (an orchestrated worker, grantable as a class
#                        by /etc/mux/send-policy) or hybrid. mux records what
#                        you declare and classifies nothing itself.
#   bottom SIZE [CMD]    add a pane spanning the full width below the panes of
#                        the current window; must come after them. SIZE is N to
#                        pin the height, or MIN-MAX to track the window between
#                        those bounds. Held there by mux-pin on every resize.
# Blank lines and lines beginning with # are ignored.
#
# The two files are kept apart deliberately: an arrangement directive in a
# profile, or an identity directive in a layout, fails loud rather than
# half-working. So the same layout serves every profile that names it, which is
# what `include` used to approximate.
#
# The profile and its layout are parsed and VALIDATED together before any tmux
# call, so a malformed pair builds nothing. root and theme are resolved for the
# session as a whole: last one wins, position irrelevant; window/pane/bottom
# build the arrangement in the order they appear.
set -eu

# The ONE version string. The man page footer and `mux --version` both read it
# from here, so they cannot drift apart the way a hardcoded "mux 0.1" in the
# man page already had.
MUX_VERSION=0.86

# EXIT 3: THE NAME IS NOT KNOWN HERE. One CONDITION, six verbs (go, kill,
# rename, hide, show, why), one code: a caller should not learn six spellings
# of the same answer.
#
# IT REPLACES A STRING CONTRACT WITH A NUMERIC ONE, which is the win. `mux
# latch` used to grep stderr for "no such session", so a message's WORDING was
# load-bearing across two files and a test existed only to hold it still. A
# code cannot be reworded.
#
# THE SMALL SET IS THE POINT: mux emits only 0, 1, 2 and 3, so 126, 127 and
# 255 stay unambiguously NOT mux. A caller that knows only 0/1/2 is still
# right, since 3 is non-zero and the reason is on stderr.
MUX_EX_NONAME=3

# 4 = NOT READY YET, TRY AGAIN. Second cross-cutting condition, same argument
# as 3: a decision on another machine must not rest on a message's wording.
#
# FOR THE LATCH-AFTER-A-REBOOT CASE. A host with no server for this partition
# and declared session pointers that have not arrived refuses, rather than
# rebuilding every session into an environment that is still starting. The
# client owns waiting, bounding and reporting; the host says "not yet" and
# stays stateless.
#
# THE RETRY IS THE MECHANISM, which is why a code beats blocking: each attempt
# is a NEW remote process with a new login shell, so it re-reads the
# environment instead of remembering one. Re-derive, never remember, falling
# out of the shape.
#
# AND IT DEGRADES BOTH WAYS WITH NO NEGOTIATION: a latch that does not know 4
# falls through to `unknown` and RETRIES, which is what you want anyway, and
# an older remote never emits it.
MUX_EX_NOTREADY=4

MUX_DIR=${MUX_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/mux}
TMUX_CONF=${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux.conf

# Find our own libexec (the helper executables + the sourced *_lib files),
# computed from this script's RESOLVED location: no hardcoded path, no env
# seam. $0 may be a bare name (a PATH lookup: how tmux run-shell and the agent
# hooks invoke us), relative, or absolute, and may arrive through symlinks
# (~/.local/bin/mux is a symlink to the install); resolve all of it. bin/,
# libexec/ and share/ are siblings under one prefix, as in a package install.
_self=$0
case $_self in
*/*) ;;
*) _self=$(command -v -- "$_self" 2>/dev/null || echo "$_self") ;;
esac
# `readlink -f` IN ONE PROCESS WHERE IT EXISTS, a POSIX loop where it does not.
# macOS had no `readlink -f` until 12.3, and the old `|| echo "$_self"` fallback
# was silently WRONG rather than merely unresolved: through the install symlink
# (~/.local/bin/mux) an unresolved $0 makes the prefix ~/.local, so LIBEXEC
# became ~/.local/libexec while setup.sh installs the namespaced
# ~/.local/libexec/mux. mux then could not find its own libraries and blamed the
# install ("missing (incomplete install)"). Reproduced on Linux by stubbing a
# readlink that rejects -f, which is how test/mux-portability.t pins it.
#
# THE FAST PATH IS FIRST because this runs on every status-bar tick and every
# agent hook: where `readlink -f` works, this is the one fork it always was.
if _r=$(readlink -f -- "$_self" 2>/dev/null) && [ -n "$_r" ]; then
  _self=$_r
else
  # One `readlink` per link in the chain. Only the FINAL component is resolved,
  # which is what the install layout needs (bin/mux is the symlink); a directory
  # symlink higher up resolves to the same tree either way. Bounded, because a
  # symlink loop must not hang the status bar: `readlink -f` errors on one and
  # so must this.
  _n=0
  while [ -L "$_self" ] && [ "$_n" -lt 40 ]; do
    _t=$(readlink -- "$_self" 2>/dev/null) || break
    [ -n "$_t" ] || break
    case $_t in
    /*) _self=$_t ;;
    *)  _self=${_self%/*}/$_t ;;
    esac
    _n=$((_n + 1))
  done
fi
LIBEXEC=${_self%/*}/../libexec
MUX_LIB=${_self%/*}/../lib
# Package DATA, the shipped defaults (themes, agents, shapes, the default
# layout), lives in share, a sibling of bin/ and libexec/ under the prefix.
# User layouts and the integrator OVERLAY (context, hosts) live in $MUX_DIR.
#
# Respect an exported $MUX_SHARE ONLY while it points at a real directory. A
# stale one (inherited from a long-running tmux server whose install has since
# moved) would send every include and theme lookup to a dead path. Unset or
# dangling, self-locate the sibling share/.
if [ -n "${MUX_SHARE:-}" ] && [ -d "$MUX_SHARE" ]; then :   # a valid override
else MUX_SHARE=${_self%/*}/../share
fi
export MUX_DIR MUX_SHARE   # the helper verbs (mux themes ...) inherit both

# THE CAPABILITY MANIFEST MOVED to libexec/mux-capabilities (2026-10-05). It
# sat here, ABOVE the dispatch, so every hot-path invocation parsed 153 lines
# it never called: the dispatch's promise below was true only of what came
# after it. The VERB LISTS stayed, because test/mux-capabilities.t scrapes
# both `case` blocks in THIS file to prove every verb is classified.

# Fast path: the helper verbs ARE standalone executables in libexec, and the
# tmux fragment + agent hooks reach them as `mux <verb>` (one entry point, on
# PATH: no path knowledge in the caller). exec straight through, so this
# script is never parsed past here on a hot path: the status bar runs `mux
# style` / `mux agent-render` every tick and the agent hooks fire `mux
# agent-emit` on every state change. Each helper self-locates its own siblings.
#
# AND THAT DISPATCH IS WHY EVERY `*_lib` BELOW IS SOURCED WHERE IT IS USED,
# never at the top. Stated once here; each banner names only its own part:
#
#   in a verb's BRANCH   a verb nobody called must not cost a lib.
#   UNCONDITIONALLY, at  where several paths need it (args, build, go). A
#   the old code's spot  function is defined when the shell reaches it
#                        either way, so availability is identical to before
#                        BY CONSTRUCTION, with no verb list to keep correct.
#
# Each site guards on `-r` and says "incomplete install", or a lost lib is
# the shell's wording and a code nobody chose.
case ${1:-} in
cycle)         shift; exec "$LIBEXEC/mux-cycle" "$@" ;;
click)         shift; exec "$LIBEXEC/mux-click" "$@" ;;
refresh)       shift; exec "$LIBEXEC/mux-refresh" "$@" ;;
pin)           shift; exec "$LIBEXEC/mux-pin" "$@" ;;
landing)       shift; exec "$LIBEXEC/mux-landing" "$@" ;;
style)         shift; exec "$LIBEXEC/mux-style" "$@" ;;
status-banner) shift; exec "$LIBEXEC/mux-status-banner" "$@" ;;
agent-render)  shift; exec "$LIBEXEC/mux-agent-state-render" "$@" ;;
agent-emit)    shift; exec "$LIBEXEC/mux-agent-state-emit" "$@" ;;
agent-summary) shift; exec "$LIBEXEC/mux-agent-state-summary" "$@" ;;
agent-list) shift; exec "$LIBEXEC/mux-agent-state-list" "$@" ;;
themes)        shift; exec "$LIBEXEC/mux-themes" "$@" ;;
check)         shift; exec "$LIBEXEC/mux-check" "$@" ;;
next-blocked)  shift; exec "$LIBEXEC/mux-next-blocked" "$@" ;;
migrate-profiles) shift; exec "$LIBEXEC/mux-migrate-profiles" "$@" ;;
scan)          shift; exec "$LIBEXEC/mux-scan" "$@" ;;
views)         shift; exec "$LIBEXEC/mux-views" "$@" ;;
agent-doctor)  shift; exec "$LIBEXEC/mux-agent-doctor" "$@" ;;
latch)         shift; exec "$LIBEXEC/mux-latch" "$@" ;;
sane)          shift; exec "$LIBEXEC/mux-sane" "$@" ;;
agent-hook)    shift; exec "$LIBEXEC/mux-agent-hook" "$@" ;;
# Called only from the client-detached hook in share/mux.tmux, with the tty
# that hook recorded at attach time. Silent when there is nothing queued,
# which is most detaches.
notice-flush)  shift; exec "$LIBEXEC/mux-notice-flush" "$@" ;;
update-env)    shift; exec "$LIBEXEC/mux-update-env" "$@" ;;
# THE MACHINE CONTRACT, and a MODE SWITCH rather than a verb: everything under
# `mux agent` answers JSON on stdout, always, including on failure. The
# hyphenated `agent-*` verbs above are mux's own plumbing (called by tmux
# hooks, the status bar and the tray), and mean "about agent state", which is
# a different thing from "for an agent to call".
agent)         shift; exec "$LIBEXEC/mux-agent" "$@" ;;
# NOT `mux agent skill`: that surface promises one JSON object on stdout, and
# a verb printing markdown would make the promise a convention with an
# exception. This one is for a human or a provisioner, run once.
skill)         shift; exec "$LIBEXEC/mux-skill" "$@" ;;
# THE ONE VERB THAT WRITES SOMEBODY ELSE'S CONFIG, which every other part of
# mux refuses to do. Confined here because the step it performs is the one a
# seam cannot cover: an agent that is never told to report is a strip full of
# "no agent" glyphs and a user who concludes mux does not work.
setup)         shift; exec "$LIBEXEC/mux-setup" "$@" ;;
demo)          shift; exec "$LIBEXEC/mux-demo" "$@" ;;
keys)          shift; exec "$LIBEXEC/mux-keys" "$@" ;;
capabilities)  shift; exec "$LIBEXEC/mux-capabilities" "$@" ;;
even)          shift; exec "$LIBEXEC/mux-even" "$@" ;;
window)        shift; exec "$LIBEXEC/mux-window" "$@" ;;
undo-pane)     shift; exec "$LIBEXEC/mux-undo-pane" "$@" ;;
host-color)    shift; exec "$LIBEXEC/mux-host-color" "$@" ;;
log)           shift; exec "$LIBEXEC/mux-log" "$@" ;;
esac

# The ONE comment/normalize rule (mux_conf_clean) for every config parse below:
# layouts, themes, agents. Core, so sourced unconditionally (it deploys with
# mux); a fallback keeps mux alive if the lib is somehow missing, stripping only
# whole-line comments (the pre-normalizer behaviour) so nothing hard-breaks.
_conf_lib=$MUX_LIB/mux-conf_lib
if [ -r "$_conf_lib" ]; then . "$_conf_lib"
else mux_conf_clean() { grep -vE '^[[:space:]]*(#|$)'; }
fi

# The ONE $MUX_DIR-over-$MUX_SHARE rule (mux_data_find / _stems / _files) for
# every package-data read below: layouts, shapes, themes, agent profiles. No
# fallback here, unlike mux_conf_clean above: a normalizer has a safe degraded
# mode, a data resolver has none (it would silently resolve nothing), so a
# missing lib is a broken install and says so.
# NO LIB SOURCES ANOTHER, so the order in this list IS the dependency graph,
# and every lib declares what it needs in its own header for a caller to
# supply. The reason is a fact about the language rather than a house rule: a
# sourced POSIX sh file sees the CALLER'S `$0` (measured in dash, bash and
# ksh), so it cannot locate a sibling to source. mux-resolve_lib comes LAST
# because it calls into mux-data_lib, mux-scan_lib and mux-sessions_lib.
for _l in mux-paths_lib mux-data_lib mux-profiles_lib mux-scan_lib \
    mux-sessions_lib mux-class_lib mux-log_lib mux-resolve_lib; do
  [ -r "$MUX_LIB/$_l" ] || {
    echo "mux: $MUX_LIB/$_l missing (incomplete install)" >&2
    exit 1; }
  . "$MUX_LIB/$_l"
done

# The shared agent-state reader (also used by the status strip) lets the session
# picker and `mux ls` show each session's agent glyph. Cosmetic, so a missing
# lib degrades to plain names rather than taking down core verbs (kill, reload).
_have_astate=0
_astate_lib=$MUX_LIB/mux-agent-state_lib
if [ -r "$_astate_lib" ]; then . "$_astate_lib"; _have_astate=1; fi

# The CONTEXT seam: mux core knows no particular notion of "context" (a
# work/personal split, a namespace, a git host, ...). mux-context_lib asks an
# optional $MUX_DIR/context hook and falls back to a single default context.
# Core, so sourced unconditionally; a stub keeps every consumer working if the
# lib is missing (default socket, side `default`, all layouts shared, no socks).
_ctx_lib=$MUX_LIB/mux-context_lib
if [ -r "$_ctx_lib" ]; then . "$_ctx_lib"
else
  mux_ctx_resolve() { MUX_CTX_TOKEN=global; MUX_CTX_PARTITION=global
    MUX_CTX_UNKNOWN=0; MUX_CTX_ERR=
    MUX_CFG_label=''; MUX_CFG_theme=''; MUX_CFG_derive=hash
    MUX_CFG_agent=claude; MUX_CFG_layout=default
    MUX_CFG_host_chip=on; MUX_CFG_scan=''; }
  mux_ctx_socket() { printf '%s' "${1:-global}"; }
  mux_ctx_partitions() { echo global; }
fi

# The root a profile declares, whichever form it is in. Empty when it declares
# none (the session then roots where it is launched).
_profile_root() {   # <name>
  _r=$(mux_prof_get "$1" root)
  if [ -z "$_r" ]; then
    _pf=$(mux_prof_find "$1")
    [ -n "$_pf" ] && _r=$(mux_conf_clean <"$_pf" \
      | awk '$1=="root"{print $2; exit}')
  fi
  printf '%s' "$_r"
}


# usage IS A ONE-LINE SHIM over libexec/mux-help, which holds the only copy of
# the text and the two list helpers it shares with the topics. It EXECS, so it
# never returns, which is what every error path below already relied on: each
# ends with `usage` and its own exit code. Written as a function rather than 21
# inline execs on purpose, because a path repeated at every call site is the
# duplication this split was removing, one layer out.
usage() { exec "$LIBEXEC/mux-help" --usage "${1:-2}"; }

# --- options and the verb in either order, then positionals ----------------
# ONE loop takes both: an option is an option wherever it sits, and the first
# non-option is the VERB. Once we have a verb the loop stops at the next
# non-option: those are the positionals, which must stay positional. So `mux
# --bare go` and `mux go --bare` are the same command; the flag-first form is
# what the README and the man page have always shown, and it used to die on
# "unknown verb: --bare".
#
# No verb at all -> the session picker: pick=1, then flow as an attach (cmd=go).
bare=0
attach=0
attachonly=0
noattach=0
all=0
listing=0
nowaitenv=0
resume=0
force=0
persist=0
cmd=
while [ "$#" -gt 0 ]; do
  case $1 in
    # --bare said nothing about what it did. --no-agent does.
    --no-agent|--bare|-b) bare=1; shift ;;
    --attach|-a)  attach=1; shift ;;
    --attach-only) attachonly=1; shift ;;
    --no-attach)  noattach=1; shift ;;
    --all)        all=1; shift ;;
    --list)       listing=1; shift ;;
    # THE HUMAN OVERRIDE for the readiness gate below. Needed because a
    # person typing `mux resume` at a terminal meets the same refusal a
    # latch does, and the refusal names this flag rather than leaving it
    # to be discovered.
    --no-wait-env) nowaitenv=1; shift ;;
    --resume)     resume=1; shift ;;
    --force)      force=1; shift ;;
    --persist|-p) persist=1; shift ;;   # retired: now the default
    -h|--help)    usage 0 ;;
    --version|-V) printf 'mux %s\n' "$MUX_VERSION"; exit 0 ;;
    --) shift; break ;;
    -*) echo "mux: unknown option: $1" >&2; usage ;;
    *)  if [ -n "$cmd" ]; then break; fi
        cmd=$1; shift ;;
  esac
done

pick=0
if [ -z "$cmd" ]; then
  pick=1
  cmd=go
fi
# --- the verb vocabulary, the arity table and the per-flag gates ----------
# ALL OF IT IS lib/mux-args_lib (2026-10-05), as `mux_args_check COUNT`,
# sourced unconditionally (every verb reaches this line). The boundary falls
# here and not around the loop above because a function's `shift` moves the
# function's positionals, never the caller's; the validation reads only `$#`
# and the flag variables, so the count is one argument.
[ -r "$MUX_LIB/mux-args_lib" ] || {
  echo "mux: mux-args_lib missing (incomplete install)" >&2
  exit 1; }
# shellcheck source=/dev/null
. "$MUX_LIB/mux-args_lib"
mux_args_check "$#"

name_arg=${1:-}
layout_arg=${2:-}


# HELP IS ENTIRELY libexec/mux-help (2026-10-05): the topics, the usage
# summary, and the two list helpers they share. The empty topic IS usage, so
# this needs no branch of its own and the topic VOCABULARY lives with the
# topics, which makes adding one a single edit in a single file.
#
# "$@" IS LOAD-BEARING. This was once an inline block reading the script's
# own positionals, and a first attempt at extracting it dropped them, which
# made every `mux help TOPIC` print the usage summary instead: an argument
# this file can only pass on, never interpret.
if [ "$cmd" = help ]; then exec "$LIBEXEC/mux-help" "$@"; fi

# Root and identity both derive from the project: the git toplevel if we are in
# a repo, else the current directory. tmux forbids ':' and '.' in a session
# name, so fold them to '-' in a derived name.
base=$(mux_resolve_project_base)
bypath=0
if [ -n "$name_arg" ] && mux_resolve_is_path "$name_arg"; then
  # A session addressed by its ROOT. Deliberately NOT the same as
  # `cd <path> && mux go`: a bare go climbs to the git toplevel, which
  # would turn a subdirectory session's root into its enclosing repo.
  # Here an exact-root claim wins first, so a profile rooted below a
  # toplevel resolves to itself.
  #
  # This is what lets `mux resume` replay a PUBLIC command rather than
  # reach into mux's internals: it knows each session's root, and a root
  # is an address.
  bypath=1
  _bp=$(mux_expand_tilde "$name_arg")
  _bp=$(readlink -f -- "$_bp" 2>/dev/null || printf '%s' "$_bp")
  [ -d "$_bp" ] || {
    echo "mux: not a directory: $name_arg" >&2; exit 1; }
  name=$(mux_prof_by_root "$_bp")
  if [ -n "$name" ]; then
    base=$_bp
  else
    base=$(mux_resolve_project_base "$_bp")
    name=$(basename "$base")
  fi
elif [ -n "$name_arg" ]; then
  # A NAME THE USER TYPED IS REFUSED, never quietly rewritten, because mux
  # RESERVES the colon for addressing and handing back a different session
  # from the one asked for is this package's signature failure: plausible,
  # wrong, and silent. A DERIVED name is rewritten instead (see
  # mux_sess_sanitise), since a directory called `example.com` is nobody's
  # mistake.
  #
  # NOT FOR `resume`, WHOSE ARGUMENT IS AN ADDRESS rather than a session
  # name: `mux resume work::api` is the qualified form and the colons there
  # are mux's own grammar doing its job. This block is the SHARED name
  # resolution, so without the exclusion the reservation refused the very
  # syntax it exists to protect, which the suite caught at once.
  [ "$cmd" = resume ] || mux_sess_name_clean "$name_arg" || {
    echo "mux: a session name cannot contain a colon: $name_arg" >&2
    echo "mux: mux reserves it for addressing, where PARTITION::SESSION" >&2
    echo "mux: and SESSION:WINDOW are how a name is qualified, and tmux" >&2
    echo "mux: uses it for the same job, so such a session could not be" >&2
    echo "mux: reached by a plain \`tmux -t\` either. Try:" >&2
    echo "mux:   mux $cmd $(mux_sess_sanitise "$name_arg")" >&2
    exit 2; }
  name=$name_arg
else
  # No name typed: the directory decides. A row whose `root` IS this
  # directory names it, so an alias is authoritative for its own
  # project, and `mux go` there reaches the same session `mux go <alias>`
  # would, instead of creating a second one under the derived name.
  # EXACT match only; a subdirectory still derives the enclosing project.
  name=$(mux_prof_by_root "$base")
  [ -n "$name" ] || name=$(basename "$base")
fi
name=$(mux_sess_sanitise "$name")

# Which tmux namespace. The context hook names the socket: an isolated context
# gets a socket of its own, everything else the default server. Degrades cleanly
# to the default socket when no hook is installed, or
# when the caller is in no special context. Prime _cur_side here too, so the
# common path resolves the hook once.
mux_ctx_resolve || { echo "mux: ${MUX_CTX_ERR:-context error}" >&2; exit 1; }
sock=$(mux_ctx_socket)

# The PARTITION KEY: what the session set, the scan map and the agent-state
# dir are filed under. Same VALUE as $sock (a partition's socket is named
# after it), different QUESTION: $sock is "which tmux -L", $part is "whose
# records". Conflating them spread a stale name through eleven sites that
# wrote ${sock:-default} as a partition key, naming a partition that stopped
# existing when the personal one became `global` while every library fell back
# to `global`. Unreachable today (resolve sets a partition or exits), but this
# was its third sighting and the first two were live: the tray (15cc461) and
# mux-agent-state-emit (6099078).
#
# The `default` in the SOCKET comparisons below is the same spelling and a
# different string, and is correct: with no -L, tmux's socket really is named
# `default`.
part=$MUX_CTX_PARTITION
# resume's optional PARTITION and SESSION. Only resume takes them today; every
# other verb acts on the partition you are in, which is the point of a context.
#
# POSITIONAL, and the first is ALWAYS the partition, never "whichever of
# these happens to name one". That magic would change meaning the day you add
# a partition, and a session sharing a partition's name would silently do the
# wrong thing, which is the exact shape of bug `mux latch` already shipped
# once (a default that succeeded at the wrong thing and said nothing).
rs_want=${1:-}
rs_focus=${2:-}
# ONE ARGUMENT IS AN ADDRESS, two are the legacy pair, and the discriminator
# is the COUNT rather than emptiness: `mux resume work ''` is a deliberate
# two-field call naming a partition and no focus, and reading it as an address
# would silently make it the session `work`.
#
# RESUME MOVED TO THE COMMON GRAMMAR because its positionals were a SECOND
# grammar for one concept, first field always a partition, colliding with "a
# bare word is always a session" everywhere else.
#
# THE BREAK IS LOUD, which is what makes it safe: `mux resume work` rebuilds
# the caller's own partition and tries to FOCUS a session `work`, and with no
# such session that is exit 3 LISTING every session there is. A silent change
# of meaning is the thing to refuse; a listed refusal is a prompt.
#
# THE TWO-FIELD FORM IS KEPT, because an OLDER `mux latch` composes it as a
# remote command and a remote contract cannot be changed from one side.
if [ "$cmd" = resume ] && [ "$#" -le 1 ] && [ -n "$rs_want" ]; then
  # shellcheck source=/dev/null
  . "$MUX_LIB/mux-addr_lib"
  mux_addr_parse "$rs_want" || exit 2
  [ -z "$MUX_ADDR_WIN" ] || {
    echo "mux: resume: a window cannot be addressed here." >&2
    echo "mux: resume rebuilds a SESSION SET and lands on one of them," >&2
    echo "mux: so there is nothing per-window for it to do. Try:" >&2
    rs_try=${MUX_ADDR_PART:+${MUX_ADDR_PART}::}$MUX_ADDR_SESS
    echo "mux:   mux resume $rs_try" >&2
    exit 2; }
  rs_want=$MUX_ADDR_PART
  rs_focus=$MUX_ADDR_SESS
fi
if [ "$cmd" = resume ] && [ -n "$rs_want" ]; then
  mux_ctx_valid "$rs_want" || {
    echo "mux: not a partition name: $rs_want" >&2; usage; }
  # KNOWN, or exit 3: mux's cross-cutting "the name is not known
  # here", the same code `go` and `why` use. A typo must not resume an
  # EMPTY set and report "no sessions recorded", which reads as data
  # loss rather than as a misspelling.
  case " $(mux_ctx_partitions | tr '\n' ' ') " in
  *" $rs_want "*) part=$rs_want ;;
  *) echo "mux: no such partition: $rs_want" >&2
     echo "mux: known: $(mux_ctx_partitions | tr '\n' ' ')" >&2
     exit "$MUX_EX_NONAME" ;;
  esac
elif [ "$cmd" = resume ] && [ "${MUX_CTX_SRC:-baseline}" = failed ]; then
  # THE THIRD OUTCOME, and the one that must not be silent. `baseline`
  # and `declined` are real answers meaning the baseline; `failed` is the
  # ABSENCE of an answer, and resuming `global` on the strength of it
  # hands you somebody else's sessions while looking like success.
  # `mux why` already refuses to credit a failed command for a token it
  # did not supply: this is the same lie, available to resume.
  echo "mux: the context-command FAILED, so the partition is unknown" >&2
  echo "mux: name one (mux resume global), or fix the command" >&2
  exit 1
fi

# A session name may contain a space but never a newline (tmux's own -F
# output is line oriented), so newline is the only safe separator for a
# LIST of them, and `for n in $set` is never safe for one.
_RS_NL='
'
# Nothing knows this context. Say so ONCE, here in the front end, never from
# mux-context_lib, which mux-style and mux-agent-render call every status
# interval, where output pops a view-mode buffer over the active pane.
[ "${MUX_CTX_UNKNOWN:-0}" -eq 1 ] && {
  echo "mux: no config for context '$MUX_CTX_TOKEN'" \
    "(no contexts/$MUX_CTX_TOKEN.context," \
    "no partitions/$MUX_CTX_PARTITION.partition)" >&2
  echo "mux: running on built-in defaults; discovery is off" >&2
}

# Single chokepoint for the socket choice: every session-scoped tmux call goes
# through here. reload deliberately bypasses it to reach BOTH servers.
tm() {
  if [ -n "$sock" ]; then
    tmux -L "$sock" "$@"
  else
    tmux "$@"
  fi
}

# --- mux's own wiring, guaranteed on every server mux acts on --------------
# WHY: a mux install was not complete on its own. The fragment loaded only
# because the user's tmux.conf carried a `source-file` line, and on this fleet
# that file belongs to the PROVISIONER: remove it and the bindings, strip and
# hooks stop loading, while `mux check` names a remedy in a file you do not
# own. Two owners is also how an option drifts, and `update-environment`,
# which mux must own, lived in that same foreign file.
#
# IT DOES NOT TAKE THE CONFIG FILE. tmux still reads the user's tmux.conf at
# server start, so their prefix key and bindings keep working with no
# migration, and mux sources its fragment AFTERWARDS, which is how tmux
# already decides: last sourced wins.
#
# `-f` IS THE OBVIOUS SHAPE AND IS WORSE, measured: a `-f` server reads ONLY
# that file, so mux would have to re-source the user's config and a plain
# `tmux` would behave differently from a mux one. Sourcing afterwards is
# equivalent: into a RUNNING server the fragment delivers status-right, every
# binding and every hook.
#
# THE OVERLAP IS FREE, so this ships before the provisioner drops its line
# with no flag day. mux.tmux is IDEMPOTENT, proven: the whole
# `show-options -g` hash, all 271 bindings and even the APPENDED
# `window-layout-changed` array are byte-identical after one, two and three
# sourcings, because that hook resets with `set-hook -g` before its three
# `-ag` appends. The REVERSE is not free and is not claimed: drop the
# provisioner's line before this is live and a server gets no wiring at all.
# Two windows; idempotence frees one.
#
# MUX WRITES THE VERSION MARKER, not the fragment, because
# `set -gF @x '#(mux -V)'` does NOT expand at set time (measured: reads back
# empty). Better anyway: a fragment left by an OLDER mux compares unequal and
# re-sources, which closes the staleness that once had `mux check` telling a
# live server to source a file it already had.
#
# THE PROBE CANNOT CREATE A SERVER, which matters on paths where none exists
# yet: `show-options -gqv` exits non-zero and spawns nothing (measured),
# unlike the `list-keys` that had to come out of `mux check`.
#
# ONLY mux.tmux. `mux-opinions.tmux` is optional taste by its own header, so
# forcing it would impose a mouse mode nobody asked for.
#
# AND A SERVER MUX NEVER TOUCHES IS NOT WIRED, the honest limit: a plain
# `tmux new-session` gives mux no hook. Called from the SESSION-AFFECTING
# paths (build, attach, reload) and never the hot read-only ones, where
# `mux agent-render` would pay a round trip per client per status-interval. So
# such a server is wired by the first mux verb that acts on it, which is the
# first moment mux is entitled to an opinion.
# --- the session pointers a pane must not start without -------------------
# R1 and R2 from the environment work. A pane's environment comes from the
# SERVER, not from whoever asked for the pane (measured: a client holding a
# good value still got the server's value in a new window), so no caller can
# fix this from outside and it has to happen here.
#
# AND AN ATTACH DESTROYS, which is why this runs on BOTH paths rather than
# only at creation. tmux's `update-environment` copies the attaching client's
# environment into the session, and copying an ABSENT variable records a
# REMOVAL (`-SSH_AUTH_SOCK`), which then MASKS the server global. One attach
# from a client with no agent turns a healthy session into a broken one. On the
# box this was found on, that client was an ssh from another machine while the
# box sat at its login greeter, so any cross-box attach does it.
#
# THE LIBS ARE SOURCED INSIDE THE FUNCTION, not at the top: the hot paths
# never call this, so they pay nothing. Functions defined by a `.` inside a
# function are global afterwards, so the guard fires once.
_mux_env_loaded=0
# ONE LOADER, TWO CALLERS, and extracted rather than copied the moment the
# second one appeared: `mux resume`'s readiness gate needs the same libs (in
# lib/mux-resume_lib since 2026-10-05, calling this), and a second copy of
# this list is the thing that drifts when a lib is added.
# Non-zero means an incomplete install; each caller decides what that costs.
_mux_env_load() {
  [ "$_mux_env_loaded" -eq 0 ] || return 0
  for _eel in mux-paths_lib mux-conf_lib mux-notice_lib mux-env_lib; do
    [ -r "$MUX_LIB/$_eel" ] || return 1
    # shellcheck source=/dev/null
    . "$MUX_LIB/$_eel"
  done
  _mux_env_loaded=1
  return 0
}
mux_env_ensure() {   # <session>
  [ -n "${1:-}" ] || return 0
  _mux_env_load || return 0
  # R7: A WITHHELD VALUE IS VISIBLE. Three outcomes come back and they are
  # reported differently on purpose:
  #
  #   dropped   a FINDING: resolved, failed its validator, so not written.
  #             Announced, because otherwise this becomes a second silent
  #             removal mechanism beside `update-environment`, which is what
  #             made the original fault cost a long session to find.
  #   stripped  the human's own POLICY, declared in envhooks.d/strip.d. Not
  #             news, and announcing it every run would be noise about a
  #             decision they already made.
  #   set       the repair working. Quiet by design: a session starting
  #             correctly is not an event.
  mux_env_apply "$1" -v 2>/dev/null | while IFS=' ' read -r _eev _een; do
    [ "$_eev" = dropped ] || continue
    mux_notice startup "$_een was withheld from '$1': it resolved," \
      "but its own validator says that value is dead."
  done
}

mux_wire() {
  [ -n "${MUX_SHARE:-}" ] && [ -f "$MUX_SHARE/mux.tmux" ] || return 0
  # No server yet is not a failure: there is simply nothing to wire.
  _wv=$(tm show-options -gqv @mux-wired 2>/dev/null) || return 0
  [ "$_wv" = "$MUX_VERSION" ] && return 0
  if ! tm source-file "$MUX_SHARE/mux.tmux" 2>/dev/null; then
    # LOUD, because the alternative is mux installed and inert: no status
    # strip, no bindings, no hooks, and nothing on screen saying why.
    echo "mux: could not source $MUX_SHARE/mux.tmux into this server," >&2
    echo "mux: so it has no mux bindings, strip or hooks." >&2
    return 1
  fi
  tm set -g @mux-wired "$MUX_VERSION" 2>/dev/null || true
}

# Heal any theme-fragment drift on the running servers before we draw anything:
# a cheap no-op unless a themes/*.theme changed since a server was last synced,
# so an edited palette needs no manual reload. Best-effort; never a gate.
if [ -x "$LIBEXEC/mux-themes" ]; then
  "$LIBEXEC/mux-themes" sync || true
fi

# --- (no verb): pick a session to attach -----------------------------------
# `mux` with no arguments lists the sessions in this context and lets you choose
# one: fzf if present, else a numbered menu. One session attaches straight
# away; none points you at `mux go`. Sets `name`, then falls through to the
# attach path below.
if [ "$pick" = 1 ]; then
  _sessions=$(tm list-sessions -F '#{session_name}' 2>/dev/null || true)
  if [ -z "$_sessions" ]; then
    echo "mux: no sessions in this context (start one: mux go)"
    exit 0
  fi
  _count=$(printf '%s\n' "$_sessions" | grep -c .)
  if [ "$_count" -eq 1 ]; then
    name=$_sessions
  else
    # Decorate each session with its agent-state glyph, so a blocked
    # or working agent is visible while you choose (⚫ = no agent).
    # The menu line is "GLYPH NAME"; NAME is the last field (mux
    # names hold no spaces), so the pick maps straight back. Skipped
    # when the shared state lib is absent, then it is plain names.
    _menu=$_sessions
    if [ "$_have_astate" -eq 1 ]; then
      _adir=$(mux_agent_dir "$part")
      _menu=$(printf '%s\n' "$_sessions" \
        | while IFS= read -r _s; do
        [ -n "$_s" ] || continue
        printf '%s %s\n' \
            "$(mux_agent_state_glyph "$_adir" "$_s")" \
            "$_s"
        done)
    fi
    if command -v fzf >/dev/null 2>&1; then
      _sel=$(printf '%s\n' "$_menu" \
        | fzf --prompt='mux> ' --height=40% --reverse) \
        || exit 0
      name=${_sel##* }
    else
      printf '%s\n' "$_menu" | nl -w2 -s') ' >&2
      printf 'mux: session #? ' >&2
      read -r _n || exit 0
      case $_n in
      ''|*[!0-9]*) echo "mux: not a number" >&2; exit 1 ;;
      esac
      _sel=$(printf '%s\n' "$_menu" | sed -n "${_n}p")
      name=${_sel##* }
    fi
  fi
  [ -n "$name" ] || { echo "mux: nothing selected" >&2; exit 0; }
fi

# --- reload: re-source tmux.conf on every running mux server ---------------
# The config is machine-wide, so one reload from any pane freshens everything:
# the default socket, plus every non-default context socket the hook names, if
# their servers are up. All the same uid, so one can source another's server.
# Guard on list-sessions so source-file never STARTS a server that was not up.
# Re-source ONE server, in the order that makes mux win: the user's own config
# first (their prefix key, their bindings), then mux's fragment.
#
# IT BYPASSES tm() like the rest of this verb, because reload deliberately
# reaches every server rather than the caller's, so the socket is a parameter
# instead of $sock. Read into a local FIRST, because `set --` below replaces
# this function's own arguments.
_reload_one() {   # <socket, or empty for the default server>
  _r_sock=$1
  if [ -n "$_r_sock" ]; then set -- -L "$_r_sock"; else set --; fi
  # Guard on list-sessions so a reload never STARTS a server that was down,
  # and note it is list-sessions rather than list-keys for the reason
  # `mux check` had to learn: list-keys SPAWNS one and answers from defaults.
  tmux "$@" list-sessions >/dev/null 2>&1 || return 1
  if [ -f "$TMUX_CONF" ]; then
    tmux "$@" source-file "$TMUX_CONF" 2>/dev/null || return 1
  fi
  if [ -n "${MUX_SHARE:-}" ] && [ -f "$MUX_SHARE/mux.tmux" ]; then
    tmux "$@" source-file "$MUX_SHARE/mux.tmux" 2>/dev/null || return 1
    tmux "$@" set -g @mux-wired "$MUX_VERSION" 2>/dev/null || true
  fi
  return 0
}

cmd_reload() {
  # THE USER'S CONFIG IS OPTIONAL, which is R10 in one line. This used to
  # `exit 1` with "no tmux.conf at ...", so mux's own reload DEPENDED on a
  # file mux neither ships nor owns: on this fleet it belongs to the
  # provisioner, and removing that project broke `mux reload` outright.
  #
  # Now: the file IF PRESENT, then mux's fragment always, in that order, so a
  # mux binding wins and a box with no tmux.conf reloads correctly.
  did=
  if _reload_one ""; then did="$did default"; fi
  # Plus every non-default context server the hook knows, so a reload
  # reaches them regardless of the caller's side.
  # A here-doc, not `for _x in $(...)`: this producer emits one entry per
  # LINE and a name may contain a SPACE, so word splitting turns one entry
  # into two. Fifth instance of that class in this package; the earlier
  # four were session names.
  while IFS= read -r _s; do
    [ -n "$_s" ] || continue
    if _reload_one "$_s"; then did="$did $_s"; fi
  done <<EOF
$(mux_ctx_partitions)
EOF
  echo "mux: reloaded${did:- (no running servers)}"
  exit 0
}

if [ "$cmd" = reload ]; then cmd_reload; fi

# --- ls: sessions in the current context only ------------------------------
# Prefix each line with the session's agent-state glyph (⚫ = no agent), so `mux
# ls` reads like the status strip. Falls back to bare `tmux list-sessions` when
# the shared state lib is absent, or when a session line has no name to key on.
cmd_ls() {
  _ls=$(tm list-sessions 2>/dev/null || true)
  [ -n "$_ls" ] || { echo "mux: no sessions in this context"; exit 0; }
  if [ "$_have_astate" -eq 1 ]; then
    _adir=$(mux_agent_dir "$part")
    printf '%s\n' "$_ls" | while IFS= read -r _line; do
      _s=${_line%%:*}
      printf '%s %s\n' \
        "$(mux_agent_state_glyph "$_adir" "$_s")" \
        "$_line"
    done
  else
    printf '%s\n' "$_ls"
  fi
  exit 0
}

if [ "$cmd" = ls ]; then cmd_ls; fi

# --- theme: set / cycle / show the current session's colour theme -----------
# THE WHOLE VERB IS lib/mux-theme_lib (2026-10-05), sourced in the branch. A
# lib and not a helper because `tm` carries the partition socket; its header
# names the three libs it needs.
if [ "$cmd" = theme ]; then
  [ -r "$MUX_LIB/mux-theme_lib" ] || {
    echo "mux: mux-theme_lib missing (incomplete install)" >&2
    exit 1; }
  # shellcheck source=/dev/null
  . "$MUX_LIB/mux-theme_lib"
  mux_theme
fi

# --- why: where every resolved value came from -----------------------------
# THE REPORT IS lib/mux-why_lib (2026-10-05), sourced in the branch: 243
# lines that only DESCRIBE values this file already resolved, so a separate
# process would need a second copy of the resolution this verb exists to
# explain. Its header names the five libs it needs.
if [ "$cmd" = why ]; then
  [ -r "$MUX_LIB/mux-why_lib" ] || {
    echo "mux: mux-why_lib missing (incomplete install)" >&2
    exit 1; }
  # shellcheck source=/dev/null
  . "$MUX_LIB/mux-why_lib"
  mux_why
fi

# --- rename: rename a live session (and its matching layout) ----------------
# `mux rename NEW`       rename the CURRENT session (needs to run in one)
# `mux rename OLD NEW`   rename OLD to NEW from anywhere. tmux forbids ':' and
# '.' in names, so they fold to '-'. A matching <OLD>.layout is renamed too if
# <NEW>.layout is free, so the per-project layout keeps matching the session.
cmd_rename() {
  if [ -z "$layout_arg" ]; then
    [ -n "${TMUX:-}" ] || {
      echo "mux: rename NEW needs a session (or: OLD NEW)" >&2
      exit 1; }
    _old=$(tm display-message -p '#{session_name}'); _new=$name_arg
  else
    _old=$name_arg; _new=$layout_arg
  fi
  # REFUSED, NOT REWRITTEN, for the same reason `go`/`new` refuse: a rename
  # is always a name the user TYPED, and quietly giving them a different one
  # is worse than saying no. `why` and `save` keep the sanitiser on purpose:
  # the first only REPORTS on a name and the second names a LAYOUT.
  mux_sess_name_clean "$_new" || {
    echo "mux: a session name cannot contain a colon: $_new" >&2
    echo "mux: mux reserves it for addressing (PARTITION::SESSION and" >&2
    echo "mux: SESSION:WINDOW), and tmux uses it for the same job. Try:" >&2
    echo "mux:   mux rename $_old $(mux_sess_sanitise "$_new")" >&2
    exit 2; }
  # AND THE DOT IS STILL FOLDED, which is a SEPARATE rule: tmux <= 3.6
  # rewrites it, so mux must agree with what tmux will store or
  # `has-session -t =NAME` stops matching the name mux recorded. My first
  # version of this block REPLACED the fold instead of preceding it, and the
  # test caught the dot coming through unfolded.
  _new=$(mux_sess_sanitise "$_new")
  tm has-session -t "=$_old" 2>/dev/null || {
    echo "mux: no such session: $_old" >&2
    exit "$MUX_EX_NONAME"; }
  _oroot=$(mux_sess_root "$_old" "$part")
  tm rename-session -t "=$_old" "$_new"
  # The recorded set has to learn the new name too. It did not, and the
  # cost showed up only after a REBOOT: `mux resume` rebuilt the OLD name
  # and never the renamed one, so a rename silently dropped the session
  # from the set that exists to bring it back. One store learned about a
  # change and another did not.
  #
  # Order matters: read the root BEFORE dropping, or the new entry is
  # recorded rootless and resume cannot rebuild it.
  if [ -n "$_oroot" ]; then
    mux_sess_drop "$_old" "$part"
    mux_sess_add "$_new" "$_oroot" "$part"
  fi
  echo "mux: renamed session $_old -> $_new"
  if [ -f "$MUX_DIR/$_old.profile" ] \
     && [ ! -e "$MUX_DIR/$_new.profile" ]; then
    mv "$MUX_DIR/$_old.profile" "$MUX_DIR/$_new.profile"
    echo "mux: renamed profile $_old -> $_new"
  fi
  exit 0
}

if [ "$cmd" = rename ]; then cmd_rename; fi

