# --- hide / show / show-all: per-client session hiding ---------------------
# Context-sensitive: must run INSIDE a session, so the client (its tty) can be
# identified; the hidden set is per client. hide drops SESSION from THIS
# client's status strip and ( / ) cycling; show restores it; show-all clears
# the set. Persists until shown or reboot. hide/show need SESSION to exist.
case $cmd in
hide|show)
  [ -n "${TMUX:-}" ] || {
    echo "mux: $cmd must run inside a session" >&2; exit 1; }
  [ -r "$MUX_LIB/mux-exclude_lib" ] || {
    echo "mux: mux-exclude_lib missing (incomplete install)" >&2
    exit 1; }
  _client=$(tm display-message -p '#{client_name}' 2>/dev/null || true)
  [ -n "$_client" ] || {
    echo "mux: could not identify the client" >&2; exit 1; }
  . "$MUX_LIB/mux-exclude_lib"
  _f=$(mux_exclude_file "$_client")
  mkdir -p "$(dirname "$_f")"
  if [ "$cmd" = show ] && [ "$all" -eq 1 ]; then
    rm -f "$_f"
    echo "mux: cleared this client's hidden sessions"
  else
    tm has-session -t "=$name" 2>/dev/null || {
      echo "mux: no such session: $name" >&2
      exit "$MUX_EX_NONAME"; }
    if [ "$cmd" = hide ]; then
      grep -qxF -- "$name" "$_f" 2>/dev/null \
        || printf '%s\n' "$name" >> "$_f"
      echo "mux: hid $name for this client"
    else
      if [ -f "$_f" ]; then
        grep -vxF -- "$name" "$_f" > "$_f.new" || true
        mv -f "$_f.new" "$_f"
      fi
      echo "mux: showing $name for this client"
    fi
  fi
  tm refresh-client 2>/dev/null || true
  exit 0
  ;;
esac

# --- the session BUILD machinery -------------------------------------------
# ATTACH, THE PROFILE READER AND THE PANE VOCABULARY ARE lib/mux-build_lib
# (2026-10-05), sourced unconditionally: 312 lines that `go`, `new` and
# `resume` share, plus the geometry a session is built at. It reads ten values
# from this file and calls three of its functions; the header has the list.
#
# Unconditional still saves, because every verb that exits ABOVE this line
# never reads it: ls, reload, theme, why, edit and save, plus every hot path.
[ -r "$MUX_LIB/mux-build_lib" ] || {
  echo "mux: mux-build_lib missing (incomplete install)" >&2
  exit 1; }
# shellcheck source=/dev/null
. "$MUX_LIB/mux-build_lib"

# --- kill --all: tear down every session on the current socket -------------
# No name, and it hits the whole context (personal OR work: whichever socket
# you are on, never both), so it is guarded behind a typed confirmation and
# lists what it will kill first. It must never fire by accident.
cmd_kill_all() {
  _all=$(tm list-sessions -F '#{session_name}' 2>/dev/null || true)
  if [ -z "$_all" ]; then
    echo "mux: no sessions in this context"
    exit 0
  fi
  _n=$(printf '%s\n' "$_all" | wc -l | tr -d ' ')
  printf 'mux: kill ALL %s session(s) on socket "%s":\n' \
    "$_n" "${sock:-default}"
  printf '%s\n' "$_all" | sed 's/^/  /'
  printf 'This cannot be undone. Type yes to confirm: '
  read -r _ans || _ans=
  case $_ans in
    yes|YES|y|Y) ;;
    *) echo "mux: aborted"; exit 0 ;;
  esac
  tm kill-server 2>/dev/null || true
  mux_sess_clear "$part"
  echo "mux: killed all sessions on \"${sock:-default}\""
  exit 0
}

if [ "$cmd" = kill ] && [ "$all" -eq 1 ]; then cmd_kill_all; fi

# --- kill: tear down on whichever socket we resolved -----------------------
# Killing is how you say you are done with a session, so the set forgets it.
# Nothing else prunes: that is the whole reason a snapshot of the live set
# would be wrong.
#
# Which left a hole, since the set is pruned ONLY here and this used to
# require the session to be LIVE: a recorded session whose root has moved or
# gone is already dead, so it could not be killed and could never be
# forgotten. `mux resume` called it unbuildable on every run with no way out,
# and the only fix was hand-editing $MUX_CACHE. So a merely RECORDED name is
# killable too: nothing to tear down, same sentence either way.
cmd_kill() {
  if tm has-session -t "=$name" 2>/dev/null; then
    tm kill-session -t "=$name"
    mux_sess_drop "$name" "$part"
    echo "mux: killed $name"
    exit 0
  fi
  if mux_sess_has "$name" "$part"; then
    mux_sess_drop "$name" "$part"
    echo "mux: $name was not running; forgotten (it will no" \
      "longer be resumed)"
    exit 0
  fi
  echo "mux: no such session: $name" >&2
  exit "$MUX_EX_NONAME"
}

if [ "$cmd" = kill ]; then cmd_kill; fi

# --- new: bind a NAME to this project, then build it ------------------------
# The ONE explicit creation verb. `mux go` creates implicitly whenever it can
# point at evidence the target exists: a row, a breakout profile, a scanned
# repo, or the directory you are standing in. `mux go NAME` for a name nothing
# knows is refused, because from the input alone a new session and a typo look
# identical. `mux new NAME` is how you say you meant it.
#
# It writes a row only when one is NEEDED: a name this directory would derive
# anyway is already findable, and config never restates what mux can derive.
cmd_new() {
  if tm has-session -t "=$name" 2>/dev/null; then
    echo "mux: $name is already up (attach it: mux go $name)" >&2
    exit 1
  fi
  if [ "$force" -eq 0 ]; then
    if mux_prof_has "$name" || [ -n "$(mux_prof_find "$name")" ]
    then
      echo "mux: $name already has a profile" \
        "(edit it: mux edit $name, or --force)" >&2
      exit 1
    fi
    # Already discoverable as a DIFFERENT project: binding it here
    # would silently change what `mux go $name` means elsewhere.
    # Binding it to the directory it already means is a harmless
    # no-op, so only a conflicting root is refused.
    _other=$(mux_scan_lookup "$name" "$part" \
      | grep -vxF -- "$base" | head -1)
    if [ -n "$_other" ]; then
      echo "mux: '$name' already means $_other" >&2
      echo "mux: choose another name, or --force to" \
        "rebind it here" >&2
      exit 1
    fi
  fi
  # `new` names THIS DIRECTORY, not the project enclosing it. That is
  # the difference between it and a bare `mux go`, which takes the git
  # toplevel: without it a subdirectory could never get a session of its
  # own, since `mux new waybar` inside a repo would bind the whole repo.
  # Subdirectory sessions stay an outlier, but an outlier mux supports.
  here=$(pwd)
  _derived=$(mux_sess_sanitise "$(basename "$base")")
  if [ "$name" != "$_derived" ] || [ "$here" != "$base" ]; then
    mux_prof_set "$name" root "$(mux_fold_tilde "$here")" || {
      echo "mux: could not write $(mux_prof_file)" >&2
      exit 1; }
    echo "mux: $name -> $(mux_fold_tilde "$here")"
  fi
  base=$here
}

if [ "$cmd" = new ]; then cmd_new; fi

# --- resume: bring back this partition's sessions --------------------------
# THE WHOLE VERB IS lib/mux-resume_lib (2026-10-05), sourced in the branch.
# A lib and not a helper because it is the heaviest consumer of
# mux-build_lib there is; its header names the six libs it needs.
if [ "$cmd" = resume ]; then
  [ -r "$MUX_LIB/mux-resume_lib" ] || {
    echo "mux: mux-resume_lib missing (incomplete install)" >&2
    exit 1; }
  # shellcheck source=/dev/null
  . "$MUX_LIB/mux-resume_lib"
  mux_resume
fi

# --- go / new: the session build flow -------------------------------------
# ALL 581 LINES ARE lib/mux-go_lib (2026-10-05), as nine phases and `mux_go`,
# sourced unconditionally: every verb with another answer has exited above
# this line. It reads twenty caller values and calls twenty-three functions
# across six libs, the longest dependency list in the package, which is the
# argument for a lib: nothing in that flow is addressable from elsewhere.
[ -r "$MUX_LIB/mux-go_lib" ] || {
  echo "mux: mux-go_lib missing (incomplete install)" >&2
  exit 1; }
# shellcheck source=/dev/null
. "$MUX_LIB/mux-go_lib"
mux_go
