#!/bin/sh
# focus/kitty - raise the kitty window showing a host's latch.
#
# A `mux-desktop-notifier` ACTIVATE hook, and the one the others are written
# against: it carries the contract, and the rest say "see focus/kitty".
# Called as `kitty LABEL [PARTITION]`, on the box with the tray, AFTER the
# click has already switched that host's session.
#
# SHIPPED BUT NOT WIRED, which is the point of a hook library: mux ships
# these so you do not have to write one, and whether any RUNS is your
# config's decision. Wire it in $MUX_DIR/config, by the bare name, because
# the directory it lives in is the seam:
#
#     desktop-notifier-activate   kitty
#
# WHY MUX DOES NOT DO THIS ITSELF. Raising a window means knowing about a
# compositor, and mux manages sessions inside terminals with no opinion about
# where a terminal sits: the same boundary that put window placement in
# usher rather than in mux. Every mechanism here is yours to replace.
#
# 78 IS THE ONLY FAILURE CODE, never 1 and never the tool's own. It means
# "cannot answer", the same three-answer contract latch's hooks use: not
# having the tool, and not finding the window, are different facts from the
# raise having failed, and the notifier REPORTS a non-zero exit rather than
# swallowing it, so a misconfigured hook says so instead of doing nothing.
#
# REQUIRES `allow_remote_control yes` in kitty.conf (or `--listen-on`).
# Without it kitten exits non-zero, which the indicator reports.
#
# MATCHED ON `[host]`, WHICH MUX ITSELF EMITS, and this is the half every
# hook here shares. share/mux.tmux sets
#
#     set-titles-string '#{@mux-prefix}#S:#W....[#{host_short}]'
#
# so every mux window's title ends in the host in SQUARE BRACKETS, and
# host_short is the tmux SERVER's hostname, so a latched session advertises
# the REMOTE's name in the terminal in front of you. That is exactly the
# label the indicator hands this hook.
#
# The brackets are not decoration: matching the bare name would also match a
# SESSION called `northwood`, or a path in the title. Anchor on what mux
# emits.
#
# VERIFIED AGAINST A LIVE kitty. Which the others in this directory are, and
# are not, each says in its own header, because a hook whose mechanism was
# read rather than run is a different thing and this package has paid for
# pretending otherwise.
set -eu

_me=focus/kitty
_label=${1:-}
[ -n "$_label" ] || { echo "usage: $_me LABEL" >&2; exit 78; }
command -v kitten >/dev/null 2>&1 || {
  echo "$_me: kitten is not on PATH" >&2; exit 78; }

kitten @ focus-window --match "title:\\[$_label\\]" 2>/dev/null || {
  echo "$_me: no kitty window titled '$_label'" >&2; exit 78; }
