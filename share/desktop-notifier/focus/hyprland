#!/bin/sh
# focus/hyprland - raise a window by title under Hyprland.
#
# An ACTIVATE hook; see focus/kitty for the contract and for the `[host]`
# title mux emits.
#
#     desktop-notifier-activate   hyprland
#
# THE EXIT CODE IS NOT THE ANSWER HERE, which is the one thing that makes
# this hook longer than its neighbours. `hyprctl dispatch` exits 0 and
# reports the outcome in its OUTPUT: a dispatch that matched nothing still
# succeeds as a process. That is the shape latch already paid for twice, once
# with `ssh -V` and once with `et` exiting 0 on its own usage errors, both of
# which reported a session that never existed. So the output is interrogated
# before it is believed, and only a literal `ok` counts.
#
# A REGEX, ANCHORED BOTH ENDS, because Hyprland's `title:` matcher is a full
# match rather than a search: `^.*\[host\].*$` is how a trailing `[host]`
# becomes findable. The brackets are escaped for the same reason as sway's.
#
# VERIFIED AGAINST A RUNNING Hyprland 0.53.3, which this header spent two
# releases saying it was not. Driven by test/lab/env/hyprland: it raises the
# window carrying the anchor, and refuses the three decoys that break a
# matcher which is almost right. Both halves of the reasoning above held, so
# nothing here changed: `hyprctl dispatch` really does exit 0 while
# reporting the outcome in its output, and the anchored full match really is
# what `title:` needs.
#
# WORTH SAYING BECAUSE ITS NEIGHBOUR DID NOT HOLD: focus/wayfire was written
# the same way, from the same kind of reading, and named a tool that does
# not exist. A hook read rather than run is not WRONG, it is UNKNOWN, and
# these two are what the difference looks like.
set -eu

_me=focus/hyprland
_label=${1:-}
[ -n "$_label" ] || { echo "usage: $_me LABEL" >&2; exit 78; }
[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || {
  echo "$_me: HYPRLAND_INSTANCE_SIGNATURE unset, so Hyprland is not the
live compositor" >&2
  exit 78; }
command -v hyprctl >/dev/null 2>&1 || {
  echo "$_me: hyprctl is not on PATH" >&2; exit 78; }

# CAPTURED, WITH NO PIPE BETWEEN THE COMMAND AND ITS STATUS, which is this
# tree's most repeated measurement mistake: `cmd | grep` reports grep's
# status. Both streams, because hyprctl's refusals do not all pick the same
# one and the string is what is being read either way.
_out=$(hyprctl dispatch focuswindow "title:^.*\\[$_label\\].*$" 2>&1) || :
case $_out in
  (ok*) ;;
  (*) echo "$_me: could not focus a window titled '$_label': $_out" >&2
      exit 78 ;;
esac
