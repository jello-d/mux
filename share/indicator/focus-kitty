#!/bin/sh
# share/indicator/focus-kitty - raise the kitty window showing a host's latch.
#
# A `mux-indicator` ACTIVATE hook. Called as `focus-kitty LABEL`, on the box
# with the tray, AFTER the click has already switched that host's session.
#
# SHIPPED BUT NOT WIRED, which is the point of a hook library: mux ships this
# so you do not have to write it, and whether it RUNS is your config's
# decision. Wire it in $MUX_DIR/config:
#
#     indicator-activate   focus-kitty
#
# WHY MUX DOES NOT DO THIS ITSELF. Raising a window means knowing about a
# compositor, and mux manages sessions inside terminals with no opinion about
# where a terminal sits -- the same boundary that put window placement in
# usher rather than in mux. Every mechanism here is yours to replace.
#
# REQUIRES `allow_remote_control yes` in kitty.conf (or `--listen-on`).
# Without it kitten exits non-zero, which the indicator reports rather than
# swallowing, so a misconfigured hook says so instead of doing nothing.
#
# MATCHED ON `[host]`, WHICH MUX ITSELF EMITS. share/mux.tmux sets
#
#     set-titles-string '#{@mux-prefix}#S:#W....[#{host_short}]'
#
# so every mux window's title ends in the host in SQUARE BRACKETS -- and
# host_short is the tmux SERVER's hostname, so a latched session advertises
# the REMOTE's name in the terminal in front of you. That is exactly the label
# the indicator hands this hook.
#
# The brackets are not decoration: matching the bare name would also match a
# SESSION called `manifold`, or a path in the title. Anchor on what mux emits.
set -eu

_label=${1:-}
[ -n "$_label" ] || { echo "usage: focus-kitty LABEL" >&2; exit 78; }
command -v kitten >/dev/null 2>&1 || {
  echo "focus-kitty: kitten is not on PATH" >&2; exit 78; }

# 78 is "cannot answer", the same code latch's hooks use for it: not being
# able to find the window is different from failing to raise one.
kitten @ focus-window --match "title:\\[$_label\\]" 2>/dev/null || {
  echo "focus-kitty: no kitty window titled '$_label'" >&2; exit 78; }
