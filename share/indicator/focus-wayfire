#!/bin/sh
# share/indicator/focus-wayfire - raise a window by title under wayfire.
#
# A `mux-indicator` ACTIVATE hook; see focus-kitty for the contract and for
# why this is a hook rather than something mux does. Wire with:
#
#     indicator-activate   focus-wayfire
#
# TERMINAL-NEUTRAL where focus-kitty is not: it asks the COMPOSITOR to raise
# whatever window carries the title, so it works for any terminal. It needs
# wayfire's IPC socket, which is a plugin you must enable, so the two
# samples trade different requirements, which is the point of shipping both.
set -eu

_label=${1:-}
[ -n "$_label" ] || { echo "usage: focus-wayfire LABEL" >&2; exit 78; }
[ -n "${WAYFIRE_SOCKET:-}" ] || {
  echo "focus-wayfire: WAYFIRE_SOCKET unset (enable the ipc plugin)" >&2
  exit 78; }
command -v wf-msg >/dev/null 2>&1 || {
  echo "focus-wayfire: wf-msg is not on PATH" >&2; exit 78; }

wf-msg focus-window "title:\\[$_label\\]" 2>/dev/null || {
  echo "focus-wayfire: could not focus a window titled '$_label'" >&2
  exit 78; }
