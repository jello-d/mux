#!/bin/sh
# share/latch/et-classify - turn an Eternal Terminal attempt into a latch state.
#
# A `mux latch` CLASSIFY hook, same contract as ssh-classify: called as
# `et-classify EXIT STDERR_FILE`, prints exactly one state word on stdout.
#
# WIRE IT, WITH THE TRANSPORT, in $MUX_DIR/config:
#
#     latch-transport  et %h --port %p:2022 --command %c
#     latch-classify   et-classify
#
# EVERYTHING BELOW WAS MEASURED against et 7.0.0 (the version its own PPA ships)
# between two VMs, after a first version of this file was written from reading
# EternalTerminal's `master` and got three things wrong. The corrections are
# recorded here because each one would otherwise be re-derived from the same
# reading:
#
# 1. `-t` IS `--tunnel`, NOT "REQUEST A PTY". The first template said
#    `et -t %h --command %c`; `-t` takes a value, so it swallowed the host and
#    et answered "Missing host to connect to": on exit 0. A pty is the
#    DEFAULT for `--command` anyway, so no flag is needed. `%c` is still right
#    (the command is typed into a remote LOGIN shell, so it must arrive
#    unquoted), and that part held up: `mux -V` through it prints the version,
#    and a real attach renders mux's status bar on the far side.
# 2. et WRITES ITS DIAGNOSTICS TO STDOUT, not stderr. "Could not reach the ET
#    server: host:port" goes to the terminal, so a CLASSIFY hook (which is
#    handed a STDERR file) cannot see it. Every string match in the first
#    version was therefore inert, which is why latch reported `refused` with
#    advice about the far side being up when etserver was simply stopped.
# 3. THE REMOTE EXIT STATUS IS NOT PROPAGATED. `mux resume nosuchpartition`
#    exits 3, ssh passes that through, and et 7.0.0 exits 0 regardless. So
#    mux's own codes never arrive and arms for 2, 3, 4, 126 and 127 cannot
#    fire.
#    (master's source returns `remoteExitStatus`, which is what the first
#    version relied on. The release does not.)
#
# WHAT IS LEFT IS THE EXIT CODE, AND IT CARRIES EXACTLY TWO ANSWERS. That is
# thin, and it is the honest amount: a classifier that pattern-matches a stream
# it is never given is worse than a short one, because it reads as coverage.
#
# TWO LIMITATIONS FALL OUT, both documented in man 1 mux rather than papered
# over here:
#
#   - A REMOTE REFUSAL READS AS `ended`. If the far side has no mux, or the
#     session is gone, et still exits 0 and latch reports the session as closed
#     deliberately. The far side's own message is on YOUR TERMINAL, where et put
#     it, so you are not blind, but latch cannot quote it and cannot act on
#     it. This is the one thing to fix if et ever propagates the status.
#     THE SHARPEST CASE IS THE READINESS REFUSAL (mux exit 4): a host that has
#     rebooted and is waiting for its session environment is asking to be
#     RETRIED, and over ET that reads as `ended`, so latch stops. Over ssh it
#     retries by itself. Until et propagates the status, a latch to a box that
#     declares `env-ready` wants the ssh transport.
#   - LATCH CANNOT QUOTE THE TRANSPORT'S REASON. Over ssh a failure report
#     carries ssh's own words; over ET there is nothing in stderr to carry.
set -eu

_rc=${1:-}
[ -n "$_rc" ] || { printf 'unknown'; exit 0; }

case $_rc in
0)
  # et finished and said nothing it is willing to put in stderr. In the
  # overwhelmingly common case that is a detach: MEASURED end to end, a human
  # detaching on the far side ends the transport at 0 and leaves the remote
  # session alive, which is exactly what `ended` promises. A remote refusal
  # also lands here, per the limitation above.
  printf 'ended' ;;
1)
  # et'S OWN FAILURE TO CONNECT, and the reason it is `probing` rather than
  # `refused` is a measurement rather than a guess: with etserver stopped, et
  # exits 1 ("Could not reach the ET server", on stdout). That heals by itself
  # the moment the service comes up, so retrying on a backoff is right and
  # terminal would mean a human restarting latch after a fix it could have
  # waited through. The same call `blocked` makes about a credential.
  #
  # A malformed transport line also exits 1 here, and would be retried
  # forever. That is tolerable because the shipped line is the tested one
  # (test/mux-latch-et.t scrapes it out of this header and runs it), and
  # because the alternative (calling a booting box terminal) is worse.
  printf 'probing' ;;
*)
  # Anything else, including whatever et exits with when it stops
  # reconnecting, which no message in its source names. `unknown` retries with
  # more patience, the safe direction for a transport whose entire premise is
  # that a drop is temporary.
  printf 'unknown' ;;
esac
exit 0
