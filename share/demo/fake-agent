#!/bin/sh
# share/demo/fake-agent - pretend to be a coding agent, for `mux demo`.
#
#   fake-agent <label> <mode>
#
# IT GOES THROUGH MUX'S REAL HOOK PATH, which is the whole point. Every state
# change is a `mux agent-hook <EventName>` call, exactly what a wired agent's
# lifecycle sends, so the strip the demo shows is produced by the same machinery
# a real agent drives: hook -> mux's event table -> agent-state-emit -> a record
# -> agent-render. A demo that wrote state files directly would be a puppet
# show, and would drift from the format the moment the record changed.
#
# MODES, because a strip with one state on it teaches nothing:
#
#   blocked   goes to `blocked` and STAYS there, so `prefix b` always has a
#             target and the "who needs me" answer is deterministic.
#   cycle     working -> beats -> blocked -> idle, forever, at its own pace.
#   idle      finishes once and sits there, which is what `done` looks like.
#
# It prints a line per transition, so the pane looks like something is happening
# rather than like a dead shell. That matters for a demo more than it sounds.
set -eu

# NO DESKTOP NOTIFICATIONS FROM A DEMO, and it is no longer this file's to
# arrange. Four pretend agents cycling forever would fill the notification
# daemon with news about sessions that do not exist, so this used to point
# mux's notification seam at `true`. That worked because the RAISER was a hook
# this script invoked, so an environment variable reached it.
#
# IT IS A SEPARATE LONG-LIVED PROCESS NOW. `mux-desktop-notifier` raises every
# banner, from the event stream, and there is no variable a demo can set that
# it reads: the suppression was structurally inapplicable rather than broken.
#
# SO THE NOTIFIER IGNORES THIS PARTITION BY DEFAULT, which is better than a
# refusal here could have been: it is a FILTER, so somebody who wants to watch
# the demo's banners can turn it off (`desktop-notifier-ignore none`), where
# validating the name instead could never have been opted out of. It keys on
# the demo's socket, which already contains a dot precisely so the partition
# machinery cannot address it. See DEFAULT_IGNORE in the notifier's sources.

_label=${1:-demo}
_mode=${2:-cycle}
# Staggered per session, so the first screen already shows a mix rather than
# four sessions in lockstep.
_beat=${3:-4}

say() { printf '  %s\n' "$*"; }
hook() { mux agent-hook "$1" >/dev/null 2>&1 || true; }

printf '\n  [demo] %s: a pretend agent, driving mux through real hooks\n' \
  "$_label"
printf '  [demo] nothing here touches your real sessions: its own\n'
printf '  [demo] tmux server and its own agent-state namespace.\n\n'

case $_mode in
  blocked)
    say "worked for a moment, then hit something that needs a human"
    hook UserPromptSubmit
    sleep 1
    hook Notification
    say "BLOCKED: waiting for you to approve something."
    say "press prefix b from any session and you land here."
    ;;
  idle)
    say "ran, finished, and has nothing to say"
    hook UserPromptSubmit
    sleep 1
    hook Stop
    say "IDLE: done."
    ;;
esac

# The cycling ones keep going; the others just park. A parked pane still has to
# hold the pane open, or tmux closes it and the session disappears mid-demo.
while :; do
  case $_mode in
    cycle)
      hook UserPromptSubmit
      say "working ..."
      _n=0
      while [ "$_n" -lt 3 ]; do
        sleep "$_beat"
        # A BEAT, not a transition: this is what an agent sends while a turn is
        # in progress, and mux refuses to let one resurrect a finished turn.
        hook PostToolUse
        say "  ... still working"
        _n=$((_n + 1))
      done
      hook Notification
      say "BLOCKED: needs you."
      sleep $((_beat * 2))
      hook Stop
      say "IDLE: done. starting again shortly."
      sleep "$_beat"
      ;;
    *)
      sleep 3600
      ;;
  esac
done
