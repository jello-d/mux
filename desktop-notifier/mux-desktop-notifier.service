[Unit]
Description=mux-desktop-notifier: SNI tray icon for mux agent-session state
After=default.target

[Service]
# The console script installed by `pipx install` (or the mux-desktop-notifier
# venv); both land it at ~/.local/bin/mux-desktop-notifier. A --user service
# inherits no login PATH, so name ~/.local/bin (for the `mux` CLI the daemon
# polls) explicitly.
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/mux-desktop-notifier
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
