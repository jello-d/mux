#!/bin/sh
# test/mutate - break each guard on purpose and assert a test NOTICES.
#
# The suite proves the code does what the tests say. This proves the TESTS say
# anything at all: a guard no mutation can kill is decorative, and a decorative
# guard is how "the suite is green" and "nothing is checked" become the same
# sentence. That has happened here more than once.
#
# Ported from vigilance's test/mutate, which was written for the same reason and
# solves the same problem. Two additions, both for failures seen HERE:
#
#   AN AMBIGUOUS TARGET IS AN ERROR. If the line occurs more than once, this
#   refuses rather than mutating the first. bin/mux has two identical
#   `if [ "$_have_astate" -eq 1 ]` lines and only one of them is in cmd_ls; a
#   by-hand mutation hit the picker's copy, the ls test passed, and that read as
#   "the guard is not covered" when the guard had never been touched.
#
#   AN OPTIONAL EXPECTED MESSAGE. A record may name a fragment the failure must
#   contain, so `killed` means killed BY THE INTENDED ASSERTION. Without it a
#   mutation that breaks some earlier, unrelated assertion counts as coverage,
#   which happened: a guard mutated to `[ -f /dev/null ]` is FALSE (a character
#   device is not a regular file), so it fired always instead of never and the
#   test died on a different line entirely.
#
# EVERY failure of this discipline here has been in the instrument, never the
# subject. So the driver asserts the mutation LANDED, that the target was
# UNAMBIGUOUS, that the result still PARSES, that the named tests pass BEFORE
# it, and only then that one dies for the stated reason.
#
# Usage: sh test/mutate [name ...]      (default: the whole corpus)
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
CORPUS=$HERE/test/mutants.rec
# THE SAME RULE THE HARNESS NOW FOLLOWS, and for the same reason: `rm -rf` is
# never run with variable expansion, and a trap is the sharpest case because it
# defers the expansion to FIRE TIME. mux's test harness removed a working tree
# that way on 2026-09-30 (an empty mktemp answer resolved to the cwd), and this
# driver carried the identical shape. Verify, then bake the LITERAL in, so
# `trap` prints exactly what will run.
T=$(mktemp -d) || T=
[ -n "$T" ] && [ -d "$T" ] && [ "$T" != "$PWD" ] && [ "$T" != / ] || {
  echo "mutate: refusing to use [$T] as a scratch dir: the trap removes it" >&2
  exit 2; }
case $T in
*\'*) echo "mutate: refusing a scratch dir containing a quote: [$T]" >&2
  exit 2 ;;
esac
# shellcheck disable=SC2064  # EXPANDING NOW IS THE POINT: shellcheck's
# advice here is to defer the expansion to signal time, and deferring is
# exactly what removed a working tree (see the rule above). The literal is
# baked in deliberately.
trap "rm -rf '$T'" EXIT INT HUP TERM

PASS=0; FAIL=0; ERR=0

# Parse under the shell the file actually declares. mux is dash-clean by rule,
# but the check follows the shebang rather than assuming.
# BY LANGUAGE, not just by shebang. The corpus reaches the notifier now,
# render.py has no shebang at all, so the shebang-only version fell through to
# `dash -n` on Python, called every mutation a syntax error, and reported a
# corpus error for a record that was fine. A parse check that cannot parse the
# file is worse than none: it turns every result into the same wrong one.
_parses() {   # <file>
  # BY SHEBANG FIRST, THEN BY SUFFIX, and that order is the fix rather than
  # the belt-and-braces it looks like. Dropping `.py` from an EXECUTED
  # Python file (the naming convention: executed takes a bare name) left
  # this falling through to `dash -n` on Python and reporting a corpus
  # error for three records that were fine. A selector keyed on a suffix
  # goes stale the moment something is renamed; a shebang travels with the
  # file. The suffix arm stays for the package's `*.py`, which are IMPORTED
  # and so carry no shebang at all.
  case "$(head -1 "$1")" in
  *python*) _pl=py ;;
  *bash)    _pl=bash ;;
  *)        _pl=sh ;;
  esac
  case "$1" in
  *.py) _pl=py ;;
  # THE HOMEBREW FORMULA IS RUBY, and this repo is its own tap, so the
  # formula ships here and its guards belong in the corpus like anything
  # else. Without this arm a mutated `.rb` goes to `dash -n`, which rejects
  # every Ruby file, and the driver reports a corpus error about a record
  # that is perfectly good: the same false accusation the suffix-keyed
  # Python selector made before the shebang arm was added.
  *.rb) _pl=rb ;;
  esac
  case "$_pl" in
  py)
    # compile(), not py_compile: it checks the syntax and writes
    # NOTHING. py_compile always wants an output file, refuses
    # /dev/null outright ("will be changed into a regular one"), and
    # left to itself would drop a .pyc beside the source that a later
    # import would pick up.
    python3 -c 'import sys
src = open(sys.argv[1]).read()
compile(src, sys.argv[1], "exec")' "$1" 2>/dev/null
    return $? ;;
  bash) bash -n "$1" 2>/dev/null ;;
  rb)
    # SKIPPED RATHER THAN FAILED with no ruby on the box, and the record
    # still has to produce its named failure for the kill to count, so
    # the worst an absent ruby can do is let a non-parsing mutant through
    # to a test that will reject it anyway. Failing here instead would make
    # a machine without ruby report corpus errors about good records, which
    # is the direction that wastes the most time.
    command -v ruby >/dev/null 2>&1 || return 0
    ruby -c "$1" >/dev/null 2>&1 ;;
  *)    dash -n "$1" 2>/dev/null ;;
  esac
}

# How many times the exact line appears. Fixed-string, whole-line: the same
# comparison the edit below makes, so the count cannot disagree with it.
_occurrences() {   # <file> <line>
  grep -Fxc -- "$2" "$1" 2>/dev/null || true
}

# Exact whole-line replace of the FIRST match, via awk so there is no pattern
# syntax at all: `||`, `*`, `/`, `$` and a trailing backslash are characters.
#
# THE STRINGS COME THROUGH THE ENVIRONMENT, not through `-v`. awk processes
# escape sequences in a `-v` assignment, so a target containing `\|` arrived as
# `|` and matched nothing, while mutants.t's `grep -Fx` matched it perfectly:
# the two comparisons disagreeing in exactly the place this file claims they
# cannot. The corpus was right and the instrument was wrong, again. ENVIRON does
# no such processing, so the value awk compares is the value the corpus holds.
_edit() {   # <file> <old> <new> -> 0 if a line changed
  MUT_OLD=$2 MUT_NEW=$3 awk '
    BEGIN { old = ENVIRON["MUT_OLD"]; new = ENVIRON["MUT_NEW"] }
    !done && $0 == old { done = 1; if (new != "") print new; next }
    { print }
    END { exit(done ? 0 : 1) }' "$1" >"$1.mut" || return 1
  # Copy the CONTENT back rather than moving the temp over the original:
  # a fresh file is created 0644, and `mv` would carry that mode across,
  # leaving a mutated PROGRAM that cannot execute. Every test invoking it
  # directly then died on a permission error and the driver reported the
  # guard as broken-for-the-wrong-reason, which is how this was found,
  # on the very first run. Found by the instrument, in the instrument.
  cat "$1.mut" >"$1" && rm -f "$1.mut"
}

# Run a test under a wall-clock bound. 124 is what timeout(1) reports; without
# timeout(1) the bound is skipped rather than faked, because pretending to
# enforce one would be worse than not having it.
MUT_TIMEOUT=${MUT_TIMEOUT:-120}
MUT_TIMEOUT_RC=124
#
# STDIN COMES FROM /dev/null, AND THAT IS LOAD-BEARING. The corpus is parsed by
# a `while read` loop reading the corpus FILE, so the driver's stdin IS the
# corpus, and every test run from inside that loop inherits it. A test that
# reads stdin then EATS COMPOSED RECORDS: test/mux-sane.t runs script(1),
# which consumes stdin, and it silently swallowed the next two records. The run
# reported 40 of 42 with one record showing an empty filename, which reads like
# a corrupt corpus rather than what it was. The same guard is on the baseline
# run below.
_timed() {   # <test file>
  if command -v timeout >/dev/null 2>&1; then
    timeout "$MUT_TIMEOUT" sh "$1" </dev/null
  else
    sh "$1" </dev/null
  fi
}

# _baseline TEST -> 0 if that test passes on the UNMUTATED tree. MEMOISED for
# the length of one run, which is where this driver's time was going.
#
# MEASURED BEFORE CHANGING ANYTHING (2026-10-01): a full run is 354 records
# naming only 52 DISTINCT tests, so it was doing 708 test runs where 406 would
# do, and the redundancy is not spread evenly. The notifier's baseline ran
# 59 times at 3.71s, `mux-latch`'s 45 times at 5.69s and `mux-agent`'s 33
# times at 5.36s: those three alone are about ELEVEN MINUTES of re-proving
# that an unmutated tree is green. The tree COPY, which looks like the
# expensive part, is 0.01s and was never worth touching.
#
# A FILE PER TEST, because POSIX sh has no associative array and the verdict
# has to survive the subshell each record runs in.
#
# AND IT ASSUMES THE TREE IS STILL FOR THE RUN, which is not a new assumption:
# a mutation run already means nothing if the tree moves under it, which is
# exactly what `muster stamp` brackets it to prove. If that ever stops being
# true the memo is the second thing to go wrong, not the first.
_baseline() {   # <test name>
  _bf=$T/baseline/$1
  # A JUNK OR EMPTY MEMO RE-RUNS rather than being believed. `return ""` is
  # an illegal number, so an interrupted write would otherwise turn a cache
  # miss into a confusing driver error about something else entirely.
  if [ -f "$_bf" ]; then
    _bv=$(cat "$_bf" 2>/dev/null)
    case $_bv in 0|1) return "$_bv" ;; esac
  fi
  mkdir -p "$T/baseline"
  if sh "$HERE/test/$1.t" >/dev/null 2>&1 </dev/null; then
    printf '0' >"$_bf"; return 0
  fi
  printf '1' >"$_bf"; return 1
}

_err() { printf 'ERROR    %s\n' "$1"; shift
  for _l in "$@"; do printf '         %s\n' "$_l"; done
  ERR=$((ERR + 1)); }

_run_one() {   # name file tests old new msg
  _n=$1; _f=$2; _ts=$3; _old=$4; _new=$5; _msg=$6

  [ -f "$HERE/$_f" ] || { _err "$_n: $_f does not exist"; return; }

  # A REPLACEMENT IDENTICAL TO ITS TARGET MUTATES NOTHING, and without this
  # the run reports SURVIVED: indicting the test for not catching a change
  # that was never made. Sixth way a mutation silently no-ops, found
  # 2026-09-26: the corpus is line-based, so a generator that wrote a `\n`
  # into the `+` value produced a replacement equal to the `-` line with the
  # intended second line orphaned below it, where the parser ignored it.
  if [ "$_new" = "$_old" ]; then
    _err "$_n: the replacement is IDENTICAL to the target" \
      "[$_old]" \
      "This mutates nothing, so the named test cannot fail and the" \
      "record would be reported as SURVIVED, blaming the test for" \
      "a change that never happened. One line per directive: a" \
      "multi-line replacement is not supported."
    return
  fi
  _cnt=$(_occurrences "$HERE/$_f" "$_old")
  if [ "$_cnt" = 0 ]; then
    _err "$_n: the line is not in $_f" \
      "looked for: [$_old]" \
      "A stale record leaves the file UNTOUCHED, so every named" \
      "test passes and that reads as 'the guard does not bite'."
    return
  fi
  if [ "$_cnt" -gt 1 ]; then
    _err "$_n: the line appears $_cnt times in $_f" \
      "looked for: [$_old]" \
      "Mutating the first occurrence may not touch the guard the" \
      "named test covers, and a pass would then be meaningless." \
      "Make the record target a line that is unique."
    return
  fi

  # A COPY, never an in-place edit with a restore. An interrupted run must
  # not be able to leave a deliberately broken mux in the working tree,
  # and a restore that misses one of two touched files leaks the mutation
  # into the next record, which is exactly what happened by hand.
  rm -rf "$T/tree"; mkdir -p "$T/tree"
  ( cd "$HERE" && tar cf - --exclude=.git . ) | ( cd "$T/tree" && tar xf - )

  _edit "$T/tree/$_f" "$_old" "$_new" || {
    _err "$_n: the edit did not apply to the copy"; return; }
  _parses "$T/tree/$_f" || {
    _err "$_n: mutated $_f no longer parses" \
      "Invalid shell kills every test it touches on a syntax" \
      "error, which proves nothing about the guard."
    return; }

  _killed=0
  for _t in $_ts; do
    [ -f "$HERE/test/$_t.t" ] || {
      _err "$_n: names test '$_t', which does not exist"
      return; }
    # BASELINE FIRST. "The test failed" only means the mutation did
    # it if the test passed before; otherwise a pre-existing
    # failure is counted as coverage. Memoised per run: see
    # `_baseline`, where the measurement that justifies it lives.
    if ! _baseline "$_t"; then
      _err "$_n: test '$_t' FAILS on the unmutated tree" \
        "A test that is already red cannot tell you anything" \
        "about this guard. Fix the baseline first."
      return
    fi
    # TIME-BOUNDED. A mutation can turn a bounded loop into an
    # unbounded one (removing latch's missing-hook guard drops it
    # into its retry loop, which by default is forever with real
    # sleeps), and an unbounded mutant HANGS THE WHOLE RUN with no
    # output and no diagnosis. That is the worst failure an
    # instrument can have: it looks like slowness, so you wait.
    # A hang is a RESULT, and this reports it as one.
    _out=$(_timed "$T/tree/test/$_t.t" 2>&1) && continue
    if [ "$?" = "$MUT_TIMEOUT_RC" ]; then
      _err "$_n: '$_t' did not finish within ${MUT_TIMEOUT}s" \
        "The mutation probably turned a bounded loop into an" \
        "unbounded one. That is a real finding, but it is not a" \
        "kill: bound the loop in the TEST (a max-tries and a" \
        "no-op sleep) so the guard's absence fails instead of" \
        "hanging."
      return
    fi
    # It died. If the record says WHY, hold it to that, or a
    # mutation that breaks an unrelated assertion counts as cover.
    if [ -n "$_msg" ]; then
      case $_out in
      *"$_msg"*) _killed=1 ;;
      *) _err "$_n: '$_t' died for the WRONG reason" \
           "wanted a failure mentioning: [$_msg]" \
           "got: $(printf '%s' "$_out" | head -1)" \
           "So the mutation broke something other than the" \
           "assertion this record claims to exercise."
         return ;;
      esac
    else
      _killed=1
    fi
  done

  if [ "$_killed" = 1 ]; then
    printf 'killed   %s\n' "$_n"; PASS=$((PASS + 1))
  else
    printf 'SURVIVED %s (%s)\n' "$_n" "$_ts"
    printf '         Nothing noticed this guard being removed, so\n'
    printf '         the test that claims it does not cover it.\n'
    FAIL=$((FAIL + 1))
  fi
}

[ -f "$CORPUS" ] || { echo "mutate: no corpus at $CORPUS" >&2; exit 2; }

# Records are blocks dispatched on a two-character prefix. Read with IFS empty
# and -r so leading whitespace survives exactly: the indentation IS part of an
# exact whole-line match, and getting that wrong is the commonest way a record
# silently stops matching.
ARGC=$#; ARGV="$*"
M_N=; M_F=; M_T=; M_O=; M_P=; M_M=
_flush() {
  [ -n "$M_N" ] || return 0
  _sel=1
  if [ "$ARGC" -gt 0 ]; then
    _sel=0
    for _a in $ARGV; do [ "$_a" = "$M_N" ] && _sel=1; done
  fi
  [ "$_sel" = 1 ] && _run_one "$M_N" "$M_F" "$M_T" "$M_O" "$M_P" "$M_M"
  M_N=; M_F=; M_T=; M_O=; M_P=; M_M=
}
while IFS= read -r _line; do
  case "$_line" in
  '= '*) _flush; M_N=${_line#??} ;;
  'f '*) M_F=${_line#??} ;;
  't '*) M_T=${_line#??} ;;
  '- '*) M_O=${_line#??} ;;
  '+ '*) M_P=${_line#??} ;;
  'm '*) M_M=${_line#??} ;;
  esac
done <"$CORPUS"
_flush

echo ""
printf '%d killed, %d SURVIVED, %d corpus error(s)\n' "$PASS" "$FAIL" "$ERR"
if [ "$FAIL" != 0 ] || [ "$ERR" != 0 ]; then
  echo "mutate: FAILED: a guard nothing kills is not a guard"
  exit 1
fi
if [ "$PASS" = 0 ]; then
  # The rule the suite already applies to itself: a run that reached no
  # verdict is a failure, not a pass. Otherwise an empty corpus, or a
  # filter that matched nothing, reports success.
  echo "mutate: FAILED: no mutations ran at all"
  exit 1
fi
echo "mutate: ok"
