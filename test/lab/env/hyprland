#!/bin/sh
# test/lab/env/hyprland - a headless Hyprland, for focus/hyprland.
#
# See test/lab/README.md for the verb contract and env/sway for the shape
# this follows. Everything below that differs from sway is a fact about
# Hyprland rather than a choice.
#
# IT RUNS, AND THE PIECE THAT WAS MISSING IS ONE IPC CALL. An earlier
# version of this header declared Hyprland un-nestable here and sent it to
# the VM tier. Three of its four measurements still stand and the conclusion
# did not:
#
#   1  THERE IS NO HEADLESS BACKEND TO SELECT. `AQ_BACKENDS` does not exist
#      (aquamarine's are AQ_DRM_DEVICES, AQ_FORCE_LINEAR_BLIT,
#      AQ_MGPU_NO_EXPLICIT, AQ_NO_ATOMIC, AQ_NO_MODIFIERS, AQ_TRACE) and
#      `Hyprland --help` has no flag for it. So it MUST nest on a host
#      display, where sway merely takes a variable.
#   2  SWAY CANNOT BE THAT HOST: nesting on the lab's headless sway 1.11 is
#      refused during handshake with `invalid version for global
#      xdg_wm_base (12): have 5, wanted 6`.
#   3  WAYFIRE CAN. 0.11 on wlroots 0.20 offers xdg-shell 6, so Hyprland
#      starts and its IPC answers.
#   4  AND IT STARTS WITH NO OUTPUT, which is where the old reading stopped:
#      aquamarine's Wayland backend creates none, so Hyprland synthesises
#      `monitor FALLBACK`, which advertises no `wl_output`, and a client
#      answers foot's own `no monitors available`.
#
# `hyprctl output create headless` IS THE ANSWER TO (4), and it is Hyprland's
# own documented verb for adding a fake output. One call and a mode, and
# clients map. So this needs no VM, and the lesson is the cheaper one:
# BEFORE CONCLUDING A TOOL CANNOT DO SOMETHING, ASK WHETHER IT HAS A VERB
# FOR IT. Four measurements made the refusal feel thorough, and the thing
# they did not cover was one line of `hyprctl --help`.
#
# `hyprctl monitors` ANSWERING `unknown request` IS THE NO-OUTPUT STATE, not
# a broken hyprctl: it answers normally once an output exists. Worth knowing,
# because it reads like the tool rather than the state.
#
# MUX_LAB_HYPR_DISPLAY OVERRIDES THE HOST, for a box that has a real
# compositor to nest in and would rather not start one.
#
# --- THE TWO THINGS THAT ARE REALLY DIFFERENT FROM SWAY -----------------
#
# A CLIENT IS LAUNCHED BY THE COMPOSITOR for the reason env/sway records at
# length: a headless compositor creates its own WAYLAND_DISPLAY, so a
# terminal started from outside answers "failed to connect to wayland".
# `hyprctl dispatch exec` is Hyprland's equivalent of `swaymsg exec`.
#
# AND THE QUERIES ARE FLAT JSON, not a tree: `hyprctl -j clients` is a list
# of windows and `hyprctl -j activewindow` is one object, where sway answers
# a recursive tree. That is why this reads them with python inline rather
# than through tree.py, whose header says plainly that it is about the
# sway/i3 shape alone and that a reader guessing between formats is how a
# wrong answer looks like a right one.
#
# THE SIGNATURE IS ASKED FOR, NOT GUESSED: `hyprctl -j instances` reports
# both the instance signature and the `wl_socket` it published, which is the
# only answer that cannot be raced by another compositor starting beside it.
# The previous version took the newest directory under $XDG_RUNTIME_DIR/hypr,
# which is the guess env/sway already records paying for.
#
# AND A CRASHED Hyprland OUTLIVES `down()`: two of them survived a lab run
# because the recorded pid is not the process that lingers. Killed by number
# from `pgrep -x`, never by pattern, and the teardown below sweeps that way.
set -eu

_me=env/hyprland
_dir=${LAB_DIR:-}
_here=$(cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=test/lab/avail_lib
. "$_here/../avail_lib"

_need_dir() { [ -n "${LAB_DIR:-}" ] || {
  echo "$_me: LAB_DIR must be set by the driver" >&2; exit 2; }; }

# ITS OWN RUNTIME DIR, SEPARATE FROM THE HOST'S. Sharing one makes Hyprland
# fail to create its wayland socket (`unable to lock lockfile ... maybe
# another compositor is running`) because the host already holds that name
# there, and it then limps on with a display nobody asked for.
_hyrt=$_dir/hyrt

kind()  { echo wayland; }
hooks() { echo hyprland; }

# FOCUS ONLY, for env/kitty's reason: the toast matrix counts rows of ink in
# a screenshot and a terminal drawing a prompt is ink. env/sway hosts it.
probes() { echo "focus"; }

# ONE TABLE, `tool package` per line; see env/sway. `foot` rather than a
# Hyprland-specific terminal, so the client is the same one every Wayland
# environment here uses and a difference between them cannot be the client.
deps() {
  cat <<'EOF'
Hyprland hyprland
hyprctl hyprland
foot foot
EOF
}

# THE HOST IS A REQUIREMENT, so it is checked here rather than failing in
# `up` as a crash: without a display to nest on there is no backend at all.
available() {
  _avail_from_deps || return 1
  [ -n "${MUX_LAB_HYPR_DISPLAY:-}" ] && return 0
  lab_wayfire >/dev/null 2>&1 || {
    echo "$_me: Hyprland has no headless backend, so it nests on a host
display, and the only one that works here is wayfire (sway offers
xdg_wm_base 5 where Hyprland wants 6). No wayfire on PATH or at
/opt/wayfire/bin. Set MUX_LAB_HYPR_DISPLAY to nest in an existing
compositor instead." >&2
    return 1; }
  return 0
}

# BOTH NAMES, because hyprctl finds the instance's socket under
# $XDG_RUNTIME_DIR/hypr/<sig>: with only the signature set it looks in the
# REAL runtime dir and reports the instance as absent.
_hy() { HYPRLAND_INSTANCE_SIGNATURE="$(cat "$_dir/hysig" 2>/dev/null)" \
  XDG_RUNTIME_DIR="$_hyrt" hyprctl "$@"; }

up() {
  cat >"$_dir/hypr.conf" <<'EOF'
# Deliberately inert: no autostart, no keybindings, no bar. The lab drives
# everything over hyprctl, and anything running here is something that can
# fail for a reason the lab did not ask about.
monitor = , 1280x800@60, 0x0, 1
misc {
    disable_hyprland_logo = true
    disable_splash_rendering = true
    force_default_wallpaper = 0
}
animations {
    enabled = false
}
decoration {
    blur { enabled = false }
    shadow { enabled = false }
}
general {
    border_size = 0
    gaps_in = 0
    gaps_out = 0
}
EOF
  mkdir -p -- "$_hyrt"
  chmod 700 -- "$_hyrt"
  # THE HOST, unless one was named for us. An ABSOLUTE PATH is a legal
  # WAYLAND_DISPLAY, which is what lets the two keep separate runtime dirs.
  if [ -n "${MUX_LAB_HYPR_DISPLAY:-}" ]; then
    _host=$MUX_LAB_HYPR_DISPLAY
  else
    _hs=$(lab_wayfire_up "$_dir") || { echo "$_me: the host wayfire never
published a socket" >&2
      sed 's/^/  /' "$_dir/host.log" >&2; return 1; }
    _host=$_dir/rt/$(basename -- "$_hs" | sed 's/^wayfire-//; s/-\.socket$//')
  fi
  # WAYFIRE_SOCKET and DISPLAY still go: this box runs wayfire, and an
  # inherited handle is how a scratch thing reaches a real one.
  env -u WAYFIRE_SOCKET -u DISPLAY \
    XDG_RUNTIME_DIR="$_hyrt" WAYLAND_DISPLAY="$_host" \
    HYPRLAND_NO_CRASHREPORTER=1 \
    Hyprland -c "$_dir/hypr.conf" >"$_dir/hypr.log" 2>&1 &
  echo "$!" >"$_dir/hypr.pid"
  # THE SIGNATURE IS ASKED FOR. `hyprctl -j instances` answers without one
  # being set, and reports both the signature and the `wl_socket` this
  # instance published, so neither is guessed from a shared directory.
  _i=0
  while [ "$_i" -lt 200 ]; do
    XDG_RUNTIME_DIR="$_hyrt" hyprctl -j instances 2>/dev/null \
      | python3 "$_here/../hyinst.py" "$_dir/hysig" "$_dir/hywd" && break
    _i=$((_i + 1)); sleep 0.05
  done
  [ -s "$_dir/hysig" ] || { echo "$_me: Hyprland never published an
instance (hyprctl -j instances stayed empty)" >&2
    sed 's/^/  /' "$_dir/hypr.log" >&2; return 1; }
  _hy version >/dev/null 2>&1 || { echo "$_me: hyprctl cannot reach the
instance it just started" >&2
    sed 's/^/  /' "$_dir/hypr.log" >&2; return 1; }
  # AND AN OUTPUT IS CREATED, which is the step the whole environment turns
  # on: nested, aquamarine's Wayland backend makes none, so Hyprland sits on
  # `monitor FALLBACK` advertising no `wl_output` and every client refuses
  # with `no monitors available`.
  _hy output create headless >/dev/null 2>&1 || { echo "$_me: Hyprland
refused to create a headless output" >&2; return 1; }
  # POLLED, because the output appears a moment after the call returns, and
  # `monitors` is itself the readiness signal: it answers `unknown request`
  # while there is none.
  _i=0
  while [ "$_i" -lt 120 ]; do
    _mon=$(_hy -j monitors 2>/dev/null \
      | python3 -c 'import json, sys
try:
    m = json.load(sys.stdin)
    print(m[0]["name"] if m else "")
except Exception:
    pass' 2>/dev/null) || :
    [ -n "${_mon:-}" ] && break
    _i=$((_i + 1)); sleep 0.05
  done
  [ -n "${_mon:-}" ] || { echo "$_me: the headless output never appeared" >&2
    return 1; }
  # A MODE, because a created output is 0x0 and a zero-size screen is not
  # somewhere a window can be placed.
  _hy keyword monitor "$_mon,1280x800@60,0x0,1" >/dev/null 2>&1 || :
  # THE HOOK GUARDS ON THIS VARIABLE, so it is published rather than left to
  # the probe to guess: without it focus/hyprland correctly exits 78 and
  # that refusal reads exactly like the matcher failing. XDG_RUNTIME_DIR
  # travels with it, since that is where hyprctl looks for the socket.
  printf 'HYPRLAND_INSTANCE_SIGNATURE=%s\nXDG_RUNTIME_DIR=%s\n' \
    "$(cat "$_dir/hysig")" "$_hyrt" >"$_dir/env"
}

window() {
  # `exec` RATHER THAN A SHELL, and `--` so a title is never read as
  # options. `sleep` holds the window open: a client that exits on a stray
  # EOF mid-assertion reads as the hook having raised nothing.
  _hy dispatch exec -- "foot -T '$(printf '%s' "$1" \
    | sed "s/'/'\\\\''/g")' -- sleep 600" >/dev/null 2>&1
  _i=0
  while [ "$_i" -lt 160 ]; do
    _titles | grep -qxF -- "$1" && return 0
    _i=$((_i + 1)); sleep 0.05
  done
  echo "$_me: a window titled '$1' never appeared" >&2; return 1
}

_titles() { _hy -j clients 2>/dev/null | python3 -c '
import json, sys
try:
    for w in json.load(sys.stdin):
        if w.get("title"):
            print(w["title"])
except Exception:
    pass'; }

focus() { _hy dispatch focuswindow "title:^$(_rex "$1")\$" >/dev/null 2>&1; }
_rex() { printf '%s' "$1" | sed 's/[][\\.*^$(){}?+|/]/\\&/g'; }

focused() { _hy -j activewindow 2>/dev/null | python3 -c '
import json, sys
try:
    print(json.load(sys.stdin).get("title") or "")
except Exception:
    pass'; }

shot() {
  command -v grim >/dev/null 2>&1 || {
    echo "$_me: grim is not on PATH" >&2; return 78; }
  echo "$_me: no display name is published for this environment, so grim
has nothing to capture" >&2
  return 78
}

down() {
  _hy dispatch exit >/dev/null 2>&1 || :
  if [ -f "$_dir/hypr.pid" ]; then
    _p=$(cat "$_dir/hypr.pid")
    case $_p in ([0-9]*) kill "$_p" 2>/dev/null || : ;; esac
  fi
  lab_wayfire_down "$_dir"
  # AND A SWEEP, because HYPRLAND IS TWO PROCESSES and the pid we recorded is
  # only the first: measured, it forks a second that the first's death leaves
  # re-parented to init. One pass is not enough either, and that is the part
  # that took a trace to see: the set CHANGES while the teardown runs, so a
  # single sweep killed the parent and left the child, once per lab run,
  # seven deep before anybody counted.
  #
  # `pgrep -x` MATCHES THE PROCESS NAME, so it cannot match the shell running
  # it, which `-f` would and which this tree has twice killed its own tool
  # shell with. Each candidate is then confirmed against OUR config path, so
  # a real Hyprland session on this box is never a candidate at all.
  _i=0
  while [ "$_i" -lt 40 ]; do
    _left=0
    for _p in $(pgrep -x Hyprland 2>/dev/null || :); do
      case $_p in ([0-9]*) ;; (*) continue ;; esac
      _cl=$(tr '\0' ' ' 2>/dev/null <"/proc/$_p/cmdline" || :)
      case $_cl in
        (*"$_dir/hypr.conf"*)
          _left=1
          # TERM FIRST AND KILL AFTER A SECOND, because a compositor asked to
          # go has a teardown of its own and SIGKILL would leave its socket
          # behind for the next run's `up` to race.
          if [ "$_i" -lt 20 ]; then kill "$_p" 2>/dev/null || :
          else kill -9 "$_p" 2>/dev/null || :; fi ;;
      esac
    done
    [ "$_left" -eq 0 ] && return 0
    _i=$((_i + 1)); sleep 0.05
  done
  echo "$_me: Hyprland would not go away" >&2
  return 0
}

case ${1:-} in
  (kind)      kind ;;
  (hooks)     hooks ;;
  (probes)    probes ;;
  (deps)      deps ;;
  (available) available ;;
  (up)        _need_dir; up ;;
  (window)    _need_dir; shift; window "$1" ;;
  (focus)     _need_dir; shift; focus "$1" ;;
  (focused)   _need_dir; focused ;;
  (shot)      _need_dir; shift; shot "$1" ;;
  (down)      _need_dir; down ;;
  (*) echo "usage: $_me {kind|hooks|probes|deps|available|up|window T|
                 focus T|focused|shot F|down}" >&2
      exit 2 ;;
esac
