= open-invents-a-missing-session
f libexec/mux-window_lib
t mux-agent
# IT NEVER CREATES A SESSION, which is `mux go`'s job: one verb one job. A
# caller that mistyped a session must get `no-such-name` and exit 3, mux's
# cross-cutting code for the condition, rather than a surprise session or
# tmux's own wording to pattern-match. Checked here rather than left to tmux
# precisely so the answer is mux's.
-     MUX_WIN_ERR="no such session: $_mwsess"; return 3; }
+     MUX_WIN_ERR="no such session: $_mwsess"; return 0; }
