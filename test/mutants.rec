f libexec/mux-update-env
t mux-update-env
-       $1 == "set"                         { add[$2] = 1 }
+       $1 == "setx"                        { add[$2] = 1 }
m reported no stale panes at all

# A RUN THAT WALKED NOTHING IS NOT A CLEAN BILL OF HEALTH. `--all` on a box
# with one empty partition, and `work::` naming a partition with no sessions,
# both reach the end having examined nothing.
= update-env-walked-nothing-looks-clean
f libexec/mux-update-env
t mux-update-env
- if [ "$_saw" -eq 0 ]; then
+ if false; then
m a partition with no sessions

# ZERO BYTES IS THE ONE ANSWER A CALLER CANNOT ACT ON, because it is equally
# true of a verb that did its job and of one that resolved no target. The
# same box answered 0 bytes and 2085 bytes from the same state and both were
# misread, once as "scoped wrongly" and once as "a scoping bug".
= update-env-dry-run-says-nothing
f libexec/mux-update-env
t mux-update-env
-     echo "mux: nothing would change ($_saw session(s) examined)"
+     :
