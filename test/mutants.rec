= open-crosses-a-partition-boundary
f libexec/mux-agent
t mux-agent
# AND THIS VERB CROSSES HARDER THAN `send` DOES, which is why it gets its own
# record rather than leaning on send's. `send` types into a pane that already
# exists; opening a window RUNS A COMMAND, and where a partition's boundary
# is a group acquired per session, the children of that server hold it. There
# is deliberately no flag and no policy token that opens this, so the refusal
# reports `override: none`.
-     mux_ctx_crossing "${_rp:-global}" 'open a window across' || {
+     true "${_rp:-global}" 'open a window across' || {
