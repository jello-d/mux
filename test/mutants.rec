= open-selects-the-new-window
f libexec/mux-window_lib
t mux-agent
# THE DEFECT vicus's HAND-ROLLED COPY ACTUALLY HAD, which is the strongest
# argument for the verb existing. Without `-d`, tmux SELECTS the new window,
# and a worker serves the session the human is working in, so EVERY SPAWN
# yanks their view into a worker. A machine verb that moves the human's view
# mid-turn is an interrupt nobody asked for, and it is the one axis on which
# the human and machine presenters genuinely differ.
-   [ "$_mwsw" = 1 ] || set -- "$@" -d
+   [ "$_mwsw" = 1 ] && set -- "$@" -d
