= peers-collapses-the-window
f libexec/mux-agent
t mux-agent
# vicus's R4, and the half of R8 a session-level answer cannot give. A worker
# is a WINDOW in the session it serves, so collapsing a session to its worst
# agent cannot say whether THIS worker is live: it would confidently answer a
# different question, which is worse than the bypass it replaced. With the
# window dropped, every entry for a session reports that session's worst
# state and the two windows become indistinguishable.
-         _se=$(mux_agent_state_win "$_dir" "$_s" "$_wi")
+         _se=$(mux_agent_state "$_dir" "$_s")
