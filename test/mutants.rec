- #     latch-transport  et %h --port %p:2022 --command %c
+ #     latch-transport  et -t %h --port %p:2022 --command %c
m documented line passes

= et-probe-closed-port-waits
f share/latch/et-probe
t mux-latch-et
-   1)   exit 1 ;;
+   1)   exit 0 ;;
m closed etserver port must answer 1

= et-probe-no-nc-does-not-park-latch
f share/latch/et-probe
t mux-latch-et
- command -v nc >/dev/null 2>&1 || exit 0
+ command -v nc >/dev/null 2>&1 || exit 78
m it must answer 0

= et-probe-tests-ets-port
f share/latch/et-probe
t mux-latch-et
-   ''|*[!0-9]*) _port=2022 ;;
+   ''|*[!0-9]*) _port=2222 ;;
m default port

= latch-bare-arg2-is-a-session
f libexec/mux-latch
t mux-latch
# THE MOST VALUABLE GUARD IN THE 0.84 GRAMMAR. A bare second argument reading as
# a PARTITION is the direction that silently resumes the wrong set while looking
# like success, which this file has shipped once before.
#
# The `%s` SUBSTITUTION CASE SEES IT FIRST, which is why `m` names that one:
# with the session emptied, `%s` falls back to the host and the earlier template
# test
# dies before the grammar block is reached. Naming the grammar assertion would
# make this record fail for being caught too early.
#
# RE-ANCHORED when arg 2 moved to the shared parser: the case arm became an
# assignment from MUX_ADDR_SESS, and the rider caught the rewording on the
# next suite run rather than letting the record silently stop matching.
-   _sess=$MUX_ADDR_SESS
+   _part=$MUX_ADDR_SESS
m host and session were not substituted

= latch-lock-key-keeps-the-session
f libexec/mux-latch
t mux-latch
# Caught by the SINGLE-FLIGHT case before the registry one: with the session
# gone from the key, `latch box proj` no longer sees the seeded lock, which IS
# the collision this guard prevents.
- _lockkey=$_host${_part:+ $_part}${_sess:+ $_sess}
+ _lockkey=$_host${_part:+ $_part}
m a concurrent latch should refuse

= latch-port-default-from-template
f libexec/mux-latch
t mux-latch
-         _wp=$(printf '%s' "$_wp" | sed "s|%p:$_pdef|${_port:-$_pdef}|g") ;;
+         _wp=$(printf '%s' "$_wp" | sed "s|%p:$_pdef|$_port|g") ;;
m must fall back to the template

= latch-port-must-be-numeric
f libexec/mux-latch
t mux-latch
# Widening the pattern so a word passes as a port turns the old spelling
# `box:work` into a host `box` on a port `work`: dialled, plausible and wrong,
# instead of refused with the migration. A no-op mutation was tried first here
# (adding a character to the negated class that the fixture never contains),
# which SURVIVED and proved nothing: the replacement has to change the path
# the fixture actually takes.
-       *[!0-9]*)
+       *[!0-9a-z]*)
m pre-0.84 target form must exit 2

= latch-ipv6-is-not-split
f libexec/mux-latch
t mux-latch
# Requiring a THIRD colon sends `fe80::1` down the single-colon arm, where the
# tail is digits, so it splits into host `fe80:` and port `1`, a host that
# does not exist, dialled while looking like it worked.
-   *:*:*)
+   *:*:*:*)
m IPv6 literal must be left whole

= undo-pane-unwrapped-display-form
f libexec/mux-undo-pane
t mux-undo-pane
# tmux 3.4 escapes `pane_start_command` WITHOUT wrapping it in quotes, 3.6 wraps
# and escapes. Treating the wrapper as the signal returned 3.4's form verbatim,
# so a restored pane exec'd a program literally named `${SHELL:-/bin/sh}`:
# created, silent, wrong, on every Ubuntu LTS box. The assertion is a unit on
# BOTH measured literals and sits AHEAD of the tmux skip, so it cannot depend on
# which tmux this machine has, which is where the bug hid.
-     '"'*'"') _uq=${_uq#\"}; _uq=${_uq%\"} ;;
+     '"'*'"') return 0 ;;
m did not round-trip

= scan-init-writes-without-a-terminal
f libexec/mux-scan
t mux-scan-init
# A provisioner runs `setup.sh install` on every sweep with no tty. Without
# this branch `read` takes EOF and the default is written unasked, so with no
# ~/src a machine would index its whole HOME: the same defect as the shipped
# `scan ~/src 3`, reached from the other side.
#
# NOTE THE REFUSAL IS NO LONGER UNCONDITIONAL, which this comment used to
# imply. With ~/src PRESENT the no-terminal path deliberately records it, and
# `scan-init-no-terminal-records-src` below guards that half. The split exists
# because $HOME is invented and an existing ~/src is observed.
-       if [ ! -t 0 ] || [ ! -t 1 ]; then
+       if false; then
m must exit 2

= scan-init-no-terminal-records-src
f libexec/mux-scan
t mux-scan-init
# THE OTHER HALF OF THE NO-TERMINAL SPLIT, and the regression it closes was
# reported from a real box. 0.85 removed the shipped `scan ~/src 3`, correctly,
# because a shipped LOCATION fails on every machine that keeps work elsewhere.
# But the replacement could only run at a terminal, and the only install path
# on a provisioned fleet has none: it printed a note nobody read and did
# nothing, so discovery went from working to OFF and `mux go <newrepo>` stopped
# finding anything. Making the refusal unconditional again restores exactly
# that silence.
-         if [ "$_def" = "$HOME" ]; then
+         if true; then
m with ~/src present and no terminal it must record

= scan-init-is-not-idempotent
f libexec/mux-scan
t mux-scan-init
# Running it twice must not give the partition two roots: every scan would then
# cover the same tree twice and the map would read as a mux that cannot count.
-     if [ -n "$_have" ]; then
+     if false; then
m added another root

= scan-init-overwrites-a-config
f libexec/mux-scan
t mux-scan-init
# THE ONE UNRECOVERABLE MISTAKE AVAILABLE HERE. A partition file may already
# carry a label, a theme or a layout, so the bootstrap appends and never
# rewrites. Inverting the test makes it clobber somebody's config.
-     if [ ! -e "$_pf" ]; then
+     if true; then
m DESTROYED an existing setting

= scan-init-hardcodes-src
f libexec/mux-scan
t mux-scan-init
# `~/src` is OFFERED when it exists and never assumed. Hardcoding it is the
# original defect: a location nobody chose, which then failed mux's own check on
# every machine that keeps work somewhere else.
#
# THE KILL MOVED when the no-terminal branch was split by whether ~/src
# exists, and the record was updated rather than the code: hardcoding the
# default now means `$_def` is never equal to `$HOME`, so the refusal is
# skipped entirely and the run dies on `[ -d "$_want" ]` instead. It still
# exits 2, so the exit-code assertion passes and the one about the refusal's
# WORDING is what fires. Reported by the corpus as a wrong-reason kill, which
# the anchor rider cannot see.
-     [ -d "$HOME/src" ] && _def=$HOME/src
+     _def=$HOME/src
m the refusal did not say why

= install-never-mentions-discovery
f setup.sh
t setup
# The installer says when discovery has no roots, and is SILENT once it has
# some. Returning early always makes a new user get a mux whose `mux go <name>`
# finds nothing, with no hint why: the state this step exists to end.
-   "$_bin/$PKG" scan --roots >/dev/null 2>&1 && return 0
+   return 0
m said nothing about discovery

= check-probe-creates-a-server
f libexec/mux-check
t mux-check
# `tmux list-keys` STARTS a server when none is running and answers from tmux's
# DEFAULTS, so probing with it meant the no-server branch could never fire: on a
# bare box `mux check` SPAWNED a server and then reported five FAILs about the
# pristine thing it had just made. Reverting to that probe makes a serverless
# box take the server branch, which the real-tmux case at the end of the test
# catches by asking whether a server now exists.
- if ! _vt list-sessions >/dev/null 2>&1; then
+ if [ -z "$(_vt list-keys -T prefix 2>/dev/null || true)" ]; then
m the check did not say so

= env-plan-truncates-on-an-invalid-name
f lib/mux-env_lib
t mux-wire
# UNDER `set -e` A BARE NON-ZERO CALL KILLS THE LOOP, and this loop runs inside
# `$( )`, so the plan TRUNCATED at the first INVALID name and every name after
# it alphabetically was never considered. Live on both boxes the day the marker
# shipped: four names resolved, two reported. The fixture's dead name sorts
# FIRST, which is the whole fixture: with the order reversed a truncating loop
# still answers correctly about everything it reached.
-     mux_env_validate "$_epn" "$_epv" || _epvr=$?
+     mux_env_validate "$_epn" "$_epv"
m verdicts for two names

= env-apply-truncates-on-an-invalid-name
f lib/mux-env_lib
t mux-wire
# THE SAME SHAPE IN THE WORSE PLACE: `bin/mux` calls mux_env_apply on every
# session build and every attach, both under `set -eu`, so ONE dead value
# stopped the repair for every name alphabetically after it and the session
# came up missing pointers mux had resolved perfectly well. Separately
# killable from the plan record because the plan is a different function, so
# the earlier assertion passes and this one fires.
-       mux_env_validate "$_eaname" "$_eahave" || _eavr=$?
+       mux_env_validate "$_eaname" "$_eahave"
m was not applied, so

= update-env-stale-names-a-withheld-value
f libexec/mux-update-env
t mux-update-env
# A PANE IS STALE RELATIVE TO WHAT THE SESSION HOLDS, never to the name list.
# Without this guard every pane was reported stale for a name mux had
# DELIBERATELY WITHHELD: measured live, 18 panes named for WAYLAND_DISPLAY on
# a box where nothing listens to it, advising a restart that could never
# supply it, printed beside a real finding about SSH_AUTH_SOCK. Advice that
# cannot come true is this package's oldest defect class.
#
# THE KILL MOVED when the DRY mode learned to report stale panes: the same
# walk now runs in both modes and the preview's copy of this assertion fires
# first. One line, two cases, so the real-mode twin is not separately
# killable by it; both are kept because a bug reaching only one mode is
# exactly what gap this closed.
-         *) continue ;;
+         *) ;;
m named a pane stale for a value the run is about to

= update-env-dry-run-writes
f libexec/mux-update-env
t mux-update-env
# `-n` MUST GO THROUGH THE SAME DECISION AND ACT ON NOTHING. The flag lives
# inside mux_env_apply so the preview cannot be computed by a different code
# path from the action; losing the -n hand-off makes a dry run WRITE, which is
# worse than having no preview at all, because the caller trusted it. The
# assertion is on the SESSION rather than the output, since "would set" is
# equally printable by a run that also set it.
-   [ "$_dry" -eq 0 ] || _mode=-n
+   _mode=$_mode
m DRY RUN WROTE TO THE SESSION

= update-env-window-refusal-succeeds
f libexec/mux-update-env
t mux-update-env
# A REFUSAL THAT EXITS 0 IS THE SIGNATURE FAILURE OF THIS CODEBASE, and this
# verb shipped with it: the validation used to sit in `_targets`, which the
# pane loop reads through a here-doc, so `exit 2` left only the SUBSHELL. The
# message printed, the substitution came back empty, and the script ran on to
# report "nothing needed changing" and exit 0. Same shape as `mux latch -V`.
# The test asserts the CODE, which is the only observable that differs.
-     exit "$MUX_EC_USAGE"; }
+     : ; }
m a WINDOW field must be refused

= envhook-wayland-probes-its-own-environment
f share/envhooks.d/WAYLAND_DISPLAY
t mux-envhooks
# THE VALUE UNDER TEST MUST BE HANDED TO THE TOOL. A bare `wayland-info`
# probes `$WAYLAND_DISPLAY` from the HOOK's own environment, which is the very
# thing being judged and is routinely absent (a login shell over ssh, a
# systemd unit, an agent pane). It then defaults to wayland-0, finds nothing,
# and calls the display it was ASKED about dead. Measured on both boxes, where
# the live display is wayland-1, and `mux update-env --all` would then have
# removed a working display from every session. The assertion is on what the
# stub was ASKED, not on the verdict: an outcome check passes on the broken
# code wherever the environment happens to name the right display.
-   WAYLAND_DISPLAY=$1 XDG_RUNTIME_DIR=$_d $_wi >/dev/null 2>&1 || exit 1
+   $_wi >/dev/null 2>&1 || exit 1
m PROBED THE WRONG DISPLAY

= envhook-wayland-guesses-with-no-tool
f share/envhooks.d/WAYLAND_DISPLAY
t mux-envhooks
# NO TOOL IS NOT A VERDICT. The socket exists and nothing on the box can say
# whether anyone is behind it, so the answer is 2 and mux leaves the value
# alone. Answering 1 makes a machine with neither wayland-info nor nc lose a
# working display, which is latch's own recorded trap (a probe site that read
# "cannot tell" as a decision) met from the other side.
- exit 2
+ exit 1
m CANNOT TELL (2)

= update-env-preview-uses-the-past-tense
f libexec/mux-update-env
t mux-update-env
# A PREVIEW MUST READ AS A PREVIEW. mux_env_apply reports what it DID, so
# prefixing "would " onto its words printed `would dropped WAYLAND_DISPLAY`,
# which is how it read on a live box. `set` is the only one of the three that
# works in both tenses, which is exactly why this looked right for a release:
# the common case is the one word that hides it.
-         dropped)  _l="drop ${_l#* }" ;;
+         dropped)  : ;;
m would dropped

# THE DRY RUN SEES THE PANES A RESTART CANNOT AVOID, and sees the RIGHT ones.
# Two records because they break different things: one removes the report,
# the other feeds it the wrong question.
= update-env-dry-hides-stale-panes
f libexec/mux-update-env
t mux-update-env
- if [ -s "$_stalef" ]; then
+ if [ "$_dry" -eq 0 ] && [ -s "$_stalef" ]; then
m reported no stale panes at all

# NOTHING IS WRITTEN IN DRY MODE, so the session still holds its OLD set and
# a pane compared against that is stale for yesterday's question. The name
# the run is ABOUT to set is exactly the one every existing pane lacks, so
# without this the preview goes quiet about the only pane it matters for.
