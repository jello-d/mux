= window-guesses-a-session-outside-tmux
f libexec/mux-window
t mux-window
# DOING NOTHING IS NOT NEUTRAL HERE, which is why the guard exists at all:
# tmux's own default target is the most recently CREATED session (measured
# while chasing even-only-current-window), so an unqualified call outside
# tmux hands the window to whichever session happened to be newest and says
# nothing. Plausible, wrong, silent, with tmux supplying the plausibility.
# The refusal prints the qualified spelling instead.
-   [ -n "${TMUX:-}" ] || {
+   true || {
