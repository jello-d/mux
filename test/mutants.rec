= payload-restage-destroys-the-venv
f setup.sh
t setup
# THE VENV LIVES INSIDE THE PAYLOAD and the swap REMOVES the old payload, so
# without the carry every re-install destroys it and `bin/mux-indicator`
# points at nothing. It bites because the two steps are SEPARATE modules in a
# provisioner: a core install alone (every sweep that does not also touch the
# indicator) leaves the unit's ExecStart dangling, and `mux check` cannot say
# so because the indicator is a different package.
#
# `_place-conversion.md` named this against mux specifically and left it as
# mux's call; this is the call. hush's shape (f39b763), which that file says
# to copy rather than inventing one.
-   if [ -d "$_pay/venv" ] && [ ! -e "$_ps_new/venv" ]; then
+   if false && [ ! -e "$_ps_new/venv" ]; then
