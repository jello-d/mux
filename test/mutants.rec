= log-header-not-gated-on-a-terminal
f libexec/mux-log
t mux-log
# THE QUIET HALF IS THE CONTRACT. The path is not log content, so a pipe, a
# redirect and a `2>&1` capture must all be byte-identical to before.
# Ungating this was the FIRST version and the suite killed it immediately: an
# earlier case in the same file counts `-n 2` through a helper that folds
# stderr into stdout, and it saw three lines. Any real consumer reading
# `mux log 2>&1` would gain a line the same way.
#
# THE KILL LANDS ON THAT PRE-EXISTING CASE rather than on the one written for
# this feature, and the `m` names it deliberately: an EXISTING consumer
# breaking is better evidence than a new assertion agreeing with its author.
- [ -t 2 ] && printf 'mux: log at %s\n' "$_f" >&2
+ printf 'mux: log at %s\n' "$_f" >&2
