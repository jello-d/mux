= class-direction-inverted
f libexec/mux-agent
t mux-agent
# THE DIRECTION IS THE WHOLE RULE, so inverting it is the mutation that
# matters most: escalation (the case R3 was written for) would then need a
# human at a terminal, and relaxing a pane to `agent` would be free to any
# machine. Both halves wrong at once, from one comparison.
-     if [ "$(mux_class_rank "$_mv")" -lt "$(mux_class_rank "$_was")" ]; then
+     if [ "$(mux_class_rank "$_mv")" -gt "$(mux_class_rank "$_was")" ]; then
