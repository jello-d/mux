#!/bin/sh
# test/run - run every mux shell test (test/*.t) and report. Non-zero if any
# test fails. POSIX sh, no dependency beyond a shell and the repo checkout.
set -eu
_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
_rc=0
_silent=
for _t in "$_dir"/*.t; do
  [ -f "$_t" ] || continue
  _n=$(basename "$_t" .t)
  # EVERY TEST MUST REPORT A VERDICT, and a test that exits non-zero
  # WITHOUT printing one is the case this catches. It happened the moment
  # `mux why` started exiting 3: two files captured it in an unguarded
  # command substitution, `set -e` killed them mid-run, and they simply
  # VANISHED from the output. The summary said some test failed and named
  # none, and the only way to find them was to diff the list of files
  # against the list of `ok` lines by hand. Twice.
  #
  # The same rule the suite applies to everything else, turned on itself:
  # a run that reached no verdict is a failure, and it has to say WHICH.
  _out=$(sh "$_t" 2>&1) || _rc=1
  printf '%s\n' "$_out"
  case $_out in
  *"ok   $_n"*|*"skip $_n"*|*FAIL*) ;;
  *) _rc=1; _silent="$_silent $_n" ;;
  esac
done
if [ -n "$_silent" ]; then
  printf '\nNO VERDICT from:%s\n' "$_silent"
  printf 'Each exited without printing ok/skip/FAIL, so it neither\n'
  printf 'passed nor reported why. The usual cause is `set -e` plus an\n'
  printf 'unguarded $(...) around a command that now exits non-zero:\n'
  printf 'add `|| true` where the output is what is wanted.\n'
  # AND THEN IT SAYS WHERE, by re-running the test under `sh -x` and printing
  # the tail of the trace. Naming the file was the old fix and it is only half
  # of one: under `set -e` the shell dies with no output at all, so "mux-kill
  # went quiet" is where the investigation STARTS and there is nothing to go on.
  #
  # THE REASON THIS IS WORTH THE RE-RUN: the deaths that matter are the ones you
  # cannot reproduce, and every one so far has been on a machine somebody else
  # owns. macOS CI has reported two silent tests for days, and the trace is the
  # difference between a guess about BSD tools and the failing command.
  #
  # ONE FILE'S INSTRUMENTATION DOES NOT SCALE, which is the other half. This
  # suite already carries a hand-rolled `stage` tracker in mux-undo-pane.t for
  # exactly this problem; `sh -x` gives every test the same thing for free and
  # keeps working on tests nobody has thought about yet.
  #
  # ONLY ON THE FAILURE PATH, so a green run pays nothing.
  for _n in $_silent; do
    printf '\n--- %s, last 15 lines of `sh -x` -------------------------\n' \
      "$_n"
    sh -x "$_dir/$_n.t" 2>&1 | tail -15
  done
fi
if [ "$_rc" -ne 0 ]; then
  # A FAILURE SUMMARY AT THE END, because the per-test lines scroll and a
  # failure is printed FIRST when the failing test sorts early. `lint`
  # sorts first, and eight releases went out red while `test/run | tail`
  # showed a reassuring `ok setup`. The verdict has to be the last thing
  # on screen, not the first.
  printf 'SOME MUX TESTS FAILED. Scroll up, or: sh test/run | grep FAIL\n'
fi
if [ "$_rc" -eq 0 ]; then
  echo "all mux tests passed"
  # The corpus VALIDATOR ran above (test/mutants.t); the mutations
  # themselves take minutes, so they stay an explicit command. Say so, or
  # a green suite reads as "every guard is confirmed to bite" when only
  # the corpus-vs-code agreement was checked.
  echo "note: guards are confirmed by 'sh test/mutate' (slower, separate)"
fi
exit "$_rc"
