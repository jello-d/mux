#!/bin/sh
# mux-themes: compile the mux colour palette from themes/*.theme into tmux
# @theme-* options, so the palette is authored as data beside the layouts
# instead of inline in tmux.conf. mux-style reads those options live every
# status tick; it neither knows nor cares that they came from files.
#
# Fragments are resolved through the shared overlay rule (mux-data.sh): the
# shipped set in $MUX_SHARE/themes, with anything in $MUX_DIR/themes replacing
# a shipped fragment of the same name and adding any name of its own. So the
# palette the SERVER gets is the same set `mux help colors` lists.
#
#   mux-themes load   push the palette to the AMBIENT tmux server ($TMUX) and
#                     stamp it. Run from tmux.conf `run-shell` at server start,
#                     and again whenever `mux reload` re-sources tmux.conf.
#   mux-themes sync   drift-heal: for each running mux server (the default
#                     socket, plus any context socket that is up), push it
#                     IFF the fragments changed since that server was last
#                     stamped. Run by the mux front end on every invocation -- a
#                     cheap no-op when nothing changed, so edits need no reload.
#
# A theme fragment themes/<name>.theme has up to six keys: `bar` (the status-bar
# style), `window` (the current-window chip), `accent` (the ACTIVE pane border),
# `border` (INACTIVE pane borders), `select` (copy-mode selection / mode-style),
# and `prompt` (the command prompt, message-command-style). Only bar/window/
# accent are required; mux-style derives border/select/prompt when a theme omits
# them (dim border, select = the window chip, prompt = the bar). Which theme a
# session gets is resolved by the front end from its context (see
# mux-context.sh), not here: this only compiles the palette. Unknown keys fail
# loud.
# The per-socket stamp lives under mux's own cache dir; a content hash gates the
# push so an unchanged palette is free. $MUX_CACHE overrides it so an integrator
# can point it wherever it keeps runtime stamps.
set -eu

MUX_DIR=${MUX_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/mux}
# The shipped defaults root -- the FALLBACK set, which the $MUX_DIR overlay
# may override per fragment (see mux-data.sh). Inherited from the mux entry
# point; self-located as a fallback (share/ is a sibling of libexec/).
MUX_SHARE=${MUX_SHARE:-$(dirname "$0")/../share}

# Where mux keeps things (see mux-paths.sh), so the stamp directory is derived
# in one place rather than spelled out here. Required, not optional: a fallback
# would be a second copy of the very rule that lib exists to hold.
_paths=$(dirname "$0")/mux-paths.sh
[ -r "$_paths" ] || {
	echo "mux-themes: $_paths missing (incomplete install)" >&2; exit 1; }
. "$_paths"
# AFTER the source, obviously, and it was not: assigning this above the `.` line
# left STAMPDIR empty and every stamp read and write landed at `/mux-themes...`.
STAMPDIR=$(mux_cache_dir)

# The shared $MUX_DIR-over-$MUX_SHARE resolver (see mux-data.sh), so a theme
# dropped in $MUX_DIR/themes is COMPILED, not just listed -- the palette the
# server gets and the palette the help shows come from one resolution.
_data=$(dirname "$0")/mux-data.sh
[ -r "$_data" ] || {
	echo "mux-themes: $_data missing (incomplete install)" >&2; exit 1; }
. "$_data"

# The shared comment/normalize rule (see bin/mux); a fallback strips only
# whole-line comments so a missing lib never breaks a palette push.
_conf=$(dirname "$0")/mux-conf.sh
if [ -r "$_conf" ]; then . "$_conf"
else mux_conf_clean() { grep -vE '^[[:space:]]*(#|$)'; }
fi
# The context seam (see mux-context.sh): `sync` heals every non-default context
# server the hook names. A stub yields none (only the default server) if absent.
_ctx=$(dirname "$0")/mux-context.sh
if [ -r "$_ctx" ]; then . "$_ctx"
else mux_ctx_partitions() { echo global; }
fi

# Every file the palette is compiled FROM: the resolved fragments plus the
# resolved defaults file. Resolved, so an overlay fragment REPLACES its shipped
# twin rather than being pushed after it.
theme_inputs() {
	mux_data_files themes .theme
}

# Content hash over that resolved set (paths and bytes, since sha256sum prints
# the path), so an edit, a rename, or an overlay fragment appearing or being
# removed all move it. An empty set hashes to a constant -- pushing nothing,
# which is safe.
themes_hash() {
	_tf=$(theme_inputs)
	[ -n "$_tf" ] || { echo none; return 0; }
	printf '%s\n' "$_tf" | LC_ALL=C sort | xargs -r sha256sum \
		| sha256sum | cut -d' ' -f1
}

# Push every fragment's styles as @theme-<name>-bar/-window, plus the per-mode
# defaults, to the server addressed by "$@" (tmux args: none for the ambient
# server, or -L <sock> for a named one). An unknown key fails loud.
push_palette() {
	# Normalize each fragment via mux_conf_clean into a temp (comments, inline
	# ` #`, trailing space, CRLF), then read from the FILE so a bad-key exit
	# aborts. #rrggbb survives (only WHITESPACE-hash begins a comment). A bad-key
	# exit leaks the temps, but it aborts the whole run, so that is moot.
	#
	# The resolved fragment LIST goes through a file for the same reason: a
	# `for _f in $(...)` would split a path containing a space, and piping
	# into `while read` would put the bad-key exit in a subshell, which would
	# carry on rather than abort.
	_ct=$(mktemp)
	_fl=$(mktemp)
	mux_data_files themes .theme >"$_fl"
	while IFS= read -r _f; do
		_name=${_f##*/}
		_name=${_name%.theme}
		mux_conf_clean < "$_f" > "$_ct"
		while read -r _k _v; do
			case $_k in
			bar) tmux "$@" set -g "@theme-$_name-bar" "$_v" ;;
			window) tmux "$@" set -g "@theme-$_name-window" "$_v" ;;
			accent) tmux "$@" set -g "@theme-$_name-accent" "$_v" ;;
			border) tmux "$@" set -g "@theme-$_name-border" "$_v" ;;
			select) tmux "$@" set -g "@theme-$_name-select" "$_v" ;;
			prompt) tmux "$@" set -g "@theme-$_name-prompt" "$_v" ;;
			*)
				echo "mux-themes: $_f: bad key: $_k" >&2
				exit 1 ;;
			esac
		done <"$_ct"
	done <"$_fl"
	rm -f "$_fl"
	rm -f "$_ct"
}

# Record socket KEY as synced to HASH.
stamp_write() {         # KEY HASH
	mkdir -p "$STAMPDIR"
	printf '%s\n' "$2" >"$STAMPDIR/mux-themes.$1.sha"
}

# Drop stamps whose socket has no server behind it any more.
#
# EVERY tmux server that sources mux.tmux writes one of these, including the
# throwaway `-L scratch` servers a test suite spins up, and nothing ever removed
# one. 60 had accumulated here from 59 dead sockets: not harmful, but it is
# litter mux made and mux should clear, and a directory that only grows is one
# nobody will ever audit.
#
# HERE is the right moment because it is the only one that needs no decision. A
# prune verb would need remembering and a timer would need installing, whereas
# `load` runs whenever a server starts -- so every new server tidies away the
# dead ones and the steady state is however many servers you actually have.
#
# The liveness test is the same one heal() uses. A server mid-startup may not
# answer and lose its stamp, which costs nothing: the stamp is a cache, and the
# next load rewrites it. That is also why this never touches anything but
# stamps.
prune_stamps() {
	[ -d "$STAMPDIR" ] || return 0
	for _ps in "$STAMPDIR"/mux-themes.*.sha; do
		[ -e "$_ps" ] || continue
		_pk=${_ps##*/mux-themes.}
		_pk=${_pk%.sha}
		[ -n "$_pk" ] || continue
		tmux -L "$_pk" list-sessions >/dev/null 2>&1 || rm -f "$_ps"
	done
	return 0
}

# Heal one server: KEY names it (for the stamp), ARGS addresses it. Skip when
# its stamp already matches, or when no server is up on that socket.
# $2 is the tmux socket ARGS -- `-L work`, two words -- so it must word-split.
# shellcheck disable=SC2086
heal() {                # KEY ARGS HASH
	_stamp="$STAMPDIR/mux-themes.$1.sha"
	[ "$(cat "$_stamp" 2>/dev/null || true)" = "$3" ] && return 0
	tmux $2 list-sessions >/dev/null 2>&1 || return 0
	push_palette $2
	stamp_write "$1" "$3"
}

case "${1:-}" in
load)
	# Ambient server: push honouring $TMUX, stamp under its socket name.
	_key=$(tmux display-message -p '#{socket_path}' 2>/dev/null || true)
	_key=${_key##*/}
	[ -n "$_key" ] || _key=default
	push_palette
	stamp_write "$_key" "$(themes_hash)"
	# After the stamp, never before: a failure here must not cost the
	# server the palette it just loaded.
	prune_stamps
	;;
sync)
	_h=$(themes_hash)
	# The global partition is addressed as -L global (unambiguous -- never
	# the ambient $TMUX server, which may be another partition's).
	heal global "-L global" "$_h"
	# Plus every non-default context server the hook names, each healed only
	# if it is up.
	# Line by line: a partition name may contain a space, and splitting it
	# would heal two servers that do not exist while missing the real one.
	while IFS= read -r _s; do
		[ -n "$_s" ] || continue
		heal "$_s" "-L $_s" "$_h"
	done <<EOF
$(mux_ctx_partitions)
EOF
	;;
''|list)
	# Bare `mux themes` LISTS them. It used to print an internal usage
	# string -- a helper's business, not an answer to the obvious question
	# asked of a verb one character away from `mux theme`.
	printf 'themes:\n'
	mux_data_stems themes .theme | tr '\n' ' ' | fold -s -w 70 \
		| sed -e 's/^/  /' -e 's/[[:space:]]*$//'
	printf '\n'
	_d=$(mux_data_find themes defaults '')
	if [ -n "$_d" ]; then
		printf 'default: %s' \
			"$(mux_conf_clean <"$_d" | awk '$1=="default"{print $2;exit}')"
		_dv=$(mux_conf_clean <"$_d" | awk '$1=="derive"{print $2;exit}')
		[ -n "$_dv" ] && printf '  (unset themes: %s)' "$_dv"
		printf '\n'
	fi
	printf 'swatches: mux help colors\n'
	;;
prune)
	# The same sweep `load` does, on demand. Exposed as a verb for two
	# reasons: it is the only way to TEST the prune without an ambient
	# server to hang a load off, and it is the escape hatch for a box that
	# accumulated stamps before this existed (60 of them, here).
	prune_stamps
	;;
*)
	echo "usage: mux themes [load|sync|list|prune]" >&2
	exit 2 ;;
esac
