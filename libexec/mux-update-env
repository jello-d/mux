#!/bin/sh
# mux-update-env: bring a LIVE session's environment up to date.
#
#   mux update-env [ADDRESS] [--all] [-n]
#
# WHY THIS VERB EXISTS. Everything else about the environment work happens when
# a session is BUILT or ATTACHED, which covers every session created from now
# on and none of the ones already running. Without this, the remedy for a box
# whose sessions were poisoned before any of it existed is "kill the tmux
# server", and for a session manager that is not a remedy: it is the difference
# between recovering a machine in place and losing every session on it.
#
# It is also what a newly added hook, or a validator whose bug has just been
# fixed, reaches sessions with. The build path cannot help there, because the
# sessions are already up.
#
# NAMED LITERALLY AND NOT `repair`, because it is not one. It is scoped to the
# names in envhooks.d, it acts only where a session lacks a working value, and
# it acts only after validation, so it can do nothing it should not already
# have done at build time.
#
# ---------------------------------------------------------------------------
# WHAT IT ACTS ON, which is where the care is
#
# THE DEFAULT IS THE CURRENT SESSION, not a sweep, and that changed with R9.
# While this verb CONVERGED every session onto one answer, sweeping everything
# was the natural default. Now that it only repairs what is broken, a wide
# sweep is the bigger hammer and wants asking for. So recovering a whole box
# is an explicit `--all`, which is the right way round.
#
# NAMING A SESSION YOU ARE NOT IN IS ORDINARY, not a mistake. Working on one
# session from inside another is routine here (`mux go <other>` from within a
# session is the common case), so a guard that assumed "the session you are in
# is the session you mean" would be wrong about normal use.
#
# AND IT ONLY COMPLAINS WHEN THERE IS GENUINELY NOTHING TO ACT ON. Inside a
# session with no argument the current session is the obvious subject and this
# just works. OUTSIDE any session with no argument there is no subject at all,
# and that is the one case that must say so and stop rather than guess or
# silently widen to everything. Silently widening would be the worst of the
# three, because it would act on sessions the caller never named.
#
# A WINDOW FIELD IS REFUSED RATHER THAN IGNORED. tmux's environment is per
# SESSION and per server; there is no per-window environment for this to act
# on. Accepting `work::api:2` and quietly treating it as `work::api` would be a
# flag that parses and does nothing, which this package has already shipped
# once and which is worse than a missing one, because the caller believes it
# asked for something.
#
# ---------------------------------------------------------------------------
# THE HONEST LIMIT, included rather than hidden
#
# A RUNNING PROCESS'S ENVIRONMENT IS FIXED AT EXEC and cannot be changed from
# outside. So this can only ever affect panes created AFTERWARDS, and it must
# not report otherwise. It can be precise about what is left, because the data
# is there: every pane's pid is a format away and /proc/<pid>/environ says what
# that pane actually has. So it NAMES the stale panes rather than leaving the
# user to discover that "updated" did not mean their running agent was fixed.
#
# ON A BOX WITH NO /proc THAT QUESTION IS UNANSWERABLE, and saying nothing
# would be the wrong answer twice over: it would read as "no stale panes". It
# says it cannot tell instead, which is the same three-answer discipline the
# validators follow.
set -eu

_self=$(command -v -- "$0" 2>/dev/null || printf '%s' "$0")
_self=$(readlink -f -- "$_self" 2>/dev/null || printf '%s' "$_self")
_libexec=${_self%/*}
_lib=$_libexec/../lib
[ -r "$_lib/mux-exit_lib" ] \
  || { echo "mux: $_lib/mux-exit_lib missing" >&2; exit 1; }
# shellcheck source=/dev/null
. "$_lib/mux-exit_lib"
MUX_DIR=${MUX_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/mux}
MUX_SHARE=${MUX_SHARE:-$_lib/../share}
[ -d "$MUX_SHARE" ] || MUX_SHARE=$_lib/../share
. "$_lib/mux-paths_lib"
. "$_lib/mux-conf_lib"
. "$_lib/mux-addr_lib"
. "$_lib/mux-notice_lib"
. "$_lib/mux-env_lib"
. "$_lib/mux-context_lib"

_all=0
_dry=0
_addr=
while [ $# -gt 0 ]; do
  case $1 in
  --all) _all=1; shift ;;
  -n|--dry-run) _dry=1; shift ;;
  -h|--help)
    echo "usage: mux update-env [[PARTITION::]SESSION] [--all] [-n]"
    exit "$MUX_EC_OK" ;;
  --) shift; break ;;
  -*) echo "mux: update-env: unknown option: $1" >&2; exit "$MUX_EC_USAGE" ;;
  *)  [ -z "$_addr" ] || {
        echo "mux: update-env takes one address" >&2; exit "$MUX_EC_USAGE"; }
      _addr=$1; shift ;;
  esac
done

[ "$_all" -eq 0 ] || [ -z "$_addr" ] || {
  echo "mux: update-env: --all and an address contradict each other" >&2
  exit "$MUX_EC_USAGE"; }

# --- which sessions ---------------------------------------------------------
# VALIDATED IN THE MAIN SHELL, EMITTED IN A SUBSHELL, and the split is not
# stylistic. The pane loop reads `_targets` through a here-doc, so an `exit`
# inside `$( )` leaves only the SUBSHELL: a refusal there PRINTS ITS MESSAGE
# AND THEN EXITS 0, the substitution yields nothing, and the script runs on to
# report "nothing needed changing". So anything that can REFUSE happens here,
# where `exit` means what it says.
_tmode=cur
_tpart=
_tsess=
if [ "$_all" -eq 1 ]; then
  _tmode=all
elif [ -n "$_addr" ]; then
  mux_addr_parse "$_addr" || exit "$MUX_EC_USAGE"
  [ -z "$MUX_ADDR_WIN" ] || {
    echo "mux: update-env: a window cannot be addressed here." >&2
    echo "mux: tmux keeps an environment per SESSION and per server, so" >&2
    echo "mux: there is nothing per-window for this to act on. Try:" >&2
    _twant=${MUX_ADDR_PART:+${MUX_ADDR_PART}::}$MUX_ADDR_SESS
    echo "mux:   mux update-env $_twant" >&2
    exit "$MUX_EC_USAGE"; }
  _tpart=$MUX_ADDR_PART
  _tsess=$MUX_ADDR_SESS
  _tmode=addr
elif [ -n "${TMUX:-}" ]; then
  _tsess=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
  [ -z "$_tsess" ] || _tmode=one
fi

if [ "$_tmode" = cur ]; then
  # OUTSIDE any session with no argument there is no subject, and this must
  # not silently widen to everything: that would act on sessions the caller
  # never named, which is the worst of the three available answers.
  echo "mux: update-env: no session to act on." >&2
  echo "mux: run it inside a session, name one ([PARTITION::]SESSION)," >&2
  echo "mux: or ask for every session with --all." >&2
  exit "$MUX_EC_USAGE"
fi

# Emits `<partition>\t<session>` lines. A TAB because a session name may
# contain a space, which is the fifth time that fact has decided a format in
# this package.
_targets() {
  if [ "$_tmode" = all ]; then
    while IFS= read -r _tp; do
      [ -n "$_tp" ] || continue
      _sessions_in "$_tp"
    done <<EOF
$(mux_ctx_partitions)
EOF
    return 0
  fi

  _tp=$_tpart
  [ -n "$_tp" ] || _tp=$(_my_partition)
  if [ -n "$_tsess" ]; then
    printf '%s\t%s\n' "$_tp" "$_tsess"
  else
    # `work::` is the whole partition: a deliberate form rather than an
    # empty address, saying "every session here".
    _sessions_in "$_tp"
  fi
}

# The caller's own partition, which is a question mux already answers; the
# fallback is the reserved word rather than an invented one.
_my_partition() {
  if mux_ctx_resolve 2>/dev/null; then
    printf '%s' "${MUX_CTX_PARTITION:-global}"
  else
    printf 'global'
  fi
}

_sessions_in() {   # <partition>
  tmux -L "$1" list-sessions -F "$1	#{session_name}" 2>/dev/null || true
}

# --- act --------------------------------------------------------------------
_did=0
# WHETHER ANY SESSION WAS EXAMINED AT ALL, which is a different question from
# whether anything changed, and conflating them cost two wrong conclusions in
# one sitting: the same box answered 0 bytes and 2085 bytes from the same
# state, and I read the silence as "scoped wrongly" and then the output as "a
# scoping bug". `--all` with no partitions, and `work::` with no sessions in
# it, both reach here with nothing to walk, so "nothing needed changing" was
# indistinguishable from "nothing was looked at".
_saw=0
# A scratch file for the stale-pane findings, verified before anything is
# appended: see the subshell note at the loop below.
_stalef=$(mktemp "${TMPDIR:-/tmp}/mux-updenv.XXXXXX" 2>/dev/null) || _stalef=
[ -n "$_stalef" ] && [ -f "$_stalef" ] || {
  echo "mux: update-env: could not make a scratch file" >&2
    exit "$MUX_EC_FAIL"; }
# The literal is baked in at ARM time, per the standing rm rule: `trap` then
# prints exactly what will be removed and no later assignment moves it.
_cleanup="'$_stalef'"
# shellcheck disable=SC2064  # EXPANDING NOW IS THE POINT, see above.
trap "rm -f $_cleanup" EXIT INT TERM
while IFS='	' read -r _p _s; do
  [ -n "$_s" ] || continue
  # tm() is what mux_env_apply calls; it is bound per target here because a
  # sweep crosses partitions and each one is a different server.
  sock=$_p
  tm() { tmux -L "$sock" "$@"; }

  if ! tm has-session -t "=$_s" 2>/dev/null; then
    echo "mux: no such session: $_p:$_s" >&2
    continue
  fi
  _saw=$((_saw + 1))

  # THE DRY RUN GOES THROUGH THE SAME DECISION. Printing mux_env_plan instead
  # is not a preview: the plan says what RESOLVED, while the decision to write
  # also consults the SESSION's existing value, so a preview built that way
  # lists two names where the real run changes three. `-n` therefore lives
  # inside mux_env_apply.
  _mode=-v
  [ "$_dry" -eq 0 ] || _mode=-n
  _out=$(mux_env_apply "$_s" "$_mode" 2>/dev/null || true)
  if [ "$_dry" -eq 1 ]; then
    printf '%s\n' "$_out" | while IFS= read -r _l; do
      [ -n "$_l" ] || continue
      # THE VERB IS PUT BACK INTO THE PRESENT, because mux_env_apply reports
      # what it DID and this is a preview. Prefixing "would " onto the past
      # tense gives `would dropped WAYLAND_DISPLAY`; only `set` reads
      # correctly in both tenses, so the common case hides the bug.
      _lv=${_l%% *}
      case $_lv in
      dropped)  _l="drop ${_l#* }" ;;
      stripped) _l="strip ${_l#* }" ;;
      esac
      printf '%s:%s  would %s\n' "$_p" "$_s" "$_l"
    done
    [ -z "$_out" ] || _did=1
  elif [ -n "$_out" ]; then
    printf '%s\n' "$_out" | while IFS= read -r _l; do
      [ -n "$_l" ] || continue
      printf '%s:%s  %s\n' "$_p" "$_s" "$_l"
    done
    _did=1
  fi

  # THE PANES THAT CANNOT BE FIXED, named rather than implied. A pane whose
  # environment lacks a name mux just set is running on the old one and always
  # will be, because exec already happened.
  # COLLECTED TO A FILE, NOT A VARIABLE, because the INNER loop is fed by a
  # PIPE (`mux_env_names | while`) and so runs in a subshell, where an
  # assignment is lost after the loop. The OUTER here-doc loop is not the
  # reason: measured in dash, bash, ksh and macOS `/bin/sh`, a
  # `while ... done <<EOF` keeps its assignments, which is why `_did` and
  # `_saw` can be plain variables. Reported once at the end rather than
  # interleaved, these being a different KIND of fact: what was fixed versus
  # what cannot be.
  # WHICH NAMES THE SESSION NOW HOLDS, computed ONCE per session rather than
  # per pane. This is not an optimisation, it is the question: a pane is only
  # stale relative to something it could actually GAIN by restarting.
  #
  # COMPARE AGAINST WHAT THE SESSION HOLDS, never against the NAME LIST: on a
  # box where nothing listens on WAYLAND_DISPLAY, the list names every pane as
  # stale for a value mux DELIBERATELY WITHHELD, advising a restart that could
  # never supply it. A withheld name is announced once by R7 and carried by
  # `mux check`; repeating it as a per-pane defect is actively wrong.
  #
  # Space-delimited and matched with the padded `case` idiom, because an
  # unanchored substring test makes `AUTH_SOCK` match `SSH_AUTH_SOCK`.
  _held=$(tm show-environment -t "=$_s" 2>/dev/null \
    | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')
  # A PREVIEW ANSWERS THE SAME QUESTION THE RUN DOES, which is this file's own
  # rule one paragraph up: `-n` lives inside mux_env_apply precisely because a
  # preview computed by a different code path is not a preview. Nothing has
  # been written in dry mode, so the session still holds its OLD set, and
  # comparing panes against that would report who is stale NOW rather than who
  # would be stale after the run. The difference is the whole point of the
  # report: a name the run is about to SET is exactly the one every existing
  # pane will be missing.
  #
  # DERIVED FROM THE PREVIEW ITSELF rather than from the plan, for the same
  # reason: `_out` is what mux_env_apply says it would do, having already
  # consulted the session's current value.
  if [ "$_dry" -eq 1 ]; then
    _held=$(printf '%s\n' "$_out" | awk -v cur="$_held" '
      $1 == "set"                         { add[$2] = 1 }
      $1 == "dropped" || $1 == "stripped" { del[$2] = 1 }
      END {
        n = split(cur, c, " ")
        for (i = 1; i <= n; i++) if (!(c[i] in del)) out[c[i]] = 1
        for (k in add) if (!(k in del)) out[k] = 1
        for (k in out) printf "%s ", k
      }')
  fi
  while IFS='	' read -r _loc _pid; do
    [ -n "$_pid" ] || continue
    if [ ! -r "/proc/$_pid/environ" ]; then
      printf '%s\t(cannot tell: no readable /proc)\n' \
        "$_loc" >>"$_stalef"
      continue
    fi
    mux_env_names | while IFS= read -r _n; do
      [ -n "$_n" ] || continue
      # Not held by the session, so there is nothing to be stale ABOUT.
      case " $_held " in
      *" $_n "*) ;;
      *) continue ;;
      esac
      # `2>/dev/null` BEFORE the redirect: a pane can die while this sweep
      # is walking, so a vanished /proc entry is the NORMAL case, and with
      # the order reversed the SHELL prints `cannot open` before tr runs.
      if ! tr '\0' '\n' 2>/dev/null <"/proc/$_pid/environ" \
        | grep -q "^$_n="; then
        printf '%s\t%s\n' "$_loc" "$_n" >>"$_stalef"
      fi
    done
  done <<EOF
$(tm list-panes -s -t "=$_s" \
  -F '#{session_name}:#{window_index}.#{pane_index}	#{pane_pid}' 2>/dev/null)
EOF
done <<EOF
$(_targets)
EOF

if [ -s "$_stalef" ]; then
  # SAID PLAINLY, because "updated" must not be read as "your running
  # agent is fixed". A process environment is fixed at exec, and setting a
  # session option cannot reach back into one already running.
  #
  # AND SAID IN DRY MODE TOO, which it was not: `-n` was the ONLY mode that
  # could not see this, and it is the mode a careful person reaches for first,
  # precisely to find out what is going on without acting. The suppression
  # read as caution and was the opposite: the pane a restart cannot be avoided
  # for is the one fact a preview most needs to carry, and hiding it meant the
  # only way to learn it was to run the thing you were previewing.
  echo
  if [ "$_dry" -eq 1 ]; then
    echo "mux: these panes would still be on the OLD environment. A running"
    echo "mux: process cannot be changed from outside, so they would stay as"
    echo "mux: they are until restarted; anything NEW in them is correct."
  else
    echo "mux: these panes are still on the OLD environment. A running"
    echo "mux: process cannot be changed from outside, so they stay as they"
    echo "mux: are until restarted; anything NEW in them is correct."
  fi
  LC_ALL=C sort -u "$_stalef" | while IFS='	' read -r _loc _what; do
    [ -n "$_loc" ] || continue
    printf '  %-26s %s\n' "$_loc" "$_what"
  done
fi

# THREE ANSWERS, NOT TWO, and the third is why this changed: a run that walked
# NO SESSION said exactly what a run that found nothing to do said, and in dry
# mode the latter said nothing at all. Zero bytes is the one answer a caller
# cannot act on, because it is equally true of a verb that did its job and of
# one that resolved no target. `--all` on a box with one empty partition, and
# `work::` naming a partition with no sessions, both land here.
# INDEPENDENT OF THE STALE REPORT, because they are different facts and both
# can be true: nothing needed CHANGING is an honest answer to a run that also
# found panes a restart cannot avoid. Gating one on the other would make a
# second run go quiet about whether it did anything.
if [ "$_saw" -eq 0 ]; then
  echo "mux: no sessions to examine"
elif [ "$_did" -eq 0 ]; then
  if [ "$_dry" -eq 1 ]; then
    echo "mux: nothing would change ($_saw session(s) examined)"
  else
    echo "mux: nothing needed changing"
  fi
fi
exit "$MUX_EC_OK"
