#!/bin/sh
# mux-agent-state-summary: machine-readable aggregate of agent state across a
# namespace, for an EXTERNAL presenter (the SNI tray indicator). Prints one
# line "<state> <count>": STATE is the worst live state across the namespace's
# sessions (blocked > working > idle), COUNT the number of sessions in that
# state; with no tracked agent it prints "none 0". Reuses mux-agent-state_lib so
# the ranking and the state model never drift from the strip and the picker.
#
#   mux agent-summary [NS]
#
# Sessions are derived from the per-pane state FILES in the namespace dir, NOT
# from `tmux list-sessions`, so this answers headless (from a tray daemon, over
# ssh, at boot) with no tmux client. NS is the namespace: a PARTITION name;
# with none it resolves the caller's context, exactly as the front end does.
#
# That resolution matters precisely BECAUSE this is the headless caller. Every
# other consumer of mux-agent-state_lib (the status strip, next-blocked) runs
# inside tmux and gets its namespace from $TMUX. This one has no $TMUX, so a
# hardcoded fallback is how it silently reads an EMPTY directory and answers
# "none 0" for ever: the name has to come from the same resolution every other
# reader uses.
set -eu

# Sibling libs in this script's own (colocated) libexec dir.
_libexec=$(dirname "$0")
_lib=$_libexec/../lib
[ -r "$_lib/mux-exit_lib" ] \
  || { echo "mux: $_lib/mux-exit_lib missing" >&2; exit 1; }
# shellcheck source=/dev/null
. "$_lib/mux-exit_lib"
# mux-conf_lib FIRST: mux-context_lib reads $MUX_DIR/config through
# mux_conf_clean, and says so in its own header.
. "$_lib/mux-conf_lib"
. "$_lib/mux-agent-state_lib"

# ARGUMENTS: [--all] [--attached] [NS]
#
#   (none)      the caller's own partition, as "<state> <count>"
#   NS          that partition, same shape
#   --all       EVERY partition that has agent state, as
#               "<partition> <state> <count>": one line each.
#   --attached  with --all: only partitions SOMEONE IS LOOKING AT, meaning a
#               client is attached to that partition's tmux server.
#
# --all EXISTS FOR ONE ROUND TRIP. The tray indicator polls a remote host over
# ssh, and asking per partition would multiply that cost by the number of
# partitions on every tick: for a signal that changes on human timescales
# and whose poll was deliberately slowed to 5s for exactly this reason. One
# question, one answer, however many partitions.
#
# --attached IS THE TRAY'S QUESTION, and it is a different one from "what
# state is everything in". A tray item means A HUMAN IS LOOKING AT THIS: for a
# remote host that is exactly what a latch already means (the notes say it
# outright: an item exists only because a latch does, and the latch IS the
# human's live view of that box), and the local equivalent is an attached
# client. Without it, a partition with a live server and no terminal window
# showing it publishes a tray item nobody can act on.
#
# IT IS A FLAG AND NOT THE DEFAULT, because the bare verb's contract is that
# it answers HEADLESS: from a tray daemon, over ssh, at boot, with no tmux
# client anywhere. Filtering on clients by default would quietly delete that
# promise for every other consumer. The tray asks the narrower question
# explicitly; everyone else keeps the state report.
_all=0
_att=0
_sess_mode=0
while :; do
  case "${1:-}" in
    --all|-a)    _all=1; shift ;;
    --attached)  _att=1; shift ;;
    --sessions)  _sess_mode=1; shift ;;
    *) break ;;
  esac
done
_ns=${1:-}
if [ -z "$_ns" ] && [ -r "$_lib/mux-context_lib" ]; then
  . "$_lib/mux-context_lib"
  _ns=$(mux_ctx_mine)
fi

# The distinct sessions, NEWLINE separated and counted line by line. A session
# name may contain a space, so neither joining them with spaces nor iterating
# the result with a bare `for` is safe: one session called `my project` would
# dedup against its own words and then be counted twice, as `my` and `project`.
# A name cannot contain a newline (tmux escapes one in its -F output), so that
# is the delimiter.
_NL='
'

# _summarise DIR -> "<state> <count>": the worst live state in that namespace
# and how many sessions sit in it, else "none 0".
#
# ONE FUNCTION, because --all asks the same question of several directories
# and a second copy of the ranking walk would be a second place for the
# "worst wins" rule to drift from mux-agent-state_lib.
_summarise() {   # <dir> <prefix>
  _sd=$1 _pfx=${2:-}
  _sessions=
  if [ -d "$_sd" ]; then
    for _f in "$_sd"/*; do
      [ -e "$_f" ] || continue
      # session LAST, so it survives containing a space.
      read -r _st _win _pane _ep _nid _ss <"$_f" || continue
      [ -n "${_ss:-}" ] || continue
      case "$_NL$_sessions$_NL" in
        *"$_NL$_ss$_NL"*) ;;
        *) _sessions="$_sessions$_NL$_ss" ;;
      esac
    done
  fi
  _sessions=${_sessions#"$_NL"}

  _worst= _wr=-1 _count=0
  while IFS= read -r _s; do
    [ -n "$_s" ] || continue
    _state=$(mux_agent_state "$_sd" "$_s")
    _state=${_state%% *}
    [ -n "$_state" ] || continue
    # --sessions: the same walk, reported per session instead of collapsed.
    # IN THIS LOOP rather than in a second helper, because the loop already
    # has every session's own state in hand: a separate enumeration would be
    # a second place for "which sessions does this namespace have" to drift,
    # and that question has already been answered wrong once here (a
    # hardcoded `default` namespace that silently reported nothing).
    #
    # NO AGE, which is the one field a caller might expect and must not get.
    # This feeds `mux agent stream`, which emits only when the DOCUMENT
    # changes; an age changes every second, so including it would make every
    # tick a change and turn the stream back into a poll that also pays for
    # a diff. A reader that wants to know how long ago something happened
    # learns it from WHEN THE LINE ARRIVED, which needs no clock agreement at
    # all and is strictly better than trusting a remote clock.
    if [ "$_sess_mode" -eq 1 ]; then
      printf '%s%s %s\n' "${_pfx:+$_pfx }" "$_state" "$_s"
      continue
    fi
    _r=$(mux_agent_rank "$_state")
    if [ "$_r" -gt "$_wr" ]; then
      _wr=$_r; _worst=$_state; _count=1
    elif [ "$_r" -eq "$_wr" ]; then
      _count=$((_count + 1))
    fi
  # A here-doc, not a pipe: `_worst` and `_count` are carried out of this
  # loop and a pipe would run it in a subshell and discard both.
  done <<EOF
$_sessions
EOF
  [ "$_sess_mode" -eq 0 ] || return 0
  [ -n "$_worst" ] || { echo "none 0"; return 0; }
  printf '%s %s\n' "$_worst" "$_count"
}

if [ "$_all" -eq 0 ]; then
  _summarise "$(mux_agent_dir "$_ns")" ""
  exit "$MUX_EC_OK"
fi

# _watched PARTITION: is anyone actually LOOKING at that partition?
#
# A client attached to its server, which is the local counterpart of a latch.
# Server-wide rather than per session: the question is whether a human has
# that partition on screen at all, not which session they are on.
#
# STATE FILES OUTLIVE THEIR SERVER, which is why this cannot be inferred from
# the directory. A partition whose server is gone keeps its records until
# something prunes them, and a partition whose server is up with nobody
# attached is a set of sessions running behind a closed window. Neither is
# something a tray can usefully point at.
_watched() {   # <partition>
  tmux -L "$1" list-clients -F '#{client_name}' 2>/dev/null | grep -q .
}

# --all: every namespace that EXISTS. State DIRECTORIES are the truth here
# rather than the configured partition list: a partition file with no agents
# has nothing to report, and a namespace can exist without a file (the
# directory is created by the first emit). Reporting what is actually there is
# the honest answer.
#
# WITHOUT --attached the caller's own partition is guaranteed present, so a
# consumer always gets at least one line. WITH it that guarantee is dropped on
# purpose: the whole point of the flag is that an unwatched partition is not
# reported, and the caller's own is not exempt from the question it just
# asked. A box where nothing is attached answers nothing, which is the honest
# report and what makes the tray empty when you detach from everything.
_root=$(dirname "$(mux_agent_dir "$_ns")")
_seen=
for _d in "$_root"/*; do
  [ -d "$_d" ] || continue
  _p=${_d##*/}
  [ "$_att" -eq 0 ] || _watched "$_p" || continue
  _seen="$_seen $_p"
  if [ "$_sess_mode" -eq 1 ]; then
    # The prefix is printed INSIDE, not wrapped in `$( )` out here: a
    # substitution carrying several lines would be handed to one `printf`
    # argument and come back as one prefixed line plus bare ones.
    _summarise "$_d" "$_p"
  else
    printf '%s %s\n' "$_p" "$(_summarise "$_d" "")"
  fi
done
[ "$_att" -eq 0 ] || exit "$MUX_EC_OK"
# COLLAPSED MODE ONLY. `none 0` is a state and a COUNT, so in --sessions mode
# it is a line of the wrong shape: a reader splitting `<partition> <state>
# <session>` takes it as a session literally called `0`. There is no
# per-session equivalent to emit, because the guarantee this provides is "a
# consumer always gets at least one line", and a partition with no sessions
# has no session lines to give.
[ "$_sess_mode" -eq 0 ] || exit "$MUX_EC_OK"
case " $_seen " in
  *" ${_ns:-global} "*) ;;
  *) printf '%s %s\n' "${_ns:-global}" "none 0" ;;
esac
