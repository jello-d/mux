#!/bin/sh
# mux-agent: THE MACHINE CONTRACT. `mux agent <verb>` is the surface an agent
# (or any program) is invited to depend on, and it is deliberately a different
# contract from the rest of mux rather than a second spelling of it.
#
#   mux agent status [--any]              every partition's worst state
#   mux agent peers  [--partition N|--all] every session and what it is doing
#   mux agent read   SESSION [-n LINES]    what is on that agent's screen
#   mux agent wait   SESSION STATE [-t N]  block until it gets there
#   mux agent send   SESSION TEXT|-         type into that agent's pane
#
# THREE PROMISES, which is what makes it a contract rather than a convention:
#
#   1. JSON ON STDOUT, ALWAYS, INCLUDING ON FAILURE. Every other mux verb puts
#      its reason on stderr, which is right for a human reading a terminal and
#      wrong for a caller that parses. A reader here never has to decide
#      whether today's answer is a document or a sentence.
#
#   2. A SYMBOLIC `status`, alongside the numeric exit. mux uses exactly four
#      exit codes and the ABSENCE of every other one is load-bearing: latch
#      attributes 126, 127 and 255 to the shell and to ssh precisely because
#      mux never emits them. So richer outcomes go in the PAYLOAD, where they
#      cost nothing: the exit code stays for the shell, the enumeration is for
#      the reader, and neither has to be widened to serve the other.
#
#   3. THE SHAPE IS STABLE OR THE CAPABILITY NUMBER MOVES. `mux capabilities`
#      declares `agent contract 1`; a breaking change to any of these
#      documents is a new number there, which is how a consumer finds out
#      without sniffing a version string.
#
# WHY A NAMESPACE AT ALL. Without one, nothing declares which output is meant
# to be parsed: the tray polls `mux agent-summary`, and improving `mux ls` for
# a human could silently break a consumer that had started reading it. A
# declared machine surface is what frees the human surface to keep changing.
set -eu

_lib=$(dirname "$0")
. "$_lib/mux-json_lib"
. "$_lib/mux-send-policy_lib"
# The pane class vocabulary and its ORDERING, which `class` turns on and
# `open` validates against. Core to this file, so unconditional.
. "$_lib/mux-class_lib"
# `class` and `send` both record a transition, and the log is the half of the
# relax gate that survives somebody working around it.
. "$_lib/mux-log_lib"

# THE STATUS ENUMERATION, and its one rule: each value maps to exactly one of
# mux's four exit codes, never the reverse. Several statuses may share a code
# (that is the point of having both), but a status must not be able to mean
# two different exits.
#
#   ok            0   the answer follows
#   refused       1   a guard fired; `message` says which
#   usage         2   this verb does not know what it was asked
#   no-such-name  3   mux's cross-cutting "the name is not known here"
#
# ALWAYS A MESSAGE. The no-message branch this used to carry was unreachable
# (every failure has a reason), and an unreachable branch is a mutation
# nothing can kill, which this corpus treats as a signal to delete rather than
# to test harder. Belt-and-braces reads as safety and measures as untestable.
_out() {   # <status> <exit> <message>
  printf '{"status":%s,"message":%s}\n' \
    "$(mux_json_str "$1")" "$(mux_json_str "$3")"
  exit "$2"
}

_usage() {
  # THE VERB LIST IN A VARIABLE so the `_out` call stays on ONE line: a
  # mutation record cannot anchor a line ending in a continuation backslash,
  # and the guard that the status WORD is honoured is worth keeping killable.
  # Same move as the `untrusted` reason in mux-latch, for the same reason.
  _uv='status|peers|read|wait|send|open|class'
  _out usage 2 "usage: mux agent <$_uv> ..."
}

_verb=${1:-}
[ -n "$_verb" ] || _usage
shift

case $_verb in
status|peers|read|wait|send|open|class) ;;
*) _out usage 2 "unknown agent verb: $_verb" ;;
esac

# _resolve TARGET: sets $_rp (partition), $_rd (state dir) and checks the
# session is one mux knows. Shared by read and wait, because "that session is
# not here" must be the same answer and the same exit from both.
_resolve() {   # <session> <partition-or-empty>
  _rp=$2
  if [ -z "$_rp" ] && [ -r "$_lib/mux-context_lib" ]; then
    . "$_lib/mux-context_lib"
    mux_ctx_resolve 2>/dev/null && _rp=$MUX_CTX_PARTITION
  fi
  _rd=$(mux_agent_dir "$_rp")
  # EXIT 3, mux's cross-cutting "the name is not known here", rather than
  # an empty answer. A caller that mistyped a session and a caller
  # looking at one with nothing to say must not get the same document.
  mux_agent_sessions "$_rd" | grep -qxF -- "$1" || _out no-such-name 3 \
    "no session $1 with a tracked agent in partition ${_rp:-global}"
}

# EVERY tmux CALL GOES THROUGH THIS. A bare `tmux` asks the DEFAULT socket,
# which is not where a partition's server lives, so `read` captured nothing
# and `send` read an empty class (defaulting to `human`) for a pane that was
# plainly marked `agent`. Both looked like correct refusals, which is why a
# stub could not have caught it and a real server did on the first try.
#
# The socket name IS the partition name, so once _resolve has one there is no
# case where a bare call is right. Same wrapper mux-even and next-blocked
# already carry, for the same reason, which makes this the third time.
_tx() {
  tmux -L "${_rp:-global}" "$@"
}

case $_verb in
read|wait|send|class)
  . "$_lib/mux-paths_lib"
  . "$_lib/mux-agent-state_lib" ;;
esac

if [ "$_verb" = read ]; then
  # --- read ----------------------------------------------------------
  # What is on that agent's screen. THE PANE IS RESOLVED NOW, from the
  # state record, rather than taken from a caller: an id cached from an
  # earlier `peers` can have died and been replaced, and capturing the
  # wrong pane is the plausible-wrong-answer shape this codebase keeps
  # meeting. Resolving it here also means `peers` need not carry one.
  # AN OPTION IS AN OPTION WHEREVER IT SITS. The front end stops parsing
  # options at the first positional (so `mux resume work --list` reads
  # `--list` as a session name), and that edge is tolerable for a human
  # who can see the result. It is not for a caller composing argv
  # programmatically, where argument ORDER becomes a rule nobody wrote
  # down. `mux agent read mux -n 5` failed exactly that way once.
  _rn=
  _rpart=
  _rsess=
  while [ $# -gt 0 ]; do
    case $1 in
    -n) shift
        _rn=${1:-}
        case ${_rn:-} in
        ''|*[!0-9]*) _out usage 2 "-n needs a line count" ;;
        esac
        shift ;;
    --partition) shift
        _rpart=${1:-}
        [ -n "$_rpart" ] || _out usage 2 "--partition needs a name"
        shift ;;
    --) shift; break ;;
    -*) _out usage 2 "unknown option: $1" ;;
    *)  [ -z "$_rsess" ] || _out usage 2 "read takes one SESSION"
        _rsess=$1; shift ;;
    esac
  done
  [ -n "$_rsess" ] || _out usage 2 "usage: mux agent read SESSION [-n N]"

  _resolve "$_rsess" "$_rpart"
  _pane=$(mux_agent_pane "$_rd" "$_rsess")
  [ -n "$_pane" ] || _out refused 1 \
    "no agent pane recorded for $_rsess"

  # THE VISIBLE PANE BY DEFAULT, scrollback only when asked. An agent
  # pane's scrollback can be enormous, and a verb whose default answer is
  # unbounded is one a caller learns to be afraid of. -J joins wrapped
  # lines, so a reader gets the logical line rather than the terminal's.
  set -- capture-pane -p -J -t "$_pane"
  [ -z "$_rn" ] || set -- "$@" -S "-$_rn"
  _text=$(_tx "$@" 2>/dev/null) || _out refused 1 \
    "could not capture pane $_pane (is that server running?)"

  printf '{"status":"ok","partition":%s,"session":%s,' \
    "$(mux_json_str "${_rp:-global}")" "$(mux_json_str "$_rsess")"
  printf '"pane":%s,"text":%s}\n' \
    "$(mux_json_str "$_pane")" "$(mux_json_str "$_text")"
  exit 0
fi

if [ "$_verb" = wait ]; then
  # --- wait ----------------------------------------------------------
  # Block until a session reaches a state. The verb that makes the other
  # two composable: without it a caller polls `peers` in a loop and
  # invents its own timeout, badly.
  #
  # ALWAYS BOUNDED. An unbounded wait from an agent is a hang with no
  # operator, so -t has a default rather than meaning forever.
  _wt=300
  _wpart=
  _wsess=
  _want=
  while [ $# -gt 0 ]; do
    case $1 in
    -t) shift
        _wt=${1:-}
        case ${_wt:-} in
        ''|*[!0-9]*) _out usage 2 "-t needs seconds" ;;
        esac
        shift ;;
    --partition) shift
        _wpart=${1:-}
        [ -n "$_wpart" ] || _out usage 2 "--partition needs a name"
        shift ;;
    --) shift; break ;;
    -*) _out usage 2 "unknown option: $1" ;;
    *)  if [ -z "$_wsess" ]; then _wsess=$1
        elif [ -z "$_want" ]; then _want=$1
        else _out usage 2 "wait takes a SESSION and a STATE"
        fi
        shift ;;
    esac
  done
  [ -n "$_wsess" ] && [ -n "$_want" ] \
    || _out usage 2 "usage: mux agent wait SESSION STATE [-t N]"
  case $_want in
  blocked|working|idle) ;;
  *) _out usage 2 "not a state mux emits: $_want" ;;
  esac

  _resolve "$_wsess" "$_wpart"

  # CHECKED BEFORE SLEEPING, so a session already in the wanted state
  # returns at once rather than after the first poll interval.
  _t0=$(date +%s 2>/dev/null || echo 0)
  while :; do
    _se=$(mux_agent_state "$_rd" "$_wsess")
    _now=$(date +%s 2>/dev/null || echo 0)
    _el=$((_now - _t0))
    [ "$_el" -ge 0 ] || _el=0
    if [ "${_se%% *}" = "$_want" ]; then
      printf '{"status":"ok","partition":%s,"session":%s,' \
        "$(mux_json_str "${_rp:-global}")" \
        "$(mux_json_str "$_wsess")"
      printf '"state":%s,"waited":%s}\n' \
        "$(mux_json_str "$_want")" \
        "$(mux_json_num "$_el")"
      exit 0
    fi
    [ "$_el" -lt "$_wt" ] || break
    sleep 1
  done

  # TIMED-OUT IS ITS OWN STATUS AND NOT ITS OWN EXIT CODE, which is the
  # whole argument for carrying both. "It did not happen in time" is a
  # refusal as far as a shell is concerned (exit 1); a reader that wants
  # to tell it from every other refusal reads the word. Widening mux's
  # four exit codes to say this would cost latch the attribution it gets
  # from 126, 127 and 255 never being mux's.
  #
  # AND IT REPORTS THE STATE IT IS ACTUALLY IN, because "not idle yet" is
  # a different problem from "blocked and waiting for a human", and a
  # caller that has just burned its timeout should not need a second
  # round trip to find out which.
  printf '{"status":"timed-out","partition":%s,"session":%s,' \
    "$(mux_json_str "${_rp:-global}")" "$(mux_json_str "$_wsess")"
  printf '"wanted":%s,"state":%s,"waited":%s,"message":%s}\n' \
    "$(mux_json_str "$_want")" \
    "$(mux_json_str "${_se%% *}")" \
    "$(mux_json_num "$_el")" \
    "$(mux_json_str "$_wsess is ${_se%% *}, not $_want, after ${_el}s")"
  exit 1
fi

if [ "$_verb" = send ]; then
  # --- send ----------------------------------------------------------
  # Type into an agent's pane. THE HOOK A HIGHER LAYER NEEDS, and the
  # reason it belongs here rather than in that layer: mux already knows
  # which pane is the agent's, which partition it is in, and (the part
  # only mux knows) whether it is BLOCKED. Without this verb an
  # orchestrator reaches around mux to `tmux send-keys`, re-derives pane
  # resolution, and inherits none of the guards below.
  #
  # WHAT IT IS NOT: orchestration. `spawn` is `mux go` plus this, which
  # the layer above composes in two lines, so mux does not grow a verb
  # that decides when a worker starts.
  _spart= _sack_prompt=0 _sack_blind=0 _senter=1
  _ssess= _stext= _shave_text=0
  while [ $# -gt 0 ]; do
    case $1 in
    --partition) shift
        _spart=${1:-}
        [ -n "$_spart" ] || _out usage 2 "--partition needs a name"
        shift ;;
    # TWO ACKNOWLEDGEMENTS, NOT ONE, pairing with the two grants:
    # being allowed to answer prompts must never imply being
    # allowed to type into a pane mux cannot classify.
    --answer-prompt) _sack_prompt=1; shift ;;
    --blind)         _sack_blind=1; shift ;;
    --no-enter)      _senter=0; shift ;;
    --) shift; break ;;
    -)  # stdin, so a long charge is not an argv-length problem
        [ "$_shave_text" -eq 0 ] || _out usage 2 "send takes one TEXT"
        _stext=$(cat); _shave_text=1; shift ;;
    -*) _out usage 2 "unknown option: $1" ;;
    *)  if [ -z "$_ssess" ]; then _ssess=$1
        elif [ "$_shave_text" -eq 0 ]; then _stext=$1; _shave_text=1
        else _out usage 2 "send takes one SESSION and one TEXT"
        fi
        shift ;;
    esac
  done
  [ -n "$_ssess" ] && [ "$_shave_text" -eq 1 ] \
    || _out usage 2 "usage: mux agent send SESSION TEXT|-"

  _resolve "$_ssess" "$_spart"
  _spane=$(mux_agent_pane "$_rd" "$_ssess")
  [ -n "$_spane" ] || _out refused 1 "no agent pane recorded for $_ssess"
  _sstate=$(mux_agent_state "$_rd" "$_ssess")
  _sstate=${_sstate%% *}

  # WHO CONTROLS THE PANE, and the default is the strict one. An
  # unclassified pane is a human's: the safe answer is the one you get by
  # saying nothing, and marking a village is a deliberate act by the
  # layer that spawned it.
  _swin=$(_tx display-message -p -t "$_spane" '#{window_name}' \
    2>/dev/null || true)
  _sclass=$(_tx display-message -p -t "$_spane" '#{@mux-control}' \
    2>/dev/null || true)
  case ${_sclass:-} in
  agent|hybrid) ;;
  *) _sclass=human ;;
  esac

  # A SEND MAY NOT LEAVE THE CALLER'S OWN PARTITION, refused structurally
  # and before the policy, for exactly the reason `human` is.
  #
  # THE HOLE THIS CLOSES was found by the user asking whether mux pokes a
  # hole in the boundary a partition mechanism is there to keep. It does,
  # and the measurement is unambiguous: every token on a policy line is
  # ANDed, so the one grant that makes a village workable at all,
  #
  #     send-blocked control:agent
  #
  # carries NO partition token and therefore reaches agents in EVERY
  # partition. One root-owned line, written for a perfectly good reason,
  # crosses the wall.
  #
  # STRUCTURAL, NOT A POLICY TOKEN, and that is the same argument the class
  # gate already makes one line down: a grant that names only a class or
  # only a window would otherwise cross a boundary BY OMISSION, and the
  # omission is the easy mistake rather than the hard one.
  #
  # THE DECISION ITSELF IS `mux_ctx_crossing`, in mux-context_lib, because
  # every actuating verb has to ask it and a second copy is the one that
  # drifts. Why crossing matters, what a failed hook means, and why a box
  # with no partitions pays nothing are all documented there, at the one
  # site that answers it.
  _scross=
  if [ -r "$_lib/mux-context_lib" ]; then
    # shellcheck source=/dev/null
    . "$_lib/mux-context_lib"
    mux_ctx_crossing "${_rp:-global}" 'type across' \
      || _scross=$MUX_CTX_CROSS
  fi

  # _refuse WHAT ACK: the target needs an override. Reports whether one
  # is AVAILABLE, which is the whole point of answering rather than just
  # refusing: a caller that does not know discovers the capability in one
  # round trip and decides; one that does know passes the flag up front
  # and pays nothing.
  _refuse() {   # <what> <ack-flag-name>
    _rf_av=none
    _rf_why=
    if [ -n "$_scross" ]; then
      # NEVER, and no override exists to report: there is deliberately
      # no flag and no policy token that opens this.
      _rf_why=$_scross
    elif [ "$_sclass" = human ]; then
      # NEVER, and the policy is not consulted. Structural
      # rather than a token an operator has to remember: a
      # grant naming only a window would otherwise reach a
      # human's pane by omission.
      _rf_why="it is human-controlled; mux does not"
      _rf_why="$_rf_why answer a prompt on a human's behalf"
    elif mux_send_allowed "$1" "${_rp:-global}" "$_ssess" \
        "${_swin:-}" "$_sclass"; then
      _rf_av=available
      _rf_why="the policy permits an override here; pass $2"
    else
      _rf_why=$(mux_send_policy_why)
      [ -n "$_rf_why" ] || _rf_why="no policy grants an override for this scope"
    fi
    printf '{"status":"refused","reason":%s,"override":%s,' \
      "$(mux_json_str "$1")" "$(mux_json_str "$_rf_av")"
    printf '"partition":%s,"session":%s,"window":%s,"class":%s,' \
      "$(mux_json_str "${_rp:-global}")" \
      "$(mux_json_str "$_ssess")" \
      "$(mux_json_str "${_swin:-}")" \
      "$(mux_json_str "$_sclass")"
    printf '"state":%s,"message":%s}\n' \
      "$(mux_json_str "$_sstate")" \
      "$(mux_json_str "$_ssess: $_rf_why")"
    exit 1
  }

  # THE BOUNDARY GATE RUNS UNCONDITIONALLY AND FIRST, which is where my
  # own first version of it was wrong: it sat inside `_refuse`, and
  # `idle|working` never reach `_refuse` at all (an ordinary queued
  # instruction needs no override), so it guarded the two RARE states and
  # missed the common one. A structural refusal that only fires on the
  # unusual path is not structural.
  [ -z "$_scross" ] || _refuse cross-partition ''

  # THE STATE DECIDES WHETHER AN OVERRIDE IS NEEDED AT ALL. idle and
  # working are ordinary: a turn that is running buffers the text and
  # picks it up when it ends, which is the natural "queue the next
  # instruction" case and is why working is not refused.
  case $_sstate in
  idle|working) ;;
  blocked)
    [ "$_sack_prompt" -eq 1 ] || _refuse blocked --answer-prompt
    mux_send_allowed blocked "${_rp:-global}" "$_ssess" \
      "${_swin:-}" "$_sclass" || _refuse blocked --answer-prompt
    [ "$_sclass" != human ] || _refuse blocked --answer-prompt ;;
  *)
    [ "$_sack_blind" -eq 1 ] || _refuse unknown --blind
    mux_send_allowed unknown "${_rp:-global}" "$_ssess" \
      "${_swin:-}" "$_sclass" || _refuse unknown --blind
    [ "$_sclass" != human ] || _refuse unknown --blind ;;
  esac

  # BRACKETED PASTE, so the agent's TUI sees PASTED TEXT rather than a
  # stream of keystrokes. It matters for anything multi-line: a TUI that
  # reads Enter as submit would send the first line on its own and leave
  # the rest arriving as a new prompt.
  #
  # A buffer named for this process, deleted on paste, so a human's own
  # tmux buffers are not clobbered by an agent talking to a peer.
  _sbuf=mux-send-$$
  printf '%s' "$_stext" | _tx load-buffer -b "$_sbuf" - 2>/dev/null \
    || _out refused 1 "could not stage the text for $_spane"
  _tx paste-buffer -p -d -b "$_sbuf" -t "$_spane" 2>/dev/null || {
    _tx delete-buffer -b "$_sbuf" 2>/dev/null || true
    _out refused 1 "could not paste into $_spane"; }
  [ "$_senter" -eq 0 ] || _tx send-keys -t "$_spane" Enter 2>/dev/null \
    || true

  # LOGGED, because a send is a MUTATION and this is the one mux makes on
  # another agent's behalf. It is also the audit trail the layer above
  # would otherwise have to build: who was typed at, in what state, and
  # whether an override was taken.
  if [ -r "$_lib/mux-log_lib" ]; then
    . "$_lib/mux-log_lib"
    _sov=
    [ "$_sack_prompt" -eq 0 ] || _sov=" --answer-prompt"
    [ "$_sack_blind" -eq 0 ]  || _sov="$_sov --blind"
    mux_log send "$_ssess (${_rp:-global}/${_swin:-?}) $_sclass \
$_sstate$_sov ${#_stext} bytes"
  fi

  printf '{"status":"ok","partition":%s,"session":%s,"window":%s,' \
    "$(mux_json_str "${_rp:-global}")" "$(mux_json_str "$_ssess")" \
    "$(mux_json_str "${_swin:-}")"
  printf '"pane":%s,"class":%s,"state":%s,"bytes":%s}\n' \
    "$(mux_json_str "$_spane")" "$(mux_json_str "$_sclass")" \
    "$(mux_json_str "$_sstate")" "$(mux_json_num "${#_stext}")"
  exit 0
fi

if [ "$_verb" = open ]; then
  # --- open ----------------------------------------------------------
  # Open a WINDOW in an existing session, and declare what it is for.
  # vicus's R8: a worker is a WINDOW in the session it serves, and with no
  # verb for this the layer above reimplements it. It did, as its single
  # documented exemption from "never sidestep mux to reach tmux", and the
  # copy omitted `-d` so every spawn dragged the human's view into a worker.
  #
  # FIELDS, NOT A COMPOUND TOKEN, which is the machine surface's existing
  # rule rather than a new one: `peers` emits partition and session
  # separately, so nothing here parses a packed identifier and `send` has
  # nothing imposed on it backwards. The HUMAN verb (`mux window`) takes one
  # typed token, because a human types.
  _oname= _odir= _ocmd= _octl= _oattn= _opart= _osess=
  while [ "$#" -gt 0 ]; do
    case $1 in
    --partition) _opart=${2:-}; shift 2 || _usage ;;
    --name)      _oname=${2:-}; shift 2 || _usage ;;
    --dir)       _odir=${2:-}; shift 2 || _usage ;;
    --cmd)       _ocmd=${2:-}; shift 2 || _usage ;;
    --control)   _octl=${2:-}; shift 2 || _usage ;;
    --attention) _oattn=${2:-}; shift 2 || _usage ;;
    -*) _out usage 2 "unknown option: $1" ;;
    *)  [ -z "$_osess" ] || _out usage 2 "one session, not two: $1"
        _osess=$1; shift ;;
    esac
  done
  [ -n "$_osess" ] || _out usage 2 "usage: mux agent open SESSION \
[--partition P] [--name N] [--dir D] [--cmd C] [--control CLASS] \
[--attention CLASS]"

  _rp=$_opart
  if [ -z "$_rp" ] && [ -r "$_lib/mux-context_lib" ]; then
    . "$_lib/mux-context_lib"
    mux_ctx_resolve 2>/dev/null && _rp=$MUX_CTX_PARTITION
  fi

  # CROSS-PARTITION IS REFUSED, AND THIS VERB CROSSES HARDER THAN `send`
  # DOES. `send` types into a pane that already exists; opening a window
  # RUNS A COMMAND, and where a partition's boundary is a group acquired per
  # session, the children of that server hold it. So the same structural
  # refusal, for a stronger reason, and there is deliberately no flag and no
  # policy token that opens it.
  if [ -r "$_lib/mux-context_lib" ]; then
    . "$_lib/mux-context_lib"
    mux_ctx_crossing "${_rp:-global}" 'open a window across' || {
      printf '{"status":%s,"reason":%s,"override":%s,"message":%s}\n' \
        "$(mux_json_str refused)" \
        "$(mux_json_str cross-partition)" \
        "$(mux_json_str none)" \
        "$(mux_json_str "refusing to open a window in $_osess: \
$MUX_CTX_CROSS")"
      exit 1
    }
  fi

  . "$_lib/mux-sessions_lib"
  . "$_lib/mux-window_lib"
  # NOT IN A `$( )`, deliberately: the engine reports its reason in a
  # variable, and a command substitution is a subshell that throws it away.
  # See mux-window_lib, where doing it the other way cost an empty document
  # on the refusal path.
  _ow=0
  mux_window_open "${_rp:-global}" "$_osess" "$_oname" "$_odir" \
    "$_ocmd" "$_octl" "$_oattn" 0 || _ow=$?
  case $_ow in
  0) ;;
  3) _out no-such-name 3 "$MUX_WIN_ERR" ;;
  *) _out usage 2 "$MUX_WIN_ERR" ;;
  esac

  # DETACHED, ALWAYS, on this surface: a machine verb that moves the human's
  # view mid-turn is an interrupt nobody asked for. The human verb switches.
  printf '{"status":%s,"partition":%s,"session":%s,"window":%s,' \
    "$(mux_json_str ok)" \
    "$(mux_json_str "${_rp:-global}")" \
    "$(mux_json_str "$_osess")" \
    "$(mux_json_num "${MUX_WIN_OUT#*:}")"
  printf '"control":%s,"attention":%s}\n' \
    "$([ -n "$_octl" ] && mux_json_str "$_octl" || printf null)" \
    "$([ -n "$_oattn" ] && mux_json_str "$_oattn" || printf null)"
  exit 0
fi

if [ "$_verb" = class ]; then
  # --- class ---------------------------------------------------------
  # Change a LIVE pane's class, which is vicus's R3: "the answer can change
  # during a session's life, and the surfaces follow it without the agent
  # being restarted". ESCALATION IS THAT TRANSITION. A supervisor that
  # cannot resolve something hands it to the human, and at that instant the
  # worker has to become visible on the human's surfaces; a value fixed when
  # the pane was created cannot express it.
  #
  # ONE WAY FOR A MACHINE (the user's call): a machine may only ever move a
  # pane TOWARD THE HUMAN. More visible, more restricted:
  # `agent -> hybrid -> human` is free, and the reverse needs a human.
  #
  # WHY THAT ASYMMETRY IS THE WHOLE DESIGN: moving toward the human only ever
  # REMOVES this side's permission and ADDS the human's sight of the pane, so
  # it cannot be a way to reach anything. The reverse GRANTS: relaxing a pane
  # to `agent` is precisely the laundering move (promote a human's pane, then
  # send into it wherever a `control:agent` grant is in force). So creation
  # declares freely, a machine may tighten, and only a human may relax.
  #
  # THE RELAX GATE IS A tty PLUS `--yes`, the shape `mux setup claude`
  # already uses: without both it REFUSES rather than inferring consent.
  # Said plainly because the man page must not overclaim: an agent can
  # allocate a pty and can call `tmux set-option` directly today, so this is
  # ORGANISATIONAL, not a sandbox. What it buys is that the dangerous
  # direction stops being the easy one and that a bypass leaves the log,
  # which is why the log line below is not optional.
  _clsess= _clwin= _clpart= _clctl= _clattn= _clyes=
  while [ "$#" -gt 0 ]; do
    case $1 in
    --partition) _clpart=${2:-}; shift 2 || _usage ;;
    --window)    _clwin=${2:-}; shift 2 || _usage ;;
    --control)   _clctl=${2:-}; shift 2 || _usage ;;
    --attention) _clattn=${2:-}; shift 2 || _usage ;;
    --yes)       _clyes=1; shift ;;
    -*) _out usage 2 "unknown option: $1" ;;
    *)  [ -z "$_clsess" ] || _out usage 2 "one session, not two: $1"
        _clsess=$1; shift ;;
    esac
  done
  [ -n "$_clsess" ] || _out usage 2 "usage: mux agent class SESSION \
[--window N] [--partition P] [--control CLASS] [--attention CLASS] [--yes]"
  [ -n "$_clctl$_clattn" ] || _out usage 2 \
    "nothing to change: give --control and/or --attention"
  for _c in "$_clctl" "$_clattn"; do
    [ -z "$_c" ] && continue
    mux_class_valid "$_c" \
      || _out usage 2 "a class is human|agent|hybrid, not: $_c"
  done

  _resolve "$_clsess" "$_clpart"

  if [ -r "$_lib/mux-context_lib" ]; then
    # shellcheck source=/dev/null
    . "$_lib/mux-context_lib"
    mux_ctx_crossing "${_rp:-global}" 'reclassify a pane across' || {
      printf '{"status":%s,"reason":%s,"override":%s,"message":%s}\n' \
        "$(mux_json_str refused)" \
        "$(mux_json_str cross-partition)" \
        "$(mux_json_str none)" \
        "$(mux_json_str "refusing to reclassify $_clsess: $MUX_CTX_CROSS")"
      exit 1
    }
  fi

  # THE PANE IS RESOLVED HERE, from the state record, never taken from the
  # caller: an id cached from an earlier `peers` can have died and been
  # replaced, and reclassifying the wrong pane is a wrong answer wearing the
  # shape of a right one. `--window` narrows it, which is how a supervisor
  # names ITS worker rather than the session's worst agent.
  if [ -n "$_clwin" ]; then
    _clpane=$(mux_agent_pane_win "$_rd" "$_clsess" "$_clwin")
  else
    _clpane=$(mux_agent_pane "$_rd" "$_clsess")
  fi
  [ -n "$_clpane" ] || _out no-such-name 3 \
    "no tracked agent in $_clsess${_clwin:+ window $_clwin}"

  # EACH MARKER IS JUDGED ON ITS OWN, because a caller may tighten one and
  # leave the other alone, and that combination is the point of their being
  # two: an escalation moves ATTENTION to the human while the supervisor
  # keeps the write access it needs to go on nudging.
  _clout=
  for _m in control:"$_clctl" attention:"$_clattn"; do
    _mk=${_m%%:*} _mv=${_m#*:}
    [ -z "$_mv" ] && continue
    _was=$(_tx display-message -p -t "$_clpane" \
      "#{@mux-$_mk}" 2>/dev/null || true)
    mux_class_valid "$_was" || _was=human
    if [ "$(mux_class_rank "$_mv")" -lt "$(mux_class_rank "$_was")" ]; then
      # RELAXING. A tty AND an explicit flag, or refuse and say which
      # override exists, so a caller learns it in one round trip instead of
      # guessing.
      if [ ! -t 0 ] || [ -z "$_clyes" ]; then
        printf '{"status":%s,"reason":%s,"override":%s,"message":%s}\n' \
          "$(mux_json_str refused)" \
          "$(mux_json_str relax)" \
          "$(mux_json_str 'a human at a terminal with --yes')" \
          "$(mux_json_str "$_clsess $_mk $_was -> $_mv moves AWAY from the \
human, which only a human may do")"
        exit 1
      fi
    fi
    _tx set-option -p -t "$_clpane" "@mux-$_mk" "$_mv" 2>/dev/null || :
    # LOGGED, ALWAYS, and for the relax direction that log IS the gate's
    # value: the check itself is organisational, so the record of a change
    # having happened is the part that survives somebody working around it.
    mux_log agent "$_clsess $_mk $_was -> $_mv via class"
    _clout="$_clout$_mk"
  done

  printf '{"status":%s,"partition":%s,"session":%s,"pane":%s,' \
    "$(mux_json_str ok)" \
    "$(mux_json_str "${_rp:-global}")" \
    "$(mux_json_str "$_clsess")" \
    "$(mux_json_str "$_clpane")"
  printf '"control":%s,"attention":%s}\n' \
    "$([ -n "$_clctl" ] && mux_json_str "$_clctl" || printf null)" \
    "$([ -n "$_clattn" ] && mux_json_str "$_clattn" || printf null)"
  exit 0
fi


if [ "$_verb" = peers ]; then
  # --- peers ---------------------------------------------------------
  # Every session with a tracked agent, and what it is doing. The verb an
  # agent reaches for first: "who else is here, and is anyone stuck".
  #
  # HEADLESS, like agent-list, and that is a property worth protecting
  # rather than an accident. It derives sessions from the state FILES and
  # roots from the session set, so it answers over a transport, at boot,
  # with no tmux client and no server attached. The intended caller is as
  # likely to be `ssh box mux agent peers` as a local one.
  #
  # NO PANE FIELD, deliberately. `read` and `send` resolve a target to a
  # pane at the moment they act, which is more correct than a caller
  # caching an id that can change under it, and it keeps this verb from
  # needing tmux at all.
  _pa=0
  _part=
  while [ $# -gt 0 ]; do
    case $1 in
    --all) _pa=1; shift ;;
    --partition)
      shift
      _part=${1:-}
      [ -n "$_part" ] || _out usage 2 "--partition needs a name"
      shift ;;
    --) shift; break ;;
    *) _out usage 2 "unknown option: $1" ;;
    esac
  done

  # mux-paths_lib FIRST: mux-sessions_lib calls mux_state_path, and a lib
  # that needs another does not say so by itself. Sourcing sessions alone
  # gave six `mux_state_path: not found` lines on stderr and an empty
  # root for every peer: a plausible answer, silently wrong, which is
  # the trap these notes already record for mux-scan and mux-sessions.t.
  . "$_lib/mux-paths_lib"
  . "$_lib/mux-agent-state_lib"
  . "$_lib/mux-sessions_lib"
  if [ -z "$_part" ] && [ -r "$_lib/mux-context_lib" ]; then
    . "$_lib/mux-context_lib"
    mux_ctx_resolve 2>/dev/null && _part=$MUX_CTX_PARTITION
  fi

  # AGE, NOT AN EPOCH, and it is resolved HERE against the clock that
  # wrote it. The obvious design emits the epoch and works perfectly
  # until the reader is on another machine, where a box a few seconds off
  # shows "idle 4s" as "idle 2m" and one badly off shows a negative.
  _now=$(date +%s 2>/dev/null || echo 0)

  _which=$_part
  [ "$_pa" -eq 0 ] || _which=$(
    _root=$(dirname "$(mux_agent_dir "$_part")")
    for _d in "$_root"/*; do
      [ -d "$_d" ] || continue
      printf '%s\n' "${_d##*/}"
    done)

  _items=$(
    printf '%s\n' "$_which" | while IFS= read -r _p; do
      [ -n "$_p" ] || continue
      _dir=$(mux_agent_dir "$_p")
      # ONE tmux QUERY PER PARTITION, not per peer. "Could
      # not ask" and "asked, and nothing is set" are
      # different answers: unreachable reports null, while
      # reached-with-no-option reports `human`, the default
      # class. Collapsing them would make a remote `peers` at
      # boot call every pane human-controlled: plausible,
      # and wrong.
      #
      # EMPTY IS UNREACHABLE, with no separate success flag.
      # One was written first and proved unkillable, because
      # a failed query leaves $_ctl empty anyway and a tmux
      # server with zero panes does not exist: it exits. An
      # unkillable guard here is redundant code rather than a
      # missing test, so it went.
      _ctl=$(tmux -L "$_p" list-panes -a \
        -F "#{pane_id}	#{@mux-control}" \
        2>/dev/null) || _ctl=
      mux_agent_sessions "$_dir" | while IFS= read -r _s; do
        [ -n "$_s" ] || continue
        # ONE ENTRY PER WINDOW, which is vicus's R4 and the half of R8 that
        # a session-level answer cannot give: a worker is a WINDOW in the
        # session it serves, so collapsing a session to its worst agent
        # cannot say whether THIS worker is live. That was tried and
        # rejected for exactly that, because it would confidently answer a
        # different question, which is worse than the bypass it replaced.
        #
        # THE COMMON CASE IS UNCHANGED IN SUBSTANCE: a session with one
        # agent emits one object, as before, now carrying the window it is
        # in. The SHAPE moved, so `agent contract` moved with it.
        mux_agent_windows "$_dir" "$_s" | while IFS= read -r _wi; do
        [ -n "$_wi" ] || continue
        _se=$(mux_agent_state_win "$_dir" "$_s" "$_wi")
        _st=${_se%% *}
        _ep=${_se#* }
        [ -n "$_st" ] || continue
        # A record with no usable epoch still has a
        # real STATE, so its age is null rather than a
        # fabricated 0, which would assert it just
        # changed, a claim there is no evidence for.
        # THE PATTERNS ARE PARENTHESISED, WHICH IS NOT STYLE. This
        # `case` sits inside the `_items=$( ... )` substitution
        # above, and bash 3.2 finds the END of a `$( )` by COUNTING
        # PARENTHESES, so an unparenthesised case pattern's closing
        # `)` closes the substitution early and the `;;` that
        # follows is then a syntax error. macOS `/bin/sh` IS bash
        # 3.2 and always will be (Apple froze it at GPLv2), so this
        # file did not PARSE there: `mux agent` was dead on macOS,
        # every verb, with `syntax error near unexpected token ';;'`
        # on stderr and exit 2.
        #
        # The `(pat)` form is POSIX, and verified identical in dash,
        # bash 5, bash 3.2 and ksh. Only a `case` INSIDE a command
        # substitution needs it; the rest of the tree is checked by
        # the macOS CI job, which runs `/bin/sh -n` over every shell
        # file precisely so this class cannot come back as a
        # mysterious exit code in one test.
        case ${_ep:-} in
        (''|*[!0-9]*) _ag= ;;
        (*) _ag=$((_now - _ep))
            [ "$_ag" -lt 0 ] && _ag=0 ;;
        esac
        # THE CLASS, looked up by the pane the record
        # speaks for. The pane is resolved INTERNALLY
        # and still not emitted: a caller caching an id
        # is the thing `read` and `send` avoid, and
        # answering a different question with it is not
        # the same as handing it over.
        _cl=
        if [ -n "$_ctl" ]; then
          _pn=$(mux_agent_pane_win "$_dir" "$_s" "$_wi")
          _cl=$(printf '%s\n' "$_ctl" | awk \
            -F'\t' -v k="$_pn" \
            '$1 == k { print $2; exit }')
          # PARENTHESISED for the bash 3.2 reason given above:
          # this is inside the same `$( )`.
          case ${_cl:-} in
          (agent|hybrid) ;;
          (*) _cl=human ;;
          esac
          # The pane is gone but its record is
          # not: the class is unknowable, which
          # is null rather than the default.
          printf '%s\n' "$_ctl" \
            | grep -q "^$_pn	" \
            || _cl=
        fi
        printf '{"partition":%s,"session":%s,"window":%s,' \
          "$(mux_json_str "$_p")" \
          "$(mux_json_str "$_s")" \
          "$(mux_json_num "$_wi")"
        printf '"state":%s,"age":%s,"control":%s,' \
          "$(mux_json_str "$_st")" \
          "$(mux_json_num "${_ag:-}")" \
          "$([ -n "$_cl" ] \
            && mux_json_str "$_cl" \
            || printf null)"
        printf '"root":%s}\n' \
          "$(mux_json_str \
            "$(mux_sess_root "$_s" "$_p")")"
        done
      done
    done | mux_json_array
  )
  printf '{"status":"ok","peers":%s}\n' "$_items"
  exit 0
fi

# --- status ---------------------------------------------------------------
# The same question `mux agent-summary --all --attached` answers, in the
# contract's shape. It SHELLS OUT to that verb rather than re-deriving: the
# ranking lives in mux-agent-state_lib and has been written twice before, which
# is once more than it should have been. Whether a verb here is a thin wrapper
# is an implementation detail; the contracts are what differ.
_all=0
_att=1
_spart=
while [ $# -gt 0 ]; do
  case $1 in
  --all)      _all=1; shift ;;
  --partition)
    [ -n "${2:-}" ] || _out usage 2 "--partition needs a name"
    _spart=$2; shift 2 ;;
  # EVERY partition, not just the watched ones. The default is `attached`
  # because a tray item means somebody is looking at it, and an agent
  # asking what is going on wants the same answer a human would see.
  --any)      _att=0; shift ;;
  --) shift; break ;;
  *)  _out usage 2 "unknown option: $1" ;;
  esac
done

# SCOPED TO THE CALLER'S PARTITION UNLESS ASKED OTHERWISE, the same rule
# `peers` already follows. `_all` was parsed and never read, so every caller
# got every partition, and the shipped skill tells an agent the opposite,
# one sentence after calling a partition an isolation boundary. A flag that
# parses and does nothing is worse than a missing one: the caller believes it
# asked for something.
if [ "$_all" -eq 0 ]; then
  if [ -z "$_spart" ] && [ -r "$_lib/mux-context_lib" ]; then
    . "$_lib/mux-context_lib"
    mux_ctx_resolve 2>/dev/null && _spart=$MUX_CTX_PARTITION
  fi
  # `global` is the namespace mux_agent_dir defaults to, so an
  # unresolvable context scopes to the default rather than widening to
  # everything: failing open is the one answer this must not give.
  [ -n "$_spart" ] || _spart=global
fi

set -- --all
[ "$_att" -eq 0 ] || set -- "$@" --attached
_rows=$("$_lib/mux-agent-state-summary" "$@" 2>/dev/null) || _rows=

# `<partition> <state> <count>` per line into one object per line, then one
# array. Read with a field split rather than `read -r a b c` so a malformed
# line cannot silently shift the count into the state.
_items=$(
  printf '%s\n' "$_rows" | while IFS=' ' read -r _p _st _n; do
    [ -n "${_p:-}" ] || continue
    [ -n "${_st:-}" ] || continue
    [ -z "$_spart" ] || [ "$_p" = "$_spart" ] || continue
    printf '{"partition":%s,"state":%s,"count":%s}\n' \
      "$(mux_json_str "$_p")" "$(mux_json_str "$_st")" \
      "$(mux_json_num "${_n:-}")"
  done | mux_json_array
)

printf '{"status":"ok","partitions":%s}\n' "$_items"
exit 0
