#!/bin/sh
# mux-agent: THE MACHINE CONTRACT. `mux agent <verb>` is the surface an agent
# (or any program) is invited to depend on, and it is deliberately a different
# contract from the rest of mux rather than a second spelling of it.
#
#   mux agent status [--any]              every partition's worst state
#   mux agent peers  [--partition N|--all] every session and what it is doing
#   mux agent read   SESSION [-n LINES]    what is on that agent's screen
#   mux agent wait   SESSION STATE [-t N]  block until it gets there
#   mux agent send   SESSION TEXT|-         type into that agent's pane
#
# THREE PROMISES, which is what makes it a contract rather than a convention:
#
#   1. JSON ON STDOUT, ALWAYS, INCLUDING ON FAILURE. Every other mux verb puts
#      its reason on stderr, which is right for a human reading a terminal and
#      wrong for a caller that parses. A reader here never has to decide
#      whether today's answer is a document or a sentence.
#
#   2. A SYMBOLIC `status`, alongside the numeric exit. mux uses exactly four
#      exit codes and the ABSENCE of every other one is load-bearing: latch
#      attributes 126, 127 and 255 to the shell and to ssh precisely because
#      mux never emits them. So richer outcomes go in the PAYLOAD, where they
#      cost nothing: the exit code stays for the shell, the enumeration is for
#      the reader, and neither has to be widened to serve the other.
#
#   3. THE SHAPE IS STABLE OR THE CAPABILITY NUMBER MOVES. `mux capabilities`
#      declares `agent contract 4`; a breaking change to any of these
#      documents is a new number there, which is how a consumer finds out
#      without sniffing a version string.
#
# WHY A NAMESPACE AT ALL. Without one, nothing declares which output is meant
# to be parsed: the tray polls `mux agent-summary`, and improving `mux ls` for
# a human could silently break a consumer that had started reading it. A
# declared machine surface is what frees the human surface to keep changing.
set -eu

_libexec=$(dirname "$0")
_lib=$_libexec/../lib
[ -r "$_lib/mux-exit_lib" ] \
  || { echo "mux: $_lib/mux-exit_lib missing" >&2; exit 1; }
# shellcheck source=/dev/null
. "$_lib/mux-exit_lib"

# How long `mux agent wait` blocks when the caller gives no -t. Named rather
# than inline because it is the one bound a caller inherits without asking
# for it; `-t` overrides, and 0 is refused.
MUX_AGENT_WAIT_DEFAULT=${MUX_AGENT_WAIT_DEFAULT:-300}
# mux-conf_lib FIRST: mux-context_lib reads $MUX_DIR/config through
# mux_conf_clean, and says so in its own header.
. "$_lib/mux-conf_lib"
. "$_lib/mux-json_lib"
. "$_lib/mux-send-policy_lib"
# The pane class vocabulary and its ORDERING, which `class` turns on and
# `open` validates against. Core to this file, so unconditional.
. "$_lib/mux-class_lib"
# `class` and `send` both record a transition, and the log is the half of the
# relax gate that survives somebody working around it.
. "$_lib/mux-log_lib"

# THE STATUS ENUMERATION, and its one rule: each value maps to exactly one of
# mux's four exit codes, never the reverse. Several statuses may share a code
# (that is the point of having both), but a status must not be able to mean
# two different exits.
#
#   ok            0   the answer follows
#   refused       1   a guard fired; `message` says which
#   usage         2   this verb does not know what it was asked
#   no-such-name  3   mux's cross-cutting "the name is not known here"
#
# ALWAYS A MESSAGE: every failure here has a reason, so a no-message branch
# would be unreachable, which is a mutation nothing can kill. Belt-and-braces
# reads as safety and measures as untestable.
_out() {   # <status> <exit> <message>
  printf '{"status":%s,"message":%s}\n' \
    "$(mux_json_str "$1")" "$(mux_json_str "$3")"
  exit "$2"
}

_usage() {
  # THE VERB LIST IN A VARIABLE so the `_out` call stays on ONE line: a
  # mutation record cannot anchor a line ending in a continuation backslash,
  # and the guard that the status WORD is honoured is worth keeping killable.
  # Same move as the `untrusted` reason in mux-latch, for the same reason.
  _uv='status|stream|self|presence|peers|read|wait|send|open|ensure'
  _uv="$_uv|class"
  _out usage 2 "usage: mux agent <$_uv> ..."
}

_verb=${1:-}
[ -n "$_verb" ] || _usage
shift

case $_verb in
  status|stream|self|presence|peers|read|wait|send|open|ensure|class) ;;
  *) _out usage 2 "unknown agent verb: $_verb" ;;
esac

# _resolve TARGET: sets $_rp (partition), $_rd (state dir) and checks the
# session is one mux knows. Shared by read and wait, because "that session is
# not here" must be the same answer and the same exit from both.
_resolve() {   # <session> <partition-or-empty>
  _rp=$2
  if [ -z "$_rp" ] && [ -r "$_lib/mux-context_lib" ]; then
    . "$_lib/mux-context_lib"
    _rp=$(mux_ctx_mine)
  fi
  _rd=$(mux_agent_dir "$_rp")
  # EXIT 3, mux's cross-cutting "the name is not known here", rather than
  # an empty answer. A caller that mistyped a session and a caller
  # looking at one with nothing to say must not get the same document.
  mux_agent_sessions "$_rd" | grep -qxF -- "$1" || _out no-such-name 3 \
    "no session $1 with a tracked agent in partition ${_rp:-global}"
}

# EVERY tmux CALL GOES THROUGH THIS. A bare `tmux` asks the DEFAULT socket,
# which is not where a partition's server lives, so `read` captured nothing
# and `send` read an empty class (defaulting to `human`) for a pane that was
# plainly marked `agent`. Both looked like correct refusals, which is why a
# stub could not have caught it and a real server did on the first try.
#
# The socket name IS the partition name, so once _resolve has one there is no
# case where a bare call is right. Same wrapper mux-even and next-blocked
# already carry, for the same reason, which makes this the third time.
_tx() {
  tmux -L "${_rp:-global}" "$@"
}

# --- WHICH WINDOW, AND WHY NOT AN INDEX ------------------------------------
# `--window` takes a NAME or a tmux window ID (`@7`). Never an index, and that
# is a measurement rather than taste: AN INDEX IS A RECYCLABLE SLOT. Windows
# a@1 b@2 c@3, kill b, create d, and index 2 IS d with id @4. A caller holding
# an index types into a different worker believing it is the one it named.
#
# AN ID IS NOT REUSED (@2 retired permanently), and the asymmetry that decides
# everything here is what a STALE handle does:
#
#     a killed or unknown @N       resolves to NOTHING
#     an unknown NAME, via tmux    resolves to the CURRENT window
#
# So A NAME IS NEVER HANDED TO tmux AS A TARGET: its own name resolution fails
# OPEN. mux matches the name here, against a listing, and acts only when
# exactly one window answers. ONLY ACT ON UNIQUENESS rather than enforcing it:
# no new invariant to maintain, no renaming that would stop a caller
# re-deriving the name it chose, and an ambiguous name stays RECOVERABLE
# because the ID is accepted too.
#
# THE EXIT CODE SAYS NOTHING. All four of those tmux calls exit 0, including
# the invalid ones, so every check below is on the ANSWER and never on `$?`.
#
# MEMBERSHIP COMES FROM LIVE tmux, never from the record's window field: that
# field is an INDEX, so a record left by a dead pane in a since-recycled slot
# would match. Records are found by PANE id, which is unique and never reused.
#
# AND THE SESSION IS VALIDATED BY CONSTRUCTION, which an ID needs: `@N` is
# server-global, so `--window @5` could name a window in another session.
# The listing is session-scoped, so filtering it answers both questions at
# once.
# It reads `$_rd` and `$_rp` from `_resolve`, which every caller has already
# run, and sets `_ws_pane`, `_ws_wid` and `_ws_state`. It REFUSES rather than
# returning: every caller's answer to "which window" being unanswerable is
# the same, and an engine that reports a reason cannot be called in `$( )`.
_winsel() {   # <session> <selector-or-empty>
  _ws_pane= _ws_wid= _ws_state= _ws_cand=
  # WHICH PANES HAVE A RECORD, read from the records themselves rather than
  # from their FILENAMES: a record's name is not its pane id (the enumerator
  # is a bare glob and the pane is field 3), so a filename join would find
  # nothing and refuse every window. Caught by the suite the first time this
  # ran.
  _ws_rp=" " _ws_recs=
  for _ws_f in "$_rd"/*; do
    [ -f "$_ws_f" ] || continue
    read -r _ws_x1 _ws_x2 _ws_x3 _ws_junk 2>/dev/null <"$_ws_f" || continue
    # THE DERIVED STATE, NOT THE RECORD'S RAW WORD, and that is the whole of
    # this line. `humming` is deliberately never STORED (the sidecar holds
    # pids so the state clears itself when the last job exits), so a reader
    # that takes field 1 at face value reports `idle` for a pane every other
    # surface calls `humming`. Measured: one pane, `send` answering
    # `"state":"idle"` while `peers` answered `"state":"humming"`, on a
    # surface whose whole promise is one declared vocabulary. The audit log
    # recorded the same wrong word.
    #
    # THE LIBRARY PREDICATE, never a second copy of the rule, and it is cheap
    # enough to be uninteresting here: a file test plus `kill -0` per pid,
    # not the /proc walk that WRITES the sidecar. These are human-speed
    # actuating verbs (read, send, class), never the strip.
    if [ "$_ws_x1" = idle ] && mux_agent_humming "$_ws_f"; then
      _ws_x1=humming
    fi
    _ws_rp="$_ws_rp$_ws_x3 "
    _ws_recs="$_ws_recs$_ws_x3 $_ws_x1
"
  done
  _ws_raw=$(_tx list-panes -s -t "=$1" \
    -F '#{window_id}	#{window_name}	#{pane_id}' \
    2>/dev/null) || _ws_raw=
  # A window answers as an AGENT window when one of its LIVE panes has a
  # record. One line per matching agent pane: "<window-id> <name> <pane>".
  while IFS="	" read -r _wi _wn _wp; do
    [ -n "$_wp" ] || continue
    # LIVE tmux DECIDES THE SESSION, not the record's session field, which is
    # a cache: a pane is in the session tmux says it is in. The record only
    # has to EXIST for the pane to count as an agent's.
    case $_ws_rp in
      (*" $_wp "*) ;;
      (*) continue ;;
    esac
    case $2 in
      '') ;;
      @*) [ "$_wi" = "$2" ] || continue ;;
      *)  [ "$_wn" = "$2" ] || continue ;;
    esac
    _ws_cand="$_ws_cand$_wi $_wn $_wp
"
  done <<WSEOF
$_ws_raw
WSEOF

  # DISTINCT WINDOWS is the number that decides. Several agent panes in ONE
  # window is not ambiguity: that is a window with two agents, and the
  # worst-ranked one wins there as it always has.
  _ws_wins=$(printf '%s' "$_ws_cand" | awk '$1 != "" { print $1 }' | sort -u)
  _ws_n=$(printf '%s' "$_ws_wins" | awk 'NF { n++ } END { print n + 0 }')

  # ONE STRING PER MESSAGE, assembled before the call. `_out` takes exactly
  # three parameters and prints `$3`, so a reason split across several
  # arguments is SILENTLY truncated at the first: this printed "name one" and
  # stopped. Same bug `mux-latch`'s `_wait` shipped once, met again by the
  # person who wrote that note down.
  if [ "$_ws_n" -eq 0 ]; then
    case $2 in
      ('') _ws_m="no agent pane recorded for $1" ;;
      (@*) _ws_m="no agent window $2 in $1. A window id is never reused, so"
           _ws_m="$_ws_m a stale one names nothing rather than whatever took"
           _ws_m="$_ws_m the slot" ;;
      (*)  _ws_m="no agent window named '$2' in $1" ;;
    esac
    _out refused 1 "$_ws_m"
  fi
  if [ "$_ws_n" -gt 1 ]; then
    # THE REFUSAL CARRIES WHAT RESOLVES IT, which is the whole reason the ID
    # is accepted at all: an ambiguous name is then recoverable in one step
    # rather than a dead end.
    _ws_ids=$(printf '%s' "$_ws_wins" | tr '\n' ' ')
    case $2 in
      ('') _ws_m="$1 holds $_ws_n agent windows ($_ws_ids); name one with"
           _ws_m="$_ws_m --window NAME or --window @ID. Acting on an unnamed"
           _ws_m="$_ws_m one would be a wrong answer rather than a refusal" ;;
      (*)  _ws_m="'$2' names $_ws_n windows in $1 ($_ws_ids); mux acts only on"
           _ws_m="$_ws_m a unique name, so pass one of those ids instead" ;;
    esac
    _out refused 1 "$_ws_m"
  fi

  # One window. Pick its worst-ranked agent pane, the rule every other
  # surface already uses, so nothing is hidden.
  _ws_br=-1
  while read -r _wi _wn _wp; do
    [ -n "$_wp" ] || continue
    _ws_st=$(printf '%s' "$_ws_recs" \
      | awk -v k="$_wp" '$1 == k { print $2; exit }')
    [ -n "$_ws_st" ] || continue
    _ws_r=$(mux_agent_rank "$_ws_st")
    if [ "$_ws_r" -gt "$_ws_br" ]; then
      _ws_br=$_ws_r; _ws_pane=$_wp; _ws_wid=$_wi; _ws_state=$_ws_st
    fi
  done <<WSEOF
$_ws_cand
WSEOF
  [ -n "$_ws_pane" ] || _out refused 1 "no readable record for $1 $2"
}

case $_verb in
  read|wait|send|class|stream)
    . "$_lib/mux-paths_lib"
    . "$_lib/mux-agent-state_lib" ;;
esac
case $_verb in
  stream)
    . "$_lib/mux-agent-announce_lib" ;;
esac

if [ "$_verb" = read ]; then
  # --- read ----------------------------------------------------------
  # What is on that agent's screen. THE PANE IS RESOLVED NOW, from the
  # state record, rather than taken from a caller: an id cached from an
  # earlier `peers` can have died and been replaced, and capturing the
  # wrong pane is the plausible-wrong-answer shape this codebase keeps
  # meeting. Resolving it here also means `peers` need not carry one.
  # AN OPTION IS AN OPTION WHEREVER IT SITS. The front end stops parsing
  # options at the first positional (so `mux resume work --list` reads
  # `--list` as a session name), and that edge is tolerable for a human
  # who can see the result. It is not for a caller composing argv
  # programmatically, where argument ORDER becomes a rule nobody wrote
  # down. `mux agent read mux -n 5` failed exactly that way once.
  _rn=
  _rpart=
  _rwin=
  _rsess=
  while [ $# -gt 0 ]; do
    case $1 in
      --window) shift
          _rwin=${1:-}
          [ -n "$_rwin" ] || _out usage 2 "--window needs a NAME or @ID"
          shift ;;
      -n) shift
          _rn=${1:-}
          case ${_rn:-} in
            ''|*[!0-9]*) _out usage 2 "-n needs a line count" ;;
          esac
          shift ;;
      --partition) shift
          _rpart=${1:-}
          [ -n "$_rpart" ] || _out usage 2 "--partition needs a name"
          shift ;;
      --) shift; break ;;
      -*) _out usage 2 "unknown option: $1" ;;
      *)  [ -z "$_rsess" ] || _out usage 2 "read takes one SESSION"
          _rsess=$1; shift ;;
    esac
  done
  [ -n "$_rsess" ] || _out usage 2 \
    "usage: mux agent read SESSION [--window NAME|@ID] [-n N]"

  _resolve "$_rsess" "$_rpart"
  _winsel "$_rsess" "$_rwin"
  _pane=$_ws_pane

  # THE VISIBLE PANE BY DEFAULT, scrollback only when asked. An agent
  # pane's scrollback can be enormous, and a verb whose default answer is
  # unbounded is one a caller learns to be afraid of. -J joins wrapped
  # lines, so a reader gets the logical line rather than the terminal's.
  set -- capture-pane -p -J -t "$_pane"
  [ -z "$_rn" ] || set -- "$@" -S "-$_rn"
  _text=$(_tx "$@" 2>/dev/null) || _out refused 1 \
    "could not capture pane $_pane (is that server running?)"

  printf '{"status":"ok","partition":%s,"session":%s,' \
    "$(mux_json_str "${_rp:-global}")" "$(mux_json_str "$_rsess")"
  printf '"window":%s,"pane":%s,"text":%s}\n' \
    "$(mux_json_str "$_ws_wid")" \
    "$(mux_json_str "$_pane")" "$(mux_json_str "$_text")"
  exit "$MUX_EC_OK"
fi

if [ "$_verb" = wait ]; then
  # --- wait ----------------------------------------------------------
  # Block until a session reaches a state. The verb that makes the other
  # two composable: without it a caller polls `peers` in a loop and
  # invents its own timeout, badly.
  #
  # ALWAYS BOUNDED. An unbounded wait from an agent is a hang with no
  # operator, so -t has a default rather than meaning forever.
  _wt=$MUX_AGENT_WAIT_DEFAULT
  _wpart=
  _wsess=
  _want=
  while [ $# -gt 0 ]; do
    case $1 in
      -t) shift
          _wt=${1:-}
          case ${_wt:-} in
            ''|*[!0-9]*) _out usage 2 "-t needs seconds" ;;
          esac
          shift ;;
      --partition) shift
          _wpart=${1:-}
          [ -n "$_wpart" ] || _out usage 2 "--partition needs a name"
          shift ;;
      --) shift; break ;;
      -*) _out usage 2 "unknown option: $1" ;;
      *)  if [ -z "$_wsess" ]; then _wsess=$1
          elif [ -z "$_want" ]; then _want=$1
          else _out usage 2 "wait takes a SESSION and a STATE"
          fi
          shift ;;
    esac
  done
  [ -n "$_wsess" ] && [ -n "$_want" ] \
    || _out usage 2 "usage: mux agent wait SESSION STATE [-t N]"
  case $_want in
    blocked|working|idle|humming) ;;
    *) _out usage 2 "not a state mux emits: $_want" ;;
  esac
  # BOTH GREENS SATISFY `idle`, and this is the one place a new state could
  # have broken an existing caller SILENTLY. The comparison below is an exact
  # string match, so without this a supervisor waiting for `idle` would keep
  # waiting while its worker sat at a prompt ready for input, and with a
  # long-running background job it would burn the whole timeout and report
  # `timed-out` about a turn that had ended. That is the same class as the
  # compaction bug (a machine surface making `idle` a lie), inverted.
  #
  # MEMBERSHIP, NOT RANK. `wait working` must stay exact: a caller waiting for
  # a turn to START would otherwise be satisfied immediately by an idle
  # session, which is a different and worse wrong answer. Only the two greens
  # mean the same thing to a caller, because only they share the fact that the
  # turn is over.
  _wset=$_want
  [ "$_want" != idle ] || _wset='idle humming'

  _resolve "$_wsess" "$_wpart"

  # CHECKED BEFORE SLEEPING, so a session already in the wanted state
  # returns at once rather than after the first poll interval.
  _t0=$(date +%s 2>/dev/null || echo 0)
  while :; do
    _se=$(mux_agent_state "$_rd" "$_wsess")
    _now=$(date +%s 2>/dev/null || echo 0)
    _el=$((_now - _t0))
    [ "$_el" -ge 0 ] || _el=0
    _wnow=${_se%% *}
    if [ -n "$_wnow" ] && case " $_wset " in *" $_wnow "*) true ;; *) false ;;
      esac; then
      printf '{"status":"ok","partition":%s,"session":%s,' \
        "$(mux_json_str "${_rp:-global}")" \
        "$(mux_json_str "$_wsess")"
      # THE STATE REACHED, not the one asked for. With `idle` satisfied by
      # either green, echoing the request back would hide the very distinction
      # the caller needs: "ready" and "ready, with work still running" are
      # different answers to the same question.
      printf '"state":%s,"waited":%s}\n' \
        "$(mux_json_str "$_wnow")" \
        "$(mux_json_num "$_el")"
      exit "$MUX_EC_OK"
    fi
    [ "$_el" -lt "$_wt" ] || break
    sleep 1
  done

  # TIMED-OUT IS ITS OWN STATUS AND NOT ITS OWN EXIT CODE, which is the
  # whole argument for carrying both. "It did not happen in time" is a
  # refusal as far as a shell is concerned (exit 1); a reader that wants
  # to tell it from every other refusal reads the word. Widening mux's
  # four exit codes to say this would cost latch the attribution it gets
  # from 126, 127 and 255 never being mux's.
  #
  # AND IT REPORTS THE STATE IT IS ACTUALLY IN, because "not idle yet" is
  # a different problem from "blocked and waiting for a human", and a
  # caller that has just burned its timeout should not need a second
  # round trip to find out which.
  printf '{"status":"timed-out","partition":%s,"session":%s,' \
    "$(mux_json_str "${_rp:-global}")" "$(mux_json_str "$_wsess")"
  printf '"wanted":%s,"state":%s,"waited":%s,"message":%s}\n' \
    "$(mux_json_str "$_want")" \
    "$(mux_json_str "${_se%% *}")" \
    "$(mux_json_num "$_el")" \
    "$(mux_json_str "$_wsess is ${_se%% *}, not $_want, after ${_el}s")"
  exit "$MUX_EC_FAIL"
fi

if [ "$_verb" = send ]; then
  # --- send ----------------------------------------------------------
  # Type into an agent's pane. THE HOOK A HIGHER LAYER NEEDS, and the
  # reason it belongs here rather than in that layer: mux already knows
  # which pane is the agent's, which partition it is in, and (the part
  # only mux knows) whether it is BLOCKED. Without this verb an
  # orchestrator reaches around mux to `tmux send-keys`, re-derives pane
  # resolution, and inherits none of the guards below.
  #
  # WHAT IT IS NOT: orchestration. `spawn` is `mux go` plus this, which
  # the layer above composes in two lines, so mux does not grow a verb
  # that decides when a worker starts.
  _spart= _sack_prompt=0 _sack_blind=0 _senter=1
  _ssess= _stext= _shave_text=0 _ssel=
  while [ $# -gt 0 ]; do
    case $1 in
      --partition) shift
          _spart=${1:-}
          [ -n "$_spart" ] || _out usage 2 "--partition needs a name"
          shift ;;
      --window) shift
          _ssel=${1:-}
          [ -n "$_ssel" ] || _out usage 2 "--window needs a NAME or @ID"
          shift ;;
      # TWO ACKNOWLEDGEMENTS, NOT ONE, pairing with the two grants:
      # being allowed to answer prompts must never imply being
      # allowed to type into a pane mux cannot classify.
      --answer-prompt) _sack_prompt=1; shift ;;
      --blind)         _sack_blind=1; shift ;;
      --no-enter)      _senter=0; shift ;;
      --) shift; break ;;
      -)  # stdin, so a long charge is not an argv-length problem
          [ "$_shave_text" -eq 0 ] || _out usage 2 "send takes one TEXT"
          _stext=$(cat); _shave_text=1; shift ;;
      -*) _out usage 2 "unknown option: $1" ;;
      *)  if [ -z "$_ssess" ]; then _ssess=$1
          elif [ "$_shave_text" -eq 0 ]; then _stext=$1; _shave_text=1
          else _out usage 2 "send takes one SESSION and one TEXT"
          fi
          shift ;;
    esac
  done
  [ -n "$_ssess" ] && [ "$_shave_text" -eq 1 ] \
    || _out usage 2 \
    "usage: mux agent send SESSION TEXT|- [--window NAME|@ID]"

  _resolve "$_ssess" "$_spart"
  _winsel "$_ssess" "$_ssel"
  _spane=$_ws_pane
  # THE GATE JUDGES THE PANE IT WILL TYPE INTO, which is why the state comes
  # from the selected pane's own record rather than from the session-wide
  # worst. Those differ precisely when they matter: one worker `blocked` at a
  # permission prompt would otherwise make an idle sibling unwritable, and
  # worse in the other direction, a session whose worst pane is `idle` would
  # let a charge through to a `blocked` one without the acknowledgement that
  # case exists to require.
  _sstate=$_ws_state

  # WHO CONTROLS THE PANE, and the default is the strict one. An
  # unclassified pane is a human's: the safe answer is the one you get by
  # saying nothing, and marking a village is a deliberate act by the
  # layer that spawned it.
  #
  # `_swin` IS THE RESOLVED PANE'S WINDOW NAME, not the caller's selector
  # (`_ssel`), and they are two variables on purpose: this one is what a
  # policy line matches and what the audit log records, so it has to be what
  # mux ACTED on rather than what it was asked for. A selector of `@7` would
  # otherwise be matched against a policy written in window names.
  _swin=$(_tx display-message -p -t "$_spane" '#{window_name}' \
    2>/dev/null || true)
  _sclass=$(_tx display-message -p -t "$_spane" '#{@mux-control}' \
    2>/dev/null || true)
  case ${_sclass:-} in
    agent|hybrid) ;;
    *) _sclass=human ;;
  esac

  # A SEND MAY NOT LEAVE THE CALLER'S OWN PARTITION, refused structurally
  # and before the policy, for exactly the reason `human` is.
  #
  # THE HOLE THIS CLOSES was found by the user asking whether mux pokes a
  # hole in the boundary a partition mechanism is there to keep. It does,
  # and the measurement is unambiguous: every token on a policy line is
  # ANDed, so the one grant that makes a village workable at all,
  #
  #     send-blocked control:agent
  #
  # carries NO partition token and therefore reaches agents in EVERY
  # partition. One root-owned line, written for a perfectly good reason,
  # crosses the wall.
  #
  # STRUCTURAL, NOT A POLICY TOKEN, and that is the same argument the class
  # gate already makes one line down: a grant that names only a class or
  # only a window would otherwise cross a boundary BY OMISSION, and the
  # omission is the easy mistake rather than the hard one.
  #
  # THE DECISION ITSELF IS `mux_ctx_crossing`, in mux-context_lib, because
  # every actuating verb has to ask it and a second copy is the one that
  # drifts. Why crossing matters, what a failed hook means, and why a box
  # with no partitions pays nothing are all documented there, at the one
  # site that answers it.
  _scross=
  if [ -r "$_lib/mux-context_lib" ]; then
    # shellcheck source=/dev/null
    . "$_lib/mux-context_lib"
    mux_ctx_crossing "${_rp:-global}" 'type across' \
      || _scross=$MUX_CTX_CROSS
  fi

  # _refuse WHAT ACK: the target needs an override. Reports whether one
  # is AVAILABLE, which is the whole point of answering rather than just
  # refusing: a caller that does not know discovers the capability in one
  # round trip and decides; one that does know passes the flag up front
  # and pays nothing.
  _refuse() {   # <what> <ack-flag-name>
    _rf_av=none
    _rf_why=
    if [ -n "$_scross" ]; then
      # NEVER, and no override exists to report: there is deliberately
      # no flag and no policy token that opens this.
      _rf_why=$_scross
    elif [ "$_sclass" = human ]; then
      # NEVER, and the policy is not consulted. Structural
      # rather than a token an operator has to remember: a
      # grant naming only a window would otherwise reach a
      # human's pane by omission.
      _rf_why="it is human-controlled; mux does not"
      _rf_why="$_rf_why answer a prompt on a human's behalf"
    elif mux_send_allowed "$1" "${_rp:-global}" "$_ssess" \
        "${_swin:-}" "$_sclass"; then
      _rf_av=available
      _rf_why="the policy permits an override here; pass $2"
    else
      _rf_why=$(mux_send_policy_why)
      [ -n "$_rf_why" ] || _rf_why="no policy grants an override for this scope"
    fi
    printf '{"status":"refused","reason":%s,"override":%s,' \
      "$(mux_json_str "$1")" "$(mux_json_str "$_rf_av")"
    printf '"partition":%s,"session":%s,"window":%s,"class":%s,' \
      "$(mux_json_str "${_rp:-global}")" \
      "$(mux_json_str "$_ssess")" \
      "$(mux_json_str "${_swin:-}")" \
      "$(mux_json_str "$_sclass")"
    printf '"state":%s,"message":%s}\n' \
      "$(mux_json_str "$_sstate")" \
      "$(mux_json_str "$_ssess: $_rf_why")"
    exit "$MUX_EC_FAIL"
  }

  # THE BOUNDARY GATE RUNS UNCONDITIONALLY AND FIRST, never inside `_refuse`:
  # `idle|working` never reach `_refuse` at all, since an ordinary queued
  # instruction needs no override, so a gate placed there guards the two RARE
  # states and misses the common one. A structural refusal that only fires on
  # the unusual path is not structural.
  [ -z "$_scross" ] || _refuse cross-partition ''

  # THE STATE DECIDES WHETHER AN OVERRIDE IS NEEDED AT ALL. idle and
  # working are ordinary: a turn that is running buffers the text and
  # picks it up when it ends, which is the natural "queue the next
  # instruction" case and is why working is not refused.
  #
  # AND `humming` IS NAMED HERE RATHER THAN LEFT TO THE FALL-THROUGH, which
  # is the whole of this arm's history: it used to reach `*)` and demand
  # `--blind` PLUS a root-owned `send-unknown` grant, so a session whose turn
  # had ended with a build still running was the hardest pane on the box to
  # talk to. That arm is for a state word THIS mux cannot classify (a newer
  # mux across a transport), where blind is right because mux genuinely
  # cannot say what the pane is doing. `humming` is the opposite: mux knows
  # exactly what it means, and what it means is that the TURN IS OVER and the
  # agent is sitting at a prompt. It is strictly as available as `idle`, so
  # it is strictly as ordinary, and the background job is not the agent.
  case $_sstate in
    idle|working|humming) ;;
    blocked)
      [ "$_sack_prompt" -eq 1 ] || _refuse blocked --answer-prompt
      mux_send_allowed blocked "${_rp:-global}" "$_ssess" \
        "${_swin:-}" "$_sclass" || _refuse blocked --answer-prompt
      [ "$_sclass" != human ] || _refuse blocked --answer-prompt ;;
    *)
      [ "$_sack_blind" -eq 1 ] || _refuse unknown --blind
      mux_send_allowed unknown "${_rp:-global}" "$_ssess" \
        "${_swin:-}" "$_sclass" || _refuse unknown --blind
      [ "$_sclass" != human ] || _refuse unknown --blind ;;
  esac

  # BRACKETED PASTE, so the agent's TUI sees PASTED TEXT rather than a
  # stream of keystrokes. It matters for anything multi-line: a TUI that
  # reads Enter as submit would send the first line on its own and leave
  # the rest arriving as a new prompt.
  #
  # A buffer named for this process, deleted on paste, so a human's own
  # tmux buffers are not clobbered by an agent talking to a peer.
  _sbuf=mux-send-$$
  printf '%s' "$_stext" | _tx load-buffer -b "$_sbuf" - 2>/dev/null \
    || _out refused 1 "could not stage the text for $_spane"
  _tx paste-buffer -p -d -b "$_sbuf" -t "$_spane" 2>/dev/null || {
    _tx delete-buffer -b "$_sbuf" 2>/dev/null || true
    _out refused 1 "could not paste into $_spane"; }
  [ "$_senter" -eq 0 ] || _tx send-keys -t "$_spane" Enter 2>/dev/null \
    || true

  # LOGGED, because a send is a MUTATION and this is the one mux makes on
  # another agent's behalf. It is also the audit trail the layer above
  # would otherwise have to build: who was typed at, in what state, and
  # whether an override was taken.
  if [ -r "$_lib/mux-log_lib" ]; then
    . "$_lib/mux-log_lib"
    _sov=
    [ "$_sack_prompt" -eq 0 ] || _sov=" --answer-prompt"
    [ "$_sack_blind" -eq 0 ]  || _sov="$_sov --blind"
    mux_log send "$_ssess (${_rp:-global}/${_swin:-?}) $_sclass \
$_sstate$_sov ${#_stext} bytes"
  fi

  printf '{"status":"ok","partition":%s,"session":%s,"window":%s,' \
    "$(mux_json_str "${_rp:-global}")" "$(mux_json_str "$_ssess")" \
    "$(mux_json_str "${_swin:-}")"
  printf '"pane":%s,"class":%s,"state":%s,"bytes":%s}\n' \
    "$(mux_json_str "$_spane")" "$(mux_json_str "$_sclass")" \
    "$(mux_json_str "$_sstate")" "$(mux_json_num "${#_stext}")"
  exit "$MUX_EC_OK"
fi

if [ "$_verb" = open ]; then
  # --- open ----------------------------------------------------------
  # Open a WINDOW in an existing session, and declare what it is for.
  # vicus's R8: a worker is a WINDOW in the session it serves, and with no
  # verb for this the layer above reimplements it. It did, as its single
  # documented exemption from "never sidestep mux to reach tmux", and the
  # copy omitted `-d` so every spawn dragged the human's view into a worker.
  #
  # FIELDS, NOT A COMPOUND TOKEN, which is the machine surface's existing
  # rule rather than a new one: `peers` emits partition and session
  # separately, so nothing here parses a packed identifier and `send` has
  # nothing imposed on it backwards. The HUMAN verb (`mux window`) takes one
  # typed token, because a human types.
  _oname= _odir= _ocmd= _octl= _oattn= _opart= _osess=
  while [ "$#" -gt 0 ]; do
    case $1 in
      --partition) _opart=${2:-}; shift 2 || _usage ;;
      --name)      _oname=${2:-}; shift 2 || _usage ;;
      --dir)       _odir=${2:-}; shift 2 || _usage ;;
      --cmd)       _ocmd=${2:-}; shift 2 || _usage ;;
      --control)   _octl=${2:-}; shift 2 || _usage ;;
      --attention) _oattn=${2:-}; shift 2 || _usage ;;
      -*) _out usage 2 "unknown option: $1" ;;
      *)  [ -z "$_osess" ] || _out usage 2 "one session, not two: $1"
          _osess=$1; shift ;;
    esac
  done
  [ -n "$_osess" ] || _out usage 2 "usage: mux agent open SESSION \
[--partition P] [--name N] [--dir D] [--cmd C] [--control CLASS] \
[--attention CLASS]"

  _rp=$_opart
  if [ -z "$_rp" ] && [ -r "$_lib/mux-context_lib" ]; then
    . "$_lib/mux-context_lib"
    _rp=$(mux_ctx_mine)
  fi

  # CROSS-PARTITION IS REFUSED, AND THIS VERB CROSSES HARDER THAN `send`
  # DOES. `send` types into a pane that already exists; opening a window
  # RUNS A COMMAND, and where a partition's boundary is a group acquired per
  # session, the children of that server hold it. So the same structural
  # refusal, for a stronger reason, and there is deliberately no flag and no
  # policy token that opens it.
  if [ -r "$_lib/mux-context_lib" ]; then
    . "$_lib/mux-context_lib"
    mux_ctx_crossing "${_rp:-global}" 'open a window across' || {
      printf '{"status":%s,"reason":%s,"override":%s,"message":%s}\n' \
        "$(mux_json_str refused)" \
        "$(mux_json_str cross-partition)" \
        "$(mux_json_str none)" \
        "$(mux_json_str "refusing to open a window in $_osess: \
$MUX_CTX_CROSS")"
      exit "$MUX_EC_FAIL"
    }
  fi

  . "$_lib/mux-sessions_lib"
  . "$_lib/mux-window_lib"
  # NOT IN A `$( )`: the engine reports its reason in a VARIABLE, and a
  # command substitution is a subshell that throws it away, leaving an empty
  # document on the refusal path. See mux-window_lib.
  _ow=0
  mux_window_open "${_rp:-global}" "$_osess" "$_oname" "$_odir" \
    "$_ocmd" "$_octl" "$_oattn" 0 || _ow=$?
  case $_ow in
    0) ;;
    3) _out no-such-name 3 "$MUX_WIN_ERR" ;;
    *) _out usage 2 "$MUX_WIN_ERR" ;;
  esac

  # DETACHED, ALWAYS, on this surface: a machine verb that moves the human's
  # view mid-turn is an interrupt nobody asked for. The human verb switches.
  printf '{"status":%s,"partition":%s,"session":%s,"window":%s,' \
    "$(mux_json_str ok)" \
    "$(mux_json_str "${_rp:-global}")" \
    "$(mux_json_str "$_osess")" \
    "$(mux_json_num "${MUX_WIN_OUT#*:}")"
  # THE ID IS WHAT `--window` WANTS, and the index is for display: a create
  # answering only an index would send the caller back through `peers` to
  # learn the handle for the window it had just made.
  printf '"window_id":%s,' \
    "$([ -n "${MUX_WIN_ID:-}" ] && mux_json_str "$MUX_WIN_ID" || printf null)"
  printf '"control":%s,"attention":%s}\n' \
    "$([ -n "$_octl" ] && mux_json_str "$_octl" || printf null)" \
    "$([ -n "$_oattn" ] && mux_json_str "$_oattn" || printf null)"
  exit "$MUX_EC_OK"
fi

if [ "$_verb" = ensure ]; then
  # --- ensure --------------------------------------------------------
  # MAKE SURE A SESSION EXISTS, and say whether that took creating it.
  # vicus's item 1 asked for a session-level create-or-attach; this surface
  # holds no terminal, so there is nothing to attach and the honest name is
  # the POSTCONDITION rather than the act.
  #
  # NOT `open --create`: `open` answers a WINDOW id, so a flag that also
  # created a SESSION would have it answering one level up from what its
  # name promises, and a caller could not tell which it got back.
  #
  # A SESSION NAME, NEVER A DIRECTORY, and that constraint is mux's rather
  # than this verb's. `mux go ~/src/foo` DERIVES the session name by folding
  # the basename, so a caller handed a path cannot predict the name it gets,
  # and a handle this surface cannot re-derive is the trap `read` already
  # refuses a pane id for. A path is refused with the human verb named.
  #
  # AND AN UNRESOLVABLE NAME IS REFUSED RATHER THAN INVENTED. That is mux's
  # decision and this verb must not weaken it: `mux why` states the reason,
  # that "from the name alone a new session and a typo are
  # indistinguishable". An agent conjuring a session out of its own typo is
  # strictly worse than a human doing it, so the explanation is passed
  # through rather than replaced.
  #
  # IT DELEGATES TO `mux go --no-attach`, measured rather than assumed: that
  # path resolves the project, reads the profile, lays out the panes, marks
  # the agent pane, settles the theme, repairs the environment and records
  # the session set, and it is idempotent and silent on stdout. Twenty
  # caller values, one of which is the resolution `mux why` exists to
  # explain. A second copy here would be free to disagree about every one.
  _enpart= _entgt= _enprof=
  while [ "$#" -gt 0 ]; do
    case $1 in
      (--partition) _enpart=${2:-}; shift 2 || _usage ;;
      (--profile)   _enprof=${2:-}; shift 2 || _usage ;;
      (-*) _out usage 2 "unknown option: $1" ;;
      (*)  [ -z "$_entgt" ] || _out usage 2 "one session, not two: $1"
           _entgt=$1; shift ;;
    esac
  done
  [ -n "$_entgt" ] || _out usage 2 "usage: mux agent ensure SESSION \
[--partition P] [--profile PROFILE]"

  # A PATH IS THE ONE INPUT THAT WOULD SUCCEED AT THE WRONG THING, so it is
  # named rather than attempted: `mux go` accepts one and answers a session
  # whose name it folded, which is not the name this caller asked about.
  case $_entgt in
    (*/*|'~'*) _enm="'$_entgt' looks like a path. mux derives a session"
      _enm="$_enm name from a directory by folding it, so the name you"
      _enm="$_enm would get back is not the one you asked for; use"
      _enm="$_enm \`mux go\` for a path, or name the session here"
      _out usage 2 "$_enm" ;;
  esac

  _rp=$_enpart
  [ ! -r "$_lib/mux-context_lib" ] || . "$_lib/mux-context_lib"
  [ -n "$_rp" ] || _rp=$(mux_ctx_mine)

  # CROSS-PARTITION IS REFUSED, AND THIS CROSSES HARDEST OF ALL. `send`
  # types into a pane that exists and `open` runs a command in a session
  # that does; this BUILDS the server, so where a boundary is a group
  # acquired per session every pane it creates would hold it.
  if [ -r "$_lib/mux-context_lib" ]; then
    mux_ctx_crossing "${_rp:-global}" 'create a session across' || {
      printf '{"status":%s,"reason":%s,"override":%s,"message":%s}\n' \
        "$(mux_json_str refused)" \
        "$(mux_json_str cross-partition)" \
        "$(mux_json_str none)" \
        "$(mux_json_str "refusing to create $_entgt: $MUX_CTX_CROSS")"
      exit "$MUX_EC_FAIL"
    }
  fi

  # LIVE IS ASKED WITH `has-session -t =NAME`, exact rather than a prefix,
  # and it ERRORS rather than spawning a server, which is the property `mux
  # check` had to learn the hard way about `list-keys`.
  _encreated=false
  if ! _tx has-session -t "=$_entgt" 2>/dev/null; then
    _enbin=$_libexec/../bin/mux
    [ -x "$_enbin" ] || _out refused 1 "cannot find mux's front end at \
$_enbin, so there is nothing to build with (incomplete install)"
    # STDERR CAPTURED, STDOUT DISCARDED, because this surface promises JSON
    # on stdout and the front end writes prose for a human. No temp file:
    # an anonymous one leaks indistinguishably, which this package has paid
    # for twice.
    _enrc=0
    if [ -n "$_enprof" ]; then
      _enerr=$("$_enbin" go --no-attach "$_entgt" "$_enprof" \
        2>&1 >/dev/null) || _enrc=$?
    else
      _enerr=$("$_enbin" go --no-attach "$_entgt" 2>&1 >/dev/null) || _enrc=$?
    fi
    case $_enrc in
      (0) _encreated=true ;;
      ("$MUX_EC_NONAME") _out no-such-name 3 "$_enerr" ;;
      (*) _out refused 1 "could not build $_entgt: $_enerr" ;;
    esac

    # THE POSTCONDITION IS VERIFIED, NOT INFERRED FROM THE EXIT CODE, which
    # is the whole of what this verb's name promises. A build that answers 0
    # having made nothing is exactly the shape this package keeps
    # cataloguing, and `ensure` claiming it when it is false would hand a
    # caller a session to address that is not there.
    _enpc="$_entgt was built without error and is still not there, so"
    _enpc="$_enpc something else removed it or the build did nothing"
    _tx has-session -t "=$_entgt" 2>/dev/null || _out refused 1 "$_enpc"

    # LOGGED ONLY WHEN IT CREATED, which is what makes the volume argument
    # that keeps `mux go` silent not apply: a found session writes nothing,
    # and an AGENT creating one is rare and worth attributing. mux's own
    # notes record the cost of `mux go` being unlogged, a stray session
    # nobody could trace to a command.
    mux_log ensure "$_entgt (${_rp:-global}) created"
  fi

  printf '{"status":%s,"partition":%s,"session":%s,"created":%s}\n' \
    "$(mux_json_str ok)" \
    "$(mux_json_str "${_rp:-global}")" \
    "$(mux_json_str "$_entgt")" \
    "$_encreated"
  exit "$MUX_EC_OK"
fi

if [ "$_verb" = class ]; then
  # --- class ---------------------------------------------------------
  # Change a LIVE pane's class, which is vicus's R3: "the answer can change
  # during a session's life, and the surfaces follow it without the agent
  # being restarted". ESCALATION IS THAT TRANSITION. A supervisor that
  # cannot resolve something hands it to the human, and at that instant the
  # worker has to become visible on the human's surfaces; a value fixed when
  # the pane was created cannot express it.
  #
  # ONE WAY FOR A MACHINE (the user's call): a machine may only ever move a
  # pane TOWARD THE HUMAN. More visible, more restricted:
  # `agent -> hybrid -> human` is free, and the reverse needs a human.
  #
  # WHY THAT ASYMMETRY IS THE WHOLE DESIGN: moving toward the human only ever
  # REMOVES this side's permission and ADDS the human's sight of the pane, so
  # it cannot be a way to reach anything. The reverse GRANTS: relaxing a pane
  # to `agent` is precisely the laundering move (promote a human's pane, then
  # send into it wherever a `control:agent` grant is in force). So creation
  # declares freely, a machine may tighten, and only a human may relax.
  #
  # THE RELAX GATE IS A tty PLUS `--yes`, the shape `mux setup claude`
  # already uses: without both it REFUSES rather than inferring consent.
  # Said plainly because the man page must not overclaim: an agent can
  # allocate a pty and can call `tmux set-option` directly today, so this is
  # ORGANISATIONAL, not a sandbox. What it buys is that the dangerous
  # direction stops being the easy one and that a bypass leaves the log,
  # which is why the log line below is not optional.
  _clsess= _clwin= _clpart= _clctl= _clattn= _clyes=
  while [ "$#" -gt 0 ]; do
    case $1 in
      --partition) _clpart=${2:-}; shift 2 || _usage ;;
      --window)    _clwin=${2:-}; shift 2 || _usage ;;
      --control)   _clctl=${2:-}; shift 2 || _usage ;;
      --attention) _clattn=${2:-}; shift 2 || _usage ;;
      --yes)       _clyes=1; shift ;;
      -*) _out usage 2 "unknown option: $1" ;;
      *)  [ -z "$_clsess" ] || _out usage 2 "one session, not two: $1"
          _clsess=$1; shift ;;
    esac
  done
  _clu="usage: mux agent class SESSION [--window NAME|@ID] [--partition P]"
  _clu="$_clu [--control CLASS] [--attention CLASS] [--yes]"
  [ -n "$_clsess" ] || _out usage 2 "$_clu"
  [ -n "$_clctl$_clattn" ] || _out usage 2 \
    "nothing to change: give --control and/or --attention"
  for _c in "$_clctl" "$_clattn"; do
    [ -z "$_c" ] && continue
    mux_class_valid "$_c" \
      || _out usage 2 "a class is human|agent|hybrid, not: $_c"
  done

  _resolve "$_clsess" "$_clpart"

  if [ -r "$_lib/mux-context_lib" ]; then
    # shellcheck source=/dev/null
    . "$_lib/mux-context_lib"
    mux_ctx_crossing "${_rp:-global}" 'reclassify a pane across' || {
      printf '{"status":%s,"reason":%s,"override":%s,"message":%s}\n' \
        "$(mux_json_str refused)" \
        "$(mux_json_str cross-partition)" \
        "$(mux_json_str none)" \
        "$(mux_json_str "refusing to reclassify $_clsess: $MUX_CTX_CROSS")"
      exit "$MUX_EC_FAIL"
    }
  fi

  # THE PANE IS RESOLVED HERE, from the records and the live server, never
  # taken from the caller: an id cached from an earlier `peers` can have died
  # and been replaced, and reclassifying the wrong pane is a wrong answer
  # wearing the shape of a right one. `--window` narrows it, which is how a
  # supervisor names ITS worker rather than the session's worst agent.
  _winsel "$_clsess" "$_clwin"
  _clpane=$_ws_pane

  # EACH MARKER IS JUDGED ON ITS OWN, because a caller may tighten one and
  # leave the other alone, and that combination is the point of their being
  # two: an escalation moves ATTENTION to the human while the supervisor
  # keeps the write access it needs to go on nudging.
  _clout=
  for _m in control:"$_clctl" attention:"$_clattn"; do
    _mk=${_m%%:*} _mv=${_m#*:}
    [ -z "$_mv" ] && continue
    _was=$(_tx display-message -p -t "$_clpane" \
      "#{@mux-$_mk}" 2>/dev/null || true)
    mux_class_valid "$_was" || _was=human
    if [ "$(mux_class_rank "$_mv")" -lt "$(mux_class_rank "$_was")" ]; then
      # RELAXING. A tty AND an explicit flag, or refuse and say which
      # override exists, so a caller learns it in one round trip instead of
      # guessing.
      if [ ! -t 0 ] || [ -z "$_clyes" ]; then
        printf '{"status":%s,"reason":%s,"override":%s,"message":%s}\n' \
          "$(mux_json_str refused)" \
          "$(mux_json_str relax)" \
          "$(mux_json_str 'a human at a terminal with --yes')" \
          "$(mux_json_str "$_clsess $_mk $_was -> $_mv moves AWAY from the \
human, which only a human may do")"
        exit "$MUX_EC_FAIL"
      fi
    fi
    _tx set-option -p -t "$_clpane" "@mux-$_mk" "$_mv" 2>/dev/null || :
    # LOGGED, ALWAYS, and for the relax direction that log IS the gate's
    # value: the check itself is organisational, so the record of a change
    # having happened is the part that survives somebody working around it.
    mux_log agent "$_clsess $_mk $_was -> $_mv via class"
    _clout="$_clout$_mk"
  done

  printf '{"status":%s,"partition":%s,"session":%s,"pane":%s,' \
    "$(mux_json_str ok)" \
    "$(mux_json_str "${_rp:-global}")" \
    "$(mux_json_str "$_clsess")" \
    "$(mux_json_str "$_clpane")"
  printf '"window":%s,"control":%s,"attention":%s}\n' \
    "$(mux_json_str "$_ws_wid")" \
    "$([ -n "$_clctl" ] && mux_json_str "$_clctl" || printf null)" \
    "$([ -n "$_clattn" ] && mux_json_str "$_clattn" || printf null)"
  exit "$MUX_EC_OK"
fi


if [ "$_verb" = self ]; then
  # --- self ----------------------------------------------------------
  # WHICH PANE AM I, answered from the pane's own server. `peers` says who
  # else is here; this says who I am, which is the question a supervised
  # agent has to answer before it can be addressed at all.
  #
  # THE CALLER NEVER CLAIMS AN IDENTITY. It is read from TMUX_PANE, which a
  # process started inside a pane inherits and cannot usefully forge to
  # something it is not already in: a wrong value names a pane this server
  # does not have, or somebody else's, and either way mux answers about THAT
  # pane rather than believing a claim. An orchestrator above can therefore
  # take this as the agent's identity instead of a self-report.
  #
  # THE PARTITION COMES FROM MY OWN SOCKET, NOT FROM THE CONTEXT COMMAND,
  # and that is the one real decision here. `mux_ctx_socket` is the identity
  # function on the partition, so a socket's basename IS the partition, and
  # $TMUX names the server this pane actually lives on. Asking the context
  # command instead would be asking a DIFFERENT question ("which partition
  # does my environment resolve to"), and the two can disagree: a declining
  # or absent hook answers `global` while the pane sits on another server,
  # and mux would then query the wrong socket. That bug has shipped three
  # times here (agent read/send, mux even, next-blocked), every time because
  # one answer was derived in two places.
  #
  # THE DERIVATION IS OPEN-CODED, which is a third copy (beside
  # mux-agent-state_lib and mux-landing) and was MEASURED rather than
  # assumed to be the cheaper answer: of the eleven files that source
  # mux-agent-state_lib, six do NOT source mux-context_lib, two of those are
  # libs whose own callers would each need the line, and one is
  # mux-agent-state-render, which runs per client every status-interval. A
  # fork and a parse on the hottest path mux has, to centralise two lines
  # that have never drifted, is the trade mux-paths_lib already refused for
  # XDG_RUNTIME_DIR. Centralise a RULE, not a derivation with one reader.
  #
  # NOT A `peers` ROW, deliberately, and the missing fields say why: `state`
  # and `age` are facts about a SESSION's worst agent, which is a question
  # `status` answers better and which would be odd here anyway, since a pane
  # asking its own state already knows it is running. What is added instead
  # is `pane` and `attention`, because both are part of "what am I": the
  # pane is the input resolved, and the two classes are what decide whether
  # anybody may type here and whose attention is owed.
  while [ $# -gt 0 ]; do
    case $1 in
      (--) shift; break ;;
      (*) _out usage 2 "unknown option: $1" ;;
    esac
  done

  _sfnp="no TMUX_PANE: this is not running inside a pane"
  _sfns="no TMUX: this is not running inside a tmux server"
  [ -n "${TMUX_PANE:-}" ] || _out refused 1 "$_sfnp"
  [ -n "${TMUX:-}" ] || _out refused 1 "$_sfns"

  # SOURCED HERE, like every other verb in this file: the libs are lazy so a
  # hot path pays for nothing it does not call. Only the VALIDATOR is wanted,
  # never `mux_ctx_mine`, which would be the other question.
  [ ! -r "$_lib/mux-context_lib" ] || . "$_lib/mux-context_lib"
  _sfp=${TMUX%%,*}
  _rp=${_sfp##*/}
  _sfbp="my socket is not a usable partition name: $_rp"
  mux_ctx_valid "$_rp" || _out refused 1 "$_sfbp"

  # ONE QUERY, tab separated, for the reason the record format already
  # documents: a comma is an argument separator inside a tmux format and
  # truncates the loop, and a window name may contain a space.
  _sft=$(printf '\t')
  _sffmt="#{session_name}$_sft#{window_index}$_sft#{window_id}"
  _sffmt="$_sffmt$_sft#{window_name}"
  _sfrow=$(_tx display-message -p -t "$TMUX_PANE" "$_sffmt" 2>/dev/null) \
    || _sfrow=
  IFS="$_sft" read -r _sfs _sfwi _sfwid _sfwn <<EOF
$_sfrow
EOF
  # THE SESSION FIELD, NOT THE WHOLE ROW, is what says the pane resolved.
  # `display-message -t %999` EXITS 0 for a pane that does not exist and
  # answers every field EMPTY, so a row of bare separators is non-empty and
  # a test on the row passes. Measured, and it is this tree's recurring
  # shape: a call that succeeds at the wrong thing.
  _sfgp="$TMUX_PANE is not a pane on partition $_rp"
  [ -n "$_sfs" ] || _out refused 1 "$_sfgp"

  # BOTH CLASSES, each falling back to the DEFAULT rather than to null: an
  # unset marker means `human`, which is what every reader of these options
  # already assumes and is the safe direction. null would read as "unknown"
  # and invite a caller to guess.
  _sfc=$(_tx show-options -pqv -t "$TMUX_PANE" @mux-control 2>/dev/null)
  _sfa=$(_tx show-options -pqv -t "$TMUX_PANE" @mux-attention 2>/dev/null)
  case ${_sfc:-} in (agent|hybrid) ;; (*) _sfc=human ;; esac
  case ${_sfa:-} in (agent|hybrid) ;; (*) _sfa=human ;; esac

  printf '{"status":"ok","partition":%s,"session":%s,"window":%s,' \
    "$(mux_json_str "$_rp")" \
    "$(mux_json_str "$_sfs")" \
    "$(mux_json_num "$_sfwi")"
  printf '"window_id":%s,"window_name":%s,"pane":%s,' \
    "$(mux_json_str "$_sfwid")" \
    "$(mux_json_str "$_sfwn")" \
    "$(mux_json_str "$TMUX_PANE")"
  printf '"control":%s,"attention":%s}\n' \
    "$(mux_json_str "$_sfc")" "$(mux_json_str "$_sfa")"
  exit "$MUX_EC_OK"
fi

if [ "$_verb" = presence ]; then
  # --- presence ------------------------------------------------------
  # WHO IS WATCHING, which is the question a hybrid hold has to ask before
  # it decides whether to wait for a human. One row per attached client:
  # where it is looking, and how long since it was last touched.
  #
  # AN AGE, NEVER AN EPOCH, and this is the invariant rather than a
  # preference. `#{client_activity}` is a unix timestamp (measured: a real
  # attached client reports `1791922870`), and the intended caller is as
  # likely to be `ssh box mux agent presence` as a local one. A reader on
  # another machine subtracting a remote clock's timestamp from its own now
  # is the bug `agent-list` was built to make impossible, and the whole
  # cross-machine design rests on not reintroducing it.
  #
  # EMPTY IS EXIT 0, the other half of that contract: "nobody is attached"
  # and "I could not ask" must be different answers, so a partition with no
  # server answers `[]` successfully rather than failing. That is the same
  # call `--attached` already makes, where this verb's boolean lives today.
  #
  # ATTACHED IS WHAT `list-clients` MEANS, so there is no `attached` field:
  # a client that is not attached is not listed. Reporting one would be a
  # column that is always true.
  _part=
  while [ $# -gt 0 ]; do
    case $1 in
      (--partition)
        shift
        _part=${1:-}
        [ -n "$_part" ] || _out usage 2 "--partition needs a name"
        shift ;;
      (--) shift; break ;;
      (*) _out usage 2 "unknown option: $1" ;;
    esac
  done
  [ ! -r "$_lib/mux-context_lib" ] || . "$_lib/mux-context_lib"
  if [ -n "$_part" ]; then
    mux_ctx_valid "$_part" || _out usage 2 "not a partition name: $_part"
    _rp=$_part
  else
    _rp=$(mux_ctx_mine)
  fi

  _prnow=$(date +%s)
  _prrows=$(
    # BUILT IN PIECES so no line runs past 80 columns, which a single
    # tmux format string of five fields cannot do.
    _prt=$(printf '\t')
    _prf="#{client_name}$_prt#{client_session}$_prt#{window_id}"
    _prf="$_prf$_prt#{window_name}$_prt#{client_activity}"
    _tx list-clients -F "$_prf" 2>/dev/null \
      | while IFS="$_prt" read -r _pn _ps _pwid _pwn _pa
    do
      [ -n "$_pn" ] || continue
      # A CLOCK THAT DISAGREES IS CLAMPED AT 0 rather than reported
      # negative: an activity stamp in the future is a machine whose clock
      # moved, and a negative age would read as nonsense to a caller doing
      # arithmetic on it.
      _page=$((_prnow - ${_pa:-0}))
      [ "$_page" -ge 0 ] || _page=0
      printf '{"client":%s,"session":%s,"window_id":%s,' \
        "$(mux_json_str "$_pn")" \
        "$(mux_json_str "$_ps")" \
        "$(mux_json_str "$_pwid")"
      printf '"window_name":%s,"idle":%s}\n' \
        "$(mux_json_str "$_pwn")" \
        "$(mux_json_num "$_page")"
    done | mux_json_array
  )
  printf '{"status":"ok","partition":%s,"clients":%s}\n' \
    "$(mux_json_str "$_rp")" "$_prrows"
  exit "$MUX_EC_OK"
fi

if [ "$_verb" = peers ]; then
  # --- peers ---------------------------------------------------------
  # Every session with a tracked agent, and what it is doing. The verb an
  # agent reaches for first: "who else is here, and is anyone stuck".
  #
  # HEADLESS, like agent-list, and that is a property worth protecting
  # rather than an accident. It derives sessions from the state FILES and
  # roots from the session set, so it answers over a transport, at boot,
  # with no tmux client and no server attached. The intended caller is as
  # likely to be `ssh box mux agent peers` as a local one.
  #
  # NO PANE FIELD, deliberately. `read` and `send` resolve a target to a
  # pane at the moment they act, which is more correct than a caller
  # caching an id that can change under it, and it keeps this verb from
  # needing tmux at all.
  _pa=0
  _part=
  while [ $# -gt 0 ]; do
    case $1 in
      --all) _pa=1; shift ;;
      --partition)
        shift
        _part=${1:-}
        [ -n "$_part" ] || _out usage 2 "--partition needs a name"
        shift ;;
      --) shift; break ;;
      *) _out usage 2 "unknown option: $1" ;;
    esac
  done

  # mux-paths_lib FIRST: mux-sessions_lib calls mux_state_path, and a lib
  # that needs another does not say so by itself. Sourcing sessions alone
  # gave six `mux_state_path: not found` lines on stderr and an empty
  # root for every peer: a plausible answer, silently wrong, which is
  # the trap these notes already record for mux-scan and mux-sessions.t.
  . "$_lib/mux-paths_lib"
  . "$_lib/mux-agent-state_lib"
  . "$_lib/mux-sessions_lib"
  if [ -z "$_part" ] && [ -r "$_lib/mux-context_lib" ]; then
    . "$_lib/mux-context_lib"
    _part=$(mux_ctx_mine)
  fi

  # AGE, NOT AN EPOCH, and it is resolved HERE against the clock that
  # wrote it. The obvious design emits the epoch and works perfectly
  # until the reader is on another machine, where a box a few seconds off
  # shows "idle 4s" as "idle 2m" and one badly off shows a negative.
  _now=$(date +%s 2>/dev/null || echo 0)

  _which=$_part
  [ "$_pa" -eq 0 ] || _which=$(
    _root=$(dirname "$(mux_agent_dir "$_part")")
    for _d in "$_root"/*; do
      [ -d "$_d" ] || continue
      printf '%s\n' "${_d##*/}"
    done)

  _items=$(
    printf '%s\n' "$_which" | while IFS= read -r _p; do
      [ -n "$_p" ] || continue
      _dir=$(mux_agent_dir "$_p")
      # ONE tmux QUERY PER PARTITION, not per peer. "Could
      # not ask" and "asked, and nothing is set" are
      # different answers: unreachable reports null, while
      # reached-with-no-option reports `human`, the default
      # class. Collapsing them would make a remote `peers` at
      # boot call every pane human-controlled: plausible,
      # and wrong.
      #
      # EMPTY IS UNREACHABLE, with no separate success flag.
      # One was written first and proved unkillable, because
      # a failed query leaves $_ctl empty anyway and a tmux
      # server with zero panes does not exist: it exits. An
      # unkillable guard here is redundant code rather than a
      # missing test, so it went.
      #
      # THE WINDOW'S ID AND NAME RIDE ALONG, which is R9's answer side: an
      # INDEX is a recyclable slot (measured: kill index 2 and the next
      # window created takes it), so a caller holding one acts on a
      # different worker. The id never recycles. It costs nothing to carry,
      # the same ride `@mux-agent` took onto the strip's query: on a path
      # that runs per poll, the ROUND TRIP is the cost and the extra fields
      # are not.
      _ctl=$(tmux -L "$_p" list-panes -a \
        -F "#{pane_id}	#{@mux-control}	#{window_id}	#{window_name}" \
        2>/dev/null) || _ctl=
      mux_agent_sessions "$_dir" | while IFS= read -r _s; do
        [ -n "$_s" ] || continue
        # ONE ENTRY PER WINDOW, which is vicus's R4 and the half of R8 that
        # a session-level answer cannot give: a worker is a WINDOW in the
        # session it serves, so collapsing a session to its worst agent
        # cannot say whether THIS worker is live. That was tried and
        # rejected for exactly that, because it would confidently answer a
        # different question, which is worse than the bypass it replaced.
        #
        # THE COMMON CASE IS UNCHANGED IN SUBSTANCE: a session with one
        # agent emits one object, as before, now carrying the window it is
        # in. The SHAPE moved, so `agent contract` moved with it.
        mux_agent_windows "$_dir" "$_s" | while IFS= read -r _wi; do
        [ -n "$_wi" ] || continue
        _se=$(mux_agent_state_win "$_dir" "$_s" "$_wi")
        _st=${_se%% *}
        _ep=${_se#* }
        [ -n "$_st" ] || continue
        # A record with no usable epoch still has a
        # real STATE, so its age is null rather than a
        # fabricated 0, which would assert it just
        # changed, a claim there is no evidence for.
        # THE PATTERNS ARE PARENTHESISED, WHICH IS NOT STYLE. This
        # `case` sits inside the `_items=$( ... )` substitution
        # above, and bash 3.2 finds the END of a `$( )` by COUNTING
        # PARENTHESES, so an unparenthesised case pattern's closing
        # `)` closes the substitution early and the `;;` that
        # follows is then a syntax error. macOS `/bin/sh` IS bash
        # 3.2 and always will be (Apple froze it at GPLv2), so this
        # file did not PARSE there: `mux agent` was dead on macOS,
        # every verb, with `syntax error near unexpected token ';;'`
        # on stderr and exit 2.
        #
        # The `(pat)` form is POSIX, and verified identical in dash,
        # bash 5, bash 3.2 and ksh. Only a `case` INSIDE a command
        # substitution needs it; the rest of the tree is checked by
        # the macOS CI job, which runs `/bin/sh -n` over every shell
        # file precisely so this class cannot come back as a
        # mysterious exit code in one test.
        case ${_ep:-} in
          (''|*[!0-9]*) _ag= ;;
          (*) _ag=$((_now - _ep))
              [ "$_ag" -lt 0 ] && _ag=0 ;;
        esac
        # THE CLASS, looked up by the pane the record
        # speaks for. The pane is resolved INTERNALLY
        # and still not emitted: a caller caching an id
        # is the thing `read` and `send` avoid, and
        # answering a different question with it is not
        # the same as handing it over.
        _cl= _wid= _wnm=
        if [ -n "$_ctl" ]; then
          _pn=$(mux_agent_pane_win "$_dir" "$_s" "$_wi")
          # ONE LOOKUP EACH, rather than one answer split here. A window
          # NAME may contain a space and may contain nothing at all, so
          # every way of packing two fields into one shell word needs a
          # separator the data is allowed to hold. Two awks on a verb a
          # supervisor calls (never the status bar, which polls `status`)
          # is the cheaper half of that trade.
          _wid=$(printf '%s\n' "$_ctl" | awk \
            -F'\t' -v k="$_pn" '$1 == k { print $3; exit }')
          _wnm=$(printf '%s\n' "$_ctl" | awk \
            -F'\t' -v k="$_pn" '$1 == k { print $4; exit }')
          _cl=$(printf '%s\n' "$_ctl" | awk \
            -F'\t' -v k="$_pn" \
            '$1 == k { print $2; exit }')
          # PARENTHESISED for the bash 3.2 reason given above:
          # this is inside the same `$( )`.
          case ${_cl:-} in
            (agent|hybrid) ;;
            (*) _cl=human ;;
          esac
          # The pane is gone but its record is
          # not: the class is unknowable, which
          # is null rather than the default.
          printf '%s\n' "$_ctl" \
            | grep -q "^$_pn	" \
            || _cl=
        fi
        # `window` IS KEPT AND IS FOR DISPLAY ONLY. It is what a human
        # types at tmux, so dropping it would be a second break for no
        # gain; `window_id` is the handle `--window` wants, and `window`
        # must not be used as one. Both null when the server could not be
        # reached, for the same reason `control` is: unknowable, never
        # defaulted.
        printf '{"partition":%s,"session":%s,"window":%s,' \
          "$(mux_json_str "$_p")" \
          "$(mux_json_str "$_s")" \
          "$(mux_json_num "$_wi")"
        printf '"window_id":%s,"window_name":%s,' \
          "$([ -n "$_wid" ] && mux_json_str "$_wid" || printf null)" \
          "$([ -n "$_wnm" ] && mux_json_str "$_wnm" || printf null)"
        printf '"state":%s,"age":%s,"control":%s,' \
          "$(mux_json_str "$_st")" \
          "$(mux_json_num "${_ag:-}")" \
          "$([ -n "$_cl" ] \
            && mux_json_str "$_cl" \
            || printf null)"
        printf '"root":%s}\n' \
          "$(mux_json_str \
            "$(mux_sess_root "$_s" "$_p")")"
        done
      done
    done | mux_json_array
  )
  printf '{"status":"ok","peers":%s}\n' "$_items"
  exit "$MUX_EC_OK"
fi

# --- status ---------------------------------------------------------------
# The same question `mux agent-summary --all --attached` answers, in the
# contract's shape. It SHELLS OUT to that verb rather than re-deriving: the
# ranking lives in mux-agent-state_lib and has been written twice before, which
# is once more than it should have been. Whether a verb here is a thin wrapper
# is an implementation detail; the contracts are what differ.
_all=0
_att=1
_spart=
# THE CADENCE IS LOCAL, which is the whole point of streaming: today the tray
# opens an ssh every 5s per host, and with a stream the polling happens ON the
# watched box and only CHANGES cross the network. 2s matches the status bar's
# own interval, so the tray is never staler than the strip beside it.
_sint=${MUX_AGENT_STREAM_INTERVAL:-2}
# Far slower, because it is not a liveness probe for the DATA: it only has to
# arrive often enough that a consumer can call a silent stream dead, and often
# enough that this process notices its reader has gone.
_shb=${MUX_AGENT_STREAM_HEARTBEAT:-15}
while [ $# -gt 0 ]; do
  case $1 in
    --all)      _all=1; shift ;;
    --partition)
      [ -n "${2:-}" ] || _out usage 2 "--partition needs a name"
      _spart=$2; shift 2 ;;
    # EVERY partition, not just the watched ones. The default is `attached`
    # because a tray item means somebody is looking at it, and an agent
    # asking what is going on wants the same answer a human would see.
    --any)      _att=0; shift ;;
    # STREAM-ONLY, and accepted on `status` too rather than given their own
    # parser: one flag table for one document means `status` and `stream`
    # cannot drift about what they were asked for.
    -i|--interval)
      [ -n "${2:-}" ] || _out usage 2 "-i needs seconds"
      case $2 in
        ''|*[!0-9]*|0) _out usage 2 "-i needs whole seconds, 1 or more" ;;
      esac
      _sint=$2; shift 2 ;;
    --heartbeat)
      [ -n "${2:-}" ] || _out usage 2 "--heartbeat needs seconds"
      case $2 in ''|*[!0-9]*) _out usage 2 "--heartbeat needs seconds" ;; esac
      _shb=$2; shift 2 ;;
    --) shift; break ;;
    *)  _out usage 2 "unknown option: $1" ;;
  esac
done

# SCOPED TO THE CALLER'S PARTITION UNLESS ASKED OTHERWISE, the same rule
# `peers` already follows. `_all` was parsed and never read, so every caller
# got every partition, and the shipped skill tells an agent the opposite,
# one sentence after calling a partition an isolation boundary. A flag that
# parses and does nothing is worse than a missing one: the caller believes it
# asked for something.
if [ "$_all" -eq 0 ]; then
  if [ -z "$_spart" ] && [ -r "$_lib/mux-context_lib" ]; then
    . "$_lib/mux-context_lib"
    _spart=$(mux_ctx_mine)
  fi
  # `global` is the namespace mux_agent_dir defaults to, so an
  # unresolvable context scopes to the default rather than widening to
  # everything: failing open is the one answer this must not give.
  [ -n "$_spart" ] || _spart=global
fi

# ONE PRODUCER FOR TWO VERBS. `stream` is `status` on a loop, so the document
# is built here and never twice: a second copy is how the polled answer and
# the streamed one start disagreeing about the same instant, which is the
# worst possible bug in a presenter that may be fed by either.
# _collect -> the document's INPUTS, in `_rows` and `_srows`. Separate from
# the formatting below because the stream compares these to decide whether
# anything happened: they are the whole truth the document is built from, and
# they cost two forks where formatting costs an `awk` per string, so a quiet
# tick pays two forks rather than a dozen.
_collect() {
  set -- --all
  [ "$_att" -eq 0 ] || set -- "$@" --attached
  _rows=$("$_libexec/mux-agent-state-summary" "$@" 2>/dev/null) || _rows=
  _srows=$("$_libexec/mux-agent-state-summary" "$@" --sessions \
    2>/dev/null) || _srows=
}

_status_doc() {
  # `<partition> <state> <count>` per line into one object per line, then one
  # array. Read with a field split rather than `read -r a b c` so a malformed
  # line cannot silently shift the count into the state.
  _items=$(
    printf '%s\n' "$_rows" | while IFS=' ' read -r _p _st _n; do
      [ -n "${_p:-}" ] || continue
      [ -n "${_st:-}" ] || continue
      [ -z "$_spart" ] || [ "$_p" = "$_spart" ] || continue
      # THE SESSIONS THIS PARTITION HOLDS, which the collapsed state and
      # count cannot express and a NOTIFIER needs: a banner says "Claude
      # finished: <session>", so a presenter fed only `(partition, state,
      # count)` can report that something happened and not what.
      #
      # SESSION LAST on the wire, so a name containing a space reads back
      # whole, which is the rule the state record itself follows.
      _sarr=$(
        printf '%s\n' "$_srows" \
          | while IFS=' ' read -r _sp _sst _ssn; do
          [ -n "${_ssn:-}" ] || continue
          [ "$_sp" = "$_p" ] || continue
          printf '{"session":%s,"state":%s}\n' \
            "$(mux_json_str "$_ssn")" "$(mux_json_str "$_sst")"
        done | mux_json_array
      )
      printf '{"partition":%s,"state":%s,"count":%s,"sessions":%s}\n' \
        "$(mux_json_str "$_p")" "$(mux_json_str "$_st")" \
        "$(mux_json_num "${_n:-}")" "$_sarr"
    done | mux_json_array
  )
  printf '{"status":"ok","partitions":%s}\n' "$_items"
}

if [ "$_verb" = stream ]; then
  _collect
  _sdoc=$(_status_doc)
  printf '%s\n' "$_sdoc"
  # THE FIRST DOCUMENT ANNOUNCES NOTHING, by construction rather than by a
  # flag: the previous session states are seeded from this very tick, so the
  # first diff can only happen on the second. A stream that announced its
  # opening state would toast every finished turn on the box each time a
  # daemon started or a connection came back.
  _slast=$_sdoc _ssnap="$_rows$_srows" _sprev=$_srows
  _squiet=0
  while :; do
    sleep "$_sint"
    # TWO LEVELS, AND BOTH ARE NEEDED. The cheap one skips the formatting
    # entirely on a quiet tick, which is the common case by far. The second
    # is not redundant: `--partition` and `--attached` FILTER what reaches
    # the document, so an input can change in a partition this stream does
    # not report and rebuild a byte-identical document. Emitting that would
    # break the one promise a consumer has, that a line IS an event.
    _collect
    if [ "$_rows$_srows" = "$_ssnap" ]; then
      _sdoc=$_slast
    else
      _ssnap="$_rows$_srows"
      _sdoc=$(_status_doc)
    fi
    if [ "$_sdoc" != "$_slast" ]; then
      printf '%s\n' "$_sdoc"
      # AFTER the state, so a consumer has repainted before it is asked to
      # interrupt anybody, and so a banner can never describe a state the
      # reader has not seen yet.
      _alines=$(mux_announce_lines "$_sprev" "$_srows")
      [ -z "$_alines" ] || printf '%s\n' "$_alines"
      _slast=$_sdoc _sprev=$_srows
      _squiet=0
      continue
    fi
    # QUIET AND DEAD MUST NOT LOOK THE SAME, which is the one thing polling
    # gave away for free: there, a non-zero exit could only be the transport.
    # A stream that simply stops speaking could be a calm host or a wedged
    # ssh, and this package has measured both (a blackholed port, and a
    # responsive peer making no progress for 342s).
    #
    # AND THE HEARTBEAT WORKS IN BOTH DIRECTIONS, which is why it is a write
    # rather than a timer the consumer keeps: it is also how THIS process
    # learns its reader has gone. Without it a remote stream would poll a
    # box for ever after the tray that asked for it died.
    _squiet=$((_squiet + _sint))
    if [ "$_squiet" -ge "$_shb" ]; then
      printf '{"status":"ok","heartbeat":true}\n'
      _squiet=0
    fi
  done
fi

_collect
_status_doc
exit "$MUX_EC_OK"
