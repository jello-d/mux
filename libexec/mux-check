#!/bin/sh
# mux-check: audit that mux is coherently installed: its package DATA (share),
# its config overlay (MUX_DIR), and its one runtime dependency (tmux).
#
# Output is the [OK]/[FAIL]/[WARN] MARKER contract: one status line per check,
# and a non-zero exit on any [FAIL]. An integrator can style the plain markers
# with its own palette (tmux's mux ships no such coupling); run standalone at a
# terminal, mux-check colours the markers itself. Either way mux depends on NO
# integrator machinery: the markers are a string convention, not shared code.
set -eu


_libexec=$(dirname "$0")
_lib=$_libexec/../lib
[ -r "$_lib/mux-exit_lib" ] \
  || { echo "mux: $_lib/mux-exit_lib missing" >&2; exit 1; }
# shellcheck source=/dev/null
. "$_lib/mux-exit_lib"
# Inherited from the mux entry point (exported there); self-located as a
# fallback so `mux-check` also works when run by its own path. share/ is a
# sibling of this libexec dir under the install prefix.
MUX_DIR=${MUX_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/mux}
MUX_SHARE=${MUX_SHARE:-$(dirname "$0")/../share}

# The shared $MUX_DIR-over-$MUX_SHARE resolver (mux-data_lib), so the check
# audits the data mux would ACTUALLY read: a default theme or layout supplied
# by the overlay counts, and one shadowed by it is judged on the overlay copy.
for _l in mux-conf_lib mux-paths_lib mux-data_lib mux-context_lib \
    mux-scan_lib mux-profiles_lib mux-notify_lib mux-views_lib \
    mux-sessions_lib; do
  _lp=$(dirname "$0")/../lib/$_l
  [ -r "$_lp" ] || {
    printf '  [FAIL] %s missing (broken install)\n' "$_lp" >&2
    exit "$MUX_EC_FAIL"; }
  . "$_lp"
done
# The audit reports on the context the caller is ACTUALLY in, so a work session
# and a personal one each check their own partition's roots.
mux_ctx_resolve || true

# Colour the markers ONLY on a real terminal (a captured/piped run stays plain,
# so an integrator's styler paints it and a log stays escape-free). NO_COLOR
# honoured. The codes match the common ANSI set; mux owns this copy (its
# independence costs six lines, not a dependency).
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  _e=$(printf '\033')
  _G="$_e[1;32m"; _R="$_e[1;31m"; _Y="$_e[1;33m"; _O="$_e[0m"
else
  _G=; _R=; _Y=; _O=
fi
RC=0
ok()   { printf '  %s[OK]%s   %s\n'   "$_G" "$_O" "$*"; }
bad()  { printf '  %s[FAIL]%s %s\n'   "$_R" "$_O" "$*"; RC=1; }
warn() { printf '  %s[WARN]%s %s\n'   "$_Y" "$_O" "$*"; }

# 1. tmux: the one hard runtime dependency.
if command -v tmux >/dev/null 2>&1; then ok "tmux present"
else bad "tmux not found (mux's one runtime dependency)"; fi

# 1b. mux ITSELF on PATH. share/mux.tmux carries no paths on purpose (it
# reaches every helper as `mux <verb>`), so a mux that is not on PATH breaks
# every key binding and every status-bar tick, while `mux check` run by its own
# path would otherwise look perfectly healthy. This is the install failure that
# actually happens.
if _mp=$(command -v mux 2>/dev/null); then
  ok "mux on PATH ($_mp)"

  # TWO mux commands on PATH is the banned state (see the install-placement
  # rule): the earlier entry silently shadows the later one, and then rots
  # behind it: a seam added this morning is inert because a day-old copy
  # wins `command -v`. Nothing else in this check can see that, because
  # everything else follows the copy it is already running from.
  _dupes=
  _oIFS=$IFS; IFS=:
  for _pe in $PATH; do
    [ -n "$_pe" ] || _pe=.
    [ -x "$_pe/mux" ] || continue
    case " $_dupes " in *" $_pe/mux "*) continue ;; esac
    _dupes="$_dupes $_pe/mux"
  done
  IFS=$_oIFS
  _dn=0
  for _d in $_dupes; do _dn=$((_dn + 1)); done
  if [ "$_dn" -gt 1 ]; then
    bad "$_dn mux commands on PATH, and the first shadows the rest:"
    for _d in $_dupes; do bad "    $_d"; done
  fi

  # Is the copy on PATH the same install this check is auditing? If not,
  # every verdict below describes a tree that the key bindings and the
  # status bar do NOT run. A WARN, not a FAIL: running a dev checkout's
  # ./bin/mux check deliberately hits this, and crying wolf there would
  # train the marker to be ignored.
  _self=$(cd "$(dirname "$0")/.." 2>/dev/null && pwd) || _self=
  _pathpfx=$(cd "$(dirname "$(readlink -f "$_mp")")/.." 2>/dev/null && pwd) \
    || _pathpfx=
  if [ -n "$_self" ] && [ -n "$_pathpfx" ] && [ "$_self" != "$_pathpfx" ]; then
    warn "checking $_self, but PATH runs $_pathpfx"
    warn "  this verdict is about the tree you invoked, not the one"
    warn "  your key bindings and status bar actually use"
  fi
else bad "mux not on PATH: the tmux fragment reaches it as \`mux <verb>\`"; fi

# 1c. Desktop notifications: OPTIONAL, so a gap is a WARN, never a FAIL; a
# headless box or a bare tty is a perfectly healthy mux that simply nudges
# nobody.
#
# MUX RAISES NOTHING ITSELF ANY MORE, which changes what this can honestly
# report. `mux-desktop-notifier` raises every banner now, from the event
# stream, because that is the only thing able to reach the box the human is
# sitting at: a hook raises on the box the AGENT runs on, so every blocked
# LATCHED session spent years popping a toast on a remote desktop. So the old
# question (is `notify-send` here, can something close one) is not the
# question any more, and both halves of that seam are gone.
#
# TWO THINGS STILL WORTH ASKING, and this box can answer both:
#   is anything able to DISPLAY a notification        (the session bus)
#   is mux's notifier installed to raise one          (a file on disk)
#
# AND IT CANNOT ASK WHETHER THE NOTIFIER IS RUNNING, which is said rather than
# guessed: that is the notifier's own `setup.sh check`, which compares three
# copies including the live process, and mux core must not learn systemd to
# find out. Installed-and-not-running is therefore the one gap this marker
# leaves, and it is covered one package over.
_nd=0; mux_notify_daemon || _nd=$?
_nbin=${MUX_DESKTOP_NOTIFIER_BIN:-$HOME/.local/bin}/mux-desktop-notifier
# `-e` AND `-L`, because this is a symlink into a venv: `-e` follows it, so a
# DANGLING one (the venv removed, the link left) answers false and would read
# as "never installed" when it is really "installed and broken". The rename
# taught this exact lesson a few hours ago.
if [ -e "$_nbin" ] || [ -L "$_nbin" ]; then
  if [ "$_nd" -eq 1 ]; then
    # A REAL FINDING, and a WARN rather than a FAIL for the reason the whole
    # block is optional: which daemon runs is the user's desktop, not mux's
    # install, and a provisioner's apply cannot repair it.
    warn "notifications: the notifier is installed but NOTHING DISPLAYS" \
      "them: no daemon owns org.freedesktop.Notifications and nothing on" \
      "this session bus offers to start one"
  elif [ "$_nd" -eq 3 ]; then
    # NOBODY HOME IS NOT NOBODY COMING. The name is D-Bus activatable, so the
    # first notification starts a daemon, and this is the ordinary state for
    # the first minutes after a boot. Reporting it as a fault was this check
    # being wrong in the opposite direction to the bug it was added to fix.
    ok "notifications (notifier installed; no daemon up yet, D-Bus will" \
      "start one on demand)"
  elif [ "$_nd" -eq 2 ]; then
    # SAID, NOT GUESSED. Over ssh there is no session bus to ask, and
    # reporting the desktop broken from a context that cannot see it is the
    # mistake the WAYLAND_DISPLAY validator made this week. It is also the
    # NORMAL answer on a watched box: the notifier belongs on the desktop,
    # not on every machine mux runs on.
    ok "notifications (notifier installed; no bus to confirm a daemon" \
      "from here)"
  else
    ok "notifications (notifier installed -> a live daemon)"
  fi
elif [ "$_nd" -eq 2 ]; then
  # No bus and no notifier is the ordinary shape of a box you LATCH TO: its
  # banners are raised where you are sitting, so saying anything stronger
  # here would be a finding about every remote machine in the fleet.
  ok "notifications are raised by the desktop notifier, not from here"
else
  warn "no desktop notifier here, so mux raises no notifications:" \
    "install it with ./setup.sh desktop-notifier, or ignore this on a" \
    "box you only ever reach from another one"
fi

# 2. package DATA (share): the dir plus the pieces mux reads at runtime.
if [ -d "$MUX_SHARE" ]; then
  ok "package data ($MUX_SHARE)"
  for _f in mux.tmux themes layouts agents partitions latch desktop-notifier \
    skills; do
    [ -e "$MUX_SHARE/$_f" ] && ok "share/$_f present" \
      || bad "share/$_f missing (broken install)"
  done
  # The global partition must ship, or an unconfigured mux has no scan
  # roots and discovery is silently off everywhere.
  if [ -n "$(mux_data_find partitions global .partition)" ]; then
    ok "partitions/global.partition present"
  else bad "no partitions/global.partition (discovery cannot work)"; fi
  # The default ARRANGEMENT must resolve: a profile that names no layout,
  # and a bare `mux go` with no profile at all, both land on it.
  if [ -n "$(mux_data_find layouts default .layout)" ]; then
    ok "default layout resolves"
  else bad "no layouts/default.layout (a bare 'mux go' cannot build)"; fi
  # THE AGENT INSTRUCTIONS MUST ASSEMBLE, which is not the same question
  # as share/skills being present. The document is a body (AGENTS.md)
  # plus a frontmatter file, and a skill emitted without the frontmatter
  # installs cleanly, errors nothing and then never triggers, so the
  # check has to be whether it composes, not whether the directory is
  # there. Read-only, and the sibling helper so a dev tree audits itself.
  if "$(dirname "$0")/mux-skill" >/dev/null 2>&1; then
    ok "agent instructions assemble (mux skill)"
  else bad "mux skill cannot assemble share/skills/mux-agent"; fi
else
  bad "package data missing ($MUX_SHARE): reinstall mux"
fi

# 3. config overlay (MUX_DIR): where user layouts + the integrator overlay live.
# Optional: with none, mux runs the shipped defaults from share, so its absence
# is a surfaced note, not drift.
if [ -d "$MUX_DIR" ]; then
  ok "config overlay ($MUX_DIR)"
  # TRANSITIONAL: profiles used to be called layouts and sat in
  # <name>.layout at the overlay root. mux still reads those, with a
  # warning; say so here with the command that fixes it.
  _old=0
  for _f in "$MUX_DIR"/*.layout; do
    [ -e "$_f" ] || continue
    _old=$((_old + 1))
  done
  if [ "$_old" -gt 0 ]; then
    warn "$_old pre-rename *.layout file(s) in $MUX_DIR"
    warn "  convert them:  mux migrate-profiles"
  fi
  # A name in BOTH the table and profiles.d is drift: promotion is meant
  # to delete the row, so a surviving one is stale. The breakout wins, but
  # say so rather than leaving it to precedence.
  if [ -f "$MUX_DIR/profiles" ]; then
    for _b in "$MUX_DIR"/profiles.d/*.profile; do
      [ -e "$_b" ] || continue
      _bn=${_b##*/}; _bn=${_bn%.profile}
      if awk '!/^[[:space:]]*#/ && NF {print $1}' \
        "$MUX_DIR/profiles" | grep -qxF -- "$_bn"; then
        warn "'$_bn' is both a row and a breakout file"
        warn "  the file wins; drop the row"
      fi
    done
  fi
  # A DIRECTIVE IN config THAT MUX DOES NOT READ. Measured before writing
  # this: three mistyped keys (`contextcommand`, `latch-prob`, `env-redy`)
  # and the audit said `[OK] config overlay` about all of them. Every one is
  # INERT, which is the whole problem: no partitions, no probe, nothing
  # waiting, and nothing anywhere says so.
  #
  # IT MATTERS MORE NOW THAT A PROVISIONER MAY PLACE THIS FILE. A placed file
  # is re-asserted on every run and nobody reads it again, so a key mux
  # renames in a later release sits there doing nothing for as long as the
  # box lives. For `env-ready` that is the feature silently off, which is the
  # exact failure it was built to prevent.
  #
  # THE LEGAL SET COMES FROM share/config.sample, which is NOT a second copy
  # of it: test/mux-config-sample.t holds that file against the source in
  # both directions, and against each default's VALUE, so it is a DECLARATION
  # that cannot drift from the code. Reading it here is cheaper and more
  # honest than a third list written out in this file.
  #
  # A WARN, NEVER A FAIL, and the reason is already written down one layer
  # over: `_mux_ctx_merge` ignores an unknown key in a settings file because
  # "a newer mux writing a key this one does not know must not break an older
  # one", and $MUX_DIR is designed to be SHARED between machines, so a config
  # ahead of this install is a normal state rather than drift.
  _cfgf=$MUX_DIR/config
  _samp=$MUX_SHARE/config.sample
  if [ -f "$_cfgf" ] && [ -r "$_samp" ]; then
    _known=$(sed -n 's/^#\{0,1\}\([a-z][a-z-]*\)[ \t].*/\1/p' "$_samp" \
      | sort -u | tr '\n' ' ')
    _unk=
    while read -r _ck _crest; do
      [ -n "${_ck:-}" ] || continue
      : "${_crest:-}"
      case " $_known " in
        *" $_ck "*) ;;
        *) _unk="$_unk $_ck" ;;
      esac
    done <<EOF
$(mux_conf_clean <"$_cfgf")
EOF
    case ${_unk# } in
      '') ok "config directives are all ones mux reads" ;;
      *)  warn "config directive(s) mux does not read:${_unk}"
          warn "  they are INERT: no error, and no effect. Spelling, or a key"
          warn "  from a newer mux. Every key is in $_samp" ;;
    esac
  elif [ -f "$_cfgf" ]; then
    ok "config present; cannot audit its keys (no $_samp)"
  fi
else warn "no config overlay at $MUX_DIR (using shipped defaults)"; fi

# 4. discovery. A configured root that has since moved means `mux go <name>`
# quietly stops finding half your projects, with no error anywhere: the map
# just comes back smaller. Cheap to check, invisible otherwise.
if [ -n "${MUX_CFG_scan:-}" ]; then
  # Fed by a here-doc, NOT a pipe. A `while` behind a pipe runs in a
  # SUBSHELL, so bad()'s RC=1 was set on a copy and thrown away: a missing
  # scan root printed [FAIL] and mux check still exited 0. This file's
  # whole contract is "non-zero on any FAIL", so the one check that could
  # not honour it made the auditor itself the thing asserting something
  # untrue, and anything gating on the exit code saw a clean bill.
  while read -r _p _d; do
    [ -n "$_p" ] || continue
    case $_p in "~") _p=$HOME ;; "~/"*) _p=$HOME/${_p#\~/} ;; esac
    if [ -d "$_p" ]; then ok "scan root $_p"
    else bad "scan root missing: $_p"; fi
  done <<EOF
$MUX_CFG_scan
EOF
else
  # A WARN AND NOT A FAIL, because discovery is optional and NOT configuring it
  # is a legitimate state. mux used to ship `scan ~/src 3`, so this arm was
  # unreachable and every machine without a ~/src got `[FAIL] scan root
  # missing` instead: a fresh install failing its own check for declining to
  # guess where somebody keeps their work.
  #
  # AND IT NAMES THE REMEDY, the rule this fleet states for any cross-cutting
  # finding: a gap named without the exact command to close it invites two
  # reasonable people to close it two different ways.
  warn "no scan roots for partition '${MUX_CTX_PARTITION:-global}'"
  warn "  discovery is off, so \`mux go <name>\` cannot find projects"
  warn "  turn it on with: mux scan --init"
fi

# 4a. THE SESSION POINTERS. R7: a withheld value must be VISIBLE. mux resolves
# these at session build and attach, and a value that resolved but FAILED its
# own validator is deliberately not written. That decision has to be VISIBLE,
# or a box runs every agent pane with no `SSH_AUTH_SOCK` while reporting
# healthy.
#
# A WARN, NEVER A FAIL, and the reasoning is the same as discovery's one arm
# up: a dead pointer is usually a fact about the MACHINE rather than about the
# install. The compositor has exited, so WAYLAND_DISPLAY points at a socket
# with nothing behind it; that is not mux being broken and a provisioner's
# apply cannot repair it.
#
# READ-ONLY, which this file's contract demands and which is easy to get wrong
# here: `mux_env_plan` resolves and validates and writes NOTHING, where
# `mux_env_apply` is the one that acts. The same distinction that keeps this
# check away from `mux agent-render`, which prunes.
if [ -r "$(dirname "$0")/../lib/mux-env_lib" ]; then
  # shellcheck source=/dev/null
  . "$(dirname "$0")/../lib/mux-notice_lib"
  # shellcheck source=/dev/null
  . "$(dirname "$0")/../lib/mux-env_lib"
  _envnames=$(mux_env_names 2>/dev/null | tr '\n' ' ')
  if [ -z "${_envnames# }" ]; then
    ok "no session pointers managed (envhooks.d is empty)"
  else
    _envbad=
    _envnone=
    while IFS=' ' read -r _ev _en _ex; do
      [ -n "$_en" ] || continue
      case $_ev in
        drop) _envbad="$_envbad $_en" ;;
        # RESOLVED TO NOTHING AT ALL, which this marker used to pass over in
        # silence: it collected `drop` only, so a managed pointer that does
        # not EXIST was listed among the healthy ones and the whole line read
        # `[OK]`. That is the state a box is in between booting and its
        # graphical session starting, so the check called the environment
        # healthy during exactly the window where it was not. Fully installed
        # and fully broken, in the file that defines the rule.
        none) _envnone="$_envnone $_en" ;;
      esac
    done <<ENVEOF
$(mux_env_plan 2>/dev/null)
ENVEOF
    if [ -n "$_envbad" ]; then
      # NAMED, not counted, for the reason this package states about `mux
      # resume`: "rebuilt 5" cannot say WHICH five, and the useful
      # post-mortem is always about the one that is missing.
      warn "session pointer(s) withheld:${_envbad}"
      warn "  each resolved, and its own validator says that value is dead,"
      warn "  so mux did not write it. Usually the thing it points at exited."
    fi
    if [ -n "$_envnone" ]; then
      # A SEPARATE WARN, not folded into the one above, because the remedy
      # differs: a WITHHELD value exists and is dead (whatever it points at
      # exited), while an ABSENT one was never published, which on a desktop
      # box usually means the graphical session has not started yet. One
      # sentence covering both would be wrong about one of them.
      warn "session pointer(s) absent:${_envnone}"
      warn "  nothing resolved them, so mux has nothing to propagate and"
      warn "  any pane built now cannot gain them later (an environment is"
      warn "  fixed at exec). Usually: the session that publishes them has"
      warn "  not started."
    fi
    if [ -z "$_envbad" ] && [ -z "$_envnone" ]; then
      ok "session pointers (${_envnames% })"
    fi
    # AND THE READINESS DECLARATION IS CHECKED HERE, where it is cheap, rather
    # than being found by a latch timing out after a reboot: a name in
    # `env-ready` that nothing manages is a typo whose only symptom is a wait
    # that never ends.
    _envdecl=$(mux_ctx_conf env-ready 2>/dev/null || true)
    if [ -n "$_envdecl" ]; then
      _envrc=0
      # Word-split on purpose: a space-separated list of variable names.
      # shellcheck disable=SC2086
      mux_env_ready $_envdecl || _envrc=$?
      if [ "$_envrc" -eq 2 ]; then
        bad "env-ready names nothing manages:$MUX_ENV_UNMANAGED"
        bad "  mux resume would refuse on this box until it is fixed"
      else
        ok "env-ready declared ($_envdecl)"
      fi
    fi
  fi
fi

# 4b. view tension. Two clients of different SIZES attached to one server means
# there is no window size that suits both, so tmux picks one and the windows
# move as you cycle: the "why did that redraw" question. Advisory, never a
# FAIL: it is a normal consequence of attaching from a second place, and often
# the second place is an ssh window you forgot rather than a fault.
MUX_VIEW_SOCKET=${MUX_CTX_PARTITION:-}
export MUX_VIEW_SOCKET
if mux_view_server_tension 2>/dev/null; then
  warn "$(mux_view_sizes | grep -c .) client sizes attached --" \
    "windows resize as you cycle (mode: $(mux_view_mode))"
  mux_view_clients | while read -r _vn _vd _vs _vi; do
    warn "  $_vn $_vd on '$_vs', idle $((_vi / 60))m"
  done
  warn "  settle or end it:  mux views"
fi

# 5. unsaved edit drafts. A draft survives an unparseable save on purpose, so
# the work is handed back rather than eaten, but a forgotten one means an edit
# you think you made is not in effect anywhere. Surface it.
_ed=$(mux_state_path_ro edit)
if [ -d "$_ed" ]; then
  for _d in "$_ed"/*.profile; do
    [ -e "$_d" ] || continue
    _dn=${_d##*/}; _dn=${_dn%.profile}
    warn "unsaved edit draft for '$_dn' at $_d"
    warn "  resume it:  mux edit $_dn"
  done
fi

# 6. Does the product actually WORK on the running server?
#
# Everything above this point is a PRESENCE check: files exist, commands
# resolve, config parses. Ask the only question that matters (what would this
# say about a box that is fully installed and fully BROKEN?) and a presence
# check answers [OK] to every line.
#
# So these ask tmux what it is actually configured to do. They are READ-ONLY
# queries (list-keys, show-options) and deliberately do NOT run the renderer:
# `mux agent-render` PRUNES state files it believes orphaned, and run against
# the wrong socket it deletes every agent's state, which has happened. A
# check must never be able to damage what it inspects.
# THE PROBE MUST NOT BE ABLE TO CREATE WHAT IT IS LOOKING FOR, and the obvious
# one does: `tmux list-keys` STARTS A SERVER when none is running and answers
# out of tmux's DEFAULTS (measured, 93 lines from a socket that did not exist
# a moment earlier). Keying the guard on its output is wrong three ways at
# once: the check spawns a server as a side effect, the no-server branch below
# can never fire, and the pristine server it just started then fails five
# assertions, so a fresh install reports a wall of red about a server the user
# never started. `list-sessions` errors and spawns nothing.
#
# `list-sessions` IS THE PROBE: it errors instead of spawning (measured both
# ways), and a server with no sessions does not exist, since tmux exits when the
# last one goes.
if ! _vt list-sessions >/dev/null 2>&1; then
  # No server for this partition. A perfectly healthy state (a fresh boot,
  # a headless box), so it is not a WARN, but it is said out loud, because
  # a check that silently skips its only functional assertions is exactly
  # the check this section exists to replace.
  ok "no tmux server for '${MUX_CTX_PARTITION:-global}': tmux state unchecked"
else
  _keys=$(_vt list-keys -T prefix 2>/dev/null || true)
  # share/mux.tmux carries no paths: every binding reaches a helper as
  # `mux <verb>`. So a binding that exists but does not mention mux is a
  # binding tmux kept from some other config, not mux's.
  _bound() {   # <key>: is prefix+<key> bound to a mux verb?
    printf '%s\n' "$_keys" | awk -v k="$1" '
      $1 == "bind-key" && $3 == "prefix" && $4 == k {
        if (index($0, "mux ") > 0) found = 1 }
      END { exit !found }'
  }
  # THE LIST IS READ OUT OF share/mux.tmux, NOT WRITTEN DOWN HERE, so the
  # assertion grows with the fragment. A hand-kept list goes stale in the
  # direction that passes: it named four keys while the fragment bound six,
  # and a server missing both of the others read clean.
  # ANY bind whose command mentions mux, not just `run-shell` ones. The
  # narrower pattern missed `prefix ?` the day it was added, because that one
  # is a `display-popup`, which is the same silent-shrink this derivation
  # exists to prevent, reproduced by the shape of the match rather than by a
  # hand-written list. A bind that does NOT mention mux is still excluded: it
  # is tmux's own, or another config's.
  _want_keys=$(sed -n \
    's/^bind \([^ -][^ ]*\) .*"mux .*/\1/p' \
    "$MUX_SHARE/mux.tmux" 2>/dev/null | sort -u | tr '\n' ' ')
  _nb=
  for _k in $_want_keys; do
    _bound "$_k" || _nb="$_nb $_k"
  done
  if [ -z "$_want_keys" ]; then
    warn "cannot read $MUX_SHARE/mux.tmux to learn the bindings"
  elif [ -z "$_nb" ]; then
    ok "key bindings live (prefix $_want_keys)"
  else
    bad "key binding(s) not bound to mux:$_nb"
    # TWO CAUSES, AND THEY NEED DIFFERENT REMEDIES. Saying only "the fragment
    # is not sourced" was advice that could not come true for the common case:
    # a LIVE server whose tmux.conf already sources the fragment, but which
    # started before the binding existed. Sourcing a file does not reload a
    # server, so the line was already there and adding it again changes
    # nothing, and a provisioner reading this loops forever, applying a fix
    # that cannot work. (tackup reported exactly that: "APPLY DID NOT FIX ...
    # a fix owed by another repo".)
    #
    # THE DISCRIMINATOR IS ALREADY ON THE SERVER: if status-right is mux's
    # renderer, the fragment HAS been sourced here, so a missing NEW binding
    # can only mean the server predates it. If it is not, nothing sourced the
    # fragment at all.
    if _vt show-options -gv status-right 2>/dev/null \
        | grep -q 'mux agent-render'; then
      bad "  this server predates them: run \`mux reload\`"
      bad "  (installing a file does not reload a running tmux server)"
    else
      bad "  the fragment is not sourced: source-file .../share/mux.tmux"
    fi
  fi

  # AND THE HOOKS. The bindings above are the visible half; the hooks carry
  # `mux undo-pane`'s trackers and recorder, the bottom-pane pin and the
  # status style. A server started before a feature landed keeps running
  # without them while every other marker stays green, so `prefix u` and the
  # whole window-layout-changed set can be absent from a live server and
  # nothing says so.
  #
  # INSTALLING A FILE DOES NOT RELOAD A SERVER, and that gap is the whole
  # point. `tackup` updating mux.tmux on disk changes nothing about a
  # tmux that has been up for weeks; only `mux reload` does.
  _want_hooks=$(sed -n 's/^set-hook -[ag]* \([a-z-]*\) .*/\1/p' \
    "$MUX_SHARE/mux.tmux" 2>/dev/null | sort -u)
  _nh=
  for _h in $_want_hooks; do
    # Present AND mux's: a hook tmux kept from another config is
    # not this one, the same reasoning the binding check uses.
    _vt show-hooks -g "$_h" 2>/dev/null \
      | grep -qE 'mux |@mux-' || _nh="$_nh $_h"
  done
  if [ -z "$_want_hooks" ]; then
    :                       # already warned about the fragment
  elif [ -z "$_nh" ]; then
    ok "tmux hooks live ($(printf '%s' "$_want_hooks" | tr '\n' ' '))"
  else
    bad "tmux hook(s) missing or not mux's:$_nh"
    bad "  this server predates the hooks: run \`mux reload\`"
  fi

  # The status bar is drawn by two #() jobs. If either is not mux's, the
  # bar still renders: just without the thing mux exists to show, which
  # is why this fails silently and looks like "no agents are running".
  _sr=$(_vt show-options -gv status-right 2>/dev/null || true)
  case $_sr in
    *"mux agent-render"*) ok "status-right draws the agent strip" ;;
    "") bad "status-right is empty: the agent strip cannot appear" ;;
    *)  bad "status-right is not mux's renderer: no agent strip" ;;
  esac
  _sl=$(_vt show-options -gv status-left 2>/dev/null || true)
  case $_sl in
    *"mux style"*) ok "status-left draws the session chip" ;;
    *) warn "status-left is not mux's: session chip styling is off" ;;
  esac

  # AN AGENT MUX STARTED AND HAS NEVER HEARD FROM. This is the first-run
  # failure and the one a presence check cannot see: everything is
  # installed, the strip draws, and every chip reads the same as a plain
  # shell because nothing ever told the agent to report. The strip now
  # draws these as `unwired` rather than `none`; this says WHY and names
  # the fix, which is the half a glyph cannot carry.
  #
  # A WARN, not a FAIL: the agent's own configuration is the user's, a
  # provisioner's `apply` cannot repair it, and `--no-agent` sessions are
  # a deliberate reason to have none. Advisory is the honest level.
  if [ -r "$(dirname "$0")/../lib/mux-agent-state_lib" ]; then
    . "$(dirname "$0")/../lib/mux-agent-state_lib"
    _adir=$(mux_agent_dir 2>/dev/null || true)
    # THE WHOLE PIPELINE IS THE SUBSTITUTION, so no temp file is
    # needed to get a value out of a `while` that runs in a
    # subshell. The first draft used one and wrote
    # `tr ... <file 2>/dev/null`, which silences NOTHING: the
    # redirections apply left to right, so a failing open happens
    # while stderr is still the terminal. test/lint.t greps for
    # exactly that shape and caught it.
    _unwired=$(_vt list-panes -a \
      -F '#{@mux-agent}	#{session_name}' 2>/dev/null \
      | while IFS='	' read -r _m _s; do
        [ -n "${_m:-}" ] || continue
        [ -n "${_s:-}" ] || continue
        # THE FIRST FIELD, not the whole answer.
        # `mux_agent_state` returns "STATE EPOCH" and
        # with no record that is a single SPACE, which
        # is non-empty, so testing the pair skipped
        # every session and this could never fire.
        _pair=$(mux_agent_state "$_adir" "$_s")
        [ -n "${_pair%% *}" ] && continue
        printf '%s\n' "$_s"
      done | sort -u | tr '\n' ' ')
    case ${_unwired% } in
      '') ok "every agent session has reported its state" ;;
      *)  warn "no agent state from: ${_unwired% }; the agent's hooks" \
        "are not wired. Fix with: mux setup <agent>" ;;
    esac
  fi

  # --- A SESSION MUX CANNOT ADDRESS -------------------------------------
  # mux RESERVES the colon in a session name, so every verb refuses to
  # create one and every derived name folds it. A session made with RAW
  # tmux is the gap that leaves, and it only became reachable at all in
  # tmux 3.7, which sanitises session names NOT AT ALL (measured: 3.4 and
  # 3.6 rewrite a colon, 3.7c keeps every character).
  #
  # A WARN RATHER THAN A FAIL, and the line is whose name it is: the
  # session belongs to the user, so renaming it is their call and not a
  # provisioner's. Nothing is broken either. The session works; it simply
  # cannot be named in an address, because `work::api` would split there
  # and a plain `tmux -t` could not reach it either.
  # ASKED ONCE and used twice, because the marker below needs the same
  # answer: a round trip is the cost on this path, not the parsing.
  _live=$(_vt list-sessions -F "#{session_name}" 2>/dev/null || true)
  _unaddr=
  while IFS= read -r _s; do
    [ -n "$_s" ] || continue
    mux_sess_name_clean "$_s" || _unaddr="$_unaddr[$_s] "
  done <<EOF
$_live
EOF
  case ${_unaddr% } in
    '') ;;
    *)  warn "session(s) mux cannot address: ${_unaddr% }" \
        "-- a colon is reserved for PARTITION::SESSION and SESSION:WINDOW," \
        "and tmux uses it the same way. Rename: mux rename OLD NEW" ;;
  esac

  # --- ASSERTED VERSUS ACTUAL: THE RECORDED SET AND THE SERVER ----------
  # The session set is what `mux resume` rebuilds after a reboot, and until
  # now nothing compared it with reality. So "did resume come back short?"
  # was answerable from the log at the moment it happened (resume logs the
  # names it rebuilt AND the ones it could not) and from nowhere at all
  # afterwards, which is the drift-detector this tree's rules ask for
  # whenever one fact is written down in two places.
  #
  # ONLY ONE DIRECTION IS A FINDING, and that was decided by measuring the
  # hooks rather than by reasoning about the set's semantics:
  #
  # LIVE AND NOT RECORDED is a session a reboot LOSES. `mux resume` rebuilds
  #   the set and nothing else, so a session missing from it is gone with no
  #   warning at the one moment it cannot be reconstructed. One-directional
  #   harm, so a WARN, and the remedy already exists: every attach records,
  #   idempotently, precisely so a set can heal.
  #
  # RECORDED AND NOT LIVE is NOT reported, and the reason is worth writing
  #   down because it is tempting. mux's fragment sets no `session-closed`
  #   hook (measured: `set-hook -g session-closed` fires on a kill-session
  #   and NOT on a kill-server, and never for the LAST session, because the
  #   server exits first), so the set is subtractive on `mux kill` alone. A
  #   session whose last pane took a stray ^D therefore stays recorded, and
  #   that is the DESIGN rather than drift: a ^D is one keystroke from
  #   detach, which is the whole reason `mux undo-pane` exists, so bringing
  #   it back on the next resume is the wanted answer. It is still STATED on
  #   the pass line, because a marker that prints a bare `ok` cannot be
  #   caught lying about what it measured.
  #
  # READ-ONLY, THROUGH THE DOOR BUILT FOR IT. `mux_sess_list` reaches
  # `mux_state_path`, which ADOPTS a pre-0.38 copy by moving it, and a check
  # that migrates is a check that damages what it inspects. The `ro` form is
  # a pure derivation.
  _recset=$(mux_sess_list "${MUX_CTX_PARTITION:-}" ro)
  _unrec=
  while IFS= read -r _s; do
    [ -n "$_s" ] || continue
    printf '%s\n' "$_recset" | grep -qxF -- "$_s" || _unrec="$_unrec $_s"
  done <<EOF
$_live
EOF
  _unlive=
  while IFS= read -r _s; do
    [ -n "$_s" ] || continue
    printf '%s\n' "$_live" | grep -qxF -- "$_s" || _unlive="$_unlive $_s"
  done <<EOF
$_recset
EOF
  if [ -n "$_unrec" ]; then
    warn "live but NOT in the session set:$_unrec; a reboot loses" \
      "them, since mux resume rebuilds the set and nothing else." \
      "Record: mux go <name>"
  fi
  _nrec=$(printf '%s\n' "$_recset" | grep -c . || true)
  _nliv=$(printf '%s\n' "$_live" | grep -c . || true)
  if [ -z "$_unrec" ]; then
    case $_unlive in
      '') ok "session set agrees with the server ($_nliv live, all recorded)"
          ;;
      *)  ok "session set: $_nrec recorded, $_nliv live; resume would also" \
          "rebuild$_unlive" ;;
    esac
  fi
fi

exit "$RC"
