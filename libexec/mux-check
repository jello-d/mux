#!/bin/sh
# mux-check: audit that mux is coherently installed -- its package DATA (share),
# its config overlay (MUX_DIR), and its one runtime dependency (tmux).
#
# Output is the [OK]/[FAIL]/[WARN] MARKER contract: one status line per check,
# and a non-zero exit on any [FAIL]. An integrator can style the plain markers
# with its own palette (tmux's mux ships no such coupling); run standalone at a
# terminal, mux-check colours the markers itself. Either way mux depends on NO
# integrator machinery -- the markers are a string convention, not shared code.
set -eu

# Inherited from the mux entry point (exported there); self-located as a
# fallback so `mux-check` also works when run by its own path. share/ is a
# sibling of this libexec dir under the install prefix.
MUX_DIR=${MUX_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/mux}
MUX_SHARE=${MUX_SHARE:-$(dirname "$0")/../share}

# The shared $MUX_DIR-over-$MUX_SHARE resolver (mux-data.sh), so the check
# audits the data mux would ACTUALLY read -- a default theme or layout supplied
# by the overlay counts, and one shadowed by it is judged on the overlay copy.
_data=$(dirname "$0")/mux-data.sh
[ -r "$_data" ] || {
	printf '  [FAIL] %s missing (broken install)\n' "$_data" >&2; exit 1; }
. "$_data"

# Colour the markers ONLY on a real terminal (a captured/piped run stays plain,
# so an integrator's styler paints it and a log stays escape-free). NO_COLOR
# honoured. The codes match the common ANSI set; mux owns this copy (its
# independence costs six lines, not a dependency).
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
	_e=$(printf '\033')
	_G="$_e[1;32m"; _R="$_e[1;31m"; _Y="$_e[1;33m"; _O="$_e[0m"
else
	_G=; _R=; _Y=; _O=
fi
RC=0
ok()   { printf '  %s[OK]%s   %s\n'   "$_G" "$_O" "$*"; }
bad()  { printf '  %s[FAIL]%s %s\n'   "$_R" "$_O" "$*"; RC=1; }
warn() { printf '  %s[WARN]%s %s\n'   "$_Y" "$_O" "$*"; }

# 1. tmux -- the one hard runtime dependency.
if command -v tmux >/dev/null 2>&1; then ok "tmux present"
else bad "tmux not found (mux's one runtime dependency)"; fi

# 1b. mux ITSELF on PATH. share/mux.tmux carries no paths on purpose -- it
# reaches every helper as `mux <verb>` -- so a mux that is not on PATH breaks
# every key binding and every status-bar tick, while `mux check` run by its own
# path would otherwise look perfectly healthy. This is the install failure that
# actually happens.
if _mp=$(command -v mux 2>/dev/null); then ok "mux on PATH ($_mp)"
else bad "mux not on PATH -- the tmux fragment reaches it as \`mux <verb>\`"; fi

# 2. package DATA (share): the dir plus the pieces mux reads at runtime.
if [ -d "$MUX_SHARE" ]; then
	ok "package data ($MUX_SHARE)"
	for _f in mux.tmux themes layouts agents; do
		[ -e "$MUX_SHARE/$_f" ] && ok "share/$_f present" \
			|| bad "share/$_f missing (broken install)"
	done
	# The default theme named by themes/defaults must resolve to a fragment.
	_df=$(mux_data_find themes defaults '')
	if [ -n "$_df" ]; then
		_dt=$(sed -n 's/^default[[:space:]]\{1,\}\([^[:space:]#]\{1,\}\).*/\1/p' \
			"$_df" | head -1)
		if [ -n "$_dt" ] && [ -n "$(mux_data_find themes "$_dt" .theme)" ]
		then ok "default theme '$_dt' resolves"
		else bad "default theme '${_dt:-unset}' has no themes/*.theme"; fi
	else warn "themes/defaults absent (no global default theme)"; fi
	# The default ARRANGEMENT must resolve: a profile that names no layout,
	# and a bare `mux go` with no profile at all, both land on it.
	if [ -n "$(mux_data_find layouts default .layout)" ]; then
		ok "default layout resolves"
	else bad "no layouts/default.layout (a bare 'mux go' cannot build)"; fi
else
	bad "package data missing ($MUX_SHARE) -- reinstall mux"
fi

# 3. config overlay (MUX_DIR): where user layouts + the integrator overlay live.
# Optional: with none, mux runs the shipped defaults from share, so its absence
# is a surfaced note, not drift.
if [ -d "$MUX_DIR" ]; then
	ok "config overlay ($MUX_DIR)"
	# TRANSITIONAL: profiles used to be called layouts and sat in
	# <name>.layout at the overlay root. mux still reads those, with a
	# warning; say so here with the command that fixes it.
	_old=0
	for _f in "$MUX_DIR"/*.layout; do
		[ -e "$_f" ] || continue
		_old=$((_old + 1))
	done
	if [ "$_old" -gt 0 ]; then
		warn "$_old pre-rename *.layout file(s) in $MUX_DIR"
		warn "  convert them:  mux migrate-profiles"
	fi
	# A name in BOTH the table and profiles.d is drift: promotion is meant
	# to delete the row, so a surviving one is stale. The breakout wins, but
	# say so rather than leaving it to precedence.
	if [ -f "$MUX_DIR/profiles" ]; then
		for _b in "$MUX_DIR"/profiles.d/*.profile; do
			[ -e "$_b" ] || continue
			_bn=${_b##*/}; _bn=${_bn%.profile}
			if awk '!/^[[:space:]]*#/ && NF {print $1}' \
				"$MUX_DIR/profiles" | grep -qxF "$_bn"; then
				warn "'$_bn' is both a row and a breakout file"
				warn "  the file wins; drop the row"
			fi
		done
	fi
else warn "no config overlay at $MUX_DIR (using shipped defaults)"; fi

# 4. unsaved edit drafts. A draft survives an unparseable save on purpose, so
# the work is handed back rather than eaten -- but a forgotten one means an edit
# you think you made is not in effect anywhere. Surface it.
_ed=${MUX_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/mux}/edit
if [ -d "$_ed" ]; then
	for _d in "$_ed"/*.profile; do
		[ -e "$_d" ] || continue
		_dn=${_d##*/}; _dn=${_dn%.profile}
		warn "unsaved edit draft for '$_dn' at $_d"
		warn "  resume it:  mux edit $_dn"
	done
fi

exit "$RC"
