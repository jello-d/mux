#!/bin/sh
# mux-agent-hook: an agent lifecycle EVENT, translated to mux's state.
#
#   mux agent-hook <EventName>
#
# THE MAPPING IS MUX'S, WHICH IS THE WHOLE POINT. Until now an integrator's
# hooks.json spelled out mux's own vocabulary (which event means `working`,
# which means `idle`, which is only a `--beat`), so the state machine was
# written down in somebody else's repo and mux could not change it without a
# coordinated release. Here the wiring says only WHAT HAPPENED and mux decides
# what that means, which is the direction already settled for this contract:
# mux defines what wiring must promise, never the reverse.
#
# It also means a rule change ships as a mux release. When `--beat` stopped
# being able to resurrect a turn, that was a plugin edit; the next such change
# is a line in the table below.
#
# --source travels automatically, so a transition in `mux log` names the hook
# that caused it. `Stop` and `SessionStart` both resolve to `idle`, and
# telling them apart afterwards is exactly what the breadcrumb is for: a
# record that went idle MID-TURN is one of them and the record alone cannot
# say which. That breadcrumb is what identified the compaction bug below, one
# release after being added.
set -eu

_libexec=$(dirname "$0")
_lib=$_libexec/../lib
[ -r "$_lib/mux-exit_lib" ] \
  || { echo "mux: $_lib/mux-exit_lib missing" >&2; exit 1; }
# shellcheck source=/dev/null
. "$_lib/mux-exit_lib"

_ev=${1:-}
[ -n "$_ev" ] || {
  echo "usage: mux agent-hook <EventName>" >&2; exit "$MUX_EC_USAGE"; }
[ $# -eq 1 ] || {
  echo "mux: agent-hook takes one event name" >&2; exit "$MUX_EC_USAGE"; }

# THE TABLE. A beat is an event that merely WITNESSES activity; only a turn
# START may create `working` out of `idle`, which is why PostToolUse and
# SubagentStop are beats and UserPromptSubmit is not.
#
# AND THE TWO BEATS ARE NOT EQUAL, which is the one distinction this table
# adds over that. Two beats over `idle` inside a window CORROBORATE an
# auto-mode turn, a rule resting on the agent calling TOOLS. PostToolUse is
# exactly that. SubagentStop says only that SOME agent stopped, and the agent
# harness runs its own housekeeping (the "while you were away" recap) as a
# subagent while no turn exists, so two recaps promoted a finished session to
# working, measured. `--refresh` keeps every other beat behaviour and is inert
# over `idle`. A real subagent is spawned as an `Agent` TOOL CALL (measured
# in transcripts), so its return fires PostToolUse and real work loses
# nothing.
case $_ev in
  UserPromptSubmit) set -- working ;;
  PostToolUse)      set -- working --beat ;;
  SubagentStop)     set -- working --refresh ;;
  Notification)     set -- blocked ;;
  # THE DIALOG ITSELF, and 6s sooner than the Notification about it
  # (measured on 2.1.308). --asked because this one is never the "waiting
  # for input" nudge, so the blocked-over-idle rule must not soften it: an
  # auto-mode turn can reach a prompt before any hook said it started.
  PermissionRequest) set -- blocked --asked ;;
  Stop)             set -- idle ;;
  # A TURN THAT ENDS IN AN API ERROR FIRES StopFailure AND NEVER Stop, so
  # without this row the record stays `working` with nothing running.
  # Measured 2026-10-20: "Prompt is too long" left a session `working`, the
  # 60s nudge then read it as `blocked`, and a manual /compact moved it back
  # to `working`, which the compaction guard below then kept for good.
  StopFailure)      set -- idle ;;
  # A COMPACTION FIRES SessionStart MID-TURN, which is why this row carries a
  # qualifier that `Stop` does not. Stop is an OBSERVATION that the turn ended;
  # SessionStart is an agent announcing itself, which is an assertion about what
  # it knows rather than about what the pane is doing. Measured: four of four
  # compact boundaries turned a working session into a finished one. The
  # mechanism is in mux-agent-state-emit.
  SessionStart)     set -- idle --unless-working ;;
  *)
    # LOUD, not silent. An unset seam means nobody asked for anything and
    # says nothing; a NAMED event mux does not know is a wiring error, and
    # the integrator is claiming a contract that does not exist. The hook
    # ends in `|| true` on its side, so the agent is never harmed by this.
    if [ -r "$_lib/mux-log_lib" ]; then
      . "$_lib/mux-log_lib"
      mux_log agent "unknown hook event: $_ev"
    fi
    echo "mux: agent-hook: unknown event: $_ev" >&2
    exit "$MUX_EC_USAGE" ;;
esac

# A Notification SAYS WHICH KIND IT IS, in `notification_type` on stdin.
# `permission_prompt` needs a human and is `blocked`; `idle_prompt` is the
# "waiting for your input" nudge, a minute after a turn ENDED, so it is
# evidence the turn is over rather than a request. Read as `blocked` it rang
# the bell for a session that was merely done, and over a stale `working` it
# made a finished session read as needing you. Anything else (an absent
# field, an older agent, a type mux has not met) keeps the old meaning, so
# emit's blocked-over-idle rule still covers those. `--unless-blocked`,
# because the nudge says the INPUT box is waiting and a permission prompt
# is not the input box: it may end a turn, never answer a prompt.
#
# ONLY READ WHEN stdin IS NOT A TERMINAL: a human or the demo calling this
# by hand has nothing to send, and `cat` would wait for them. The agent
# harness writes one JSON object and closes the pipe. Matched rather than
# parsed: mux carries no JSON parser, and the one field is enough.
if [ "$_ev" = Notification ] && ! [ -t 0 ]; then
  _in=$(cat 2>/dev/null) || _in=
  _np='"notification_type"[[:space:]]*:[[:space:]]*"idle_prompt"'
  if printf '%s' "$_in" | grep -q -- "$_np"; then
    set -- idle --unless-blocked
  fi
fi

exec "$_libexec/mux-agent-state-emit" "$@" --source "$_ev"
