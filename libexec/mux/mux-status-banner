#!/bin/sh
# mux-status-banner: a CENTRED, loud status-bar banner for two modes --
#   PREFIX HELD  -> a bright "PREFIX ENABLED" banner: the prefix (C-Space) is
#                   armed and tmux is waiting for the next key, unmissable.
#   PANE ZOOMED  -> a "how to unzoom" hint: prefix z hid the other panes, so an
#                   accidental zoom is obviously recoverable.
# Prefix wins when both apply (it is momentary; the zoom hint returns after).
#
# tmux has no per-mode hook and no clean way to inject centred text into the
# status line declaratively, so this REBUILDS status-format[0] as the pristine
# default plus the banner. The pristine default is stashed in @mux-sf0-default
# on the first run and reused every time after, so this is idempotent AND the
# banner can be UPDATED just by re-running (mux reload) -- no accumulation, no
# stale copy. Run from tmux.conf via run-shell at server start and on reload.
set -eu

# Stash the pristine default once; rebuild from it every time.
def=$(tmux show -gqv @mux-sf0-default)
if [ -z "$def" ]; then
	def=$(tmux show -gqv "status-format[0]")
	tmux set -g @mux-sf0-default "$def"
fi

# The two banners. Commas inside the styles are escaped #, so the #{?...} parser
# does not read them as its own true/false separator.
pfx='#[fg=colour231#,bg=colour61#,bold]'
pfx="$pfx  ⌨ PREFIX ENABLED ⌨  #[default]"
zoom='#[fg=colour16#,bg=colour214#,bold] ⛶ ZOOM · '
zoom="$zoom""C-Space z to restore #[default]"

# Centred; prefix banner first, else zoom hint, else nothing.
banner="#[align=centre]#{?client_prefix,$pfx,#{?window_zoomed_flag,$zoom,}}"

tmux set -g "status-format[0]" "$def$banner"
