#!/bin/sh
# mux-addr_lib: one address grammar for partition, session and window.
#
#     [PARTITION.]SESSION[:WINDOW]      a bare word is always a SESSION
#
#     api            session api, in my partition
#     api:2          session api, window 2
#     work.api       session api in partition work
#     work.api:2     fully qualified
#     work.          the whole partition
#
# TWO DELIMITERS, AND THE CHOICE WAS FORCED BY MEASUREMENT rather than taste.
# A delimiter is only structural if it CANNOT occur in the thing it separates,
# so every candidate was put to tmux by creating `work<D>api` and reading back
# what it stored:
#
#     @ ~ % ^ + = , /    kept VERBATIM, so each is a legal session name and
#                        `work@api` is genuinely ambiguous with a session
#                        called `work@api`
#     : .                REWRITTEN to `_`, so neither can ever appear
#
# EXACTLY TWO CHARACTERS IN THE WHOLE ASCII RANGE ARE AVAILABLE, which is also
# exactly how many this grammar needs. A partition name is a DNS label, so it
# can contain neither either way.
#
# WHICH ONE GOES WHERE WAS THE REAL DECISION (the user's, 2026-10-01), and it
# went to the tool underneath: tmux spells a window target `session:window`,
# and a user of mux types raw tmux targets too. So mux's `api:2` is
# BYTE-IDENTICAL to tmux's `api:2`, and the rare field, the partition, is the
# one that carries the unusual delimiter. The first choice made in this
# session was the other way round (`partition:session.window`), and it was
# reversed on exactly that argument: a `.` for the window would have meant
# typing `tmux switch -t api:2` and `mux ... api.2` for the same thing
# forever.
#
# A BARE WORD IS A SESSION because that is the common case by a wide margin,
# and naming a partition is rare. That is what removes the placeholder: the
# old two-colon grammar needed a leading `:` to say "no partition" because one
# delimiter had to serve both pairs, and with two delimiters no form is ever
# ambiguous, so `:api:2` has nothing to express any more.
#
# `host:port` IS A DIFFERENT CONCERN and is untouched, now with no overlap at
# all: `mux latch box:2222 work.api` carries two delimiters answering two
# questions, and the host field is parsed before the target ever reaches here.
# A hostname's own dots are in the HOST field, which this never sees.

# Parse one address into three variables. Deliberately NOT a printf of three
# fields: a session name may contain a space, so any single-string answer needs
# a delimiter and every delimiter is a bug waiting for a name that contains it.
# The same reason latch's transport is argv rather than a string.
#
#     MUX_ADDR_PART   empty means "not specified", never "global"
#     MUX_ADDR_SESS
#     MUX_ADDR_WIN
#
# EMPTY IS NOT A DEFAULT, which matters at every call site: resolving an
# unspecified partition to the caller's own context is the CALLER's decision,
# because `update-env` and a future window verb want different answers for it
# and a default buried here would make one of them wrong silently.
#
# Returns 2 and says why on a malformed address, rather than guessing.
mux_addr_parse() {   # <address>
  MUX_ADDR_PART=; MUX_ADDR_SESS=; MUX_ADDR_WIN=
  _apa=${1:-}
  case $_apa in
  '')
    echo "mux: empty address" >&2
    return 2 ;;
  esac

  # THE PARTITION COMES OFF FIRST, because a dot binds tighter than a colon
  # here: `work.api:2` is partition `work` holding `api:2`, never session
  # `work.api` with window `2`, and that order has to be fixed rather than
  # inferred. Neither character can appear in a NAME, so there is no case
  # where the other reading is reachable.
  #
  # `%%` AND `#*` ARE DELIBERATE AND CARRY NO MUTATION RECORD, which was
  # measured rather than assumed: swapping either for its longest-match
  # twin is UNKILLABLE here, because an address with two dots is refused by
  # the second check whichever way the first one splits it. Redundant
  # strictness rather than an untested guard, so it is stated instead of
  # defended with a record that could only ever survive.
  case $_apa in
  *.*)
    MUX_ADDR_PART=${_apa%%.*}
    _aprest=${_apa#*.}
    # A DOT WITH NOTHING BEFORE IT NAMES NO PARTITION, and is refused rather
    # than quietly accepted as a second spelling of the bare form. One
    # spelling per meaning is the whole reason the placeholder went away.
    [ -n "$MUX_ADDR_PART" ] || {
      echo "mux: '$_apa' has a dot with no partition before it" >&2
      echo "mux: a bare name is already a session: ${_aprest:-SESSION}" >&2
      return 2; }
    case $_aprest in
    *.*)
      echo "mux: too many dots in '$_apa'" >&2
      echo "mux: an address is [PARTITION.]SESSION[:WINDOW], and neither a" >&2
      echo "mux: partition (a DNS label) nor a tmux session name may" >&2
      echo "mux: contain a dot, so there is no field it could belong to." >&2
      return 2 ;;
    esac ;;
  *) _aprest=$_apa ;;
  esac

  # Then the window, by the same reasoning in the other direction.
  case $_aprest in
  *:*)
    MUX_ADDR_SESS=${_aprest%%:*}
    MUX_ADDR_WIN=${_aprest#*:}
    case $MUX_ADDR_WIN in
    *:*)
      echo "mux: too many colons in '$_apa'" >&2
      echo "mux: an address is [PARTITION.]SESSION[:WINDOW], and a tmux" >&2
      echo "mux: session name cannot contain a colon, so there is no" >&2
      echo "mux: fourth field it could belong to." >&2
      return 2 ;;
    esac ;;
  *) MUX_ADDR_SESS=$_aprest ;;
  esac
  return 0
}

# A human-readable rendering of what was parsed, for a message that has to
# quote the address back. Kept here so a caller never re-assembles it and
# invents a different spelling of the same thing.
mux_addr_show() {
  printf '%s%s%s' \
    "${MUX_ADDR_PART:+$MUX_ADDR_PART.}" \
    "$MUX_ADDR_SESS" \
    "${MUX_ADDR_WIN:+:$MUX_ADDR_WIN}"
}
