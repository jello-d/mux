#!/bin/sh
# mux-addr_lib: one address grammar for partition, session and window.
#
#     [PARTITION::]SESSION[:WINDOW]     a bare word is always a SESSION
#
#     api            session api, in my partition
#     api:2          session api, window 2
#     work::api      session api in partition work
#     work::api:2    fully qualified
#     work::         the whole partition
#
# ONE CHARACTER, DOUBLED FOR THE RARE FIELD (the user's design, 2026-10-01),
# and it is the only form that survives the measurement. A delimiter is
# structural only if it CANNOT occur in the thing it separates, so every
# candidate was put to tmux by creating `work<D>api` and reading the stored
# name back. The answer DEPENDS ON THE TMUX VERSION, which is the part that
# cost two wrong decisions before this one:
#
#     tmux 3.4    structural: . :           verbatim: @ ~ % ^ + = , /
#     tmux 3.6    structural: . :           verbatim: @ ~ % ^ + = , /
#     tmux 3.7c   structural: : @ ~ ^ = /   verbatim: . % + ,
#
# `:` IS THE ONLY CHARACTER STRUCTURAL ON ALL THREE. A first attempt spent a
# `.` on the partition, measured on 3.6 alone, and 3.7c stores `work.api`
# verbatim: a session can be CALLED that there, so the address was ambiguous
# on exactly the platform the macOS runner exists to speak for. 3.7 also moved
# the other way, making `@ ~ ^ = /` structural, so a table from one version is
# a table about that version and nothing more.
#
# SO THE SECOND FIELD SEPARATOR IS THE SAME CHARACTER, DOUBLED. `::` can never
# arise from a name, because neither a partition (a DNS label) nor a session
# may contain even ONE colon, so a doubled colon is unambiguous BY
# CONSTRUCTION rather than by a version-dependent accident. Verified directly
# as well: `work::api` is stored as `work__api`.
#
# A BARE WORD IS A SESSION, the common case by a wide margin, and `api:2` is
# BYTE-IDENTICAL to the window target tmux itself takes, which matters because
# a user of mux types raw tmux targets too. The rare field pays the extra
# character. That also removes the placeholder the old grammar needed: with
# `::` carrying the partition, nothing has to be said to mean "not that".
#
# `host:port` IS A DIFFERENT CONCERN and does not overlap: `mux latch
# box:2222 work::api` answers two questions with two spellings, and the host
# field is parsed before the target ever reaches here.

# Parse one address into three variables. Deliberately NOT a printf of three
# fields: a session name may contain a space, so any single-string answer needs
# a delimiter and every delimiter is a bug waiting for a name that contains it.
# The same reason latch's transport is argv rather than a string.
#
#     MUX_ADDR_PART   empty means "not specified", never "global"
#     MUX_ADDR_SESS
#     MUX_ADDR_WIN
#
# EMPTY IS NOT A DEFAULT, which matters at every call site: resolving an
# unspecified partition to the caller's own context is the CALLER's decision,
# because `update-env` and a future window verb want different answers for it
# and a default buried here would make one of them wrong silently.
#
# Returns 2 and says why on a malformed address, rather than guessing.
mux_addr_parse() {   # <address>
  MUX_ADDR_PART=; MUX_ADDR_SESS=; MUX_ADDR_WIN=
  _apa=${1:-}
  case $_apa in
  '')
    echo "mux: empty address" >&2
    return 2 ;;
  esac

  # THE DOUBLE COLON COMES OFF FIRST, which fixes the precedence rather than
  # inferring it: `work::api:2` is partition `work` holding `api:2`, and the
  # single-colon split then runs on what is LEFT. Taking them the other way
  # round would see `work` and `:api:2` and have to guess.
  #
  # `%%` AND `#*` ARE DELIBERATE AND CARRY NO MUTATION RECORD, measured
  # rather than assumed: swapping either for its longest-match twin is
  # UNKILLABLE, because an address with two `::` is refused by the next
  # check whichever way the first one splits it. Redundant strictness rather
  # than an untested guard, so it is stated instead of defended by a record
  # that could only ever survive.
  case $_apa in
  *::*)
    MUX_ADDR_PART=${_apa%%::*}
    _aprest=${_apa#*::}
    # A `::` WITH NOTHING BEFORE IT NAMES NO PARTITION, and is refused rather
    # than quietly accepted as a second spelling of the bare form. One
    # spelling per meaning is why no placeholder is needed at all.
    [ -n "$MUX_ADDR_PART" ] || {
      echo "mux: '$_apa' has a '::' with no partition before it" >&2
      echo "mux: a bare name is already a session: ${_aprest:-SESSION}" >&2
      return 2; }
    case $_aprest in
    *::*)
      echo "mux: too many '::' in '$_apa'" >&2
      echo "mux: an address is [PARTITION::]SESSION[:WINDOW], and a tmux" >&2
      echo "mux: session name cannot contain a colon at all, so there is" >&2
      echo "mux: no second partition field it could belong to." >&2
      return 2 ;;
    esac ;;
  *) _aprest=$_apa ;;
  esac

  # Then the window, on a SINGLE colon, over what the partition left behind.
  case $_aprest in
  *:*)
    MUX_ADDR_SESS=${_aprest%%:*}
    MUX_ADDR_WIN=${_aprest#*:}
    case $MUX_ADDR_WIN in
    *:*)
      echo "mux: too many colons in '$_apa'" >&2
      echo "mux: an address is [PARTITION::]SESSION[:WINDOW], and a tmux" >&2
      echo "mux: session name cannot contain a colon, so there is no" >&2
      echo "mux: fourth field it could belong to." >&2
      return 2 ;;
    esac
    # A WINDOW WITH NO SESSION NAMES NOTHING. `work:::api` splits to a
    # partition and then `:api`, which would otherwise read as an empty
    # session with a window called `api`: a shape no caller can act on, so
    # it is refused rather than passed along half-formed.
    [ -z "$MUX_ADDR_WIN" ] || [ -n "$MUX_ADDR_SESS" ] || {
      echo "mux: '$_apa' names a window with no session" >&2
      echo "mux: an address is [PARTITION::]SESSION[:WINDOW]" >&2
      return 2; }
    ;;
  *) MUX_ADDR_SESS=$_aprest ;;
  esac
  return 0
}

# A human-readable rendering of what was parsed, for a message that has to
# quote the address back. Kept here so a caller never re-assembles it and
# invents a different spelling of the same thing.
mux_addr_show() {
  printf '%s%s%s' \
    "${MUX_ADDR_PART:+$MUX_ADDR_PART::}" \
    "$MUX_ADDR_SESS" \
    "${MUX_ADDR_WIN:+:$MUX_ADDR_WIN}"
}
