#!/bin/sh
# mux-latch: keep an attachment to a remote mux session alive as the network
# allows. BRING YOUR OWN TRANSPORT: mux owns the state machine and the attach
# semantics; ssh, mosh, Eternal Terminal or anything else supplies the pipe, and
# nothing here knows what a host, an IP or an MTU is.
#
#   mux latch [HOST[:SESSION]]
#
# IT IS NOT A TRANSPORT. It never carries a keystroke. It decides WHEN to
# (re)establish an attachment and reports WHY it has not, which is what keeps it
# small and stops it growing into a transport project.
#
# THE MODEL IS A STATE MACHINE, and the question that partitions it is not which
# exit code came back but: does resolving this need a HUMAN, or PATIENCE?
# Retrying is right in every state except one, where it is actively harmful.
#
#   probing   down, recoverable with no human action. Retry on a backoff.
#   blocked   no credential is live YET (empty agent, a key not added, a
#             hardware key wanting a touch). DO NOT ATTEMPT: every attempt is a
#             prompt and a loop here is the storm. Poll the CREDENTIAL instead,
#             which costs nothing and self-heals the moment a key appears.
#   denied    a credential WAS offered and the far side rejected it, OR a host
#             key was rejected (the same refusal pointing the other way).
#             Different problem, opposite handling: TERMINAL. latch cannot
#             observe a human fixing authorized_keys or a known_hosts entry, so
#             there is no condition on which to retry, and retrying a rejected
#             credential forever is the storm wearing a backoff. Say what to fix
#             and stop.
#             (These two were one state at first. The test for the storm is what
#             separated them: with auth live and the far side refusing, a single
#             `blocked` state oscillates.)
#   unknown   cannot determine. Never reported as usable and never as blocked;
#             retried with more patience. On a real fleet this is COMMON, not
#             exotic: an MTU blackhole passes every cheap liveness probe.
#   ended     the human detached or quit. TERMINAL; retrying resurrects what
#             they just closed.
#   gone      the far side no longer has the session. Reported loudly, never
#             silently recreated.
#
# WHY `blocked` IS NOT A DEAD END, which is the good part: auth liveness is
# observable WITHOUT connecting (`ssh-add -l` answers in 12ms). So latch waits
# for you by polling the credential rather than the connection, raises no prompt
# while it waits, and moves on by itself the moment a key is added.
#
# FIVE SEAMS, each a command, each overridable, because every one of them
# encodes transport-specific knowledge that does not belong in mux:
#
#   MUX_LATCH_TRANSPORT  stand the pipe up. %h and %s are host and session.
#   MUX_LATCH_AUTH       credential live? 0 yes / 1 needs a human / 78 no idea
#   MUX_LATCH_PROBE      is the target usable? 0 yes / 1 no / 78 no idea.
#                        Unset means no opinion: just attempt.
#   MUX_LATCH_CLASSIFY   <exit> <stderr-file> -> one state word
#   MUX_LATCH_STATUS     <state> <detail>, fire and forget
#
# 78 is "cannot answer", borrowed from vigilance's HOOK_NA, and the rule with it
# is the one this fleet keeps rediscovering: AN EDGE NOBODY CAN CHECK MUST NOT
# REPORT SUCCESS. A hook that cannot tell must never be read as "fine".
#
# ONE TRANSPORT FOR NOW, deliberately. The state is tracked per transport so an
# ordered fallback list is a later refactor and not a rewrite: `blocked` is a
# per-transport verdict, and with several transports the aggregate is blocked
# only when every one of them is.
set -eu

_lib=$(dirname "$0")
. "$_lib/mux-conf.sh"

MUX_DIR=${MUX_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/mux}
[ -d "${MUX_SHARE:-}" ] || MUX_SHARE=$_lib/../share

# A seam's value: the environment wins, then a key in $MUX_DIR/config, then the
# shipped default. Same precedence the context seam uses.
_seam() {   # <env value> <config key> [default]
	[ -n "$1" ] && { printf '%s' "$1"; return 0; }
	if [ -r "$MUX_DIR/config" ]; then
		_sv=$(mux_conf_clean 2>/dev/null <"$MUX_DIR/config" \
			| awk -v k="$2" '$1 == k { $1 = ""
				sub(/^[ \t]+/, ""); print; exit }')
		[ -n "${_sv:-}" ] && { printf '%s' "$_sv"; return 0; }
	fi
	printf '%s' "${3:-}"
}

# THE HOOK LIBRARY. A hook is named, not spelled out, and a BARE name resolves
# against the overlay before the shipped set before PATH -- the same
# $MUX_DIR-over-$MUX_SHARE order layouts, themes and agents use, and the same
# reason `context-command` already documents: this config travels between
# machines through a dotfiles repo, so it must not carry an absolute path that
# is only right on one of them.
#
# Only the FIRST word is resolved, because a hook value is a command LINE and
# the rest is its arguments. A value containing a slash is a path already and is
# left exactly alone.
_hook() {   # <value> -> the value with its command resolved
	case ${1:-} in
	'' | */*) printf '%s' "${1:-}"; return 0 ;;
	esac
	_hn=${1%% *}; _ha=${1#"$_hn"}
	for _hd in "$MUX_DIR/latch" "$MUX_SHARE/latch"; do
		if [ -x "$_hd/$_hn" ]; then
			printf '%s%s' "$_hd/$_hn" "$_ha"; return 0
		fi
	done
	printf '%s' "$1"
}

# The DEFAULT transport is ssh, because it is the only one that needs no daemon
# and no new listening port, and because the fleet's conventions already depend
# on its agent forwarding. It is still only a default: the seam takes anything.
#
# `sh -lc` is load-bearing, not decoration. sshd runs a remote command WITHOUT a
# login shell, so `ssh host mux go x` gets PATH=/usr/bin:... with no
# ~/.local/bin and exits 127 `mux: not found`. Measured on this fleet, where it
# was the first thing a real latch hit. A login shell reads the profile that
# puts mux on PATH, and %c is what lets the command survive as one argument.
_DEF_TRANSPORT='ssh -t %h sh -lc %q'

TRANSPORT=$(_seam "${MUX_LATCH_TRANSPORT:-}" latch-transport "$_DEF_TRANSPORT")
AUTH=$(_hook "$(_seam "${MUX_LATCH_AUTH:-}" latch-auth ssh-auth)")
_c_seam=$(_seam "${MUX_LATCH_CLASSIFY:-}" latch-classify ssh-classify)
CLASSIFY=$(_hook "$_c_seam")
# PROBE has NO default, and that is a decision rather than an omission: mux
# ships share/latch/ssh-probe but does not wire it. No probe means no opinion,
# so the attempt itself is the probe, which is right because a probe costs a
# round trip before EVERY attempt and only pays off when the host is down.
# Shipping a hook and running it are different acts, and that difference is the
# whole point of having a library.
PROBE=$(_hook "$(_seam "${MUX_LATCH_PROBE:-}" latch-probe '')")
STATUS=$(_hook "$(_seam "${MUX_LATCH_STATUS:-}" latch-status '')")

# A NAMED HOOK THAT DOES NOT EXIST IS A CONFIG ERROR, and it must be loud.
# Silently carrying on means the classifier never answers, every attempt lands
# in `unknown`, and latch retries forever against a host that is fine -- exactly
# what a stale MUX_SHARE produced here during development, with no clue on
# screen as to why. An empty seam is a different thing entirely and stays
# silent: it means nobody asked for a hook.
_hook_must_run() {   # <value> <what>
	[ -n "$1" ] || return 0
	_hw=${1%% *}
	[ -x "$_hw" ] && return 0
	command -v "$_hw" >/dev/null 2>&1 && return 0
	echo "mux: latch: $2 hook not found: $_hw" >&2
	echo "mux: latch: looked in $MUX_DIR/latch, $MUX_SHARE/latch," \
		"then PATH" >&2
	exit 2
}
_hook_must_run "$AUTH" auth
_hook_must_run "$CLASSIFY" classify
_hook_must_run "$PROBE" probe
_hook_must_run "$STATUS" status

# Backoff, and every bound is overridable so a test does not have to sleep.
BACKOFF=${MUX_LATCH_BACKOFF:-2}
BACKOFF_MAX=${MUX_LATCH_BACKOFF_MAX:-60}
BLOCKED_WAIT=${MUX_LATCH_BLOCKED_WAIT:-5}
MAX_TRIES=${MUX_LATCH_MAX_TRIES:-0}         # 0 = forever
SLEEP=${MUX_LATCH_SLEEP:-sleep}

_target=${1:-}
[ -n "$_target" ] || {
	echo "mux: latch needs a target: HOST[:SESSION]" >&2; exit 2; }
_host=${_target%%:*}
_sess=${_target#*:}
[ "$_sess" = "$_target" ] && _sess=
[ -n "$_host" ] || { echo "mux: latch: empty host in '$_target'" >&2; exit 2; }

# SINGLE FLIGHT. A network flap can fire several attach attempts at once (a
# dispatcher hook, a key binding, a human), and N loops against one target is N
# credential prompts and N reconnect races. The lock is per target, and a stale
# one from a killed run is reclaimed by checking the recorded pid.
_run=${XDG_RUNTIME_DIR:-/tmp}/mux-latch
mkdir -p "$_run" 2>/dev/null || true
_lock=$_run/$(printf '%s' "$_target" | tr -c 'A-Za-z0-9_.-' '_').lock
if [ -f "$_lock" ]; then
	_other=$(cat "$_lock" 2>/dev/null || true)
	case ${_other:-} in
	''|*[!0-9]*) ;;
	*) if kill -0 "$_other" 2>/dev/null; then
			echo "mux: latch already running for $_target (pid" \
				"$_other)" >&2
			exit 1
		fi ;;
	esac
fi
printf '%s\n' "$$" >"$_lock"
trap 'rm -f "$_lock"' EXIT INT HUP TERM

# say STATE DETAIL: to the terminal AND to the status seam. The terminal copy is
# the point -- "why is my terminal dead" is the actual daily complaint, and
# autossh's silence is the thing being fixed.
#
# EVERY remaining argument is the detail, joined. With `"$2"` only, a call
# wrapped across lines to stay inside 80 columns silently lost everything after
# the first fragment, and the terminal printed "this needs a human: latch cannot
# see when a" and stopped mid-sentence. The wrapping is unavoidable here, so the
# function has to tolerate it.
_say() {   # <state> <detail...>
	_ss=$1; shift
	_sd=$*
	printf 'mux latch: %s%s\n' "$_ss" "${_sd:+ -- $_sd}" >&2
	[ -n "$STATUS" ] || return 0
	$STATUS "$_ss" "$_sd" >/dev/null 2>&1 || true
}

# A hook's three-state answer, normalised. Anything other than 0, 1 or 78 is
# treated as CANNOT TELL rather than as a verdict: a hook that failed in a way
# it did not anticipate has not answered, and guessing on its behalf is how an
# edge nobody checked gets reported as fine.
_ask() {   # <command...> -> 0 yes, 1 no, 2 cannot tell
	# No hook configured answers 2 as well, so a CALLER that means "then
	# proceed" has to test for the hook itself. Those are opposite
	# instructions and 2 cannot carry both; the probe site does the test.
	[ -n "$1" ] || return 2
	# INTENTIONAL word split, and "$@" would be wrong here: a hook is a
	# command LINE supplied as one string, with the host appended as its
	# argument. Quoting it would look for a program literally named
	# `ssh-add -l`.
	# (The directive sits on its own line because it binds to the NEXT
	# command, and `_ar=0; $*` would have bound it to the assignment.)
	_ar=0
	# shellcheck disable=SC2048,SC2086
	$* >/dev/null 2>&1 || _ar=$?
	case $_ar in
	0)  return 0 ;;
	1)  return 1 ;;
	78) return 2 ;;
	*)  return 2 ;;
	esac
}

_auth_state() { _ask "$AUTH" "$_host"; }

_classify_state() {   # <exit> <stderr file>
	_cs=$($CLASSIFY "$1" "$2" 2>/dev/null || true)
	case ${_cs:-} in
	probing|blocked|denied|unknown|ended|gone|refused)
		printf '%s' "$_cs"; return 0 ;;
	esac
	# A classifier that answered with something meaningless has not answered,
	# and neither has one that is missing or unrunnable. `unknown` is the
	# honest state in all three cases, not a guess.
	printf 'unknown'
}

# THE TRANSPORT IS ARGV, NOT A STRING. The template is split on whitespace into
# positional parameters, and each word is substituted individually. Nothing is
# eval'd, which is the same rule the context seam follows: a value from config
# is parsed, never executed as shell.
#
# That is what makes `%c` possible, and `%c` is why this stopped being a string.
# The old form printed one line for the caller to word-split, so it could not
# express an argument CONTAINING a space -- and the default transport now needs
# exactly that: `sh -lc "mux go NAME"` is three words plus one argument, and
# word-splitting it would hand `go` and `NAME` to the inner shell as $0 and $1.
#
#   %h  the host
#   %s  the session (defaulting to the host)
#   %c  the remote mux command, as ONE argv element, composed by latch
#   %q  the same command, additionally SHELL-QUOTED
#   %%  a literal %
#
# %c AND %q BOTH EXIST BECAUSE TRANSPORTS DIFFER ON WHETHER ARGV SURVIVES, and
# this was measured, not assumed. `ssh host sh -lc 'mux -V'` does NOT run
# `mux -V`: ssh CONCATENATES its remaining arguments into one string and the
# remote login shell re-splits it, so the inner shell received `mux` with `-V`
# as its $0 and ran the bare session picker. Passing the command shell-quoted
# instead printed `mux 0.28`, correctly.
#
# So: %c for a transport that preserves argv (`docker exec`, `kubectl exec`),
# %q for one that flattens to a string and re-parses remotely (ssh). %q is still
# one LOCAL argv element -- the quoting is for the far side's shell, not this
# one -- which is why both go through the same machinery.
#
# A template using %s rather than %c keeps the pre-0.31 behaviour of always
# creating, so attach-only is opt-in by template and no existing config breaks.
# It BUILDS AND RUNS, rather than returning the argv, because POSIX sh has no
# way to hand an array back: joining it into a string is the very problem this
# exists to solve, and every delimiter is a bug waiting for a host name that
# contains it. A function's `set --` rebinds only its OWN positionals, so this
# is local and the script's arguments are untouched.
# Single-quote for a REMOTE POSIX shell: wrap in ', and close/escape/reopen for
# each embedded '. The only character single quotes cannot hold is the quote
# itself, so this is the whole rule and there are no others to forget.
_shquote() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

_run_transport() {   # <remote command> -> runs it, returns its status
	_rc_cmd=$1
	set --
	for _w in $TRANSPORT; do
		if [ "$_w" = %c ]; then
			set -- "$@" "$_rc_cmd"
			continue
		fi
		if [ "$_w" = %q ]; then
			set -- "$@" "$(_shquote "$_rc_cmd")"
			continue
		fi
		set -- "$@" "$(printf '%s' "$_w" | sed \
			-e "s|%h|$_host|g" -e "s|%s|${_sess:-$_host}|g" \
			-e 's|%%|%|g')"
	done
	[ "$#" -gt 0 ] || return 78
	"$@"
}

_errf=$(mktemp)
trap 'rm -f "$_lock" "$_errf"' EXIT INT HUP TERM

# ATTACH-ONLY ON RETRY. The FIRST attempt may create -- you asked to latch onto
# something -- but a REattach that finds nothing means the host rebooted, and
# handing over a fresh empty session where the work was is the worst available
# answer. So every attempt after the first asks for `mux go --attach-only`,
# which refuses rather than creates, and the classifier turns the far side's own
# "no such session" into `gone`.
#
# NEGOTIATED, ONCE, LAZILY, and this is the first real consumer of `mux
# capabilities`. A remote too old for the flag answers exit 2 with a usage
# block, so using it blind would make latch work perfectly until the first drop
# and then break -- the exact discover-by-failure the handshake exists to end.
# The query is deferred to the first RETRY, so the happy path pays nothing, and
# cached for the run. A remote that cannot do it degrades to pre-0.31 behaviour
# rather than to nothing: a stale far side is a reason to create, not to stop.
_remote_attach_only=          # empty / yes / no, decided at most once per run

_remote_can_attach_only() {
	case $_remote_attach_only in
	yes) return 0 ;;
	no)  return 1 ;;
	esac

	_qrc=0
	_qout=$(_run_transport 'mux capabilities' 2>/dev/null) || _qrc=$?
	case $_qrc in
	0)
		# It answered. Absence is then a real answer about the build, not
		# a silence, which is the entire reason the manifest enumerates
		# what it does NOT have.
		case $_qout in
		*'attach-only 1'*) _remote_attach_only=yes; return 0 ;;
		esac
		_remote_attach_only=no ;;
	2)
		# mux's usage code: that far side is too old to know the verb.
		# Also an answer, and the one this was built for.
		_remote_attach_only=no ;;
	*)
		# COULD NOT ASK -- the transport failed, which says nothing
		# whatever about the remote's version. Caching `no` here would
		# record a network outage as a capability verdict and keep it for
		# the life of the run, so this stays UNDECIDED and asks again
		# next time. Same rule as everywhere else in this file: cannot
		# tell is not no.
		return 1 ;;
	esac
	_say attaching "the remote mux cannot attach-only; a reattach there" \
		"may CREATE rather than report a lost session"
	return 1
}

# The remote command for this attempt, as ONE argv element, ASSIGNED to $_cmd.
#
# It assigns rather than prints, and that is not a style choice. `_cmd=$(...)`
# runs the function in a SUBSHELL, so every variable it sets is discarded when
# the substitution ends -- which silently threw away the negotiation cache on
# every single retry. latch re-queried the remote each time while its own
# comments and the man page both claimed "negotiated once, lazily". The
# mutation test is what found it: corrupting the cache changed NOTHING, because
# there was no cache.
#
# Keyed on ATTEMPTS, not on loop iterations. `_tries` counts trips round the
# state machine, and a `blocked` wait is one of those without ever touching the
# transport -- so using it here made the very first attach ask for attach-only
# after any wait at all, which is precisely the case that must CREATE.
_remote_cmd() {   # -> sets $_cmd
	if [ "$_attempts" -gt 0 ] && _remote_can_attach_only; then
		_cmd="mux go --attach-only ${_sess:-$_host}"
	else
		_cmd="mux go ${_sess:-$_host}"
	fi
}

_state=probing
_tries=0
_attempts=0       # transport attaches made; 0 means the next is the first
_delay=$BACKOFF

_wait() {   # <seconds> <state> <why>
	_say "$2" "$3, retrying in ${1}s"
	$SLEEP "$1" || true
}

# The transport's operative complaint: its LAST non-empty stderr line, not its
# first. `head -1` looked obvious and was wrong on the very first live run --
# `ssh -t` from a non-tty leads with "Pseudo-terminal will not be allocated
# because stdin is not a terminal.", so every report named a harmless warning
# and buried "Could not resolve hostname" underneath it. The same would have hit
# the denied, refused and gone reports, which is the half that matters: they are
# what a human reads to decide what to fix.
_errline() {
	awk 'NF { l = $0 } END { print l }' "$_errf" 2>/dev/null || true
}

# Doubled per attempt, capped. One place, so the two retrying paths cannot
# drift: they were written with the doubling on opposite sides of the wait, so
# one of them slept BACKOFF first and the other 2*BACKOFF.
_backoff() {
	_delay=$(( _delay * 2 > BACKOFF_MAX ? BACKOFF_MAX : _delay * 2 ))
}

while :; do
	_tries=$((_tries + 1))
	if [ "$MAX_TRIES" -gt 0 ] && [ "$_tries" -gt "$MAX_TRIES" ]; then
		_say giving-up "after $MAX_TRIES attempt(s) in state $_state"
		exit 1
	fi

	if [ "$_state" = blocked ]; then
		# Poll the CREDENTIAL, never the connection: an attempt here is
		# a prompt, and this is the loop that would storm.
		if _auth_state; then
			_state=probing
			_say probing "a credential is live again"
			continue
		fi
		_wait "$BLOCKED_WAIT" blocked "waiting for a credential"
		continue
	fi

	# Pre-flight. Refusing to attempt without a live credential is what makes
	# the prompt storm impossible by construction rather than merely damped.
	# `! _auth_state` would INVERT the status, making $? 0 for the very
	# verdict being tested, so the blocked branch could never be reached.
	# The three-state answer has to be captured, not negated.
	_ar=0; _auth_state || _ar=$?
	if [ "$_ar" = 1 ]; then
		_state=blocked
		_say blocked "no usable credential; not attempting"
		continue
	fi

	# Reachability, ONLY if someone supplied a probe. NO PROBE MEANS NO
	# OPINION, and the attempt itself becomes the probe -- which has to be
	# tested here rather than inferred from _ask, because _ask answers 2 both
	# for "no hook configured" and for "the hook ran and could not tell".
	# Those are opposite instructions: the first says proceed, the second
	# says wait. Conflating them made the DEFAULT configuration, with no
	# probe seam set, wait forever and never attach even once. Found in a
	# live smoke test against an unreachable host; the suite missed it
	# because every case in it configures a probe.
	if [ -n "$PROBE" ]; then
		_pr=0; _ask "$PROBE" "$_host" || _pr=$?
		case $_pr in
		1|2)
			# 1 says not reachable, 2 says the probe could not tell.
			# Both wait, and both must UPDATE _state: the give-up line
			# reports it, and it once said "in state probing" having
			# just printed unknown, the report contradicting itself.
			if [ "$_pr" = 1 ]; then
				_state=probing
				_why="the target is not reachable"
			else
				_state=unknown
				_why="cannot tell if the target is usable"
			fi
			_wait "$_delay" "$_state" "$_why"
			_backoff
			continue ;;
		esac
	fi

	: >"$_errf"
	_remote_cmd
	_say attaching "$_target via ${TRANSPORT%% *}"
	_rc=0
	_attempts=$((_attempts + 1))
	_run_transport "$_cmd" 2>"$_errf" || _rc=$?
	_state=$(_classify_state "$_rc" "$_errf")

	case $_state in
	ended)
		_say ended "the session was closed deliberately"
		exit 0 ;;
	gone)
		_say gone "the session is not there any more; NOT recreating it"
		exit 1 ;;
	refused)
		_say refused "$(_errline)"
		exit 1 ;;
	denied)
		_say denied "$(_errline)"
		_say denied "this needs a human: latch cannot see when a" \
			"credential or a host key is fixed, so it stops rather" \
			"than retrying a refusal forever"
		exit 1 ;;
	blocked)
		# Only reachable from a classifier that says "no credential yet"
		# rather than "rejected". Waiting is right; attempting is not.
		_say blocked "$(_errline)"
		continue ;;
	*)
		# The transport's OWN first line, when it left one. "the transport
		# dropped" is true of a timeout, a refused port and an
		# unresolvable name alike, and which one it was is the whole
		# question a human has when the terminal goes dead.
		_d1=$(_errline)
		_wait "$_delay" "$_state" "${_d1:-the transport dropped}"
		_backoff
		continue ;;
	esac
done
