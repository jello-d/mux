#!/bin/sh
# mux-notify_lib - raise and clear desktop notifications without binding mux to
# one notification daemon. Sourced by mux-agent-state-emit (which raises one
# when an
# agent stops needing the CPU and starts needing YOU) and by
# mux-agent-state-render
# (which clears one whose pane has since died). Functions only; source it, do
# not run it.
#
# Raising has always been portable: notify-send is libnotify, which every
# freedesktop desktop ships. CLEARING was the part hardcoded to `makoctl
# dismiss`, so a stale "needs you" only ever cleaned itself up under mako on
# Wayland; under dunst, xfce4-notifyd, GNOME or KDE the call was a silent no-op
# and the banner sat there until dismissed by hand.
#
# Nothing about the operation was ever mako-specific. Closing a notification by
# id is in the freedesktop spec that all of those daemons implement, as
# org.freedesktop.Notifications.CloseNotification. So the portable close is a
# plain D-Bus call and the only real variable is which D-Bus CLI is installed:
# gdbus (glib), busctl (systemd) and dbus-send (dbus itself) are each tried in
# turn, with makoctl kept LAST so a mako box carrying no D-Bus CLI at all keeps
# the behaviour it had. All four were verified against a live mako.
#
# Everything here is best effort and silent. A machine with no daemon, no
# notify-send or no session bus is a machine where mux notifies nobody, and
# that must never surface as an error: mux_notify_send runs inside a Claude Code
# hook, where a non-zero exit is a failed hook.
#
# NOT freedesktop at all (macOS, a phone relay, a logger)? Set both of
# MUX_NOTIFY_SEND and MUX_NOTIFY_CLOSE to commands. Send is invoked as
# `CMD URGENCY SUMMARY BODY` and should print an id on stdout (or nothing, if
# it has no notion of one); close is invoked as `CMD ID` and may ignore it. An
# id is opaque to mux (it only ever hands back what send printed), so any
# token the pair agrees on works.

# _mux_notify_closer -> the first usable close backend, or `none`. Cached in
# MUX_NOTIFY_CLOSER: the render pass can clear several phantoms in one run and
# there is no reason to re-probe per notification.
_mux_notify_closer() {
  if [ -z "${MUX_NOTIFY_CLOSER:-}" ]; then
    MUX_NOTIFY_CLOSER=none
    for _nc in gdbus busctl dbus-send makoctl; do
      if command -v "$_nc" >/dev/null 2>&1; then
        MUX_NOTIFY_CLOSER=$_nc
        break
      fi
    done
  fi
  printf '%s' "$MUX_NOTIFY_CLOSER"
}

# mux_notify_daemon -> is anything actually able to DISPLAY a notification?
#
#     0  a daemon owns org.freedesktop.Notifications
#     1  nobody owns it AND nothing would start: mux raises into the void
#     2  cannot tell from here (no tool, or no session bus reachable)
#     3  nobody owns it YET, but the name is D-BUS ACTIVATABLE
#
# THE FOURTH ANSWER IS THE COMMON STATE AFTER A BOOT, and leaving it out made
# this check wrong in the opposite direction to the bug it fixed. Measured five
# minutes after a reboot: `NameHasOwner` answered false, no mako was running,
# and `org.freedesktop.Notifications` was in `ListActivatableNames` with mako
# shipping `fr.emersion.mako.service`. So notifications worked perfectly and
# the check said "NOTHING DISPLAYS them". FOR AN ACTIVATABLE NAME, "nobody
# home" AND "nobody can ever come" ARE THE SAME `false`, and only the second
# is worth warning about.
#
# WHY THIS EXISTS. `mux check` reported `[OK] notifications` on the strength of
# `command -v notify-send`, and on this box that was a lie: the binary was
# there and a real notification died with
#
#     Failed to show notification: GDBus.Error:...NoReply: Message recipient
#     disconnected from message bus without replying
#
# because no daemon owned the name (mako was being activated and dying at
# once on a stale WAYLAND_DISPLAY). A presence check saying OK about a box
# that is fully installed and fully broken is the exact failure the marker
# contract exists to prevent, so having it inside the file that DEFINES that
# contract was the worst available place for it.
#
# READ-ONLY, AND THAT WAS MEASURED, not assumed, because `mux check` must
# never be able to actuate what it inspects and a bus call is the obvious way
# to break that. `NameHasOwner` and `GetNameOwner` DO NOT ACTIVATE a dormant
# service: driven against `ca.desrt.dconf` (activatable, not running) both
# answered and it was still absent a second later. Only a call to the service
# ITSELF activates, which is why this asks the BUS about the name rather than
# asking the daemon anything.
#
# `NameHasOwner` RATHER THAN `GetNameOwner`, because it answers with a clean
# boolean where the other raises `NameHasNoOwner` as an ERROR. That matters
# for the third answer: it lets "nobody home" be a parsed `false` instead of
# an error string, so an error can mean the one thing left, which is that the
# question could not be put at all.
#
# ASKING WHICH NAMES CAN BE ACTIVATED IS ALSO READ-ONLY, measured the same way
# rather than assumed by analogy: driven against `ca.desrt.dconf` (activatable,
# not running), `ListActivatableNames` answered and the name was still unowned
# a second later. It asks the BUS for its own service list, so there is nothing
# for it to start.
#
# AND THE MATCH IS QUOTE-EXACT, never a substring. All three tools quote each
# name, which is what makes that possible, and it is necessary rather than
# fastidious: this box also lists `org.gnome.Shell.Notifications`, so a
# substring match would read a GNOME service as an answer about ours.
#
# THE THIRD ANSWER IS THE LOAD-BEARING ONE, and it is the lesson the
# WAYLAND_DISPLAY hook cost: a probe run where it cannot see the desktop must
# not report the desktop broken. `mux check` over ssh reaches no session bus,
# so the query ERRORS, and calling that "nobody will display it" would be a
# confident false finding about a machine that is fine.
# _mux_bus_ask TOOL METHOD [ARG] -> prints the raw answer, non-zero if the
# call could not be put. ONE caller for two questions, because the alternative
# is a second three-arm case statement and three more chances for the two to
# drift apart on a flag.
_mux_bus_ask() {
  _bat=$1; _bam=$2; _baa=${3:-}
  case $_bat in
  gdbus)
    set -- gdbus call --session --dest org.freedesktop.DBus \
      --object-path /org/freedesktop/DBus \
      --method "org.freedesktop.DBus.$_bam"
    [ -z "$_baa" ] || set -- "$@" "$_baa" ;;
  busctl)
    set -- busctl --user call org.freedesktop.DBus \
      /org/freedesktop/DBus org.freedesktop.DBus "$_bam"
    [ -z "$_baa" ] || set -- "$@" s "$_baa" ;;
  dbus-send)
    set -- dbus-send --session --print-reply \
      --dest=org.freedesktop.DBus /org/freedesktop/DBus \
      "org.freedesktop.DBus.$_bam"
    [ -z "$_baa" ] || set -- "$@" "string:$_baa" ;;
  *) return 1 ;;
  esac
  "$@" 2>/dev/null
}

mux_notify_daemon() {
  _ndn=org.freedesktop.Notifications
  for _ndt in gdbus busctl dbus-send; do
    command -v "$_ndt" >/dev/null 2>&1 || continue
    _ndo=$(_mux_bus_ask "$_ndt" NameHasOwner "$_ndn") || _ndo=
    # All three spell the answer differently and all three contain the word:
    # `(true,)`, `b true`, `   boolean true`. Matched rather than parsed per
    # tool, since the shapes agree on the only token that carries meaning.
    case $_ndo in
    *true*) return 0 ;;
    esac
    case $_ndo in
    *false*) ;;
    # This tool could not put the question. Try the next one rather than
    # concluding anything: a box can carry a gdbus that cannot reach a bus
    # and a busctl that can.
    *) continue ;;
    esac
    # NOBODY OWNS IT. That is only news if nothing WOULD start, so ask.
    _nda=$(_mux_bus_ask "$_ndt" ListActivatableNames) || return 1
    case $_nda in
    *"'$_ndn'"*|*"\"$_ndn\""*) return 3 ;;
    esac
    return 1
  done
  return 2
}

# mux_notify_close ID: clear a notification mux raised, because the state
# that raised it has passed. Never fails, and does nothing at all for an empty
# ID (the common case: most state files carry no notification).
mux_notify_close() {
  [ -n "${1:-}" ] || return 0
  if [ -n "${MUX_NOTIFY_CLOSE:-}" ]; then
    $MUX_NOTIFY_CLOSE "$1" >/dev/null 2>&1 || true
    return 0
  fi
  case $(_mux_notify_closer) in
  gdbus)
    gdbus call --session \
      --dest org.freedesktop.Notifications \
      --object-path /org/freedesktop/Notifications \
      --method \
      org.freedesktop.Notifications.CloseNotification \
      "$1" >/dev/null 2>&1 || true ;;
  busctl)
    busctl --user call org.freedesktop.Notifications \
      /org/freedesktop/Notifications \
      org.freedesktop.Notifications CloseNotification \
      u "$1" >/dev/null 2>&1 || true ;;
  dbus-send)
    dbus-send --session --type=method_call \
      --dest=org.freedesktop.Notifications \
      /org/freedesktop/Notifications \
      org.freedesktop.Notifications.CloseNotification \
      "uint32:$1" >/dev/null 2>&1 || true ;;
  makoctl)
    makoctl dismiss -n "$1" >/dev/null 2>&1 || true ;;
  esac
  return 0
}

# mux_notify_send URGENCY SUMMARY BODY -> the new notification's id on stdout,
# or nothing when it could not be raised or the server declined to report one.
# URGENCY is the spec's low|normal|critical.
#
# mux passes `normal`, and deliberately never `critical`. critical is the spec's
# "an emergency, do not expire me": mako maps it to urgency=high, whose stock
# config sets default-timeout=0, and dunst treats it the same way. That made
# every "Claude needs you" a banner that outlived the thing it reported and had
# to be swatted by hand. An agent waiting on a permission prompt is not a system
# emergency; the status strip and the tray already hold the state persistently,
# so the notification only has to be the nudge that points at them.
#
# -a names mux as the source, which is what lets a daemon-side rule (a mako
# [app-name=mux] block) style or route these without also catching every other
# notification on the box.
mux_notify_send() {
  _nu=${1:-normal}
  _nsum=${2:-}
  _nbody=${3:-}
  if [ -n "${MUX_NOTIFY_SEND:-}" ]; then
    $MUX_NOTIFY_SEND "$_nu" "$_nsum" "$_nbody" 2>/dev/null || true
    return 0
  fi
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a mux -u "$_nu" -p "$_nsum" "$_nbody" 2>/dev/null || true
}
