#!/bin/sh
# mux-next-blocked: switch this client to the session whose agent has been
# BLOCKED (needs-you) the LONGEST -- the loudest, most-escalated chip on the
# strip (see mux-agent-state-render). "Jump to whoever needs me most." Skips
# this
# client's hidden sessions (mux hide) and the session you are already on, so a
# repeat press walks to the next-most-urgent. Silent by contract: it runs from a
# key binding, whose stdout tmux would pop in a view-mode buffer over the pane.
#
#   mux next-blocked [--partition NAME] [CLIENT [CURRENT]]
#
# CLIENT defaults to the client of the pane we are running in, so the bare CLI
# form resolves itself; the `b` binding passes it explicitly (#{client_name})
# since a key-triggered run-shell has no unambiguous "current" client. CURRENT
# (the session to skip) defaults to CLIENT's own session, so the key binding
# need only pass the client. Longest-blocked == earliest epoch:
# mux_agent_state returns "STATE EPOCH" where EPOCH is when the state began, so
# the smallest epoch is the oldest wait.
set -eu

# Sibling libs in this script's own (colocated) libexec dir.
_lib=$(dirname "$0")

# --partition NAME scopes the whole run to another partition's server and
# state. THE TRAY IS THE CALLER: one host can publish several items now, one
# per partition, and a click on the `work` item must jump to work's blocked
# session rather than to whichever partition the far side's login shell
# resolved. Without it every item on a host did the same thing.
#
# AUTHORITATIVE WHEN GIVEN, even inside tmux: you named a partition, you get
# that partition's server. The bare form is unchanged and still follows $TMUX.
_part=
_pflag=0
while [ $# -gt 0 ]; do
  case $1 in
  --partition)
    _pflag=1; _part=${2:-}
    # GUARDED, because `shift 2` on a bare `--partition` is a shell
    # error that also exits 2 -- the right code for the wrong
    # reason, and one no mutation of the real guard could ever be
    # distinguished from.
    if [ $# -gt 1 ]; then shift; fi ;;
  --) shift; break ;;
  -*) echo "mux: next-blocked: unknown option: $1" >&2; exit 2 ;;
  *)  break ;;
  esac
  shift
done
# A bare --partition is a usage error, not a silent fall back to the caller's
# own partition: a click composed without its name would jump somewhere
# plausible and wrong, which is this codebase's recurring failure shape.
[ "$_pflag" = 0 ] || [ -n "$_part" ] || {
  echo "mux: next-blocked: --partition needs a name" >&2; exit 2; }

client=${1:-}
current=${2:-}

# EVERY tmux CALL GOES THROUGH THIS. Inside tmux, $TMUX names the socket and a
# bare call is right. HEADLESS -- which is how a remote caller arrives over a
# transport -- a bare call reaches the DEFAULT socket, which is not where mux's
# server lives, so every query came back empty and this reported "no attached
# client" on a box with clients attached. Same wrapper the doctor already uses,
# for the same reason.
# ONE NAMESPACE, COMPUTED ONCE, because the socket and the STATE DIRECTORY
# must agree and they were resolving from different places: this wrapper used
# `$MUX_CTX_PARTITION` while mux_agent_dir independently defaults to `global`.
# Headless with a partition of `default` that asked the right server for its
# clients and then read an empty state dir -- so it resolved a client, found
# nothing blocked, and exited 0 having done nothing. Silent, and indisting-
# uishable from "nothing needs you".
#
# Empty inside tmux, where $TMUX governs both and mux_agent_dir already knows.
_ns=$_part
[ -n "$_ns" ] || [ -n "${TMUX:-}" ] || _ns=${MUX_CTX_PARTITION:-global}
_nb() {
  if [ -n "$_ns" ]; then tmux -L "$_ns" "$@"
  else tmux "$@"; fi
}
# No CLIENT given (the bare `mux next-blocked`): resolve the client of the pane
# we are in, which means we have to BE in one -- switch-client needs a target.
if [ -z "$client" ]; then
  if [ -n "${TMUX:-}" ]; then
    client=$(_nb display-message -p '#{client_name}' \
      2>/dev/null || true)
  else
    # HEADLESS, which is how a REMOTE caller arrives. The tray
    # indicator reaches a latched host over the same transport it
    # polls with, so there is no pane to resolve from -- and there
    # does not need to be, because a tray item EXISTS only when a
    # latch does, which means a client is attached and the human is
    # looking at it.
    #
    # MOST RECENTLY ACTIVE, and the limitation is worth stating:
    # with several clients on that box (a latch and someone sitting
    # at its console) this picks the one used last, which is
    # usually but not always the one you meant. Precise attribution
    # would need the attach to record its own $SSH_TTY, which is
    # more plumbing than the ambiguity has so far been worth --
    # revisit if it ever picks wrong in practice.
    client=$(_nb list-clients \
      -F '#{client_activity} #{client_name}' 2>/dev/null \
      | sort -rn | awk 'NR == 1 { print $2 }')
  fi
  [ -n "$client" ] || {
    echo "mux: no attached client to switch" >&2; exit 1; }
fi
if [ -z "$current" ]; then
  current=$(_nb display-message -c "$client" -p '#{client_session}' \
    2>/dev/null || true)
fi

. "$_lib/mux-agent-state_lib"
excluded=
if [ -r "$_lib/mux-exclude_lib" ]; then
  . "$_lib/mux-exclude_lib"
  excluded=$(mux_excluded "$client")
fi
dir=$(mux_agent_dir "$_ns")

# LINE by line, and a here-doc rather than a pipe -- `best` is carried out of
# this loop, and a pipe would run it in a subshell and discard it. Word
# splitting here made a session named `my project` two phantom candidates and
# hid the real one, in the feature whose whole job is "take me to whoever has
# waited longest".
best= bestep=
while IFS= read -r s; do
  [ -n "$s" ] || continue
  mux_excluded_has "$excluded" "$s" && continue      # mux hide
  [ "$s" = "$current" ] && continue
  pair=$(mux_agent_state "$dir" "$s")
  [ "${pair%% *}" = blocked ] || continue
  ep=${pair##* }
  [ -n "$ep" ] || ep=9999999999
  if [ -z "$best" ] || [ "$ep" -lt "$bestep" ]; then best=$s; bestep=$ep; fi
done <<EOF
$(_nb list-sessions -F '#{session_name}' 2>/dev/null)
EOF

[ -n "$best" ] || exit 0            # nothing blocked; nowhere to jump
if [ -n "$client" ]; then
  _nb switch-client -c "$client" -t "=$best"
else
  _nb switch-client -t "=$best"
fi
