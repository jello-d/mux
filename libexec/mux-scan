#!/bin/sh
# mux-scan: rebuild the project discovery map for THIS context, then report what
# it found. The on-demand trigger; mux also rebuilds silently when the map is
# absent or a lookup misses (see mux-scan.sh).
#
#   mux scan          rescan and report
#   mux scan --list   print the current map without rescanning
set -eu

MUX_DIR=${MUX_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/mux}

_lib=$(dirname "$0")
for _l in mux-profiles.sh mux-context.sh mux-scan.sh; do
	[ -r "$_lib/$_l" ] || {
		echo "mux: $_l missing (incomplete install)" >&2; exit 1; }
	. "$_lib/$_l"
done

# The partition decides which map this is: a scan run in one partition cannot
# see another's trees.
mux_ctx_resolve || { echo "mux: ${MUX_CTX_ERR:-context error}" >&2; exit 1; }
_key=$MUX_CTX_PARTITION

case "${1:-}" in
--list) ;;
'')
	_roots=$(mux_scan_roots)
	if [ -z "$_roots" ]; then
		echo "mux: no scan roots for partition '$_key'" >&2
		echo "mux: add 'scan <dir> [depth]' to" \
			"$MUX_DIR/partitions/$_key.partition" >&2
		echo "mux: (there is no built-in root on purpose -- a" \
			"partition scans only where you say)" >&2
		exit 1
	fi
	printf 'mux: scanning'
	printf '%s\n' "$_roots" | while read -r _p _d; do
		printf ' %s (depth %s)' "$_p" "$_d"
	done
	printf ' [partition %s]\n' "$_key"
	_ilog=$(mktemp 2>/dev/null || true)
	mux_scan_build "$_key" "$_ilog"
	# An `ignore` that matches nothing is almost always a typo, and a typo
	# in a filter is invisible by construction -- the map just looks normal.
	# So report the count, and say plainly when a configured pattern dropped
	# nothing at all.
	if [ -n "${MUX_CFG_ignore:-}" ]; then
		# -s first: on an EMPTY log `grep -c .` prints 0 and exits 1,
		# so a `|| echo 0` fallback fires as well and the count becomes
		# two lines, which the -gt below then refuses as a number.
		_ni=0
		if [ -n "$_ilog" ] && [ -s "$_ilog" ]; then
			_ni=$(grep -c . "$_ilog" 2>/dev/null || true)
		fi
		[ -n "$_ni" ] || _ni=0
		_pl=$(printf '%s\n' "$MUX_CFG_ignore" | tr '\n' ' ' \
			| sed 's/ *$//')
		if [ "$_ni" -gt 0 ]; then
			printf 'mux: ignored %s path(s) -- ignore: %s\n' \
				"$_ni" "$_pl"
		else
			echo "mux: ignore matched NOTHING -- $_pl" >&2
			echo "mux: (no slash matches a single path component;" \
				"a slash globs the whole path)" >&2
		fi
	fi
	if [ -n "$_ilog" ]; then rm -f "$_ilog"; fi
	;;
*) echo "usage: mux scan [--list]" >&2; exit 2 ;;
esac

_sf=$(mux_scan_file "$_key")
if [ ! -f "$_sf" ]; then
	echo "mux: no map at $_sf (run: mux scan)" >&2
	exit 1
fi
_n=$(cut -f1 "$_sf" | grep -c . || true)
printf 'mux: %s project(s) in %s\n' "$_n" "$_sf"
# Name collisions are worth surfacing here rather than at `mux go` time: two
# repos sharing a basename is a thing to resolve with an alias, once.
_dup=$(cut -f1 "$_sf" | LC_ALL=C sort | uniq -d)
if [ -n "$_dup" ]; then
	printf 'mux: ambiguous name(s) -- give one an alias with `mux new`:\n'
	printf '%s\n' "$_dup" | while IFS= read -r _d; do
		printf '  %s\n' "$_d"
		mux_scan_lookup "$_d" "$_key" | sed 's/^/      /'
	done
fi
