#!/bin/sh
# mux-scan: rebuild the project discovery map for THIS context, then report what
# it found. The on-demand trigger; mux also rebuilds silently when the map is
# absent or a lookup misses (see mux-scan_lib).
#
#   mux scan            rescan and report
#   mux scan --list     print the current map without rescanning
#   mux scan --init     ask where your projects are, and record it
#   mux scan --init DIR the same, without asking
#   mux scan --roots    print the configured roots; exit 1 if there are none
set -eu

MUX_DIR=${MUX_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/mux}

_lib=$(dirname "$0")
for _l in mux-paths_lib mux-profiles_lib mux-context_lib mux-scan_lib; do
  [ -r "$_lib/$_l" ] || {
    echo "mux: $_l missing (incomplete install)" >&2; exit 1; }
  . "$_lib/$_l"
done

# The partition decides which map this is: a scan run in one partition cannot
# see another's trees.
mux_ctx_resolve || { echo "mux: ${MUX_CTX_ERR:-context error}" >&2; exit 1; }
_key=$MUX_CTX_PARTITION

case "${1:-}" in
--list) ;;
'')
  _roots=$(mux_scan_roots)
  if [ -z "$_roots" ]; then
    echo "mux: no scan roots for partition '$_key'" >&2
    echo "mux: set one with:  mux scan --init" >&2
    echo "mux: (or add 'scan <dir> [depth]' to" \
      "$MUX_DIR/partitions/$_key.partition)" >&2
    echo "mux: there is no built-in root on purpose: a partition scans" \
      "only where you say" >&2
    exit 1
  fi
  printf 'mux: scanning'
  printf '%s\n' "$_roots" | while read -r _p _d; do
    printf ' %s (depth %s)' "$_p" "$_d"
  done
  printf ' [partition %s]\n' "$_key"
  _ilog=$(mktemp 2>/dev/null || true)
  mux_scan_build "$_key" "$_ilog"
  # An `ignore` that matches nothing is almost always a typo, and a typo
  # in a filter is invisible by construction: the map just looks normal.
  # So report the count, and say plainly when a configured pattern dropped
  # nothing at all.
  if [ -n "${MUX_CFG_ignore:-}" ]; then
    # -s first: on an EMPTY log `grep -c .` prints 0 and exits 1,
    # so a `|| echo 0` fallback fires as well and the count becomes
    # two lines, which the -gt below then refuses as a number.
    _ni=0
    if [ -n "$_ilog" ] && [ -s "$_ilog" ]; then
      _ni=$(grep -c . "$_ilog" 2>/dev/null || true)
    fi
    [ -n "$_ni" ] || _ni=0
    _pl=$(printf '%s\n' "$MUX_CFG_ignore" | tr '\n' ' ' \
      | sed 's/ *$//')
    if [ "$_ni" -gt 0 ]; then
      printf 'mux: ignored %s path(s); ignore: %s\n' \
        "$_ni" "$_pl"
    else
      echo "mux: ignore matched NOTHING: $_pl" >&2
      echo "mux: (no slash matches a single path component;" \
        "a slash globs the whole path)" >&2
    fi
  fi
  if [ -n "$_ilog" ]; then rm -f "$_ilog"; fi
  ;;
--roots)
  # A QUERY, so a caller can ask whether discovery is configured without
  # running a scan or parsing config itself. `mux scan` is the wrong question
  # (it rebuilds the whole map) and `--list` is too (it prints the map, which is
  # legitimately empty on a fresh root). setup.sh needs exactly this: ask once,
  # and only ASK the human when the answer is none.
  #
  # EXIT 1 FOR NONE, matching what plain `mux scan` already does about the same
  # condition, rather than inventing a second spelling of it.
  _r=$(mux_scan_roots)
  [ -n "$_r" ] || exit 1
  printf '%s\n' "$_r"
  exit 0
  ;;
--init)
  # --- TURNING DISCOVERY ON, WITHOUT GUESSING ------------------------------
  # mux used to SHIP `scan ~/src 3`, so every install that did not keep
  # projects in ~/src got a `[FAIL]` from its own check for a location nobody
  # had chosen. A default is fine; a default nobody confirmed is not, and the
  # bootstrap is exactly where a question belongs.
  #
  # SNIFFED, THEN CONFIRMED: `~/src` if it happens to exist, otherwise $HOME,
  # and either way the human sees it before it is written. Sniffing beats
  # hardcoding because it is right for the people who do use ~/src and asks
  # nothing of the people who do not.
  shift
  _want=${1:-}
  # ALREADY SET IS NOT AN ERROR, it is the second time you ran the command.
  # Idempotent by the same rule everything else here follows.
  _have=$(mux_scan_roots)
  if [ -n "$_have" ]; then
    echo "mux: scan roots for '$_key' are already set:"
    printf '%s\n' "$_have" | while read -r _p _d; do
      printf 'mux:   %s (depth %s)\n' "$_p" "$_d"
    done
    echo "mux: edit $MUX_DIR/partitions/$_key.partition to change them"
    exit 0
  fi
  _def=$HOME
  [ -d "$HOME/src" ] && _def=$HOME/src
  if [ -z "$_want" ]; then
    # WITHOUT A TERMINAL IT REFUSES rather than inferring consent, the same
    # call `mux setup claude` makes: a provisioner runs the installer on every
    # sweep, and inventing a location there is how one machine silently
    # indexes a tree the human never named.
    if [ ! -t 0 ] || [ ! -t 1 ]; then
      echo "mux: scan --init needs a terminal to ask, or a directory:" >&2
      echo "mux:   mux scan --init $_def" >&2
      exit 2
    fi
    printf 'mux: where do you keep your projects? [%s] ' "$_def"
    read -r _want || _want=
    [ -n "$_want" ] || _want=$_def
  fi
  case $_want in
  "~") _want=$HOME ;;
  "~/"*) _want=$HOME/${_want#\~/} ;;
  esac
  [ -d "$_want" ] || {
    echo "mux: not a directory: $_want" >&2; exit 2; }
  _pf=$MUX_DIR/partitions/$_key.partition
  mkdir -p "$MUX_DIR/partitions" || {
    echo "mux: cannot create $MUX_DIR/partitions" >&2; exit 1; }
  # APPENDED IF THE FILE EXISTS, never rewritten: a partition file may already
  # carry a label, a theme or a layout, and a bootstrap step that overwrote
  # somebody's config would be the one unrecoverable mistake available here.
  if [ ! -e "$_pf" ]; then
    {
      printf '# %s: written by `mux scan --init`.\n' "$_key"
      printf '#\n'
      printf '# `scan DIR [DEPTH]` is where `mux go <name>` looks for\n'
      printf '# projects. DEPTH is how many levels below DIR to descend;\n'
      printf '# raise it for a deeper tree, and add more `scan` lines for\n'
      printf '# more roots.\n'
    } >"$_pf" || { echo "mux: cannot write $_pf" >&2; exit 1; }
  fi
  printf 'scan\t%s 3\n' "$_want" >>"$_pf" || {
    echo "mux: cannot write $_pf" >&2; exit 1; }
  echo "mux: discovery on for '$_key': $_want (depth 3)"
  echo "mux: recorded in $_pf"
  echo "mux: now run:  mux scan"
  exit 0
  ;;
*) echo "usage: mux scan [--list] [--init [DIR]] [--roots]" >&2; exit 2 ;;
esac

_sf=$(mux_scan_file "$_key")
if [ ! -f "$_sf" ]; then
  echo "mux: no map at $_sf (run: mux scan)" >&2
  exit 1
fi
_n=$(cut -f1 "$_sf" | grep -c . || true)
printf 'mux: %s project(s) in %s\n' "$_n" "$_sf"
# Name collisions are worth surfacing here rather than at `mux go` time: two
# repos sharing a basename is a thing to resolve with an alias, once.
_dup=$(cut -f1 "$_sf" | LC_ALL=C sort | uniq -d)
if [ -n "$_dup" ]; then
  printf 'mux: ambiguous name(s); give one an alias with `mux new`:\n'
  printf '%s\n' "$_dup" | while IFS= read -r _d; do
    printf '  %s\n' "$_d"
    mux_scan_lookup "$_d" "$_key" | sed 's/^/      /'
  done
fi
