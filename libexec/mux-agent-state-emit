#!/bin/sh
# mux-agent-state-emit: record this agent's lifecycle state for the status bar.
# Invoked from Claude Code hooks with one argument, the new state. Writes a
# single line to a per-pane file under the runtime state dir and nudges tmux
# to redraw. Stays silent on stdout so the UserPromptSubmit hook never injects
# noise into the model context.
set -eu

# THE EXIT CODES FIRST, ABOVE ANYTHING THAT CAN EXIT. They used to be sourced
# below the argument loop, so every usage path here referenced an UNSET
# MUX_EC_USAGE: the message printed and the script then died on `set -u`.
# Linux hid it, because dash's own fatal-error status is 2 and so is
# MUX_EC_USAGE, which is the value the test asserts; macOS /bin/sh is bash and
# exits 1, which is what finally showed it. A coincidence that makes a test
# pass is worse than a failure.
_libexec=$(dirname "$0")
_lib=$_libexec/../lib
[ -r "$_lib/mux-exit_lib" ] \
  || { echo "mux: $_lib/mux-exit_lib missing" >&2; exit 1; }
# shellcheck source=/dev/null
. "$_lib/mux-exit_lib"

# STATE, plus an optional --beat. Parsed rather than taken as $1 so a
# hook can pass them in either order.
state= _beat= _src= _unless_working=
while [ $# -gt 0 ]; do
  case $1 in
    --beat) _beat=1 ;;
    # --unless-working: this state is an ASSERTION OF IGNORANCE, not an
    # observation. It means "an agent has just appeared here and knows of no
    # turn in progress", which is true at a startup, a resume or a clear,
    # and FALSE at a context COMPACTION, where the agent that just announced
    # itself is the same one, still mid-turn. See the table in
    # mux-agent-hook for which event carries it.
    --unless-working) _unless_working=1 ;;
    # --source NAME: which hook is speaking. OPTIONAL, and mux never
    # requires it: an integrator that does not pass one is not broken,
    # it is just quieter. THE CONTRACT IS MUX'S TO OWN: this defines the
    # shape of the answer now, so wiring it later is a plugin edit and not
    # a negotiation.
    #
    # WHY IT IS NEEDED. `Stop` and `SessionStart` BOTH send plain `idle`,
    # so a record that went idle mid-turn cannot be blamed on either. That
    # exact ambiguity is live: on 2026-09-27 a vigilance session on
    # northwood went idle 9 minutes into a 34-minute auto-mode turn and the
    # two candidates were indistinguishable from the record alone.
    --source) shift
      [ $# -gt 0 ] || {
        echo "mux-agent-state-emit: --source wants a name" >&2
        exit "$MUX_EC_USAGE"; }
      _src=$1 ;;
    -*) echo "mux-agent-state-emit: unknown option: $1" >&2
       exit "$MUX_EC_USAGE" ;;
    *)
      [ -z "$state" ] || {
        echo "mux-agent-state-emit: one STATE only" >&2; exit "$MUX_EC_USAGE"; }
      state=$1 ;;
  esac
  shift
done
[ -n "$state" ] || {
  echo "usage: mux-agent-state-emit STATE [--beat] [--unless-working]" \
    "[--source NAME]" >&2
  exit "$MUX_EC_USAGE"; }

# No tmux pane means nothing to track. Exit clean so the hook never fails.
[ -n "${TMUX_PANE:-}" ] || exit "$MUX_EC_OK"

. "$_lib/mux-agent-state_lib"
# NOT mux-notify_lib, and the absence is the point: this file raised banners
# until the desktop notifier took them over, and the source outlived the
# last call to it. A dead dependency on the hottest path mux has (this runs
# per agent tool call) costs a fork and a parse to define two functions
# nobody here calls.
# mux_log, for TRANSITIONS only: see the write below. A beat that merely
# refreshes an unchanged state is not a change and is not logged, or a busy
# session would fill the log with "still working" at tool-call rate.
. "$_lib/mux-log_lib"

# The state dir, namespaced by tmux socket so a work session and a personal one
# (separate tmux servers sharing this runtime dir), never collide on pane
# ids. Derived by mux_agent_dir rather than open-coded here: this file used to
# compute the namespace itself, with its own `default` fallback, which is a
# second place for the baseline partition's name to be written down and so a
# second place for it to go stale. The reader and the writer now take it from
# one function.
dir=$(mux_agent_dir)

mkdir -p "$dir"

# Key by pane id (for example %5). Strip the % for a clean filename.
key=${TMUX_PANE#%}
file=$dir/$key

# Read the previous record once (state session window pane epoch): its state
# gates the downgrade below and the notification, its epoch lets an unchanged
# state keep its start time.
_pstate= _pepoch= _pnotif=
if [ -f "$file" ]; then
  # Same field order as the write below: session LAST. Read in the
  # old order, _pnotif became the SESSION NAME, so the next
  # transition tried to close a notification whose id was `alpha`.
  read -r _pstate _pw _pp _pepoch _pnotif _ps \
    < "$file" 2>/dev/null || _pstate=
fi

# --beat: this caller is a HEARTBEAT, not a turn start. A beat says "still
# going", which is meaningless if the heart already stopped: it may refresh an
# existing `working` but must never resurrect one out of `idle`.
#
# `idle` means THE TURN ENDED. Only a turn-start event (UserPromptSubmit) may
# leave it. Without this, any event that fires after a turn finishes writes
# `working` as a fresh transition and nothing ever fires again to correct it:
# the session then shows a brain glyph forever while actually sitting at a
# prompt waiting for you. That is the signal mux exists to carry, inverted, and
# it is worse than the stale-idle direction because a busy-looking session is
# one you deliberately leave alone.
#
# A straggler arrives MINUTES after the turn ends (three, in the case this was
# built for), so no clock-based rule would catch it.
#
# Scoped deliberately to `idle` and nothing wider. A `blocked` -> `working`
# promotion is LEGITIMATE (you approved a permission prompt and the tool ran),
# and an absent record means the turn start was missed, where recording
# something beats recording nothing.
# A SINGLE trailing beat is a straggler; SUSTAINED beats are work, and both
# halves matter. Refusing every beat over `idle` leaves an agent continuing in
# AUTO MODE unable to ever create `working` again, because it starts a turn
# with no UserPromptSubmit, so the session reads DONE for the whole run and
# only a human typing recovers it.
#
# The two are distinguishable without guessing at clocks: a straggler is ONE
# event after the turn ended and then silence, where an agent actually working
# keeps calling tools. So a beat over `idle` does not promote on its own, it
# leaves a mark, and a SECOND beat within the window corroborates it.
#
# The mark is a sidecar, not a new record field: the record's format is read by
# a single `read -r` in several programs and widening it has already cost this
# codebase a day (see the session-name field move).
#
# WHAT THIS STILL DOES NOT COVER, said plainly: a turn that makes no tool calls
# at all. The 34-minute case above was one long model call, so there were no
# beats to corroborate and the record stayed idle until the first tool ran.
# mux can only know what the agent tells it, and in auto mode tool calls are
# the only thing it says.
_beatf=$file.beat
_BEAT_WINDOW=${MUX_AGENT_BEAT_WINDOW:-300}
if [ -n "$_beat" ] && [ "$_pstate" = idle ]; then
  _bnow=$(date +%s 2>/dev/null || echo 0)
  _bfirst=
  [ -f "$_beatf" ] && read -r _bfirst 2>/dev/null <"$_beatf"
  case ${_bfirst:-} in
    ''|*[!0-9]*) _bfirst= ;;
  esac
  # The no-mark case is handled FIRST and on its own, rather than folded
  # into the window test below. Folded, it was redundant: an absent mark
  # reads as 0 in the arithmetic, so the age comes out enormous and the
  # window test already rejects it, which made the guard impossible to
  # kill, the corpus said so, and belt-and-braces that measures as
  # untestable is the shape this codebase deletes rather than defends.
  if [ -z "$_bfirst" ]; then
    printf '%s\n' "$_bnow" 2>/dev/null >"$_beatf" || true
    exit "$MUX_EC_OK"
  fi
  if [ "$((_bnow - _bfirst))" -le "$_BEAT_WINDOW" ] \
     && [ "$_bnow" -ge "$_bfirst" ]; then
    # Corroborated: fall through and write `working`.
    rm -f "$_beatf" 2>/dev/null || true
    mux_log agent \
      "beat corroborated: ${_ps:-?} back to working" \
      "${_src:+(}${_src:-}${_src:+)}"
  else
    # The window lapsed. Two beats this far apart are two
    # stragglers, not sustained work: restart the clock.
    printf '%s\n' "$_bnow" 2>/dev/null >"$_beatf" || true
    exit "$MUX_EC_OK"
  fi
fi

# A SESSION START MAY NOT CONTRADICT AN OBSERVED TURN, because a CONTEXT
# COMPACTION fires SessionStart MID-TURN: the history is summarised and the
# session announces itself again while the same agent is still working.
# Measured against this box's logs, four of four compact boundaries produced a
# `working -> idle` in the same second, in two sessions.
#
# THE COST IS THE WHOLE SIGNAL: a busy agent reads `done` on the strip and in
# the tray, `mux agent wait` tells an orchestrator the turn is over mid-turn,
# and a "Claude finished" banner fires for a turn that has not. The straggler
# guard above cannot recover it either, since two beats rarely land inside the
# window before the human gives up and types.
#
# WHY A FLAG AND NOT THE SOURCE. `--source` is a BREADCRUMB: mux never
# requires it and an integrator that omits one is not broken, so a rule keyed
# on it would silently protect only the callers that happened to be chatty.
# The flag comes from the table in mux-agent-hook, which is the single place
# that says what an event MEANS.
#
# SCOPED TO `working` AND NOTHING WIDER. `blocked` is left alone on purpose:
# an agent waiting at a permission prompt is not processing, so a compaction
# cannot fire over it, and clearing a leftover prompt-block when a genuinely
# new agent starts in that pane is the right answer.
#
# WHAT IT COSTS, said plainly: a pane whose previous agent died mid-turn keeps
# its stale `working` until the first real event instead of being cleared by
# the new agent's start. That window is bounded by the human's first prompt (
# they just started an agent), and `mux agent-doctor --repair` exists for the
# unbounded version. The measured bug is guaranteed on every compaction; this
# one needs an agent to die mid-turn first.
if [ -n "$_unless_working" ] && [ "$_pstate" = working ]; then
  mux_log agent "${_ps:-?} kept working; $state refused" \
    "${_src:+via }${_src:-}"
  exit "$MUX_EC_OK"
fi

# Claude Code fires Notification for TWO things: a permission prompt (mid-work),
# and the "waiting for your input" nudge a few seconds after a turn ends. Both
# arrive here as `blocked`. A permission prompt only happens while working, so a
# `blocked` that lands while the agent is already idle is the waiting nudge:
# keep it idle, so a finished turn stays a check (done), not a bell (needs you).
if [ "$state" = blocked ] && [ "$_pstate" = idle ]; then
  state=idle
fi

# The epoch marks when the CURRENT state BEGAN. Keep it across same-state
# re-emits (one turn can fire `working` repeatedly) and stamp fresh only on a
# real change, so a duration reads "time in THIS state", not "since last hook".
if [ "$state" = "$_pstate" ] && [ -n "$_pepoch" ]; then
  epoch=$_pepoch
else
  epoch=$(date +%s)
fi

# Resolve session and window once, at emit time, so the renderer never has
# to call back into tmux per entry. If tmux is gone, degrade gracefully.
# Window FIRST, session LAST, because a session name may contain spaces and a
# window index never can. Asking for them the other way round (as this did)
# made `#{session_name} #{window_index}` unsplittable for a session called
# `my project`, and every field after it shifted.
loc=$(tmux display-message -p -t "$TMUX_PANE" \
  '#{window_index} #{session_name}' 2>/dev/null || true)
[ -n "$loc" ] || loc="? ?"
_win=${loc%% *}
_sess=${loc#* }

# THE NOTIFICATION ID IS GONE, and the field it lived in is not.
#
# mux raises no banners: `mux-desktop-notifier` does, from the stream, and it
# holds its own ids on the box the human is at. So there is nothing here to
# carry across a re-emit, nothing to age out and nothing to close.
#
# THE FIELD STAYS AS A PERMANENT `-`: the record is six fields read by a
# single `read -r` in several programs, so a dead field costs one byte where a
# format change costs every reader.
notif=-

# RAISING IS THE DESKTOP NOTIFIER'S. The gate (a real transition out of
# `working`, not into the pane you are looking at, `@mux-notify-always`,
# `@mux-attention`) lives in `mux agent stream`, which runs beside this tmux
# server and can ask tmux
# exactly the same questions. Nothing was dropped: the rules moved, they did
# not change.
#
# WHY IT COULD NOT STAY. A hook raises the banner on the box the AGENT runs
# on, which is the one machine that may well have nobody sitting at it: every
# blocked LATCHED session has been popping a toast on a remote desktop for as
# long as latch has existed. That is structural rather than a bug in the
# notification path, and it is not fixable from here, because a hook has no
# way to reach the box the human is at. A stream does.
#
# ONE OWNER, SO THERE IS NOTHING TO DRIFT. Keeping a raise here for the local
# case and delegating the remote one would be two notification paths free to
# disagree about wording, urgency and when to fire. A box running no notifier
# therefore gets no banners, which `mux check` says rather than leaving you to
# notice, and which is the same call the tray already makes about an
# unattached partition.
#
# AND THE CLOSE PATHS WENT TOO, which an earlier version of this comment
# said they had not. They were kept for one release on the argument that a
# record written by an OLDER mux carries a real id only this file knows how
# to withdraw; what retired them is not cost but DETECTABILITY, since
# nothing can say when the last pre-upgrade record has been rewritten, so
# the shim had no expiry anybody could act on. The one-time price is at most
# one stranded banner per session, bounded because the urgency was always
# `normal` and so self-expires, a choice made years earlier for an unrelated
# reason.

# Fields: state session window pane epoch notif-id. Space separated, one line.
#
# Written through a temp and MOVED, so a reader never sees a half-written
# record. Several hooks can fire close together (a tool finishing while a
# turn ends), and a plain redirect truncates before it writes, so a render
# landing in that gap reads an empty or partial line and reports a session as
# having no agent at all. rename(2) is atomic within a directory, so a reader
# sees either the old record or the new one.
#
# This does NOT order the writers: if Stop lands after PostToolUse, idle wins,
# which is the shape of the stale-idle bug. Atomicity keeps the record intact;
# ordering is the hooks' to decide.
# Fields: state window pane epoch notif SESSION: the session LAST so a name
# containing spaces is read back whole as "the rest of the line". A session
# called `my project` previously produced a record nothing could parse: it got
# no agent chip at all, and a session actually named `my` picked up its state.
#
# notif is `-` when absent, never empty. An empty field collapses in the
# whitespace run and shifts everything after it, which would reintroduce the
# same bug from the other end.
# A REAL TRANSITION CLEARS THE BEAT MARK. The mark only means "one unexplained
# beat landed on an idle record"; once the state moves for any reason the
# question it was asking is answered, and a stale mark would let a much later
# straggler find corroboration it never earned.
[ "$state" = "${_pstate:-}" ] || rm -f "$_beatf" 2>/dev/null || true

# THE TRANSITION IS THE LOG LINE, never the refresh. A beat landing on an
# unchanged `working` is the common case and says nothing new; logging it would
# fill the file at tool-call rate. `--source` is included when the caller named
# itself, which is the whole point of accepting it: `Stop` and `SessionStart`
# both write plain `idle`, and only the caller can say which one did.
if [ "$state" != "${_pstate:-}" ]; then
  mux_log agent \
    "${_sess:-?} ${_pstate:--} -> $state" \
    "${_src:+via }${_src:-}"
fi

_tmp=$file.$$
printf '%s %s %s %s %s %s\n' \
  "$state" "$_win" "$TMUX_PANE" "$epoch" "${notif:--}" "$_sess" \
  >"$_tmp" && mv -f "$_tmp" "$file" || rm -f "$_tmp"

# --- the HUMMING sidecar: did this turn leave work behind? -----------------
# THE CHECK HAPPENS ONCE, HERE, at the moment the state turns green, and never
# again. That is the whole reason it can afford to walk /proc: a per-render
# check on the status bar would cost a scan per client every status-interval,
# and there is nothing to poll afterwards because the agents already wait() for
# us. When the job finishes the sidecar's pids simply stop being alive, which
# the READER notices for free.
#
# AFTER the record, deliberately, for the reason `mux themes load` prunes after
# writing its stamp: a failed scan must never cost the turn its state.
#
# ONLY ON `idle`, and the other arm is as load-bearing: any other state CLEARS
# the sidecar, so a pane that goes back to `working` cannot carry a stale set
# of pids into its next turn.
#
# THE ROOT IS ASKED FOR SEPARATELY rather than added to the location probe
# above, and that is worth one fork: widening a space-joined answer whose LAST
# field is a session name (which may contain spaces) is the change that has
# already cost this package a day. This runs only on the green transition.
_humf=$file.hum
if [ "$state" = idle ]; then
  _hpp=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_pid}' \
    2>/dev/null || true)
  _htmp=$_humf.$$
  if mux_agent_hum_scan "$_hpp" "$$" 2>/dev/null >"$_htmp" \
    && [ -s "$_htmp" ]; then
    mv -f "$_htmp" "$_humf" 2>/dev/null || rm -f "$_htmp" 2>/dev/null || true
  else
    rm -f "$_htmp" "$_humf" 2>/dev/null || true
  fi
else
  rm -f "$_humf" 2>/dev/null || true
fi

# An opt-in breadcrumb: with MUX_EMIT_LOG set, every transition is appended, so
# a state that gets stuck can be traced to the hook that last wrote it, or to
# the hook that never fired. The hooks send stderr to /dev/null and end in
# `|| true` (a failing hook must never break the agent), which is correct and
# also means a silently broken emit looks exactly like a working one.
#
# Capped rather than rotated: this is switched on deliberately to catch
# something, and an unbounded file left on by accident is its own bug.
if [ -n "${MUX_EMIT_LOG:-}" ]; then
  {
    if [ -f "$MUX_EMIT_LOG" ] \
       && [ "$(wc -c 2>/dev/null <"$MUX_EMIT_LOG" || echo 0)" \
      -gt 262144 ]; then
      : >"$MUX_EMIT_LOG"
    fi
    printf '%s %s %s %s was=%s\n' \
      "$(date +%s)" "$state" "$_sess" "$TMUX_PANE" \
      "${_pstate:-none}" >>"$MUX_EMIT_LOG"
  } 2>/dev/null || true
fi

# Instant redraw for clients on this server. Interval polling is the
# cross server backstop, so a failure here is not fatal.
tmux refresh-client -S 2>/dev/null || true

exit "$MUX_EC_OK"
