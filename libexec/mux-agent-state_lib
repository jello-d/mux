#!/bin/sh
# mux-agent-state_lib - shared reader for per-pane agent state (see
# mux-agent-state-emit). Sourced by mux-agent-state-render (the status strip)
# AND by the
# mux front end (the session picker and `mux ls`), so the state ranking and the
# state GLYPHS live in ONE place, so the bar and the picker cannot drift apart.
# Functions and glyph constants only; source it, do not run it.
#
# State lives in per-pane files under $XDG_RUNTIME_DIR/mux/agent-state/<ns>, a
# each: "state window pane epoch notif SESSION" (see mux-agent-state-emit). The
# session comes LAST so a name containing a space reads back whole in one
# `read`; this comment said the old order long after the code changed, which is
# the same asserted-vs-actual drift that let a notification overwrite the
# session name with the window index. The namespace <ns> is the tmux socket
# basename, so a work bar never shows personal agents and vice versa.

# Width-2 glyphs, so a caller that aligns columns (the strip) holds line. This
# is the single source of the state->glyph mapping; the strip's colour STYLES
# stay in mux-agent-state-render, which owns the bar's look.
MUX_GLYPH_BLOCKED='⚠️' ; MUX_GLYPH_WORKING='🧠' ; MUX_GLYPH_IDLE='✅'
MUX_GLYPH_NONE='⚫'    ; MUX_GLYPH_UNKNOWN='❓'
# UNWIRED: mux STARTED an agent in this session and has never heard from it.
# A PLUG, not a question mark, because the answer is not unknown: it is that
# nothing is connected. `❓` already means something else and rarer (a state
# word this mux cannot draw, which only a newer mux across a transport
# produces), and conflating the common actionable case with the exotic one
# would waste the only glyph a newcomer will ever need to look up.
#
# THIS IS THE FIRST-RUN FAILURE. Install mux, start a session, and every chip
# reads `⚫`, which is also what a plain shell looks like, so nothing says
# the hooks were never wired and the reasonable conclusion is that mux does not
# work. It is not a state an agent can emit and never appears in a record.
MUX_GLYPH_UNWIRED='🔌'

# A literal newline, as a constant: the one delimiter a session name cannot
# contain, so it is what separates a set of them.
MUX_AGENT_NL='
'

# mux_agent_dir [NS] -> the namespaced state directory. NS is $1 if given, else
# the current tmux socket basename (from $TMUX), else 'default'. Callers outside
# tmux (the picker on a bare shell) pass the socket they resolved.
mux_agent_dir() {
  _rt=${XDG_RUNTIME_DIR:-/tmp/user-$(id -u)}
  _ns=${1:-}
  if [ -z "$_ns" ]; then
    # `global` is the baseline PARTITION. It used to be `default`,
    # the old tmux socket basename, which stopped existing when the
    # personal partition took a name: a stale default that made
    # every headless reader silently see nothing. Callers inside
    # tmux still get theirs from $TMUX.
    _ns=global
    [ -n "${TMUX:-}" ] && { _ns=${TMUX%%,*}; _ns=${_ns##*/}; }
  fi
  # NAMESPACED UNDER `mux/`, per the fleet install-placement rule (ruled
  # 2026-10-01). It used to sit at `$XDG_RUNTIME_DIR/agent-state`, directly
  # beside `at-spi`, `bus`, `dbus-1`, `dconf`, `doc` and `gcr`, under a
  # GENERIC name any other agent tool could claim. Every other location mux
  # owns was already namespaced; this was the one that was not.
  _ad=$_rt/mux/agent-state/$_ns

  # THIS FUNCTION DERIVES A PATH AND TOUCHES NOTHING. It briefly adopted the
  # old directory from here, and that was wrong twice over; the adoption
  # lives in `setup.sh` now (`_adopt_runtime_state`), which is the only moment
  # that is atomic with the writer switching over. Do not put it back:
  #
  # A READER THAT MIGRATES TAKES A SNAPSHOT. Eleven of this function's twelve
  # callers are read-only, so the FIRST of them to run copied the old
  # directory, the still-deployed old writer carried on updating the original
  # for another 32 minutes, and when the install finally moved the writer over
  # the frozen copy became authoritative. Measured on northgate the day it
  # shipped: a session reading `working` with an epoch 51 minutes stale, every
  # beat refreshing it, and NO transition ever logged, because there was
  # nothing left to transition from. That is the inversion this package calls
  # worse than a stale idle, since a session that looks busy is one you
  # deliberately leave alone.
  #
  # AND A COPY CANNOT BE JUDGED AFTERWARDS: a beat refreshes mtime without
  # advancing the epoch, so the snapshot had the NEWER mtime and the staler
  # content, and no timestamp rule can tell the two apart.
  printf '%s' "$_ad"
}

# Numeric urgency of a state, so the worst live agent in a session wins.
mux_agent_rank() {
  case $1 in
  blocked) echo 3 ;;
  working) echo 2 ;;
  idle)    echo 1 ;;
  *)       echo 0 ;;
  esac
}

# mux_agent_state DIR SESSION -> "STATE EPOCH": the most-urgent live agent state
# for SESSION (blocked > working > idle) and the epoch that state began, or a
# lone space when the session has no tracked agent. A session may hold several
# agent panes; the worst one wins (and carries its epoch), so nothing is hidden.
mux_agent_state() {
  mux_agent_state_skip "$1" "$2" ""
}

# mux_agent_state_skip DIR SESSION SKIP -> the same answer, ignoring any record
# whose PANE appears in SKIP (a space-separated list of pane ids).
#
# WHY THE EXCLUSION IS A PARAMETER AND NOT A RULE IN HERE: the panes a caller
# wants to ignore are the ones whose `@mux-attention` is not the human's, and
# that is a tmux OPTION. This lib reads FILES and makes no tmux calls at all,
# which is what lets `mux agent-summary` answer headless with no server
# anywhere. So the caller asks tmux (in a query it is already making) and
# passes the answer down.
#
# AND IT MUST NOT BE THE DEFAULT, which is the 0.60 `--attached` call again:
# the HUMAN surfaces filter (the strip, the notification path,
# `next-blocked`), and the MACHINE surface does not, because a supervisor
# polling `mux agent peers` specifically wants to see its own workers. A
# filter in the shared enumerator would delete that promise for every caller
# at once.
#
# TWO ENTRY POINTS, ONE WALK, ONE RANKING. `mux_agent_state` is a wrapper
# rather than this function gaining an optional third argument, because the
# two shellcheck versions this tree meets (0.9.0 on ubuntu-latest, which is
# what CI runs, and 0.11 here) disagree about a function that references an
# argument some callers omit. Both of these are always called with their full
# arity, so neither rule set has anything to say.
#
# AND THAT PARAGRAPH COST A RED SUITE: a comment whose FIRST WORD is
# `shellcheck` is read as a DIRECTIVE, so the sentence above used to fail to
# parse (SC1073) and took the whole file's linting with it.
mux_agent_state_skip() {
  _mux_agent_walk "$1" "$2" "$3" ""
  printf '%s %s' "$_best" "$_bestep"
}

# mux_agent_state_win DIR SESSION WINDOW -> the same answer for ONE window of
# that session. `mux agent peers` reports per window, because a worker is a
# WINDOW in the session it serves: collapsing a session to its worst agent
# cannot say whether THIS worker is live, which vicus tried and rejected for
# exactly that reason.
mux_agent_state_win() {
  _mux_agent_walk "$1" "$2" "" "$3"
  printf '%s %s' "$_best" "$_bestep"
}

# mux_agent_pane DIR SESSION -> the pane id of the record that SPEAKS for that
# session, or empty. The same walk and the same ranking: a session with
# several agent panes reports its worst, and this is the pane that worst state
# came from, which is the one a caller wanting to READ it means.
mux_agent_pane() {      # <dir> <session>
  _mux_agent_walk "$1" "$2" "" ""
  printf '%s' "$_bestpane"
}

# mux_agent_pane_win DIR SESSION WINDOW -> the pane that speaks for ONE
# window, the counterpart of mux_agent_state_win. `peers` needs it to look up
# that window's control class, and it is an entry point rather than a reach
# into the walk for the reason the walk's own comment gives: a caller choosing
# which fields to parse is what went wrong the first time.
mux_agent_pane_win() {  # <dir> <session> <window>
  _mux_agent_walk "$1" "$2" "" "$3"
  printf '%s' "$_bestpane"
}

# _mux_agent_walk DIR SESSION SKIP WINDOW -> the worst live record matching
# SESSION, leaving its state in $_best, its epoch in $_bestep and its pane in
# $_bestpane. SKIP is a space-separated pane list to ignore; WINDOW, when
# non-empty, restricts the walk to one window index. Both empty is the plain
# question.
#
# ONE WALK, FOUR ENTRY POINTS, and that is a correction rather than the
# original design. This file used to carry the walk TWICE, once for the state
# and once for the pane, with a comment explaining that the duplication was
# forced: appending a field to `mux_agent_state`'s answer would silently turn
# the epoch into "EPOCH PANE" for the seven callers parsing it as
# `${_se%% *}` and `${_se#* }`. That reasoning was right about the ANSWER and
# wrong about the implementation: the fix is for the walk to leave its result
# in variables and for each entry point to print only what it owes. The
# published shapes are byte-identical; the second copy is gone.
#
# A LEADING FUNCTION NAME WITH `_`, because this one is internal: the four
# above are the surface, and a caller reaching past them would be choosing
# which fields to parse, which is the thing that went wrong before.
_mux_agent_walk() {
  _awdir=$1 _awsess=$2 _awskip=$3 _awwin=$4
  _best= _bestep= _bestpane= _br=-1
  [ -d "$_awdir" ] || return 0
  for _f in "$_awdir"/*; do
    [ -e "$_f" ] || continue
    # session LAST: it may contain spaces, so it takes the rest.
    read -r _st _w _p _e _nid _ss <"$_f" || continue
    [ "$_ss" = "$_awsess" ] || continue
    case " $_awskip " in *" $_p "*) continue ;; esac
    [ -z "$_awwin" ] || [ "$_w" = "$_awwin" ] || continue
    _r=$(mux_agent_rank "$_st")
    # AN `if`, NOT AN `&&` LIST, AND THAT IS NOT STYLE. This loop is the LAST
    # command in the function, so with `&&` the function's exit status is the
    # comparison's: a final record that does NOT win leaves it non-zero, and
    # the four entry points call this as a bare command, so `set -e` in a
    # caller kills the shell before the `printf` that answers. Inside `$( )`
    # that is silent: the substitution simply comes back EMPTY and the session
    # reads as having no agent.
    #
    # MEASURED, by doing it: the unified walk shipped with `&&` and
    # `mux-agent-rank.t` went red on `blocked should beat idle` with the walk
    # having computed `blocked` perfectly. It is the same defect this package
    # fixed in `mux_env_plan` and `mux_env_apply` hours earlier, which is the
    # argument for the idiom rather than the vigilance.
    if [ "$_r" -gt "$_br" ]; then
      _br=$_r; _best=$_st; _bestep=$_e; _bestpane=$_p
    fi
  done
}

# mux_agent_windows DIR SESSION -> the distinct WINDOW indexes that session has
# a record in, one per line, lowest first. The enumerator `peers` needs to
# report per window, and the counterpart of mux_agent_sessions.
mux_agent_windows() {   # <dir> <session>
  [ -d "$1" ] || return 0
  _awsd=$1 _awss=$2
  for _f in "$_awsd"/*; do
    [ -e "$_f" ] || continue
    read -r _st _w _p _e _nid _ss <"$_f" || continue
    [ "$_ss" = "$_awss" ] || continue
    printf '%s\n' "$_w"
  done | LC_ALL=C sort -n -u
}

# mux_agent_sessions DIR -> the distinct sessions with a tracked agent, ONE PER
# LINE. Newline separated because a session name may contain a space but never a
# newline (tmux escapes one in its -F output), so joining with spaces would let
# `my project` dedup against its own words and then be counted twice, as `my`
# and `project`.
#
# Centralised because it was already written twice (in
# mux-agent-state-summary and
# in mux-agent-doctor), and a third copy was about to be written for
# mux-agent-state-list. Every copy has to independently remember that the
# session is
# the LAST field.
mux_agent_sessions() {  # DIR
  _asd=$1
  [ -d "$_asd" ] || return 0
  _seen=
  for _f in "$_asd"/*; do
    [ -e "$_f" ] || continue
    # 2>/dev/null BEFORE the redirect: a file pruned between the glob
    # and the read fails the OPEN while stderr is still the terminal.
    read -r _st _w _p _e _nid _ss 2>/dev/null <"$_f" || continue
    [ -n "${_ss:-}" ] || continue
    case "$MUX_AGENT_NL$_seen$MUX_AGENT_NL" in
    *"$MUX_AGENT_NL$_ss$MUX_AGENT_NL"*) continue ;;
    esac
    _seen="$_seen$MUX_AGENT_NL$_ss"
    printf '%s\n' "$_ss"
  done
}

# mux_agent_glyph STATE -> the width-2 glyph for a state word ('' -> none).
mux_agent_glyph() {
  case $1 in
  blocked) printf '%s' "$MUX_GLYPH_BLOCKED" ;;
  working) printf '%s' "$MUX_GLYPH_WORKING" ;;
  idle)    printf '%s' "$MUX_GLYPH_IDLE" ;;
  '')      printf '%s' "$MUX_GLYPH_NONE" ;;
  unwired) printf '%s' "$MUX_GLYPH_UNWIRED" ;;
  *)       printf '%s' "$MUX_GLYPH_UNKNOWN" ;;
  esac
}

# mux_agent_state_glyph DIR SESSION -> just the state glyph for SESSION, for
# callers that want the glyph and not the epoch (the picker and `mux ls`).
mux_agent_state_glyph() {
  _sg=$(mux_agent_state "$1" "$2")
  mux_agent_glyph "${_sg%% *}"
}
