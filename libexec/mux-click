#!/bin/sh
# mux-click - switch a tmux client to the session encoded in a clicked status
# range tag. mux-agent-state-render wraps each session chip in
# #[range=user|s:NAME],
# so tmux's MouseDown1Status binding hands us that tag; strip the s: marker and
# switch. A tag naming no live session (e.g. a name tmux truncated past its
# 15-char range cap) is a silent no-op: a mis-click never lands elsewhere. A
# hidden session has no chip, hence no range, hence nothing to click.
set -eu


_libexec=$(dirname "$0")
_lib=$_libexec/../lib
[ -r "$_lib/mux-exit_lib" ] \
  || { echo "mux: $_lib/mux-exit_lib missing" >&2; exit 1; }
# shellcheck source=/dev/null
. "$_lib/mux-exit_lib"
range=${1:-}
client=${2:-}

# v: is the VIEW-TENSION chip, not a session. Clicking it cycles how the tension
# is resolved (auto -> floor -> ceil), so the condition is both noticed and
# settled on the bar without looking up a verb.
case "$range" in
  v:*)
    exec "$(dirname "$0")/mux-views" next ;;
esac

case "$range" in s:?*) ;; *) exit "$MUX_EC_OK" ;; esac
sess=${range#s:}

if [ -n "$client" ]; then
  tmux switch-client -c "$client" -t "=$sess" 2>/dev/null || true
else
  tmux switch-client -t "=$sess" 2>/dev/null || true
fi
