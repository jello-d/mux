#!/bin/sh
# mux-help: ALL of mux's help. The four topics
# (`mux help [agents|themes|profiles|palette]`), the usage summary, and the
# two list helpers they share.
#
# EXTRACTED FROM bin/mux (2026-10-05), 450 lines of a 3,554-line entry point,
# and separable because every one of these functions only PRINTS. They read
# shipped and overlay data through mux-data_lib and the profile table through
# mux-profiles_lib, and they resolve nothing else.
#
# THE TOPICS CAME FIRST AND usage FOLLOWED THE SAME DAY, and what stayed in
# bin/mux is a one-line shim: `usage() { exec ... --usage "${1:-2}"; }`. Its
# twenty-two callers are the error paths of the argument parser, each with its
# own exit code, and they are unchanged: an exec never returns, which is what
# `usage; }` already relied on. The first attempt put the exec at all
# twenty-two sites instead, which traded duplicated TEXT for a duplicated
# PATH and went over 80 columns in eleven places.
#
# NO TOPIC IS USAGE, so bin/mux execs here for the whole `help` verb and the
# topic VOCABULARY lives beside the topics. `--usage` is spelled as a FLAG
# rather than a topic so `mux help usage` stays a refusal instead of becoming
# a second spelling of `mux --help`; test/mux-verbs.t pins that, and pins the
# two forms being byte-identical, because they are two dispatch arms over one
# function now rather than one call.
#
# SO THE ONE THING IT NEEDS FROM A RESOLVED CONTEXT is the caller's own
# partition, which `help_profiles` and `usage` use to show the layouts for
# this side. About 5ms, which is what a fresh process can afford for a
# human-speed verb and what a status bar must not pay. bin/mux had a lazy
# `_ensure_side`/`_cur_part` pair for it, and that is GONE rather than moved:
# it existed only because usage() ran before that file's socket block, and
# here there is no such ordering to dodge.
set -eu

_libexec=$(dirname "$0")
_lib=$_libexec/../lib
[ -r "$_lib/mux-exit_lib" ] \
  || { echo "mux: $_lib/mux-exit_lib missing" >&2; exit 1; }
# shellcheck source=/dev/null
. "$_lib/mux-exit_lib"
[ -d "${MUX_SHARE:-}" ] || MUX_SHARE=$_lib/../share
MUX_DIR=${MUX_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/mux}
export MUX_DIR MUX_SHARE

# mux-conf_lib FIRST: mux-context_lib reads $MUX_DIR/config through
# mux_conf_clean, and says so in its own header.
. "$_lib/mux-conf_lib"
. "$_lib/mux-paths_lib"
. "$_lib/mux-data_lib"
. "$_lib/mux-context_lib"
. "$_lib/mux-profiles_lib"

# `mux_ctx_resolve` DIRECTLY, not `mux_ctx_mine`, and shellcheck is what
# caught the difference: `help_colors` reads MUX_CFG_theme and
# MUX_CFG_derive, and mux_ctx_mine runs the resolve inside a COMMAND
# SUBSTITUTION, so every MUX_CFG_* it sets dies with the subshell. That is
# the trap written into mux_ctx_mine's own header this same week, made anyway
# by the person who wrote it down.
#
# AND MY DIFFERENTIAL PASSED VACUOUSLY OVER IT. `mux help themes` was
# byte-identical before and after, because this box configures no explicit
# theme: an UNSET variable and an empty one print the same thing. A box with
# a theme in its partition file would have differed. SC2154 saw what the
# comparison could not.
mux_ctx_resolve 2>/dev/null || :
_cur_part=${MUX_CTX_PARTITION:-}

# A proper verb. Bare (and the -h/--help flags) prints the plain usage; `colors`
# renders each theme in its OWN palette so you see it; `layouts` diagrams each
# session shape in ASCII. All read-only file work: runs here, before any git
# or socket touch.
# Colour only when stdout is a terminal; an empty _RST doubles as the "no
# colour" flag for _sgr_* below, so `mux help colors | less` stays plain text.
if [ -t 1 ]; then _RST=$(printf '\033[0m'); else _RST=; fi

# ANSI SGR for one tmux colour spec (colourN or #rrggbb), as fg(38) or bg(48).
# Colour spec -> SGR parameter fragment. A "0x" or "#" prefix means TRUECOLOR
# (rrggbb -> R;G;B); anything else is a 256-palette index (a bare number, or
# colourN). <role> is 38 (fg) or 48 (bg). Empty on an unrecognised spec.
_sgr_frag() {           # <spec> <38|48>
  case $1 in
  '#'*|0x*)
    _h=${1#\#}; _h=${_h#0x}
    case $_h in ??????) ;; *) return 0 ;; esac   # need 6 hex digits
    _r=${_h%????}; _gb=${_h#??}; _g=${_gb%??}; _b=${_h#????}
    printf '%s;2;%d;%d;%d' "$2" \
      "$((0x$_r))" "$((0x$_g))" "$((0x$_b))" ;;
  colour[0-9]*) printf '%s;5;%s' "$2" "${1#colour}" ;;
  [0-9]*)       printf '%s;5;%s' "$2" "$1" ;;
  esac
}
# Full SGR escape for a colour spec (empty when not a tty or spec unrecognised).
_sgr_color() {          # <spec> <38|48>
  [ -n "$_RST" ] || return 0
  _f=$(_sgr_frag "$1" "$2"); [ -n "$_f" ] && printf '\033[%sm' "$_f"
}
# ANSI SGR for a tmux style string ("bg=X fg=Y bold"): fg, then bg, then bold.
_sgr_style() {          # <style>
  [ -n "$_RST" ] || return 0
  for _t in $1; do
    case $_t in
    fg=*) _sgr_color "${_t#fg=}" 38 ;;
    bg=*) _sgr_color "${_t#bg=}" 48 ;;
    bold) printf '\033[1m' ;;
    esac
  done
}
help_colors() {
  echo 'themes (`mux theme NAME`, or a `theme` line in a profile):'
  echo
  mux_data_files themes .theme | while IFS= read -r _f; do
    _n=${_f##*/}; _n=${_n%.theme}
    _cf=$(mktemp); mux_conf_clean < "$_f" > "$_cf"
    _bar=$(awk '$1=="bar"{sub(/^bar[ \t]+/,"");print;exit}' "$_cf")
    _win=$(awk \
        '$1=="window"{sub(/^window[ \t]+/,"");print;exit}' "$_cf")
    _acc=$(awk \
        '$1=="accent"{sub(/^accent[ \t]+/,"");print;exit}' "$_cf")
    _sel=$(awk \
        '$1=="select"{sub(/^select[ \t]+/,"");print;exit}' "$_cf")
    rm -f "$_cf"
    # select falls back to the window chip (as mux-style does);
    # accent is fg-only, so show it as a solid bg swatch.
    [ -n "$_sel" ] || _sel=$_win
    # Split the bar into its bg/fg tokens so they print in fixed
    # columns (bg=colour166 is the widest at 12), not a ragged
    # trailing string where fg never lines up.
    _bg= _fg=
    for _t in $_bar; do
      case $_t in bg=*) _bg=$_t ;; fg=*) _fg=$_t ;; esac
    done
    printf '  %-11s %s bar %s %s active %s %s   %s' \
      "$_n" \
      "$(_sgr_style "$_bar")" "$_RST" \
      "$(_sgr_style "$_win")" "$_RST" \
      "$(_sgr_color "${_acc#fg=}" 48)" "$_RST"
    printf ' %s sel %s   %-12s %s\n' \
      "$(_sgr_style "$_sel")" "$_RST" "$_bg" "$_fg"
  done
  # The resolved default for THIS context: a hashed theme when `derive
  # hash` is in force, else the context's own `theme`.
  if [ "${MUX_CFG_derive:-hash}" = hash ]; then
    printf '\n  unset themes:   hashed from the session name\n'
  else
    # GUARDED, like ${MUX_CFG_derive:-hash} one line above, which the
    # original was not: bin/mux pre-assigns every MUX_CFG_* in its
    # missing-lib fallback, so an unguarded read was safe THERE and is a
    # `set -u` fatal here. SC2154 is what asked the question.
    printf '\n  default theme:  %s\n' "${MUX_CFG_theme:-}"
  fi
}
# Flatten a profile for display: its own directives, then the window/pane/
# bottom lines of the layout it names. Takes a NAME, not a path, so a row and a
# breakout file both reach it. Display-only, so a pipe is fine (no
# exit-on-error to preserve) and an unresolvable layout just shows nothing.
_flat_profile() {       # <name>
  _pf=$(mux_prof_find "$1")
  if [ -n "$_pf" ]; then
    _wl=$(mux_conf_clean < "$_pf" \
      | awk '$1=="layout"{print $2; exit}')
    mux_conf_clean < "$_pf" | grep -v '^layout[[:space:]]' || true
  else
    _wl=$(mux_prof_get "$1" layout)
    mux_prof_directives "$1" | grep -v '^layout ' || true
  fi
  _lf=$(mux_data_find layouts "${_wl:-default}" .layout)
  [ -n "$_lf" ] && mux_conf_clean < "$_lf"
  return 0
}
# Draw the window/pane/bottom directives (on stdin) as ASCII boxes: top panes
# side by side, a full-width bottom strip below when present; one per window.
_draw_layout() {
  awk '
  function rep(c,n,  s){s="";while(n-->0)s=s c;return s}
  function cell(s,w){return sprintf(" %-" (w-1) "s", substr(s,1,w-1))}
  # l + (dashes j)*(N-1) + dashes r : a border row with pane junctions.
  function edge(l,j,r,  i,s){
    s=l
    for(i=1;i<=np;i++)s=s rep("─",cw) (i<np?j:r)
    return s
  }
  function flush(  i,m,fw){
    if(np==0)return
    print "    " edge("┌","┬","┐")
    m="    │"; for(i=1;i<=np;i++)m=m cell(p[i],cw)"│"; print m
    if(bot!=""){                       # merged full-width bottom
      print "    " edge("├","┴","┤")
      fw=np*(cw+1)-1
      print "    │" cell(bl,fw) "│"
      print "    └" rep("─",fw) "┘"
    } else print "    " edge("└","┴","┘")
    np=0; bot=""
  }
  BEGIN{cw=11}
  $1=="window"{flush(); print "    [" $2 "]"}
  $1=="pane"{$1="";sub(/^ /,"");np++;p[np]=$0}
  $1=="bottom"{bot=$2; bl="shell " $2}
  END{flush()}'
}
help_profiles() {
  # Tag the heading with the side only when there is more than one (a hook
  # is active); the default single-context case stays untagged.
  _tag=''
  [ "$_cur_part" = global ] || _tag=" [$_cur_part]"
  printf 'profiles%s (`mux go NAME`):\n' "$_tag"
  echo
  mux_prof_all_names | while IFS= read -r _n; do
    _flat=$(_flat_profile "$_n")
    _th=$(printf '%s\n' "$_flat" | awk '$1=="theme"{print $2;exit}')
    _rt=$(printf '%s\n' "$_flat" | awk '$1=="root"{print $2;exit}')
    [ "$(mux_prof_partition "$_n")" = "$_cur_part" ] || continue
    printf '  %s' "$_n"
    if [ -n "$_th" ]; then          # theme name in its own colour
      _tf=$(mux_data_find themes "$_th" .theme)
      _tb=$(mux_conf_clean \
          < "${_tf:-/dev/null}" 2>/dev/null \
          | awk '$1=="bar"{sub(/^bar[ \t]+/,"");print;exit}')
      printf '  theme %s %s %s' \
        "$(_sgr_style "$_tb")" "$_th" "$_RST"
    fi
    printf '  root %s\n' "${_rt:-<the dir you run it in>}"
    printf '%s\n' "$_flat" | _draw_layout
    echo
  done
}
# The xterm 256-colour palette as swatches (bg=colourN, contrast fg) so a
# theme's bg=/fg= number can be picked by eye. Meaningless without colour.
# palette test BAR_FG BAR_BG ACT_FG ACT_BG: a mock status bar in the given
# bar and active-chip colours, so a whole theme is judged IN CONTEXT rather
# than one swatch at a time. Colours: bar fg, bar bg, active-window fg, bg.
_palette_preview() {    # BAR_FG BAR_BG ACT_FG ACT_BG
  [ "$#" -eq 4 ] || { echo \
    "mux: palette test BAR_FG BAR_BG ACT_FG ACT_BG" >&2
    exit "$MUX_EC_USAGE"; }
  for _c in "$@"; do
    [ -n "$(_sgr_frag "$_c" 48)" ] || {
      echo "mux: bad colour: $_c" >&2; exit "$MUX_EC_USAGE"; }
  done
  _b=$(_sgr_color "$2" 48)$(_sgr_color "$1" 38)   # bar bg + fg
  _a=$(_sgr_color "$4" 48)$(_sgr_color "$3" 38)$(printf '\033[1m')
  printf 'status bar preview '
  printf '(bar fg=%s bg=%s, active fg=%s bg=%s):\n\n' \
    "$1" "$2" "$3" "$4"
  printf '  %s edit │ %s code %s logs   ⏳ · host 09:41 %s\n' \
    "$_b" "$_a" "$_b" "$_RST"
}

# The 256-colour grid. FG is an SGR fragment applied to every cell; empty picks
# black or white per cell by luminance, so each number stays legible on its own
# background.
_palette_grid() {       # [sgr-fg-fragment]
  awk -v fg="$1" '
  function fgof(n,  i,r,g,b,l){
    if(n<16) l=(n==0)?0:(n==7||n>=9)?200:90
    else if(n<232){
      i=n-16; b=i%6; i=int(i/6); g=i%6; r=int(i/6)
      r=r?r*40+55:0; g=g?g*40+55:0; b=b?b*40+55:0
      l=0.3*r+0.59*g+0.11*b
    } else l=8+(n-232)*10
    return l>140?16:231
  }
  function cell(n){
    if(fg!="")
      return sprintf("\033[48;5;%dm\033[%sm%4d\033[0m",n,fg,n)
    return sprintf("\033[48;5;%dm\033[38;5;%dm%4d\033[0m",
      n, fgof(n), n)
  }
  function grid(lo,hi,per,  i,c,s){
    s=""; c=0
    for(i=lo;i<=hi;i++){
      s=s cell(i)
      if(++c==per){print "  " s; s=""; c=0}
    }
    if(c>0)print "  " s
  }
  BEGIN{
    print "  system 0-15:";       grid(0,15,16);   print ""
    print "  cube 16-231:";       grid(16,231,18);  print ""
    print "  grayscale 232-255:"; grid(232,255,12)
  }'
}

help_palette() {        # [FG] | test BAR_FG BAR_BG ACT_FG ACT_BG
  [ -n "$_RST" ] || { echo 'mux: palette needs a terminal' >&2
    return 0; }
  if [ "${1:-}" = test ]; then
    shift
    _palette_preview "$@"
    exit "$MUX_EC_OK"
  fi
  _fg=                            # empty => B&W contrast per cell
  if [ -n "${1:-}" ]; then
    _fg=$(_sgr_frag "$1" 38)
    [ -n "$_fg" ] || { echo \
      "mux: palette fg: 0-255, colourN, #rrggbb, or 0x..." >&2
      exit "$MUX_EC_USAGE"; }
  fi
  if [ -n "$_fg" ]; then
    printf 'palette (fg %s over every bg):\n\n' "$1"
  else
    echo 'palette (the 256 colours; any works as fg OR bg):'
    echo
  fi
  _palette_grid "$_fg"
  [ -n "$_fg" ] || { printf \
    '\n  tip: `palette N` renders colour N as fg here;\n'
    printf '       `palette test FG BG FG BG` mocks a bar.\n'; }
}
# The agent profiles and how to select one: the mux peer of help_colors, so
# `pane agent`'s target (and how to add another CLI) is discoverable.
help_agents() {
  echo 'agents (the CLI a `pane agent` runs). Choose per session with an'
  echo '`agent <name>` line in a layout, or `pane <name>` for one pane:'
  echo
  mux_data_files agents .agent | while IFS= read -r _f; do
    _n=${_f##*/}; _n=${_n%.agent}
    _cf=$(mktemp); mux_conf_clean < "$_f" > "$_cf"
    _go=$(awk '$1=="go"{sub(/^go[ \t]+/,"");print;exit}' "$_cf")
    _rs=$(awk \
        '$1=="resume"{sub(/^resume[ \t]+/,"");print;exit}' "$_cf")
    rm -f "$_cf"
    [ "$_n" = claude ] && _n="$_n (default)"
    printf '  %s\n' "$_n"
    printf '    go      %s\n' "${_go:-<none>}"
    printf '    resume  %s\n' "${_rs:-<none>}"
  done
  printf '\n  profiles: <name>.agent, a `go` line and a `resume` line:\n'
  printf '    %s/agents\n' "$MUX_DIR"
  printf '      (yours: a profile here overrides a shipped one)\n'
  printf '    %s/agents\n' "$MUX_SHARE"
  printf '      (shipped)\n'
  printf '  add a CLI by dropping in one; the state strip also needs'
  printf '\n  the agent to call `mux agent-emit` over its lifecycle.\n'
}

# --- usage, and the lists it shows -----------------------------------------
# MOVED FROM bin/mux (2026-10-05), the last of the help surface. It stayed
# behind in the first pass because EIGHT error paths in the argument parser
# call it, each with its own exit code, and that parser is the most
# load-bearing block in the file. Those are `exec` now, which is what makes
# this safe: exec REPLACES the process, so the caller's `echo ... >&2` lands
# first and this exits with the code it was handed. No return path to get
# wrong.
#
# `_ensure_side` WENT RATHER THAN MOVING. It resolved `_cur_part` lazily
# because usage() in bin/mux runs BEFORE that file's socket block; here the
# context is resolved eagerly at the top and there is no ordering to dodge.

# Layout stems for the caller's side plus the shared (rootless) ones: the same
# one-side-or-the-other view `mux ls` gives for sessions.
_list_layouts() {
  mux_prof_all_names | while IFS= read -r _n; do
    [ "$(mux_prof_partition "$_n")" = "$_cur_part" ] || continue
    printf '%s ' "$_n"
  done
}

# Print "<label><items...>" to stderr, space-separated, wrapping so no line runs
# past 78 columns; continuation lines are indented to the label's width, so a
# long list stays in its column instead of wrapping back to the margin.
_wrap_list() {   # <label> <space-separated items>
  _lbl=$1; _items=$2
  _ind=$(printf "%${#_lbl}s" '')
  _line=$_lbl _first=1
  for _it in $_items; do
    if [ "$_first" = 1 ]; then
      _line=$_lbl$_it; _first=0
    elif [ "$(( ${#_line} + 1 + ${#_it} ))" -le 78 ]; then
      _line="$_line $_it"
    else
      printf '%s\n' "$_line" >&2
      _line=$_ind$_it
    fi
  done
  printf '%s\n' "$_line" >&2
}

# usage [RC]: print help to stderr and exit RC (default 2; `mux --help` passes
# 0). Ends with the live layouts (go/resume/kill NAME) and colors (new COLOR).
usage() {
  cat >&2 <<'EOF'
usage: mux [OPTION] [VERB] [NAME] [PROFILE]  (OPTION may follow VERB too)
  (no verb)                  pick a session to attach (fzf or numbered menu)
  go [NAME|DIR] [PROFILE]    create/attach/switch; agent continues in the pane
  go --resume                same, but the agent resumes (choose a conversation)
  kill NAME                  tear the named session down (--all: every one)
  reload                     re-source tmux.conf on every running mux server
  ls                         list sessions in the current context
  new NAME                   create NAME here (binds the name if needed)
  save [NAME]                snapshot this session (records only deltas)
  hide/show SESSION          hide/unhide SESSION for this client (strip/cycle)
                             show --all clears this client's hidden set
  next-blocked               jump to the session that has needed you longest
  theme [NAME|next|prev]     set/cycle/show the theme (remembered)
  rename [OLD] NEW           rename a session (and its matching layout)
  edit [NAME]                open a profile in $EDITOR
  resume [PARTITION [SESSION]]
                             rebuild a partition's sessions (--list to see
                             them); SESSION is where to focus afterwards.
                             --no-wait-env builds them even when a declared
                             session pointer has not arrived yet
  sane                       put the terminal back after a wedged session
  skill [NAME]               print the agent instructions for this mux
  demo                       a throwaway mux to look at (--stop)
  keys                       what the key bindings do (prefix ?)
  setup AGENT                wire that agent's hooks to mux (--remove,
                             --dry-run, --yes)
                             (--agents-md for the AGENTS.md form)
  latch HOST[:PART] [SESS]   hold an attachment to a remote mux open across
                             drops (bring your own transport; see man 1 mux)
  why [NAME]                 show each resolved value and where it came from
  views [MODE]               who is attached, and what that costs
  agent-doctor               does recorded agent state match reality? (--repair)
  log [-n N] [-f] [SUBSYS]   what mux changed, and what it could not do
  agent-hook EVENT           an agent lifecycle event (wiring calls this)
  window [[PART::]SESS:]NAME
                             open a window in an existing session and go
                             there. --control/--attention declare what it
                             is for; `mux agent open` is the detached form
  even [--all]               put panes back to the declared shape (prefix-E)
  undo-pane                  put back the pane you just closed (prefix-u)
  check                      audit mux's install: package data, deps, overlay
  migrate-profiles           convert pre-rename *.layout files (--apply)
  scan                       rebuild the project discovery map (--list)
  --no-agent                 go/new without the agent (its pane is a shell)
  --attach                   go: attach a live session whose root differs
  --attach-only              go: attach if live, else refuse (never create)
  --all                      kill/show: act on every session
  --force                    overwrite an existing profile (save/new)
  help [TOPIC]               this help; TOPIC = agents|themes|profiles|palette
  -h, --help                 alias for bare `help`
  -V, --version              print the version
EOF
  echo >&2
  _wrap_list "  profiles (mux go NAME):    " "$(_list_layouts)"
  _wrap_list "  themes  (mux theme NAME):  " \
    "$(mux_data_stems_line themes .theme)"
  _wrap_list "  agents  (agent NAME):      " \
    "$(mux_data_stems_line agents .agent)"
  exit "${1:-2}"
}

# THE TOPIC VOCABULARY IS HERE, not in bin/mux, so adding a topic is one edit
# in one file. bin/mux only answers the EMPTY case, which is usage.
case ${1:-} in
# --usage [RC] is bin/mux's eight parser error paths and its -h/--help flag,
# reaching the one copy of the usage text. NOT a topic: it is deliberately
# spelled as a flag so `mux help usage` stays an unknown topic rather than
# becoming a second spelling of `mux --help`.
--usage)           shift; usage "${1:-2}" ;;
# NO TOPIC IS USAGE, which is why bin/mux can now exec straight here for the
# whole verb instead of branching first. `mux help` and `mux --help` are the
# same question and there is one copy of the answer.
'')                usage 0 ;;
agents)            help_agents ;;
themes|colors)     help_colors ;;
profiles|layouts)  help_profiles ;;
palette)           shift; help_palette "$@" ;;
*) echo "mux: unknown help topic: ${1:-}" \
  "(agents, themes, profiles, palette)" >&2
   exit "$MUX_EC_USAGE" ;;
esac
exit "$MUX_EC_OK"
