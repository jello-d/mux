#!/bin/sh
# agent-state-summary: machine-readable aggregate of agent state across a
# namespace, for an EXTERNAL presenter (the SNI tray indicator). Prints one
# line "<state> <count>": STATE is the worst live state across the namespace's
# sessions (blocked > working > idle), COUNT the number of sessions in that
# state; with no tracked agent it prints "none 0". Reuses mux-agent-state.sh so
# the ranking and the state model never drift from the strip and the picker.
#
#   mux agent-summary [NS]
#
# Sessions are derived from the per-pane state FILES in the namespace dir, NOT
# from `tmux list-sessions`, so this answers headless (from a tray daemon, over
# ssh, at boot) with no tmux client. NS is the namespace -- a PARTITION name;
# with none it resolves the caller's context, exactly as the front end does.
#
# That resolution matters precisely BECAUSE this is the headless caller. Every
# other consumer of mux-agent-state.sh (the status strip, next-blocked) runs
# inside tmux and gets its namespace from $TMUX. This one has no $TMUX, so it
# used to fall back to a hardcoded 'default' -- the old tmux socket basename.
# When the personal partition became `global` that name stopped existing, and
# the tray indicator silently read an empty directory and reported "none 0"
# forever.
set -eu

# Sibling libs in this script's own (colocated) libexec dir.
_lib=$(dirname "$0")
. "$_lib/mux-agent-state.sh"

# ARGUMENTS: [--all] [NS]
#
#   (none)   the caller's own partition, as "<state> <count>"
#   NS       that partition, same shape
#   --all    EVERY partition that has agent state, as
#            "<partition> <state> <count>" -- one line each.
#
# --all EXISTS FOR ONE ROUND TRIP. The tray indicator polls a remote host over
# ssh, and asking per partition would multiply that cost by the number of
# partitions on every tick -- for a signal that changes on human timescales
# and whose poll was deliberately slowed to 5s for exactly this reason. One
# question, one answer, however many partitions.
_all=0
case "${1:-}" in
--all|-a) _all=1; shift ;;
esac
_ns=${1:-}
if [ -z "$_ns" ] && [ -r "$_lib/mux-context.sh" ]; then
	. "$_lib/mux-context.sh"
	mux_ctx_resolve 2>/dev/null && _ns=$MUX_CTX_PARTITION
fi

# The distinct sessions, NEWLINE separated and counted line by line. A session
# name may contain a space, so neither joining them with spaces nor iterating
# the result with a bare `for` is safe: one session called `my project` would
# dedup against its own words and then be counted twice, as `my` and `project`.
# A name cannot contain a newline (tmux escapes one in its -F output), so that
# is the delimiter.
_NL='
'

# _summarise DIR -> "<state> <count>": the worst live state in that namespace
# and how many sessions sit in it, else "none 0".
#
# ONE FUNCTION, because --all asks the same question of several directories
# and a second copy of the ranking walk would be a second place for the
# "worst wins" rule to drift from mux-agent-state.sh.
_summarise() {   # <dir>
	_sd=$1
	_sessions=
	if [ -d "$_sd" ]; then
		for _f in "$_sd"/*; do
			[ -e "$_f" ] || continue
			# session LAST, so it survives containing a space.
			read -r _st _win _pane _ep _nid _ss <"$_f" || continue
			[ -n "${_ss:-}" ] || continue
			case "$_NL$_sessions$_NL" in
			*"$_NL$_ss$_NL"*) ;;
			*) _sessions="$_sessions$_NL$_ss" ;;
			esac
		done
	fi
	_sessions=${_sessions#"$_NL"}

	_worst= _wr=-1 _count=0
	while IFS= read -r _s; do
		[ -n "$_s" ] || continue
		_state=$(mux_agent_state "$_sd" "$_s")
		_state=${_state%% *}
		[ -n "$_state" ] || continue
		_r=$(mux_agent_rank "$_state")
		if [ "$_r" -gt "$_wr" ]; then
			_wr=$_r; _worst=$_state; _count=1
		elif [ "$_r" -eq "$_wr" ]; then
			_count=$((_count + 1))
		fi
	# A here-doc, not a pipe: `_worst` and `_count` are carried out of this
	# loop and a pipe would run it in a subshell and discard both.
	done <<EOF
$_sessions
EOF
	[ -n "$_worst" ] || { echo "none 0"; return 0; }
	printf '%s %s\n' "$_worst" "$_count"
}

if [ "$_all" -eq 0 ]; then
	_summarise "$(mux_agent_dir "$_ns")"
	exit 0
fi

# --all: every namespace that EXISTS, plus the caller's own partition even if
# it has none yet. State DIRECTORIES are the truth here rather than the
# configured partition list: a partition file with no agents has nothing to
# report, and a namespace can exist without a file (the directory is created
# by the first emit). Reporting what is actually there is the honest answer.
#
# The caller's own is guaranteed present so a consumer always gets at least
# one line -- the same reason the tray always carries the local host.
_root=$(dirname "$(mux_agent_dir "$_ns")")
_seen=
for _d in "$_root"/*; do
	[ -d "$_d" ] || continue
	_p=${_d##*/}
	_seen="$_seen $_p"
	printf '%s %s\n' "$_p" "$(_summarise "$_d")"
done
case " $_seen " in
*" ${_ns:-global} "*) ;;
*) printf '%s %s\n' "${_ns:-global}" "none 0" ;;
esac
